/* 全局浅绿色科技风样式 */
.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #F0FFF0 0%, #E8F5E8 50%, #F0FFF0 100%);
  font-family: 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

/* 头部样式 - 矩形科技感渐变 */
.header {
  position: relative;
  height: 280rpx;
  overflow: hidden;
  background: linear-gradient(145deg, 
    #00FF387C 0%, 
    #7CFC887C 25%, 
    #98FB987C 50%, 
    #90EE907C 75%, 
    #00FF387C 100%);
  box-shadow: 
    0 8rpx 32rpx rgba(0, 255, 56, 0.15),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.3);
  border-bottom: 2rpx solid rgba(255, 255, 255, 0.5);
}

.header-content {
  position: relative;
  z-index: 2;
  padding: 40rpx 32rpx 32rpx;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
}

.title-section {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.title {
  font-size: 52rpx;
  font-weight: 700;
  color: #1A3B1A;
  letter-spacing: 2rpx;
  text-shadow: 0 2rpx 4rpx rgba(255, 255, 255, 0.8);
}

.header-buttons {
  display: flex;
  gap: 20rpx;
}

.refresh-btn,
.back-btn {
  padding: 16rpx 28rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #1A3B1A;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.9) 0%, rgba(255, 255, 255, 0.7) 100%);
  border: 2rpx solid rgba(255, 255, 255, 0.8);
  border-radius: 20rpx;
  box-shadow: 
    4rpx 4rpx 12rpx rgba(0, 100, 0, 0.1),
    -4rpx -4rpx 12rpx rgba(255, 255, 255, 0.8);
  backdrop-filter: blur(20rpx);
  transition: all 0.3s ease;
}

.refresh-btn:active,
.back-btn:active {
  transform: scale(0.95);
  box-shadow: 
    2rpx 2rpx 6rpx rgba(0, 100, 0, 0.1),
    -2rpx -2rpx 6rpx rgba(255, 255, 255, 0.8);
}

.refresh-btn.loading {
  opacity: 0.7;
  pointer-events: none;
}

.welcome-section {
  margin-bottom: 24rpx;
}

.welcome-text {
  font-size: 30rpx;
  color: #2D5A2D;
  font-weight: 500;
  text-shadow: 0 1rpx 2rpx rgba(255, 255, 255, 0.8);
}

/* 搜索框 - 科技感设计 */
.search-box {
  position: relative;
  margin-top: 20rpx;
}

.search-input {
  width: 100%;
  height: 80rpx;
  padding: 0 90rpx 0 36rpx;
  font-size: 28rpx;
  color: #1A3B1A;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.9) 0%, rgba(255, 255, 255, 0.7) 100%);
  border: 2rpx solid rgba(255, 255, 255, 0.8);
  border-radius: 25rpx;
  box-shadow: 
    inset 2rpx 2rpx 6rpx rgba(0, 100, 0, 0.1),
    4rpx 4rpx 12rpx rgba(0, 100, 0, 0.1);
  backdrop-filter: blur(20rpx);
  box-sizing: border-box;
}

.search-input::placeholder {
  color: #7AA87A;
}

.search-icon {
  position: absolute;
  right: 36rpx;
  top: 50%; 
  transform: translateY(-50%);
  font-size: 32rpx;
  color: #00CC44;
}

/* 内容区域 */
.content {
  padding: 30rpx;
  background: transparent;
}

.loading {
  text-align: center;
  padding: 120rpx 0;
  color: #2D5A2D;
  font-size: 30rpx;
  font-weight: 500;
}

/* 活动卡片 - 科技感设计 */
.activity-list {
  background: transparent;
}

.activity-card {
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.85) 0%, rgba(255, 255, 255, 0.7) 100%);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 28rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.8);
  box-shadow: 
    8rpx 8rpx 24rpx rgba(0, 100, 0, 0.08),
    -4rpx -4rpx 16rpx rgba(255, 255, 255, 0.8);
  backdrop-filter: blur(20rpx);
  position: relative;
  transition: all 0.3s ease;
}

.activity-card:active {
  transform: translateY(4rpx);
  box-shadow: 
    4rpx 4rpx 12rpx rgba(0, 100, 0, 0.08),
    -2rpx -2rpx 8rpx rgba(255, 255, 255, 0.8);
}

.activity-card.ended {
  opacity: 0.8;
  background: linear-gradient(135deg, rgba(240, 240, 240, 0.85) 0%, rgba(240, 240, 240, 0.7) 100%);
}

/* 状态标签 */
.status-badge {
  position: absolute;
  right: 0; 
  top: 0;
  padding: 12rpx 28rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #fff;
  border-radius: 0 24rpx 0 24rpx;
  box-shadow: -2rpx 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.status-badge.pending { 
  background: linear-gradient(135deg, #FFA000 0%, #FF8C00 100%);
}
.status-badge.running { 
  background: linear-gradient(135deg, #00CC44 0%, #00AA33 100%);
}
.status-badge.ended { 
  background: linear-gradient(135deg, #9E9E9E 0%, #757575 100%);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
  padding-right: 100rpx;
}

.activity-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1A3B1A;
  flex: 1;
  margin-right: 20rpx;
  line-height: 1.4;
}

.time-info {
  font-size: 24rpx;
  font-weight: 500;
  color: #00AA33;
  white-space: nowrap;
  background: rgba(0, 255, 56, 0.1);
  padding: 6rpx 12rpx;
  border-radius: 12rpx;
}

.activity-theme,
.activity-form {
  display: block;
  font-size: 26rpx;
  color: #2D5A2D;
  margin-bottom: 8rpx;
  font-weight: 500;
}

.activity-desc {
  display: block;
  font-size: 28rpx;
  color: #1A3B1A;
  margin: 20rpx 0;
  line-height: 1.5;
  font-weight: 400;
}

.activity-details {
  margin: 24rpx 0;
  background: rgba(255, 255, 255, 0.5);
  padding: 20rpx;
  border-radius: 16rpx;
}

.detail-item {
  display: block;
  font-size: 24rpx;
  color: #4A764A;
  margin-bottom: 8rpx;
  font-weight: 400;
}

/* 进度条 - 科技感设计 */
.progress-section {
  margin: 28rpx 0;
}

.progress-info {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: #2D5A2D;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.progress-bar {
  height: 12rpx;
  background: rgba(0, 255, 56, 0.2);
  border-radius: 8rpx;
  overflow: hidden;
  box-shadow: inset 2rpx 2rpx 6rpx rgba(0, 100, 0, 0.1);
}

.progress-fill {
  height: 100%;
  border-radius: 8rpx;
  transition: width 0.5s ease;
  box-shadow: 0 0 12rpx rgba(0, 255, 56, 0.4);
}

.progress-fill.pending { 
  background: linear-gradient(90deg, #2196F3, #64B5F6);
}
.progress-fill.running { 
  background: linear-gradient(90deg, #00CC44, #00FF38);
}
.progress-fill.ended { 
  background: linear-gradient(90deg, #9E9E9E, #BDBDBD);
}

/* 操作按钮 - 科技感设计 */
.action-buttons {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
}

.btn {
  flex: 1;
  padding: 24rpx;
  border: none;
  border-radius: 18rpx;
  font-size: 26rpx;
  font-weight: 600;
  text-align: center;
  transition: all 0.3s ease;
  box-shadow: 
    4rpx 4rpx 12rpx rgba(0, 100, 0, 0.1),
    -2rpx -2rpx 8rpx rgba(255, 255, 255, 0.8);
}

.btn:active {
  transform: scale(0.96);
  box-shadow: 
    2rpx 2rpx 6rpx rgba(0, 100, 0, 0.1),
    -1rpx -1rpx 4rpx rgba(255, 255, 255, 0.8);
}

.detail-btn {
  background: linear-gradient(135deg, rgba(240, 240, 240, 0.9) 0%, rgba(240, 240, 240, 0.7) 100%);
  color: #2D5A2D;
  border: 2rpx solid rgba(255, 255, 255, 0.8);
}

.join-btn {
  background: linear-gradient(135deg, #00FF38 0%, #00CC44 100%);
  color: #1A3B1A;
  border: 2rpx solid rgba(255, 255, 255, 0.8);
  box-shadow: 
    4rpx 4rpx 12rpx rgba(0, 255, 56, 0.3),
    -2rpx -2rpx 8rpx rgba(255, 255, 255, 0.8);
}

.joined-btn {
  background: linear-gradient(135deg, #C8E6C9 0%, #A5D6A7 100%);
  color: #4A764A;
  border: 2rpx solid rgba(255, 255, 255, 0.8);
}

.disabled-btn {
  background: linear-gradient(135deg, #E0E0E0 0%, #BDBDBD 100%);
  color: #9E9E9E;
  border: 2rpx solid rgba(255, 255, 255, 0.8);
}

/* 空状态 - 科技感设计 */
.empty-state {
  text-align: center;
  padding: 140rpx 32rpx;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.7) 0%, rgba(255, 255, 255, 0.5) 100%);
  border-radius: 24rpx;
  margin: 40rpx 0;
  border: 2rpx solid rgba(255, 255, 255, 0.8);
  box-shadow: 
    8rpx 8rpx 24rpx rgba(0, 100, 0, 0.08),
    -4rpx -4rpx 16rpx rgba(255, 255, 255, 0.8);
  backdrop-filter: blur(20rpx);
}

.empty-icon {
  font-size: 100rpx;
  color: #00CC44;
  margin-bottom: 32rpx;
  text-shadow: 0 4rpx 8rpx rgba(0, 255, 56, 0.3);
}

.empty-text {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #1A3B1A;
  margin-bottom: 16rpx;
}

.empty-desc {
  display: block;
  font-size: 28rpx;
  color: #4A764A;
  margin-bottom: 48rpx;
  font-weight: 400;
}

.empty-state .refresh-btn {
  padding: 24rpx 56rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #1A3B1A;
  background: linear-gradient(135deg, #00FF38 0%, #00CC44 100%);
  border-radius: 30rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.8);
  box-shadow: 
    6rpx 6rpx 18rpx rgba(0, 255, 56, 0.3),
    -3rpx -3rpx 12rpx rgba(255, 255, 255, 0.8);
}

.empty-state .refresh-btn:active {
  transform: scale(0.95);
  box-shadow: 
    3rpx 3rpx 9rpx rgba(0, 255, 56, 0.3),
    -1rpx -1rpx 6rpx rgba(255, 255, 255, 0.8);
}

/* 响应式设计 */
@media (max-width: 750rpx) {
  .header {
    height: 260rpx;
  }
  
  .title {
    font-size: 44rpx;
  }
  
  .activity-card {
    padding: 28rpx;
    margin-bottom: 24rpx;
  }
  
  .action-buttons {
    flex-direction: column;
    gap: 16rpx;
  }
  
  .btn {
    padding: 20rpx;
  }
}