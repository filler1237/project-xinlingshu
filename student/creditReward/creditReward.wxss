.container {
  background: linear-gradient(135deg, #F8FCF9 0%, #F0F7F2 100%);
  min-height: 100vh;
}

/* 页面头部 - 添加文本框效果 */
.header {
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(30rpx);
  border-radius: 0 0 24rpx 24rpx;
  padding: 40rpx 32rpx 32rpx;
  margin-bottom: 32rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  box-shadow: 0 4rpx 20rpx rgba(126, 211, 33, 0.08);
}

.header-content {
  text-align: center;
}

.title-section {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.title {
  font-size: 52rpx;
  font-weight: 700;
  color: #1B5E20;
  flex: 1;
  text-align: center;
}

.back-btn {
  font-size: 28rpx;
  color: #4CAF50;
  padding: 16rpx 24rpx;
  border: 1rpx solid rgba(126, 211, 33, 0.3);
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.8);
}

.welcome-text {
  font-size: 30rpx;
  color: #4CAF50;
  font-weight: 500;
  opacity: 0.85;
}

/* 总学分展示 - 添加文本框效果 */
.total-credits-section {
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(30rpx);
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  margin: 0 32rpx 32rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  box-shadow: 0 4rpx 20rpx rgba(126, 211, 33, 0.08);
}

.total-credits-card {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 32rpx;
}

.credit-icon {
  font-size: 80rpx;
}

.credit-info {
  text-align: left;
}

.credit-label {
  display: block;
  font-size: 28rpx;
  color: #4CAF50;
  margin-bottom: 8rpx;
}

.credit-value {
  font-size: 64rpx;
  font-weight: 700;
  color: #1B5E20;
}

/* 学分明细列表 - 添加文本框效果 */
.credit-list-section {
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(30rpx);
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  margin: 0 32rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  box-shadow: 0 4rpx 20rpx rgba(126, 211, 33, 0.08);
}

.section-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #2E7D32;
  margin-bottom: 32rpx;
  text-align: center;
}

.credit-list {
  margin-top: 24rpx;
}

.credit-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 0;
  border-bottom: 1rpx solid rgba(126, 211, 33, 0.1);
}

.credit-item:last-child {
  border-bottom: none;
}

.activity-info {
  flex: 1;
}

.activity-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #2E7D32;
  margin-bottom: 8rpx;
  display: block;
}

.obtain-time {
  font-size: 26rpx;
  color: #4CAF50;
  opacity: 0.7;
  display: block;
}

.credit-value-section {
  text-align: right;
}

.credit-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #7ED321;
  margin-right: 8rpx;
}

.credit-unit {
  font-size: 24rpx;
  color: #4CAF50;
}

/* 空状态 - 添加文本框效果 */
.empty-state {
  text-align: center;
  padding: 80rpx 40rpx;
}

.empty-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #2E7D32;
  font-weight: 600;
  display: block;
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 28rpx;
  color: #4CAF50;
  opacity: 0.7;
  display: block;
}