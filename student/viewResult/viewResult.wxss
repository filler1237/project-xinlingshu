/* 静态顶尖UI | 浅绿渐变+毛玻璃 | 零动画 - 统一风格
-------------------------------------------------- */
page {
  background: linear-gradient(135deg, #f0f9f4 0%, #e8f5e9 50%, #e0f2eb 100%);
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, sans-serif;
  min-height: 100vh;
}

.container {
  padding: 32rpx;
}

/* 页面头部 - 毛玻璃效果 */
.header {
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(30rpx);
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 32rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  box-shadow: 0 8rpx 32rpx rgba(126, 211, 33, 0.08);
  position: relative;
  overflow: hidden;
}

.header::before {
  content: '';
  position: absolute;
  top: -20%;
  right: -20%;
  width: 160rpx;
  height: 160rpx;
  background: linear-gradient(45deg, rgba(126, 211, 33, 0.05), rgba(76, 175, 80, 0.08));
  border-radius: 50%;
  z-index: 0;
}

.header-content {
  position: relative;
  z-index: 1;
}

.title-section {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.title {
  font-size: 48rpx;
  font-weight: 700;
  color: #1B5E20;
  line-height: 1.3;
  letter-spacing: -0.5rpx;
  flex: 1;
  text-align: center;
}

.back-btn {
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(20rpx);
  color: #4CAF50;
  padding: 20rpx 28rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: 1rpx solid rgba(126, 211, 33, 0.3);
  box-shadow: 0 2rpx 12rpx rgba(126, 211, 33, 0.1);
}

.welcome-section {
  text-align: center;
}

.welcome-text {
  font-size: 30rpx;
  color: #4CAF50;
  font-weight: 500;
  opacity: 0.85;
  line-height: 1.5;
}

/* 作品列表选择区域 */
.works-list-section {
  background: rgba(255, 255, 255, 0.88);
  backdrop-filter: blur(30rpx);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  box-shadow: 0 8rpx 32rpx rgba(126, 211, 33, 0.06);
}

.works-scroll {
  white-space: nowrap;
  margin-top: 20rpx;
}

.work-item {
  display: inline-block;
  padding: 20rpx 32rpx;
  margin-right: 16rpx;
  background: rgba(240, 249, 244, 0.8);
  border-radius: 16rpx;
  border: 2rpx solid rgba(76, 175, 80, 0.2);
  min-width: 200rpx;
  text-align: center;
}

.work-item.active {
  background: linear-gradient(135deg, #4CAF50 0%, #66BB6A 100%);
  border-color: #4CAF50;
  color: white;
}

.work-item-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #2E7D32;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.work-item.active .work-item-title {
  color: white;
}

.work-item-status {
  display: block;
  font-size: 22rpx;
  color: #66BB6A;
}

.work-item.active .work-item-status {
  color: rgba(255, 255, 255, 0.9);
}

/* 加载状态 */
.loading-state {
  text-align: center;
  padding: 120rpx 0;
  font-size: 28rpx;
  color: #66BB6A;
}

/* 搜索栏 - 毛玻璃效果 */
.search-section {
  padding: 0 0 32rpx 0;
}

.search-box {
  background: rgba(255, 255, 255, 0.88);
  backdrop-filter: blur(30rpx);
  border-radius: 24rpx;
  padding: 32rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  box-shadow: 0 8rpx 32rpx rgba(126, 211, 33, 0.06);
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.search-input {
  flex: 1;
  font-size: 30rpx;
  color: #1B5E20;
  font-weight: 500;
  background: transparent;
  border: none;
  outline: none;
}

.search-input::placeholder {
  color: #81C784;
  font-weight: 400;
}

.search-btn {
  background: linear-gradient(135deg, #7ED321, #4CAF50);
  border-radius: 16rpx;
  padding: 20rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 20rpx rgba(126, 211, 33, 0.3);
}

.search-icon {
  font-size: 32rpx;
  color: white;
  font-weight: bold;
}

/* 流程步骤 - 毛玻璃效果 */
.process-section {
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(30rpx);
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 32rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.4);
  box-shadow: 0 8rpx 32rpx rgba(126, 211, 33, 0.05);
  position: relative;
  overflow: hidden;
}

.process-section::before {
  content: '';
  position: absolute;
  top: -30%;
  left: -30%;
  width: 200rpx;
  height: 200rpx;
  background: linear-gradient(45deg, rgba(126, 211, 33, 0.08), rgba(76, 175, 80, 0.12));
  border-radius: 50%;
  z-index: 0;
}

.section-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #2E7D32;
  margin-bottom: 32rpx;
  text-align: center;
  position: relative;
  z-index: 1;
}

.process-steps {
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;
  z-index: 1;
}

.process-step {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  position: relative;
}

.step-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #E8F5E9, #C8E6C9);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 700;
  color: #66BB6A;
  margin-bottom: 20rpx;
  border: 3rpx solid #C8E6C9;
  box-shadow: 0 4rpx 15rpx rgba(76, 175, 80, 0.15);
}

.process-step.active .step-icon {
  background: linear-gradient(135deg, #7ED321, #4CAF50);
  color: white;
  border-color: #4CAF50;
  box-shadow: 0 6rpx 25rpx rgba(126, 211, 33, 0.35);
}

.step-text {
  font-size: 28rpx;
  color: #9E9E9E;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.process-step.active .step-text {
  color: #2E7D32;
  font-weight: 700;
}

.step-desc {
  font-size: 24rpx;
  color: #BDBDBD;
  text-align: center;
  font-weight: 400;
}

.process-step.active .step-desc {
  color: #4CAF50;
  font-weight: 500;
}

.process-connector {
  flex: 1;
  height: 6rpx;
  background: linear-gradient(90deg, #E8F5E9, #C8E6C9);
  margin: 0 25rpx;
  position: relative;
  top: -40rpx;
  border-radius: 3rpx;
}

.process-connector.active {
  background: linear-gradient(90deg, #7ED321, #81C784, #7ED321);
}

/* 状态概览 - 毛玻璃效果 */
.status-overview {
  margin-bottom: 32rpx;
}

.status-card {
  background: rgba(255, 255, 255, 0.88);
  backdrop-filter: blur(30rpx);
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  box-shadow: 0 8rpx 32rpx rgba(126, 211, 33, 0.06);
  display: flex;
  align-items: center;
  gap: 32rpx;
  position: relative;
  overflow: hidden;
}

.status-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 6rpx;
  border-radius: 3rpx 3rpx 0 0;
}

.status-card.submitted::before {
  background: linear-gradient(90deg, #FF9800, #FFB74D);
}

.status-card.reviewing::before {
  background: linear-gradient(90deg, #2196F3, #64B5F6);
}

.status-card.completed::before {
  background: linear-gradient(90deg, #7ED321, #81C784);
}

.status-card.rejected::before {
  background: linear-gradient(90deg, #F44336, #E57373);
}

.status-icon {
  font-size: 80rpx;
  width: 120rpx;
  text-align: center;
}

.status-info {
  flex: 1;
}

.status-text {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #1B5E20;
  margin-bottom: 12rpx;
  letter-spacing: -0.5rpx;
}

.status-desc {
  display: block;
  font-size: 28rpx;
  color: #66BB6A;
  font-weight: 500;
  line-height: 1.4;
}

.status-badge {
  background: rgba(126, 211, 33, 0.15);
  color: #2E7D32;
  padding: 16rpx 28rpx;
  border-radius: 25rpx;
  font-size: 26rpx;
  font-weight: 700;
  border: 1rpx solid rgba(126, 211, 33, 0.2);
}

/* 信息卡片 - 毛玻璃效果 */
.info-section, .score-section, .final-result, .preview-section {
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(30rpx);
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 32rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.4);
  box-shadow: 0 8rpx 32rpx rgba(126, 211, 33, 0.05);
  position: relative;
  overflow: hidden;
}

.info-section::before, .score-section::before, .final-result::before, .preview-section::before {
  content: '';
  position: absolute;
  top: -20%;
  right: -20%;
  width: 160rpx;
  height: 160rpx;
  background: linear-gradient(45deg, rgba(126, 211, 33, 0.05), rgba(76, 175, 80, 0.08));
  border-radius: 50%;
  z-index: 0;
}

/* 信息网格 */
.info-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
  position: relative;
  z-index: 1;
}

.info-item {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 24rpx;
  background: rgba(232, 245, 233, 0.4);
  border-radius: 16rpx;
  border: 1rpx solid rgba(200, 230, 201, 0.5);
}

.info-label {
  font-size: 26rpx;
  color: #66BB6A;
  font-weight: 600;
}

.info-value {
  font-size: 30rpx;
  color: #2E7D32;
  font-weight: 700;
  line-height: 1.3;
}

/* 最终结果 */
.final-result {
  background: rgba(126, 211, 33, 0.08);
  border: 1rpx solid rgba(126, 211, 33, 0.15);
}

.result-card {
  text-align: center;
  padding: 20rpx;
  position: relative;
  z-index: 1;
}

.result-header {
  margin-bottom: 32rpx;
}

.result-title {
  display: block;
  font-size: 32rpx;
  color: #1B5E20;
  margin-bottom: 24rpx;
  font-weight: 700;
}

.final-score {
  display: flex;
  justify-content: center;
  align-items: baseline;
  gap: 12rpx;
}

.score-main {
  font-size: 72rpx;
  font-weight: 800;
  color: #FF9800;
  text-shadow: 0 4rpx 12rpx rgba(255, 152, 0, 0.3);
}

.score-divider {
  font-size: 36rpx;
  color: #81C784;
  font-weight: 600;
}

.score-total {
  font-size: 32rpx;
  color: #81C784;
  font-weight: 600;
}

.result-rank {
  background: rgba(255, 255, 255, 0.8);
  padding: 24rpx;
  border-radius: 16rpx;
  margin-bottom: 32rpx;
  display: inline-flex;
  align-items: center;
  gap: 16rpx;
  border: 1rpx solid rgba(126, 211, 33, 0.2);
}

.rank-label {
  font-size: 28rpx;
  color: #66BB6A;
  font-weight: 600;
}

.rank-value {
  font-size: 32rpx;
  font-weight: 800;
  color: #2E7D32;
}

.result-actions {
  display: flex;
  gap: 24rpx;
  justify-content: center;
}

.action-btn {
  padding: 24rpx 40rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 700;
  border: 1rpx solid transparent;
}

.action-btn.primary {
  background: linear-gradient(135deg, #7ED321, #4CAF50);
  color: white;
  box-shadow: 0 4rpx 20rpx rgba(126, 211, 33, 0.3);
}

.action-btn.secondary {
  background: rgba(255, 255, 255, 0.9);
  color: #2E7D32;
  border-color: #81C784;
}

/* 作品预览 */
.work-preview {
  background: rgba(255, 255, 255, 0.6);
  border-radius: 20rpx;
  padding: 32rpx;
  border: 1rpx solid rgba(200, 230, 201, 0.5);
  position: relative;
  z-index: 1;
}

.work-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #1B5E20;
  margin-bottom: 24rpx;
  text-align: center;
}

.work-content {
  display: block;
  font-size: 28rpx;
  color: #2E7D32;
  line-height: 1.7;
  margin-bottom: 32rpx;
  font-weight: 500;
}

/* 附件列表 */
.attachment-list {
  margin-top: 32rpx;
}

.attachment-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 16rpx;
  border: 1rpx solid rgba(200, 230, 201, 0.6);
  margin-bottom: 24rpx;
  position: relative;
  overflow: hidden;
}

.attachment-item::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  height: 100%;
  width: 6rpx;
  background: linear-gradient(180deg, #7ED321, #81C784);
}

.file-icon {
  font-size: 40rpx;
  margin-right: 24rpx;
  color: #4CAF50;
}

.file-info {
  flex: 1;
}

.file-name {
  display: block;
  font-size: 28rpx;
  color: #1B5E20;
  margin-bottom: 8rpx;
  font-weight: 600;
}

.file-size {
  display: block;
  font-size: 24rpx;
  color: #66BB6A;
  font-weight: 500;
}

.file-action {
  color: #4CAF50;
  padding: 16rpx 24rpx;
  border-radius: 12rpx;
  border: 1rpx solid #81C784;
  background: rgba(255, 255, 255, 0.7);
  font-weight: 600;
}

/* 测试数据提示 */
.test-data-notice {
  background: rgba(255, 193, 7, 0.15);
  border: 1rpx solid rgba(255, 193, 7, 0.2);
  border-radius: 20rpx;
  padding: 30rpx 25rpx;
  margin-top: 32rpx;
  display: flex;
  align-items: center;
  gap: 25rpx;
}

.notice-icon {
  font-size: 40rpx;
  color: #FF9800;
}

.notice-text {
  font-size: 28rpx;
  color: #FF9800;
  line-height: 1.4;
  flex: 1;
  font-weight: 600;
  letter-spacing: 0.2rpx;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 120rpx 40rpx;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 24rpx;
  margin-top: 32rpx;
  border: 1rpx solid rgba(126, 211, 33, 0.15);
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 32rpx;
  opacity: 0.7;
  color: #4CAF50;
}

.empty-text {
  display: block;
  font-size: 32rpx;
  color: #2E7D32;
  margin-bottom: 24rpx;
  font-weight: 700;
}

.empty-desc {
  display: block;
  font-size: 28rpx;
  color: #66BB6A;
  line-height: 1.5;
  font-weight: 500;
  margin-bottom: 32rpx;
}

.empty-action {
  background: linear-gradient(135deg, #7ED321, #4CAF50);
  color: white;
  padding: 24rpx 40rpx;
  border-radius: 16rpx;
  margin-top: 24rpx;
  display: inline-block;
  box-shadow: 0 4rpx 20rpx rgba(126, 211, 33, 0.3);
  font-size: 28rpx;
  font-weight: 600;
  border: none;
}