.task-panel-wrapper {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx;
  z-index: 1000;
}

.task-panel {
  background-color: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(10px);
  border-radius: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  overflow: hidden;
  transition: all 0.3s ease-in-out;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 30rpx;
  cursor: pointer;
}

.header-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.arrow {
  width: 32rpx;
  height: 32rpx;
  transition: transform 0.3s ease-in-out;
}

.arrow.up {
  transform: rotate(180deg);
}

/* 任务列表容器，用于高度动画 */
.task-list-container {
  max-height: 0;
  opacity: 0;
  transition: max-height 0.3s ease-in-out, opacity 0.3s ease-in-out;
  padding: 0 30rpx;
}

.task-panel.expanded .task-list-container {
  max-height: 500rpx; /* 设置一个足够大的值 */
  opacity: 1;
}

/* 实际的任务列表，用于处理padding */
.task-list {
  padding-bottom: 24rpx;
  border-top: 1rpx solid #f0f0f0;
}
