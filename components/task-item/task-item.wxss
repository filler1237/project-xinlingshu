.task-item-container {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  position: relative;
  transition: opacity 0.4s ease-in-out;
}

.content {
  position: relative;
  display: inline-block;
}

.title {
  font-size: 28rpx;
  transition: color 0.4s ease-in-out;
  color: #333;
}

.line {
  position: absolute;
  top: 50%;
  left: 0;
  height: 2rpx;
  background-color: #aaa;
  transform-origin: left center;
  /* 初始状态由 JS 控制 width: 0 */
}

.checkmark {
  width: 40rpx;
  height: 40rpx;
  margin-left: 20rpx;
  flex-shrink: 0; /* 防止图标被压缩 */
}
