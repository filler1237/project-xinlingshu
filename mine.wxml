<!-- 编辑个人信息弹窗 (原生实现) -->
<view class="popup-overlay" wx:if="{{ showEditProfilePopup }}" bindtap="onCloseEditProfilePopup">
  <view class="popup-container" catchtap="doNothing"> <!-- catchtap 防止点击弹窗内容导致弹窗关闭 -->
    <view class="popup-header">
      <text class="cancel-btn" bindtap="onCloseEditProfilePopup">取消</text>
      <text class="popup-title">编辑资料</text>
      <text class="save-btn" bindtap="onSaveProfile">保存</text>
    </view>
    <view class="popup-content">
      <view class="avatar-edit" bindtap="onChangeAvatar">
        <image class="editing-avatar" src="{{tempAvatarUrl || '/image/默认头像.jpeg'}}" />
        <text class="change-avatar-text">更换头像</text>
      </view>
      <view class="nickname-edit">
        <!-- 这里我们用一个普通的 view 和 input 来代替 van-field -->
        <view class="input-wrapper">
          <text class="input-label">昵称</text>
          <input 
            class="input-field" 
            value="{{ editingNickName }}" 
            placeholder="请输入昵称" 
            bindinput="onNickNameInput"
          />
        </view>
      </view>
    </view>
  </view>
</view>

<!-- 身份选择弹窗 - 修复版本 -->
<view class="popup-overlay" wx:if="{{ showIdentityPopup }}" bindtap="onCloseIdentityPopup">
  <view class="popup-container identity-popup" catchtap="doNothing">
    <view class="popup-header">
      <text class="popup-title">选择您的身份</text>
    </view>
    <view class="popup-content identity-options">
      <view class="identity-option" bindtap="onChooseIdentity" data-identity="student">
        <view class="identity-icon-placeholder">🎓</view>
        <text class="identity-text">学生</text>
        <text class="identity-desc">使用心灵树洞功能，参与活动</text>
      </view>
      
      <view class="identity-option" bindtap="onChooseIdentity" data-identity="admin">
        <view class="identity-icon-placeholder">⚙️</view>
        <text class="identity-text">管理员</text>
        <text class="identity-desc">管理活动系统，审核内容</text>
      </view>
      
      <view class="identity-option" bindtap="onChooseIdentity" data-identity="judge">
        <view class="identity-icon-placeholder">⭐</view>
        <text class="identity-text">评委</text>
        <text class="identity-desc">评审活动作品，打分评价</text>
      </view>
    </view>
    <view class="popup-footer">
      <button class="cancel-btn" bindtap="onCloseIdentityPopup">取消</button>
    </view>
  </view>
</view>