/* pages/admin/home/home.wxss */
.admin-home {
  background-color: #f8fcf9;
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 1. 概览区域 */
.overview-section {
  background: linear-gradient(135deg, #4cd964 0%, #44d7a8 100%);
  border-radius: 0 0 40rpx 40rpx;
  padding: 30rpx 30rpx 40rpx;
  color: white;
  box-shadow: 0 10rpx 30rpx rgba(76, 217, 100, 0.15);
  margin-bottom: 40rpx;
  position: relative;
}

.back-button {
  position: absolute;
  top: 35rpx;
  left: 30rpx;
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: white;
  opacity: 0.95;
  z-index: 10;
}
.back-icon {
  font-size: 36rpx;
  margin-right: 8rpx;
  font-weight: bold;
}

.user-card {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-top: 50rpx;
  margin-bottom: 40rpx;
}

.user-meta {
  display: flex;
  align-items: center;
}

.avatar-wrapper {
  width: 90rpx;
  height: 90rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  backdrop-filter: blur(10px);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.4);
}

.avatar-text {
  font-size: 36rpx;
  font-weight: bold;
  color: white;
}

.user-info {
  display: flex;
  flex-direction: column;
}

.user-greeting {
  font-size: 24rpx;
  opacity: 0.9;
  margin-bottom: 6rpx;
}

.user-name {
  font-size: 34rpx;
  font-weight: bold;
}

.today-date {
  font-size: 24rpx;
  opacity: 0.9;
  background: rgba(255, 255, 255, 0.15);
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
}

/* 精简数据看板 */
.stats-board {
  display: flex;
  justify-content: space-between;
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(20px);
  border-radius: 24rpx;
  padding: 25rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.25);
}

.stat-item {
  flex: 1;
  text-align: center;
  padding: 0 10rpx;
}

.stat-value {
  display: block;
  font-size: 48rpx;
  font-weight: 800;
  margin-bottom: 8rpx;
}

.stat-label {
  display: block;
  font-size: 24rpx;
  opacity: 0.9;
}

/* 2. 核心功能区域 */
.workspace-section {
  padding: 0 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #2c3e50;
  margin-bottom: 30rpx;
  padding-left: 10rpx;
}

.core-function-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
  margin-bottom: 40rpx;
}

.core-function-card {
  background: white;
  border-radius: 24rpx;
  padding: 35rpx 25rpx;
  text-align: center;
  box-shadow: 0 6rpx 20rpx rgba(76, 217, 100, 0.08);
  border: 1rpx solid rgba(76, 217, 100, 0.12);
  transition: all 0.3s ease;
}
.core-function-card:active {
  transform: translateY(-6rpx);
  box-shadow: 0 12rpx 30rpx rgba(76, 217, 100, 0.12);
}

.core-icon {
  font-size: 60rpx;
  margin-bottom: 20rpx;
  display: block;
}

.core-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #2c3e50;
  display: block;
  margin-bottom: 10rpx;
}

.core-desc {
  font-size: 24rpx;
  color: #5a6c7d;
  display: block;
  margin-bottom: 8rpx;
  line-height: 1.4;
}

.core-note {
  font-size: 20rpx;
  color: #4cd964;
  display: block;
  font-style: italic;
  margin-top: 5rpx;
}

/* 系统说明 */
.system-note {
  background: #edf9f0;
  border-radius: 20rpx;
  padding: 25rpx;
  border-left: 6rpx solid #4cd964;
  display: flex;
  align-items: flex-start;
}

.note-icon {
  font-size: 32rpx;
  margin-right: 15rpx;
  flex-shrink: 0;
}

.note-text {
  font-size: 24rpx;
  color: #5a6c7d;
  line-height: 1.5;
}