.login-container {
  padding: 40rpx;
  min-height: 100vh;
  background: linear-gradient(135deg, #e0f7fa 0%, #b2ebf2 100%);
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.login-header {
  text-align: center;
  margin-bottom: 80rpx;
}

.title {
  display: block;
  font-size: 52rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  color: #00796b;
}

.subtitle {
  font-size: 32rpx;
  color: #004d40;
}

.login-type {
  background-color: white;
  padding: 40rpx 30rpx;
  border-radius: 20rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 8rpx 30rpx rgba(0,150,136,0.1);
}

.radio-item {
  display: flex;
  align-items: center;
  margin: 25rpx 0;
  font-size: 34rpx;
  color: #00796b;
}

.radio-item radio {
  margin-right: 20rpx;
  transform: scale(0.8);
}

.login-form {
  background-color: white;
  padding: 40rpx 30rpx;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 30rpx rgba(0,150,136,0.1);
}

.input-group {
  margin-bottom: 40rpx;
}

.label {
  display: block;
  font-size: 32rpx;
  margin-bottom: 20rpx;
  color: #00796b;
  font-weight: 500;
}

.input {
  border: 2rpx solid #b2dfdb;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 32rpx;
  background-color: #fafafa;
  transition: all 0.3s;
}

.input:focus {
  border-color: #00796b;
  background-color: white;
}

.login-btn {
  background: linear-gradient(135deg, #00796b 0%, #004d40 100%);
  color: white;
  border-radius: 12rpx;
  font-size: 34rpx;
  padding: 24rpx;
  margin-top: 20rpx;
  border: none;
  box-shadow: 0 4rpx 15rpx rgba(0,150,136,0.3);
  transition: all 0.3s;
}

.login-btn:active {
  transform: translateY(2rpx);
  box-shadow: 0 2rpx 8rpx rgba(0,150,136,0.3);
}

.register-link {
  text-align: center;
  margin-top: 40rpx;
  font-size: 30rpx;
  color: #00796b;
}

.link {
  color: #004d40;
  margin-left: 10rpx;
  font-weight: bold;
}