/* pages/teacher/home/teacherHome.wxss
 * 舒适间距版 | 绿色方框返回键 | 零荧光绿
-------------------------------------------------- */
page{
  background: linear-gradient(180deg, #F0F9F0 0%, #FFFFFF 100%);
  font-family: PingFang SC;
  min-height: 100vh;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

.container{ padding: 36rpx; }

/* 顶部导航区 - 舒适高度 */
.header{
  padding: 56rpx 36rpx 40rpx;
  background: linear-gradient(135deg, #7ED321 0%, #5BAE0C 100%);
  border-radius: 0 0 28rpx 28rpx;
  box-shadow: 0 6rpx 20rpx rgba(126,211,33,.2);
  position: relative;
  overflow: hidden;
}
.header::before{
  content: '';
  position: absolute; inset: 0;
  background: radial-gradient(circle at 30% 20%, rgba(255,255,255,.15) 0%, transparent 50%),
              radial-gradient(circle at 70% 80%, rgba(255,255,255,.08) 0%, transparent 50%);
}
.header-content{ position: relative; z-index: 2; }

.title-section{
  display: flex; justify-content: space-between; align-items: center;
  gap: 16rpx;   /* 标题与按钮呼吸距离 */
}
.title{
  font-size: 42rpx;
  font-weight: 700;
  color: #FFFFFF;
  text-shadow: 0 2rpx 6rpx rgba(0,0,0,.1);
}

/* 绿色方框返回键 */
.back-btn{
  background: #7ED321;
  color: #FFFFFF;
  padding: 14rpx 26rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  font-weight: 500;
  border: none;
  box-shadow: 0 4rpx 12rpx rgba(126,211,33,.3);
  transition: all .3s;
}
.back-btn:active{ background: #6AC210; transform: scale(.96); }

.welcome-section{
  margin-top: 20rpx;          /* 舒适下沉 */
  padding: 24rpx;
  background: rgba(255,255,255,.2);
  border-radius: 16rpx;
  backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(255,255,255,.3);
}
.welcome-text{
  font-size: 28rpx;
  color: #FFFFFF;
  text-align: center;
  font-weight: 500;
}

/* 内容区 - 自然上提 */
.content{
  padding: 36rpx 24rpx;
  margin-top: -28rpx;
  position: relative;
  z-index: 1;
}

.activity-list{
  display: flex;
  flex-direction: column;
  gap: 26rpx;   /* 舒适卡片间隙 */
}
.activity-item{
  background: rgba(255,255,255,.85);
  border-radius: 22rpx;
  padding: 36rpx 32rpx;   /* 松弛内边距 */
  box-shadow: 0 6rpx 20rpx rgba(0,0,0,.05);
  backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(126,211,33,.1);
  border-left: 6rpx solid #7ED321;
  transition: all .3s;
}
.activity-item:active{
  transform: translateY(-2rpx);
  box-shadow: 0 10rpx 25rpx rgba(126,211,33,.15);
}

.activity-title{
  font-size: 32rpx;
  font-weight: 600;
  color: #3F3F3F;
  margin-bottom: 14rpx;
  padding-left: 14rpx;
  position: relative;
}
.activity-title::before{
  content: '';
  position: absolute; left: 0; top: 50%; transform: translateY(-50%);
  width: 4rpx; height: 20rpx;
  background: #7ED321;
  border-radius: 2rpx;
}
.activity-desc{
  font-size: 26rpx;
  color: #666;
  margin-bottom: 18rpx;
  line-height: 1.5;
}
.activity-info{
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid rgba(126,211,33,.1);
}
.info-item{
  font-size: 24rpx;
  color: #7ED321;
  display: flex; align-items: center;
}
.info-item::before{
  content: '▶'; margin-right: 10rpx;
  font-size: 18rpx;
}

.empty-state{
  margin: 100rpx 32rpx 0;
  padding: 64rpx 36rpx;
  background: rgba(255,255,255,.7);
  border-radius: 22rpx;
  text-align: center;
  backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(126,211,33,.1);
}
.empty-icon{ font-size: 60rpx; color: #7ED321; margin-bottom: 20rpx; }
.empty-text{ font-size: 30rpx; color: #3F3F3F; font-weight: 600; margin-bottom: 10rpx; }
.empty-desc{ font-size: 24rpx; color: #999; }

/* 淡入动画 - 稍慢但舒适 */
@keyframes fadeInUp{
  from{ opacity: 0; transform: translateY(24rpx); }
  to{ opacity: 1; transform: translateY(0); }
}
.activity-item{ animation: fadeInUp .5s ease forwards; }
.activity-item:nth-child(1){ animation-delay: .08s; }
.activity-item:nth-child(2){ animation-delay: .16s; }
.activity-item:nth-child(3){ animation-delay: .24s; }
.activity-item:nth-child(4){ animation-delay: .32s; }
.activity-item:nth-child(5){ animation-delay: .4s; }