.container {
  padding: 0;
  min-height: 100vh;
  background: linear-gradient(135deg, #f0f9f4 0%, #e8f5e9 50%, #e0f2eb 100%);
}

.header {
  background: linear-gradient(135deg, #4CAF50 0%, #2E7D32 100%);
  padding: 60rpx 40rpx;
  text-align: center;
  border-bottom-left-radius: 30rpx;
  border-bottom-right-radius: 30rpx;
  box-shadow: 0 8rpx 30rpx rgba(76, 175, 80, 0.3);
  position: relative;
  overflow: hidden;
}

.header::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: 
    radial-gradient(circle at 30% 20%, rgba(255,255,255,0.1) 0%, transparent 50%),
    radial-gradient(circle at 70% 80%, rgba(255,255,255,0.05) 0%, transparent 50%);
}

.title {
  font-size: 44rpx;
  font-weight: bold;
  color: white;
  text-shadow: 0 4rpx 12rpx rgba(0,0,0,0.2);
  position: relative;
  z-index: 2;
}

.form {
  padding: 40rpx 30rpx;
}

.form-section {
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(20rpx);
  border-radius: 24rpx;
  padding: 40rpx;
  margin-bottom: 35rpx;
  box-shadow: 
    0 8rpx 40rpx rgba(76, 175, 80, 0.15),
    0 2rpx 12rpx rgba(0,0,0,0.05);
  border: 1rpx solid rgba(76, 175, 80, 0.1);
  position: relative;
  overflow: hidden;
}

.form-section::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 8rpx;
  height: 100%;
  background: linear-gradient(180deg, #4CAF50, #81C784);
}

.section-title {
  display: block;
  font-size: 34rpx;
  font-weight: bold;
  color: #1B5E20;
  margin-bottom: 35rpx;
  position: relative;
  padding-left: 20rpx;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 30rpx;
  background: #4CAF50;
  border-radius: 3rpx;
}

.activity-selector {
  display: flex;
  flex-direction: column;
  gap: 25rpx;
}

.activity-option {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 35rpx 30rpx;
  border: 2rpx solid #C8E6C9;
  border-radius: 20rpx;
  transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  background: rgba(255, 255, 255, 0.7);
  position: relative;
  overflow: hidden;
}

.activity-option::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(76, 175, 80, 0.1), transparent);
  transition: left 0.6s ease;
}

.activity-option:active::before {
  left: 100%;
}

.activity-option.selected {
  border-color: #4CAF50;
  background: rgba(76, 175, 80, 0.05);
  box-shadow: 0 6rpx 25rpx rgba(76, 175, 80, 0.2);
  transform: translateY(-2rpx);
}

.activity-info {
  flex: 1;
}

.activity-name {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #2E7D32;
  margin-bottom: 12rpx;
}

.activity-deadline {
  display: block;
  font-size: 26rpx;
  color: #66BB6A;
  font-family: 'Courier New', monospace;
}

.checkmark {
  color: #4CAF50;
  font-size: 36rpx;
  font-weight: bold;
  text-shadow: 0 2rpx 8rpx rgba(76, 175, 80, 0.3);
}

.input-group {
  margin-bottom: 45rpx;
}

.input-group:last-child {
  margin-bottom: 0;
}

.input-label {
  display: block;
  font-size: 30rpx;
  color: #1B5E20;
  margin-bottom: 25rpx;
  font-weight: 600;
}

.input, .textarea {
  border: 2rpx solid #A5D6A7;
  border-radius: 16rpx;
  padding: 28rpx;
  font-size: 30rpx;
  background: rgba(255, 255, 255, 0.8);
  transition: all 0.3s ease;
  box-shadow: 0 2rpx 12rpx rgba(165, 214, 167, 0.1);
}

.input:focus, .textarea:focus {
  border-color: #4CAF50;
  box-shadow: 0 4rpx 20rpx rgba(76, 175, 80, 0.2);
  background: white;
}

.textarea {
  height: 240rpx;
  line-height: 1.6;
}

.char-count {
  display: block;
  text-align: right;
  font-size: 26rpx;
  color: #81C784;
  margin-top: 15rpx;
  font-family: 'Courier New', monospace;
}

.file-upload {
  border: 2rpx dashed #81C784;
  border-radius: 20rpx;
  padding: 50rpx 40rpx;
  text-align: center;
  transition: all 0.4s ease;
  background: rgba(129, 199, 132, 0.03);
  position: relative;
}

.file-upload:active {
  background: rgba(129, 199, 132, 0.1);
  border-color: #4CAF50;
  transform: scale(0.98);
}

.upload-icon {
  display: block;
  font-size: 72rpx;
  margin-bottom: 25rpx;
  opacity: 0.8;
  color: #4CAF50;
}

.upload-text {
  display: block;
  font-size: 32rpx;
  color: #2E7D32;
  margin-bottom: 15rpx;
  font-weight: 600;
}

.upload-hint {
  display: block;
  font-size: 26rpx;
  color: #66BB6A;
  line-height: 1.5;
}

.file-list {
  padding: 25rpx 0;
}

.file-item {
  display: flex;
  align-items: center;
  padding: 25rpx;
  background: rgba(76, 175, 80, 0.05);
  border-radius: 16rpx;
  border: 1rpx solid rgba(76, 175, 80, 0.2);
  margin-bottom: 20rpx;
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.file-item::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  height: 100%;
  width: 6rpx;
  background: #4CAF50;
}

.file-item:last-child {
  margin-bottom: 0;
}

.file-icon {
  font-size: 44rpx;
  margin-right: 25rpx;
  color: #4CAF50;
}

.file-info {
  flex: 1;
}

.file-name {
  display: block;
  font-size: 30rpx;
  color: #1B5E20;
  margin-bottom: 8rpx;
  font-weight: 500;
}

.file-size {
  display: block;
  font-size: 26rpx;
  color: #66BB6A;
  font-family: 'Courier New', monospace;
}

.file-remove {
  font-size: 44rpx;
  color: #E57373;
  padding: 15rpx;
  border-radius: 12rpx;
  transition: all 0.3s ease;
}

.file-remove:active {
  background: rgba(229, 115, 115, 0.1);
  transform: scale(0.9);
}

.submit-section {
  margin-top: 70rpx;
  padding: 0 10rpx;
}

.submit-btn {
  background: linear-gradient(135deg, #4CAF50 0%, #2E7D32 100%);
  color: white;
  border-radius: 20rpx;
  font-size: 34rpx;
  font-weight: 600;
  padding: 35rpx;
  border: none;
  box-shadow: 
    0 8rpx 30rpx rgba(76, 175, 80, 0.4),
    0 4rpx 15rpx rgba(46, 125, 50, 0.3);
  transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  position: relative;
  overflow: hidden;
}

.submit-btn::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
  transition: left 0.6s ease;
}

.submit-btn:active {
  transform: translateY(4rpx);
  box-shadow: 
    0 4rpx 15rpx rgba(76, 175, 80, 0.3),
    0 2rpx 8rpx rgba(46, 125, 50, 0.2);
}

.submit-btn:active::before {
  left: 100%;
}

/* 添加科技感的光效和动效 */
@keyframes glow {
  0%, 100% { box-shadow: 0 8rpx 30rpx rgba(76, 175, 80, 0.4); }
  50% { box-shadow: 0 8rpx 40rpx rgba(76, 175, 80, 0.6); }
}

.submit-btn {
  animation: glow 3s ease-in-out infinite;
}

/* 响应式调整 */
@media (max-width: 480rpx) {
  .form {
    padding: 30rpx 20rpx;
  }
  
  .form-section {
    padding: 30rpx;
    border-radius: 20rpx;
  }
}