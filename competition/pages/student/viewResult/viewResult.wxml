<view class="container">
  <!-- 页面头部 -->
  <view class="header">
    <view class="header-content">
      <view class="title-section">
        <text class="title">学分查看</text>
        <view class="back-btn" bindtap="onBack">返回</view>
      </view>
      <view class="welcome-section">
        <text class="welcome-text">查看您的学分获取记录</text>
      </view>
    </view>
  </view>

  <!-- 页面内容 -->
  <view class="content">
    <!-- 测试数据提示 -->
    <view class="test-data-notice" wx:if="{{isTestData}}">
      <text class="notice-icon">💡</text>
      <text class="notice-text">当前显示的是测试数据，实际数据将在正式环境中显示</text>
    </view>

    <!-- 总学分展示 -->
    <view class="total-credits-section">
      <view class="total-credits-card">
        <view class="credit-icon">🎓</view>
        <view class="credit-info">
          <text class="credit-label">已获得学分</text>
          <text class="credit-value">{{totalCredits}}</text>
        </view>
      </view>
    </view>

    <!-- 学分明细列表 -->
    <view class="credit-list-section">
      <view class="section-title">学分明细</view>
      
      <view class="credit-list">
        <view class="credit-item" wx:for="{{creditList}}" wx:key="id">
          <view class="activity-info">
            <text class="activity-name">{{item.activityName}}</text>
            <text class="obtain-time">{{item.obtainTime}}</text>
          </view>
          <view class="credit-value-section">
            <text class="credit-value">+{{item.creditValue}}</text>
            <text class="credit-unit">学分</text>
          </view>
        </view>
      </view>

      <!-- 空状态 -->
      <view class="empty-state" wx:if="{{creditList.length === 0 && !loading}}">
        <text class="empty-icon">📚</text>
        <text class="empty-text">暂无学分记录</text>
        <text class="empty-desc">您还没有获得任何学分</text>
        <view class="empty-action" bindtap="createTestData" wx:if="{{!isTestData}}">
          <text class="action-text">生成测试数据</text>
        </view>
      </view>

      <!-- 加载状态 -->
      <view class="loading-state" wx:if="{{loading}}">
        <text class="loading-icon">⏳</text>
        <text class="loading-text">加载中...</text>
      </view>
    </view>
  </view>
</view>