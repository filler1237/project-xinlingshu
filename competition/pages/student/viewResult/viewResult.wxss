/* 在原有样式基础上添加以下内容 */

/* 测试数据提示 */
.test-data-notice {
  background: linear-gradient(135deg, rgba(255, 193, 7, 0.15) 0%, rgba(255, 235, 59, 0.1) 100%);
  border: 2rpx solid rgba(255, 193, 7, 0.3);
  border-radius: 20rpx;
  padding: 30rpx 25rpx;
  margin-bottom: 35rpx;
  display: flex;
  align-items: center;
  gap: 25rpx;
  backdrop-filter: blur(10rpx);
}

.notice-icon {
  font-size: 40rpx;
}

.notice-text {
  font-size: 28rpx;
  color: #FF9800;
  line-height: 1.4;
  flex: 1;
  font-weight: 600;
  letter-spacing: 0.2rpx;
}

/* 加载状态 */
.loading-state {
  text-align: center;
  padding: 80rpx 40rpx;
  background: rgba(255, 255, 255, 0.7);
  border-radius: 20rpx;
  margin-top: 30rpx;
}

.loading-icon {
  font-size: 60rpx;
  margin-bottom: 20rpx;
  display: block;
  color: #4CAF50;
}

.loading-text {
  font-size: 28rpx;
  color: #66BB6A;
  font-weight: 500;
}

/* 空状态操作按钮 */
.empty-action {
  background: linear-gradient(135deg, #4CAF50 0%, #2E7D32 100%);
  color: white;
  padding: 25rpx 40rpx;
  border-radius: 16rpx;
  margin-top: 30rpx;
  display: inline-block;
  box-shadow: 0 4rpx 15rpx rgba(76, 175, 80, 0.3);
  transition: all 0.3s ease;
}

.empty-action:active {
  transform: translateY(2rpx);
  box-shadow: 0 2rpx 8rpx rgba(76, 175, 80, 0.2);
}

.action-text {
  font-size: 28rpx;
  font-weight: 600;
}