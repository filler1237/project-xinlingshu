<view class="my-container">
  <view class="user-card">
    <view class="user-info">
      <text class="username">{{userInfo.username || '未登录'}}</text>
      <text class="role">身份：{{userInfo.role || '未知'}}</text>
      <text class="department" wx:if="{{userInfo.department}}">{{userInfo.department}}</text>
      <text class="student-id" wx:if="{{userInfo.studentId}}">学号：{{userInfo.studentId}}</text>
    </view>
  </view>

  <view class="menu-list">
    <view class="menu-item" bindtap="onGoHome">
      <text class="menu-text">返回首页</text>
      <text class="menu-arrow">></text>
    </view>
    
    <view class="menu-item" bindtap="onLogout">
      <text class="menu-text logout-text">退出登录</text>
      <text class="menu-arrow">></text>
    </view>
  </view>
</view>