.my-container {
  padding: 0;
  min-height: 100vh;
  background-color: #f5f5f5;
}

.user-card {
  background-color: white;
  padding: 40rpx;
  margin-bottom: 20rpx;
}

.user-info {
  display: flex;
  flex-direction: column;
}

.username {
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.role {
  font-size: 32rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.department {
  font-size: 30rpx;
  color: #888;
  margin-bottom: 8rpx;
}

.student-id {
  font-size: 30rpx;
  color: #888;
}

.menu-list {
  background-color: white;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 40rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.menu-item:active {
  background-color: #f9f9f9;
}

.menu-text {
  font-size: 34rpx;
}

.logout-text {
  color: #FF3B30;
}

.menu-arrow {
  color: #ccc;
  font-size: 32rpx;
}