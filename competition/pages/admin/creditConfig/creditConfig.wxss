/* pages/admin/creditConfig/creditConfig.wxss
 * 顶尖轻量UI | 柔和草绿 | 无荧光绿
-------------------------------------------------- */
page{
  background: linear-gradient(180deg, #F0F9F0 0%, #FFFFFF 100%);
  font-family: PingFang SC;
  min-height: 100vh;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

.credit-container{
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 顶部导航区 */
.page-header{
  position: relative;
  padding: 64rpx 40rpx 48rpx;
  background: transparent;
}

.back-btn{
  position: absolute;
  left: 40rpx;
  top: calc(44px + 20rpx);          /* 刘海安全区 + 额外 20rpx */
  padding: 12rpx 24rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: #3F3F3F;
  background: rgba(255,255,255,.85);
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,.06);
  backdrop-filter: blur(20rpx);
}

.header-title{
  font-size: 56rpx;
  font-weight: 700;
  color: #3F3F3F;
  letter-spacing: .5rpx;
}

.header-desc{
  font-size: 28rpx;
  color: #666;
  margin-top: 8rpx;
}

/* 活动选择器 */
.activity-selector{
  display: flex;
  align-items: center;
  margin: 24rpx 40rpx;
  padding: 28rpx 32rpx;
  background: rgba(255,255,255,.8);
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,.05);
  backdrop-filter: blur(20rpx);
}
.selector-label{
  font-size: 28rpx;
  font-weight: 500;
  color: #3F3F3F;
  margin-right: 24rpx;
  white-space: nowrap;
}
.picker-display{
  flex: 1;
  padding: 20rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: #3F3F3F;
  text-align: center;
  background: rgba(255,255,255,.6);
  border-radius: 16rpx;
  border: 1rpx solid rgba(0,0,0,.06);
}

/* 配置卡片 */
.config-section{
  margin: 0 40rpx;
}

.config-card{
  margin-bottom: 24rpx;
  padding: 32rpx;
  background: rgba(255,255,255,.8);
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,.05);
  backdrop-filter: blur(20rpx);
}

.config-header{
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid rgba(0,0,0,.06);
}

.config-title{
  font-size: 32rpx;
  font-weight: 600;
  color: #3F3F3F;
  margin-bottom: 8rpx;
}

.config-desc{
  font-size: 26rpx;
  color: #999;
}

.config-content{
  padding: 0 8rpx;
}

/* 学分输入组 */
.credit-input-group{
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 16rpx 0;
}

.input-label{
  font-size: 28rpx;
  color: #3F3F3F;
  font-weight: 500;
  min-width: 140rpx;
}

.credit-input{
  flex: 1;
  padding: 16rpx;
  margin: 0 16rpx;
  font-size: 28rpx;
  text-align: center;
  background: rgba(255,255,255,.6);
  border-radius: 16rpx;
  border: 1rpx solid rgba(0,0,0,.06);
}

.credit-unit{
  font-size: 28rpx;
  color: #666;
  min-width: 80rpx;
}

.config-tip{
  font-size: 24rpx;
  color: #999;
  font-style: italic;
}

/* 获奖项目 */
.award-item{
  background: rgba(255,255,255,.6);
  padding: 24rpx;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid rgba(0,0,0,.06);
}

.award-header{
  display: flex; justify-content: space-between; align-items: center;
  margin-bottom: 16rpx;
}

.award-level{
  font-size: 28rpx;
  font-weight: 600;
  color: #3F3F3F;
}

.remove-award{
  font-size: 24rpx;
  color: #F44336;
  padding: 8rpx 16rpx;
  background: rgba(244,67,54,.1);
  border-radius: 12rpx;
}

.score-range{
  display: flex; align-items: center; margin-top: 12rpx;
}

.range-label{
  font-size: 24rpx;
  color: #666;
  margin-right: 12rpx;
}

.range-value{
  font-size: 24rpx;
  color: #7ED321;
  font-weight: 500;
}

/* 添加获奖等级 */
.add-award-section{
  display: flex; gap: 16rpx;
  margin-top: 24rpx; padding-top: 24rpx;
  border-top: 1rpx dashed rgba(0,0,0,.06);
}

.award-input{
  flex: 1;
  padding: 16rpx;
  font-size: 28rpx;
  background: rgba(255,255,255,.6);
  border-radius: 16rpx;
  border: 1rpx solid rgba(0,0,0,.06);
}

.add-btn{
  background: #7ED321;
  color: #fff;
  border: none;
  border-radius: 16rpx;
  padding: 16rpx 32rpx;
  font-size: 26rpx;
  font-weight: 500;
  white-space: nowrap;
  box-shadow: 0 4rpx 12rpx rgba(126,211,33,.3);
}

/* 规则项目 */
.rule-item{
  display: flex; justify-content: space-between; align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(0,0,0,.06);
}
.rule-item:last-child{ border-bottom: none; }

.rule-label{
  font-size: 28rpx;
  color: #3F3F3F;
}

/* 预览卡片 */
.preview-card{
  margin-bottom: 24rpx;
  padding: 32rpx;
  background: rgba(255,255,255,.8);
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,.05);
  backdrop-filter: blur(20rpx);
  border: 2rpx solid #7ED321;
}

.preview-header{ margin-bottom: 24rpx; }

.preview-title{
  font-size: 32rpx;
  font-weight: 600;
  color: #7ED321;
}

.preview-stats{
  display: flex; justify-content: space-between;
  margin-bottom: 24rpx;
}
.preview-stats .stat-item{ text-align: center; flex: 1; }
.preview-stats .stat-value{
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #7ED321;
  margin-bottom: 8rpx;
}
.preview-stats .stat-label{
  font-size: 24rpx;
  color: #999;
}

.credit-summary{
  text-align: center; padding: 20rpx;
  background: rgba(126,211,33,.08);
  border-radius: 16rpx;
}
.summary-text{
  font-size: 28rpx;
  color: #7ED321;
  font-weight: 600;
}

/* 操作按钮 */
.action-buttons{
  display: flex; gap: 16rpx;
  margin: 24rpx 40rpx 40rpx;
}
.action-btn{
  flex: 1;
  padding: 24rpx;
  border: none; border-radius: 16rpx;
  font-size: 28rpx; font-weight: 500;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,.08);
}
.action-btn.save{ background: #7ED321; color: #fff; }
.action-btn.reset{ background: #F5F5F5; color: #666; }
.action-btn.preview{ background: #2196F3; color: #fff; }

/* 空状态 */
.empty-state{
  margin: 64rpx 40rpx;
  padding: 80rpx 40rpx;
  background: rgba(255,255,255,.8);
  border-radius: 24rpx;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,.05);
  backdrop-filter: blur(20rpx);
}
.empty-icon{ font-size: 80rpx; color: #3F3F3F; margin-bottom: 24rpx; }
.empty-text{ font-size: 32rpx; color: #3F3F3F; font-weight: 600; margin-bottom: 12rpx; }
.empty-desc{ font-size: 26rpx; color: #9B9B9B; margin-bottom: 40rpx; }
.empty-btn{
  background: #7ED321; color: #fff;
  border-radius: 24rpx; padding: 24rpx 56rpx;
  font-size: 28rpx; font-weight: 500;
  box-shadow: 0 4rpx 12rpx rgba(126,211,33,.3);
}

/* 模态框（轻毛玻璃） */
.modal{
  position: fixed; inset: 0;
  background: rgba(0,0,0,.45);
  display: flex; align-items: center; justify-content: center;
  z-index: 2000; opacity: 0; visibility: hidden; transition: all .3s;
  padding: 40rpx;
}
.modal.show{ opacity: 1; visibility: visible; }
.modal-content{
  width: 100%; max-width: 90vw;
  background: rgba(255,255,255,.85);
  border-radius: 24rpx;
  box-shadow: 0 12rpx 36rpx rgba(0,0,0,.1);
  backdrop-filter: blur(20rpx);
  transform: translateY(40rpx); transition: all .3s;
}
.modal.show .modal-content{ transform: translateY(0); }
.modal-header{
  display: flex; justify-content: space-between; align-items: center;
  padding: 32rpx 40rpx 24rpx; border-bottom: 1rpx solid rgba(0,0,0,.06);
}
.modal-title{ font-size: 32rpx; font-weight: 600; color: #3F3F3F; }
.modal-close{ font-size: 36rpx; color: #999; padding: 8rpx; }
.modal-body{ padding: 32rpx 40rpx 40rpx; max-height: 60vh; overflow-y: auto; }

/* 预览详情 */
.preview-detail{ padding: 8rpx; }
.preview-activity{
  display: block; font-size: 28rpx; color: #7ED321; font-weight: 600;
  text-align: center; margin-bottom: 24rpx; padding-bottom: 16rpx;
  border-bottom: 2rpx solid #7ED321;
}
.preview-section{ margin-bottom: 24rpx; }
.section-title{
  font-size: 28rpx; font-weight: 600; color: #3F3F3F;
  margin-bottom: 16rpx; padding-bottom: 8rpx; border-bottom: 1rpx solid rgba(0,0,0,.06);
}
.preview-item{
  display: flex; justify-content: space-between; align-items: center;
  padding: 12rpx 0; border-bottom: 1rpx solid rgba(0,0,0,.04);
}
.item-label{ font-size: 26rpx; color: #666; }
.item-value{ font-size: 26rpx; font-weight: 500; }
.item-value.enabled{ color: #7ED321; }
.item-value.disabled{ color: #999; }

.modal-footer{
  display: flex; padding: 24rpx 40rpx 32rpx; gap: 16rpx;
}
.modal-btn{
  flex: 1; padding: 24rpx; border: none; border-radius: 16rpx;
  font-size: 28rpx; font-weight: 500;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,.08);
}
.modal-btn.confirm{ background: #7ED321; color: #fff; }