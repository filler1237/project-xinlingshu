/* pages/admin/applyActivity/applyActivity.wxss */
.apply-container {
  min-height: 100vh;
  background: linear-gradient(135deg, #f0f9f0 0%, #e6f7e6 100%);
}

/* 顶部标题区域 */
.page-header {
  position: relative;
  height: 200rpx;
  overflow: hidden;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, #00c6a7 0%, #00a886 100%);
  clip-path: polygon(0 0, 100% 0, 100% 80%, 0 100%);
}

.header-content {
  position: relative;
  z-index: 2;
  padding: 60rpx 40rpx 0;
}

.header-title {
  display: block;
  font-size: 48rpx;
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 10rpx;
}

.header-desc {
  font-size: 28rpx;
  color: rgba(255,255,255,0.8);
}

/* 表单区域 */
.form-section {
  padding: 0 30rpx;
  margin-top: -60rpx;
  position: relative;
  z-index: 3;
}

.form-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 40rpx;
  box-shadow: 0 10rpx 30rpx rgba(0, 198, 167, 0.1);
  border: 1rpx solid #e0f2e9;
}

.form-item {
  margin-bottom: 50rpx;
}

.form-label {
  display: block;
  font-size: 32rpx;
  font-weight: 500;
  color: #2d3748;
  margin-bottom: 20rpx;
}

.form-input, .form-textarea {
  width: 100%;
  padding: 24rpx;
  border: 2rpx solid #e2e8f0;
  border-radius: 12rpx;
  font-size: 28rpx;
  background: #fafafa;
  transition: all 0.3s ease;
}

.form-input:focus, .form-textarea:focus {
  border-color: #00c6a7;
  background: #ffffff;
  box-shadow: 0 0 0 3rpx rgba(0, 198, 167, 0.1);
}

.placeholder-style {
  color: #a0aec0;
  font-size: 28rpx;
}

/* 时间选择器 */
.time-picker-group {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.time-picker {
  flex: 1;
}

.time-label {
  display: block;
  font-size: 26rpx;
  color: #718096;
  margin-bottom: 10rpx;
}

.picker-display {
  padding: 24rpx;
  border: 2rpx solid #e2e8f0;
  border-radius: 12rpx;
  background: #fafafa;
  color: #2d3748;
  text-align: center;
  font-size: 28rpx;
}

.time-separator {
  color: #a0aec0;
  font-size: 26rpx;
  margin-top: 40rpx;
}

/* 单选按钮组 */
.radio-group {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.radio-item {
  flex: 1;
  min-width: 150rpx;
  padding: 20rpx;
  border: 2rpx solid #e2e8f0;
  border-radius: 12rpx;
  text-align: center;
  background: #fafafa;
  transition: all 0.3s ease;
}

.radio-item.active {
  border-color: #00c6a7;
  background: rgba(0, 198, 167, 0.1);
  color: #00c6a7;
}

.radio-text {
  font-size: 26rpx;
  color: inherit;
}

/* 文本域 */
.form-textarea {
  height: 200rpx;
  resize: none;
}

.word-count {
  display: block;
  text-align: right;
  font-size: 24rpx;
  color: #a0aec0;
  margin-top: 10rpx;
}

/* 提交按钮 */
.submit-section {
  margin-top: 60rpx;
}

.submit-btn {
  width: 100%;
  padding: 28rpx;
  background: #cbd5e0;
  border: none;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 15rpx;
  transition: all 0.3s ease;
}

.submit-btn.active {
  background: linear-gradient(135deg, #00c6a7 0%, #00a886 100%);
  box-shadow: 0 8rpx 20rpx rgba(0, 198, 167, 0.3);
}

.btn-text {
  font-size: 32rpx;
  font-weight: 500;
  color: #ffffff;
}

.btn-icon {
  font-size: 32rpx;
  color: #ffffff;
  font-weight: bold;
}

/* pages/admin/applyActivity/applyActivity.wxss */

/* 返回按钮样式 */
.back-button {
  display: flex;
  align-items: center;
  position: absolute;
  left: 30rpx;
  top: 50%;
  transform: translateY(-50%);
  padding: 16rpx 24rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(10rpx);
  z-index: 10;
}

.back-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
  color: #fff;
}

.back-text {
  font-size: 28rpx;
  color: #fff;
  font-weight: 500;
}

/* 调整标题布局 */
.header-content {
  position: relative;
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 120rpx;
}

.header-titles {
  text-align: center;
}