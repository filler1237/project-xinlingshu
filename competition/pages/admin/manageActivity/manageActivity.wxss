/* manageActivity.wxss  ——  复刻「个人中心」风格 */
page{
  background: linear-gradient(180deg, #FFFFF5 0%, #FFFFFF 100%);
  font-family: PingFang SC;
}

.manage-container{
  min-height: 100vh;
  padding-bottom: 120rpx;
  box-sizing: border-box;
}

/* 顶部背景区 */
.page-header{
  position: relative;
  height: 400rpx;
  overflow: hidden;
}
.header-bg{
  position: absolute;
  left: 0; right: 0; top: 0; height: 100%;
  background: linear-gradient(148.26deg, #00FF387C 0%, #FFFFFF 9%, #FFFFFF 100%);
  border-radius: 0 0 40% 40%/0 0 100% 100%;
  box-shadow: 2rpx 2rpx 6rpx 0rpx #00000026;
}
.header-content{
  position: relative;
  z-index: 2;
  padding: 0 32rpx;
}

/* 标题 & 描述 */
.header-title{
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #3F3F3F;
  letter-spacing: 1rpx;
  margin-top: 20rpx;
}
.header-desc{
  display: block;
  font-size: 28rpx;
  color: #3F3F3F;
  margin-top: 8rpx;
  letter-spacing: 0;
}

/* 返回按钮 —— 下移 + 例子风格 */
.back-btn{
  position: absolute;
  left: 30rpx;
  top: calc(176rpx + 44px);          /* 例子头像区域下方 + 44px 刘海空隙 */
  z-index: 99;
  padding: 8rpx 20rpx;
  font-size: 28rpx;
  color: #3F3F3F;
  background: rgba(255,255,255,.85);
  border: 3rpx solid #FFFFFFE2;
  border-radius: 15rpx;
  box-shadow: 4rpx 4rpx 4rpx 0rpx #88C16F38;
  backdrop-filter: blur(20rpx);
}

/* 统计卡片（毛玻璃 + 圆角 + 阴影） */
.stats-grid{
  display: flex;
  justify-content: space-between;
  margin: 40rpx 30rpx 0;
  background: rgba(255,255,255,0.69);
  border-radius: 20rpx;
  backdrop-filter: blur(20rpx);
  box-shadow: 4rpx 4rpx 4rpx 0rpx #00000026;
  padding: 24rpx 0;
}
.stat-item{
  flex: 1;
  text-align: center;
}
.stat-number{
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #3F3F3F;
}
.stat-label{
  display: block;
  font-size: 24rpx;
  color: #3F3F3F;
  margin-top: 4rpx;
}

/* 筛选区 */
.filter-section{
  margin: 32rpx 30rpx;
}
.search-box{
  position: relative;
}
.search-input{
  width: 100%;
  height: 72rpx;
  padding: 0 80rpx 0 32rpx;
  font-size: 28rpx;
  color: #3F3F3F;
  background: rgba(255,255,255,0.85);
  border-radius: 20rpx;
  box-shadow: 4rpx 4rpx 4rpx 0rpx #00000026;
  backdrop-filter: blur(20rpx);
  box-sizing: border-box;
}
.search-placeholder{
  color: #9B9B9B;
}
.search-icon{
  position: absolute;
  right: 32rpx;
  top: 50%; transform: translateY(-50%);
  font-size: 32rpx;
  color: #3F3F3F;
}

/* 筛选标签 */
.filter-tabs{
  display: flex;
  margin-top: 24rpx;
  background: rgba(255,255,255,0.85);
  border-radius: 20rpx;
  box-shadow: 4rpx 4rpx 4rpx 0rpx #00000026;
  backdrop-filter: blur(20rpx);
  overflow: hidden;
}
.filter-tab{
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #3F3F3F;
  transition: all .3s;
}
.filter-tab.active{
  color: #00FF38;
  background: rgba(0,255,56,.08);
}

/* 活动卡片 */
.activity-list{
  margin: 0 30rpx;
}
.activity-card{
  background: rgba(255,255,255,0.85);
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 4rpx 4rpx 4rpx 0rpx #00000026;
  backdrop-filter: blur(20rpx);
  position: relative;
  overflow: hidden;
}
.activity-card.ended{
  opacity: .75;
}

/* 状态角标 */
.status-badge{
  position: absolute;
  right: 0; top: 0;
  padding: 8rpx 20rpx;
  font-size: 24rpx;
  color: #fff;
  border-radius: 0 20rpx 0 20rpx;
}
.status-badge.pending_review{ background: #FF9800; }
.status-badge.pending{ background: #2196F3; }
.status-badge.running{ background: #4CAF50; }
.status-badge.ended{ background: #9E9E9E; }
.status-badge.rejected{ background: #F44336; }

.activity-header{
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}
.activity-title{
  flex: 1;
  font-size: 32rpx;
  font-weight: medium;
  color: #3F3F3F;
}
.activity-time{
  font-size: 24rpx;
  color: #9B9B9B;
  white-space: nowrap;
}

.activity-info{
  margin-top: 16rpx;
}
.info-item{
  display: flex;
  align-items: center;
  margin-top: 8rpx;
  font-size: 26rpx;
}
.info-label{
  color: #9B9B9B;
}
.info-value{
  flex: 1;
  color: #3F3F3F;
  margin-left: 8rpx;
}

/* 进度条 */
.progress-section{
  margin-top: 24rpx;
}
.progress-info{
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: #9B9B9B;
}
.progress-bar{
  height: 8rpx;
  background: #E0E0E0;
  border-radius: 4rpx;
  margin-top: 8rpx;
  overflow: hidden;
}
.progress-fill{
  height: 100%;
  border-radius: 4rpx;
  transition: width .3s;
}
.progress-fill.pending_review,
.progress-fill.pending{ background: #2196F3; }
.progress-fill.running{ background: #4CAF50; }
.progress-fill.ended{ background: #9E9E9E; }

/* 操作按钮组 */
.action-buttons{
  display: flex;
  flex-wrap: wrap;
  margin-top: 24rpx;
  margin-left: -12rpx;
}
.action-btn{
  margin-left: 12rpx;
  margin-bottom: 12rpx;
  padding: 12rpx 24rpx;
  font-size: 26rpx;
  border-radius: 15rpx;
  border: none;
  color: #fff;
  box-shadow: 2rpx 2rpx 6rpx 0rpx #00000026;
}
.action-btn.review{ background: #FF9800; }
.action-btn.primary{ background: #00FF38; color: #3F3F3F; }
.action-btn.secondary{ background: #9E9E9E; }
.action-btn.edit{ background: #607D8B; }
.action-btn.delete{ background: #F44336; }
.action-btn.view{ background: #00BCD4; }
.action-btn.manage{ background: #795548; }

/* 空状态 */
.empty-state{
  text-align: center;
  padding: 120rpx 32rpx;
}
.empty-icon{
  font-size: 80rpx;
  color: #3F3F3F;
}
.empty-text{
  display: block;
  font-size: 32rpx;
  color: #3F3F3F;
  margin-top: 24rpx;
}
.empty-desc{
  display: block;
  font-size: 28rpx;
  color: #9B9B9B;
  margin-top: 12rpx;
}
.empty-btn{
  margin-top: 40rpx;
  padding: 20rpx 48rpx;
  font-size: 30rpx;
  color: #3F3F3F;
  background: #00FF38;
  border-radius: 30rpx;
  border: none;
  box-shadow: 2rpx 2rpx 6rpx 0rpx #00000026;
}

/* 悬浮添加按钮 */
.floating-action{
  position: fixed;
  right: 30rpx;
  bottom: 60rpx;
  width: 96rpx;
  height: 96rpx;
  background: #00FF38;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 4rpx 4rpx 4rpx 0rpx #88C16F38;
  backdrop-filter: blur(20rpx);
}
.fab-icon{
  font-size: 48rpx;
  color: #3F3F3F;
}