/* pages/admin/manageActivity/manageActivity.wxss */
page {
  background: linear-gradient(135deg, #f0f9f0 0%, #e6f7e6 100%);
  min-height: 100vh;
}

.page-container {
  min-height: 100vh;
  padding-bottom: 120rpx;
}

/* 科技风头部 */
.simple-header {
  position: relative;
  background: linear-gradient(135deg, #00c6a7 0%, #00a886 100%);
  padding: 60rpx 40rpx 50rpx;
  border-radius: 0 0 30rpx 30rpx;
  margin-bottom: 40rpx;
  color: white;
  box-shadow: 0 10rpx 30rpx rgba(0, 198, 167, 0.3);
  overflow: hidden;
}

.simple-header::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 100%;
  background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 120" preserveAspectRatio="none"><path d="M1200 120L0 16.48 0 0 1200 0 1200 120z" fill="rgba(255,255,255,0.1)"/></svg>');
  background-size: 100% 100%;
}

.header-title {
  display: block;
  font-size: 42rpx;
  font-weight: 700;
  margin-bottom: 15rpx;
  text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.header-desc {
  font-size: 28rpx;
  opacity: 0.9;
  font-weight: 300;
}

/* 科技风筛选区域 */
.simple-filter {
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20rpx);
  padding: 40rpx 30rpx;
  border-radius: 20rpx;
  margin: 0 30rpx 40rpx;
  box-shadow: 0 8rpx 25rpx rgba(0, 198, 167, 0.15);
  border: 1rpx solid rgba(0, 198, 167, 0.1);
}

.search-input {
  width: 100%;
  padding: 28rpx 40rpx;
  background: #f8fdfb;
  border: 2rpx solid #e0f2e9;
  border-radius: 50rpx;
  font-size: 28rpx;
  color: #2d3748;
  margin-bottom: 30rpx;
  transition: all 0.3s ease;
  box-shadow: 0 4rpx 15rpx rgba(0, 198, 167, 0.1);
}

.search-input:focus {
  border-color: #00c6a7;
  background: #ffffff;
  box-shadow: 0 6rpx 20rpx rgba(0, 198, 167, 0.2);
}

.search-input::placeholder {
  color: #a0aec0;
}

.filter-tabs {
  display: flex;
  gap: 20rpx;
  justify-content: space-between;
}

.tab {
  flex: 1;
  padding: 20rpx;
  background: #f8fdfb;
  border: 2rpx solid #e0f2e9;
  border-radius: 15rpx;
  font-size: 26rpx;
  color: #718096;
  text-align: center;
  transition: all 0.3s ease;
  font-weight: 500;
}

.tab.active {
  background: linear-gradient(135deg, #00c6a7 0%, #00a886 100%);
  color: #ffffff;
  border-color: #00c6a7;
  box-shadow: 0 4rpx 12rpx rgba(0, 198, 167, 0.3);
  transform: translateY(-2rpx);
}

/* 科技风统计卡片 */
.stats-cards {
  display: flex;
  gap: 20rpx;
  margin: 0 30rpx 40rpx;
  padding: 0 10rpx;
}

.stat-card {
  flex: 1;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.9) 0%, rgba(255, 255, 255, 0.7) 100%);
  backdrop-filter: blur(10rpx);
  padding: 35rpx 20rpx;
  border-radius: 20rpx;
  text-align: center;
  box-shadow: 0 8rpx 25rpx rgba(0, 198, 167, 0.15);
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  position: relative;
  overflow: hidden;
  transition: all 0.3s ease;
}

.stat-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: linear-gradient(90deg, #00c6a7, #00a886);
}

.stat-card:active {
  transform: translateY(-4rpx);
  box-shadow: 0 12rpx 30rpx rgba(0, 198, 167, 0.25);
}

.stat-number {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #00c6a7;
  margin-bottom: 12rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 198, 167, 0.2);
}

.stat-label {
  font-size: 24rpx;
  color: #718096;
  font-weight: 500;
}

/* 科技风活动列表 */
.activity-list {
  display: flex;
  flex-direction: column;
  gap: 25rpx;
  padding: 0 30rpx;
}

.activity-item {
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20rpx);
  padding: 40rpx;
  border-radius: 25rpx;
  box-shadow: 0 10rpx 30rpx rgba(0, 198, 167, 0.15);
  border: 1rpx solid rgba(0, 198, 167, 0.1);
  position: relative;
  overflow: hidden;
  transition: all 0.3s ease;
}

.activity-item::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 6rpx;
  background: linear-gradient(90deg, #00c6a7, #00a886);
  opacity: 0.8;
}

.activity-item:active {
  transform: translateY(-6rpx);
  box-shadow: 0 15rpx 35rpx rgba(0, 198, 167, 0.25);
}

.activity-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 25rpx;
  padding-right: 120rpx;
}

.activity-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #2d3748;
  flex: 1;
  margin-right: 20rpx;
  line-height: 1.4;
}

.activity-status {
  position: absolute;
  top: 35rpx;
  right: 35rpx;
  padding: 12rpx 24rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.activity-status.pending_review {
  background: linear-gradient(135deg, #fff3cd 0%, #ffeaa7 100%);
  color: #856404;
  border: 1rpx solid #ffeaa7;
}

.activity-status.running {
  background: linear-gradient(135deg, #d4edda 0%, #c3e6cb 100%);
  color: #155724;
  border: 1rpx solid #c3e6cb;
}

.activity-status.pending {
  background: linear-gradient(135deg, #d1ecf1 0%, #bee5eb 100%);
  color: #0c5460;
  border: 1rpx solid #bee5eb;
}

.activity-status.ended {
  background: linear-gradient(135deg, #e2e3e5 0%, #d6d8db 100%);
  color: #383d41;
  border: 1rpx solid #d6d8db;
}

/* 活动信息 */
.activity-info {
  margin-bottom: 30rpx;
  background: #f8fdfb;
  padding: 25rpx;
  border-radius: 15rpx;
  border: 1rpx solid #e0f2e9;
}

.info-text {
  display: block;
  font-size: 26rpx;
  color: #4a5568;
  margin-bottom: 12rpx;
  padding-left: 30rpx;
  position: relative;
}

.info-text::before {
  content: '•';
  position: absolute;
  left: 10rpx;
  color: #00c6a7;
  font-weight: bold;
}

/* 科技风进度条 */
.simple-progress {
  margin-bottom: 30rpx;
  background: #f8fdfb;
  padding: 25rpx;
  border-radius: 15rpx;
  border: 1rpx solid #e0f2e9;
}

.progress-text {
  font-size: 26rpx;
  color: #4a5568;
  margin-bottom: 20rpx;
  display: block;
  font-weight: 500;
}

.progress-bar {
  height: 12rpx;
  background: #e2e8f0;
  border-radius: 10rpx;
  overflow: hidden;
  position: relative;
  box-shadow: inset 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #00c6a7, #00a886);
  border-radius: 10rpx;
  transition: width 0.8s cubic-bezier(0.22, 0.61, 0.36, 1);
  position: relative;
  overflow: hidden;
}

.progress-fill::after {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.4), transparent);
  animation: shimmer 2s infinite;
}

@keyframes shimmer {
  0% {
    left: -100%;
  }
  100% {
    left: 100%;
  }
}

/* 科技风操作按钮 */
.simple-actions {
  display: flex;
  gap: 15rpx;
  flex-wrap: wrap;
}

.btn {
  flex: 1;
  min-width: 140rpx;
  padding: 20rpx 24rpx;
  border: none;
  border-radius: 12rpx;
  font-size: 24rpx;
  text-align: center;
  font-weight: 600;
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.btn::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 0;
  height: 0;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  transform: translate(-50%, -50%);
  transition: width 0.6s, height 0.6s;
}

.btn:active::before {
  width: 300rpx;
  height: 300rpx;
}

.btn.primary {
  background: linear-gradient(135deg, #007bff 0%, #0056b3 100%);
  color: white;
  box-shadow: 0 4rpx 15rpx rgba(0, 123, 255, 0.3);
}

.btn.success {
  background: linear-gradient(135deg, #00c6a7 0%, #00a886 100%);
  color: white;
  box-shadow: 0 4rpx 15rpx rgba(0, 198, 167, 0.3);
}

.btn.warning {
  background: linear-gradient(135deg, #ffc107 0%, #e0a800 100%);
  color: #212529;
  box-shadow: 0 4rpx 15rpx rgba(255, 193, 7, 0.3);
}

.btn.danger {
  background: linear-gradient(135deg, #dc3545 0%, #c82333 100%);
  color: white;
  box-shadow: 0 4rpx 15rpx rgba(220, 53, 69, 0.3);
}

.btn:active {
  transform: translateY(2rpx);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
}

/* 科技风空状态 */
.empty-state {
  text-align: center;
  padding: 120rpx 40rpx;
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(20rpx);
  margin: 40rpx 30rpx;
  border-radius: 25rpx;
  box-shadow: 0 10rpx 30rpx rgba(0, 198, 167, 0.15);
  border: 1rpx solid rgba(0, 198, 167, 0.1);
}

.empty-text {
  display: block;
  font-size: 32rpx;
  color: #4a5568;
  margin-bottom: 20rpx;
  font-weight: 600;
}

.empty-desc {
  display: block;
  font-size: 26rpx;
  color: #718096;
  margin-bottom: 40rpx;
}

.create-btn {
  background: linear-gradient(135deg, #00c6a7 0%, #00a886 100%);
  color: white;
  border: none;
  border-radius: 50rpx;
  padding: 24rpx 60rpx;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 25rpx rgba(0, 198, 167, 0.4);
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.create-btn::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 0;
  height: 0;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 50%;
  transform: translate(-50%, -50%);
  transition: width 0.6s, height 0.6s;
}

.create-btn:active::before {
  width: 300rpx;
  height: 300rpx;
}

.create-btn:active {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 15rpx rgba(0, 198, 167, 0.6);
}

/* 科技风悬浮按钮 */
.fab {
  position: fixed;
  bottom: 60rpx;
  right: 40rpx;
  width: 120rpx;
  height: 120rpx;
  background: linear-gradient(135deg, #00c6a7 0%, #00a886 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 30rpx rgba(0, 198, 167, 0.5);
  z-index: 1000;
  transition: all 0.3s ease;
  border: 3rpx solid rgba(255, 255, 255, 0.2);
}

.fab::before {
  content: '';
  position: absolute;
  top: -2rpx;
  left: -2rpx;
  right: -2rpx;
  bottom: -2rpx;
  background: linear-gradient(135deg, #00c6a7, #00a886, #00c6a7);
  border-radius: 50%;
  z-index: -1;
  opacity: 0;
  transition: opacity 0.3s;
}

.fab:active::before {
  opacity: 1;
}

.fab:active {
  transform: scale(0.95);
  box-shadow: 0 5rpx 20rpx rgba(0, 198, 167, 0.7);
}

.fab-icon {
  color: white;
  font-size: 48rpx;
  font-weight: 300;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
}

/* 响应式设计 */
@media (max-width: 750rpx) {
  .stats-cards {
    flex-wrap: wrap;
  }
  
  .stat-card {
    flex: 0 0 calc(50% - 10rpx);
    margin-bottom: 20rpx;
  }
  
  .simple-actions {
    justify-content: center;
  }
  
  .btn {
    flex: 0 0 calc(50% - 10rpx);
  }
}

/* 加载动画 */
@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(30rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.activity-item {
  animation: fadeInUp 0.6s ease-out;
}

/* 悬停效果（小程序中通过active状态模拟） */
.stat-card:active,
.activity-item:active,
.btn:active {
  transition: all 0.1s ease;
}

/* 深色模式支持 */
@media (prefers-color-scheme: dark) {
  .simple-filter,
  .activity-item,
  .empty-state {
    background: rgba(45, 55, 72, 0.95);
    color: #e2e8f0;
    border-color: rgba(74, 85, 104, 0.5);
  }
  
  .search-input {
    background: rgba(26, 32, 44, 0.8);
    border-color: rgba(74, 85, 104, 0.5);
    color: #e2e8f0;
  }
  
  .activity-info,
  .simple-progress {
    background: rgba(26, 32, 44, 0.8);
    border-color: rgba(74, 85, 104, 0.5);
  }
  
  .info-text {
    color: #cbd5e0;
  }
}