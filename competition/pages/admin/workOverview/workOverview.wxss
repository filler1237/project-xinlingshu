/* pages/admin/judgeManagement/judgeManagement.wxss */
page {
  background: #f5f5f5;
  min-height: 100vh;
}

.judge-container {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 顶部标题区域 */
.page-header {
  background: #00c6a7;
  padding: 40rpx 30rpx 30rpx;
  color: white;
}

.header-title {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.header-desc {
  font-size: 26rpx;
  opacity: 0.9;
  margin-bottom: 30rpx;
}

/* 统计网格 */
.stats-grid {
  display: flex;
  justify-content: space-between;
}

.stat-item {
  text-align: center;
  flex: 1;
}

.stat-number {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 22rpx;
  opacity: 0.9;
}

/* 活动选择器 */
.activity-selector {
  background: white;
  margin: 20rpx 30rpx;
  padding: 25rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1);
}

.selector-label {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-right: 20rpx;
  white-space: nowrap;
}

.picker-display {
  flex: 1;
  padding: 20rpx;
  background: #f8f8f8;
  border: 1rpx solid #e0e0e0;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #333;
  text-align: center;
}

/* 筛选区域 */
.filter-section {
  padding: 0 30rpx 20rpx;
}

.search-box {
  position: relative;
  margin-bottom: 20rpx;
}

.search-input {
  width: 100%;
  padding: 22rpx 50rpx 22rpx 25rpx;
  background: white;
  border: 1rpx solid #e0e0e0;
  border-radius: 8rpx;
  font-size: 28rpx;
  box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.05);
}

.search-placeholder {
  color: #999;
  font-size: 28rpx;
}

.search-icon {
  position: absolute;
  right: 25rpx;
  top: 50%;
  transform: translateY(-50%);
  color: #00c6a7;
  font-size: 28rpx;
}

.filter-tabs {
  display: flex;
  background: white;
  border-radius: 8rpx;
  padding: 6rpx;
  box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.05);
}

.filter-tab {
  flex: 1;
  text-align: center;
  padding: 18rpx;
  font-size: 26rpx;
  color: #666;
  border-radius: 6rpx;
}

.filter-tab.active {
  background: #00c6a7;
  color: white;
}

/* 已任命评委面板 */
.appointed-panel {
  background: white;
  margin: 0 30rpx 20rpx;
  padding: 25rpx;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1);
}

.panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.panel-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.panel-count {
  font-size: 22rpx;
  color: #00c6a7;
  background: rgba(0, 198, 167, 0.1);
  padding: 6rpx 12rpx;
  border-radius: 12rpx;
  font-weight: 500;
}

.judges-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.judge-tag {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 14rpx 18rpx;
  background: #f8f8f8;
  border: 1rpx solid #e0e0e0;
  border-radius: 20rpx;
}

.judge-tag.chief {
  background: #fff8e1;
  border-color: #ffd54f;
}

.judge-name {
  font-size: 24rpx;
  color: #333;
  font-weight: 500;
}

.judge-role {
  font-size: 20rpx;
  color: #666;
  background: rgba(255, 255, 255, 0.8);
  padding: 4rpx 10rpx;
  border-radius: 10rpx;
}

.judge-tag.chief .judge-role {
  background: rgba(255, 255, 255, 0.9);
  color: #e65100;
}

.remove-btn {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: #f44336;
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18rpx;
  font-weight: bold;
}

/* 老师列表 */
.teacher-list {
  padding: 0 30rpx;
}

.teacher-card {
  background: white;
  padding: 30rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1);
}

/* 老师头部 */
.teacher-header {
  display: flex;
  align-items: flex-start;
  margin-bottom: 20rpx;
  position: relative;
}

.avatar-section {
  position: relative;
  margin-right: 20rpx;
}

.teacher-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #00c6a7;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-text {
  color: white;
  font-size: 28rpx;
  font-weight: 600;
}

.online-status {
  position: absolute;
  bottom: 5rpx;
  right: 5rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  border: 2rpx solid white;
}

.online-status.online {
  background: #4caf50;
}

.online-status.offline {
  background: #9e9e9e;
}

.teacher-info {
  flex: 1;
}

.teacher-name {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 6rpx;
}

.teacher-id {
  display: block;
  font-size: 24rpx;
  color: #666;
  margin-bottom: 4rpx;
}

.teacher-department {
  display: block;
  font-size: 22rpx;
  color: #999;
}

.appointment-status {
  position: absolute;
  top: 0;
  right: 0;
  padding: 6rpx 12rpx;
  border-radius: 12rpx;
  font-size: 20rpx;
  font-weight: 500;
}

.appointment-status.available {
  background: #e8f5e9;
  color: #2e7d32;
}

.appointment-status.appointed {
  background: #e3f2fd;
  color: #1565c0;
}

.appointment-status.busy {
  background: #fff3e0;
  color: #ef6c00;
}

/* 专业领域 */
.expertise-section {
  margin-bottom: 18rpx;
  padding: 18rpx;
  background: #f8f8f8;
  border-radius: 8rpx;
}

.section-label {
  font-size: 24rpx;
  color: #555;
  font-weight: 500;
  margin-bottom: 10rpx;
  display: block;
}

.expertise-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.expertise-tag {
  padding: 6rpx 12rpx;
  background: rgba(0, 198, 167, 0.1);
  color: #00c6a7;
  border-radius: 12rpx;
  font-size: 20rpx;
  border: 1rpx solid rgba(0, 198, 167, 0.2);
}

/* 任命信息 */
.appointment-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
  padding: 16rpx;
  background: #fff8e1;
  border-radius: 8rpx;
}

.info-label {
  font-size: 24rpx;
  color: #e65100;
  font-weight: 500;
}

.info-value {
  font-size: 24rpx;
  color: #e65100;
  flex: 1;
}

.info-role {
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  font-weight: 500;
}

.info-role.judge {
  background: #e3f2fd;
  color: #1565c0;
}

.info-role.chief {
  background: #fff3e0;
  color: #e65100;
}

/* 操作按钮 */
.action-buttons {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.action-btn {
  flex: 1;
  min-width: 150rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  padding: 16rpx 18rpx;
  border: none;
  border-radius: 6rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.action-btn.appoint {
  background: #00c6a7;
  color: white;
}

.action-btn.change-role {
  background: #ff9800;
  color: white;
}

.action-btn.remove {
  background: #f44336;
  color: white;
}

.action-btn.view {
  background: #2196f3;
  color: white;
}

.btn-icon {
  font-size: 18rpx;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 100rpx 40rpx;
  background: white;
  margin: 40rpx 30rpx;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1);
}

.empty-icon {
  font-size: 70rpx;
  display: block;
  margin-bottom: 25rpx;
}

.empty-text {
  display: block;
  font-size: 30rpx;
  color: #333;
  margin-bottom: 12rpx;
  font-weight: 600;
}

.empty-desc {
  display: block;
  font-size: 24rpx;
  color: #666;
  margin-bottom: 35rpx;
}

.empty-btn {
  background: #00c6a7;
  color: white;
  border: none;
  border-radius: 25rpx;
  padding: 20rpx 50rpx;
  font-size: 26rpx;
  font-weight: 500;
}

/* 模态框 */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2000;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
  padding: 40rpx;
}

.modal.show {
  opacity: 1;
  visibility: visible;
}

.modal-content {
  background: white;
  border-radius: 12rpx;
  width: 100%;
  max-width: 90vw;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.2);
  transform: translateY(50rpx);
  transition: all 0.3s ease;
}

.modal.show .modal-content {
  transform: translateY(0);
}

.modal-content.large {
  max-width: 95vw;
  max-height: 85vh;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 30rpx 20rpx;
  border-bottom: 1rpx solid #e0e0e0;
}

.modal-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.modal-close {
  font-size: 36rpx;
  color: #999;
  padding: 8rpx;
}

.modal-body {
  padding: 30rpx;
}

.modal-teacher {
  display: block;
  font-size: 26rpx;
  color: #555;
  margin-bottom: 30rpx;
  text-align: center;
  font-weight: 500;
}

/* 角色选择 */
.role-selection {
  margin-top: 25rpx;
}

.selection-label {
  display: block;
  font-size: 26rpx;
  color: #555;
  margin-bottom: 20rpx;
  font-weight: 500;
}

.role-options {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.role-option {
  display: flex;
  align-items: center;
  padding: 25rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 8rpx;
}

.role-option.selected {
  border-color: #00c6a7;
  background: rgba(0, 198, 167, 0.05);
}

.role-icon {
  font-size: 32rpx;
  margin-right: 15rpx;
}

.role-name {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
  margin-right: 12rpx;
}

.role-desc {
  font-size: 22rpx;
  color: #666;
  flex: 1;
}

/* 老师详情 */
.profile-section {
  display: flex;
  flex-direction: column;
  gap: 25rpx;
}

.profile-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding-bottom: 25rpx;
  border-bottom: 1rpx solid #e0e0e0;
}

.profile-avatar.large {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #00c6a7;
  display: flex;
  align-items: center;
  justify-content: center;
}

.profile-avatar.large .avatar-text {
  font-size: 36rpx;
}

.profile-info {
  flex: 1;
}

.profile-name {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 6rpx;
}

.profile-id {
  display: block;
  font-size: 24rpx;
  color: #666;
  margin-bottom: 4rpx;
}

.profile-department {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.profile-status {
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  font-weight: 500;
  display: inline-block;
}

.profile-status.online {
  background: #e8f5e9;
  color: #2e7d32;
}

.profile-status.offline {
  background: #f5f5f5;
  color: #666;
}

.detail-section {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.detail-group {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.detail-label {
  font-size: 26rpx;
  color: #666;
  font-weight: 500;
  min-width: 130rpx;
}

.detail-value {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
  flex: 1;
  text-align: right;
}

.detail-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  justify-content: flex-end;
}

.detail-tag {
  padding: 4rpx 10rpx;
  background: rgba(0, 198, 167, 0.1);
  color: #00c6a7;
  border-radius: 8rpx;
  font-size: 20rpx;
  border: 1rpx solid rgba(0, 198, 167, 0.2);
}

.appointment-history {
  margin-top: 18rpx;
}

.section-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 18rpx;
  padding-bottom: 8rpx;
  border-bottom: 1rpx solid #00c6a7;
}

.history-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.history-activity {
  font-size: 24rpx;
  color: #555;
  flex: 1;
}

.history-role {
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  font-weight: 500;
  margin: 0 12rpx;
}

.history-role.judge {
  background: #e3f2fd;
  color: #1565c0;
}

.history-role.chief {
  background: #fff3e0;
  color: #e65100;
}

.history-time {
  font-size: 20rpx;
  color: #999;
}

.modal-footer {
  display: flex;
  padding: 20rpx 30rpx 30rpx;
  gap: 15rpx;
}

.modal-btn {
  flex: 1;
  padding: 20rpx;
  border: none;
  border-radius: 8rpx;
  font-size: 26rpx;
  font-weight: 500;
}

.modal-btn.cancel {
  background: #f5f5f5;
  color: #666;
}

.modal-btn.confirm {
  background: #00c6a7;
  color: white;
}

.modal-btn.primary {
  background: #00c6a7;
  color: white;
}