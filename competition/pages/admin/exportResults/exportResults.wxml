<!-- competition/pages/admin/exportResults/exportResults.wxml -->
<navigation-bar title="结果导出" back="{{true}}" color="white" background="#4cd964"></navigation-bar>

<view class="export-results-page">
  <scroll-view class="content" scroll-y>
    <!-- 活动选择 -->
    <view class="card">
      <view class="card-title">
        <text class="title-icon">📋</text>
        <text class="title-text">选择活动</text>
      </view>
      
      <picker 
        mode="selector"
        range="{{activityOptions}}"
        range-key="name"
        value="{{selectedActivityIndex}}"
        bindchange="onActivityChange"
      >
        <view class="picker-view">
          <text class="picker-label">活动名称</text>
          <view class="picker-content">
            <text class="picker-text">{{activityOptions[selectedActivityIndex].name}}</text>
            <text class="picker-arrow">▼</text>
          </view>
        </view>
      </picker>
      
      <view class="activity-info" wx:if="{{selectedActivity}}">
        <view class="info-row">
          <text class="info-label">活动主题：</text>
          <text class="info-value">{{selectedActivity.theme || selectedActivity.title}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">已评分作品：</text>
          <text class="info-value">{{selectedActivity.scoredWorkCount || 0}}个</text>
        </view>
        <view class="info-row">
          <text class="info-label">活动状态：</text>
          <text class="info-value">{{selectedActivity.statusText || '未知'}}</text>
        </view>
      </view>
    </view>

    <!-- 导出说明 -->
    <view class="card">
      <view class="card-title">
        <text class="title-icon">ℹ️</text>
        <text class="title-text">导出说明</text>
      </view>
      
      <view class="export-info">
        <view class="info-item">
          <text class="item-icon">📊</text>
          <text class="item-text">导出格式：CSV文件（可在Excel中打开）</text>
        </view>
        <view class="info-item">
          <text class="item-icon">📝</text>
          <text class="item-text">包含内容：排名、学号、作品名称、平均分、获奖等级</text>
        </view>
        <view class="info-item">
          <text class="item-icon">📥</text>
          <text class="item-text">文件将保存到云存储，可下载查看</text>
        </view>
      </view>
    </view>

    <!-- 导出按钮 -->
    <view class="export-section">
      <button 
        class="export-btn"
        bindtap="onExport"
        loading="{{exporting}}"
        disabled="{{!selectedActivity || exporting}}"
      >
        {{exporting ? '导出中...' : '📊 导出结果'}}
      </button>
    </view>

    <!-- 导出历史 -->
    <view class="card" wx:if="{{exportHistory.length > 0}}">
      <view class="card-title">
        <text class="title-icon">📚</text>
        <text class="title-text">导出历史</text>
      </view>
      
      <view class="history-list">
        <view 
          class="history-item"
          wx:for="{{exportHistory}}"
          wx:key="index"
        >
          <view class="history-info">
            <text class="history-name">{{item.activityName}}</text>
            <text class="history-time">{{item.exportTime}}</text>
          </view>
          <button 
            class="download-btn"
            size="mini"
            bindtap="onDownloadFile"
            data-fileid="{{item.fileID}}"
            data-filename="{{item.fileName}}"
          >
            下载
          </button>
        </view>
      </view>
    </view>

    <!-- 加载状态 -->
    <view class="loading-state" wx:if="{{loading}}">
      <text>加载中...</text>
    </view>
  </scroll-view>
</view>

