/* pages/admin/judgeManagement/judgeManagement.wxss */
page {
  background: linear-gradient(135deg, #f0f9f0 0%, #e6f7e6 100%);
  min-height: 100vh;
}

.judge-container {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 顶部标题区域 */
.page-header {
  position: relative;
  height: 320rpx;
  overflow: hidden;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, #00c6a7 0%, #00a886 100%);
  clip-path: polygon(0 0, 100% 0, 100% 85%, 0 100%);
}

.header-content {
  position: relative;
  z-index: 2;
  padding: 60rpx 40rpx 0;
}

.header-title {
  display: block;
  font-size: 48rpx;
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 10rpx;
}

.header-desc {
  font-size: 28rpx;
  color: rgba(255,255,255,0.8);
  margin-bottom: 40rpx;
}

/* 统计网格 */
.stats-grid {
  display: flex;
  justify-content: space-between;
  margin-top: 30rpx;
}

.stat-item {
  text-align: center;
  flex: 1;
}

.stat-number {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
}

/* 活动选择器 */
.activity-selector {
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20rpx);
  margin: -30rpx 30rpx 30rpx;
  padding: 30rpx;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 25rpx rgba(0, 198, 167, 0.15);
  border: 1rpx solid rgba(0, 198, 167, 0.1);
  display: flex;
  align-items: center;
  position: relative;
  z-index: 3;
}

.selector-label {
  font-size: 28rpx;
  color: #4a5568;
  font-weight: 500;
  margin-right: 20rpx;
  white-space: nowrap;
}

.picker-display {
  flex: 1;
  padding: 20rpx 30rpx;
  background: #f8fdfb;
  border: 2rpx solid #e0f2e9;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #2d3748;
  text-align: center;
  box-shadow: 0 2rpx 10rpx rgba(0, 198, 167, 0.1);
  transition: all 0.3s ease;
}

.picker-display:active {
  border-color: #00c6a7;
  background: #ffffff;
}

/* 筛选区域 */
.filter-section {
  background: transparent;
  padding: 0 30rpx 30rpx;
}

.search-box {
  position: relative;
  margin-bottom: 30rpx;
}

.search-input {
  width: 100%;
  padding: 24rpx 60rpx 24rpx 30rpx;
  background: #ffffff;
  border: 2rpx solid #e0f2e9;
  border-radius: 50rpx;
  font-size: 28rpx;
  box-shadow: 0 4rpx 15rpx rgba(0, 198, 167, 0.1);
}

.search-placeholder {
  color: #a0aec0;
  font-size: 28rpx;
}

.search-icon {
  position: absolute;
  right: 30rpx;
  top: 50%;
  transform: translateY(-50%);
  color: #00c6a7;
  font-size: 28rpx;
}

.filter-tabs {
  display: flex;
  background: #ffffff;
  border-radius: 50rpx;
  padding: 8rpx;
  box-shadow: 0 4rpx 15rpx rgba(0, 198, 167, 0.1);
}

.filter-tab {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  font-size: 26rpx;
  color: #718096;
  border-radius: 40rpx;
  transition: all 0.3s ease;
}

.filter-tab.active {
  background: linear-gradient(135deg, #00c6a7 0%, #00a886 100%);
  color: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(0, 198, 167, 0.3);
}

/* 已任命评委面板 */
.appointed-panel {
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20rpx);
  margin: 0 30rpx 30rpx;
  padding: 30rpx;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 25rpx rgba(0, 198, 167, 0.15);
  border: 1rpx solid rgba(0, 198, 167, 0.1);
}

.panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 25rpx;
}

.panel-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2d3748;
}

.panel-count {
  font-size: 24rpx;
  color: #00c6a7;
  background: rgba(0, 198, 167, 0.1);
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

.judges-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
}

.judge-tag {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 20rpx;
  background: #f8fdfb;
  border: 2rpx solid #e0f2e9;
  border-radius: 25rpx;
  transition: all 0.3s ease;
}

.judge-tag.chief {
  background: linear-gradient(135deg, #fff3cd 0%, #ffeaa7 100%);
  border-color: #ffeaa7;
}

.judge-name {
  font-size: 26rpx;
  color: #2d3748;
  font-weight: 500;
}

.judge-role {
  font-size: 22rpx;
  color: #718096;
  background: rgba(255, 255, 255, 0.8);
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

.judge-tag.chief .judge-role {
  background: rgba(255, 255, 255, 0.9);
  color: #856404;
}

.remove-btn {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: #e53e3e;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: bold;
  cursor: pointer;
  transition: all 0.3s ease;
}

.remove-btn:active {
  transform: scale(0.9);
}

/* 老师列表 */
.teacher-list {
  padding: 0 30rpx;
}

.teacher-card {
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20rpx);
  padding: 40rpx;
  border-radius: 20rpx;
  margin-bottom: 25rpx;
  box-shadow: 0 8rpx 25rpx rgba(0, 198, 167, 0.15);
  border: 1rpx solid rgba(0, 198, 167, 0.1);
  transition: all 0.3s ease;
  animation: fadeInUp 0.6s ease-out;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(30rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.teacher-card:active {
  transform: translateY(-4rpx);
  box-shadow: 0 15rpx 35rpx rgba(0, 198, 167, 0.25);
}

/* 老师头部 */
.teacher-header {
  display: flex;
  align-items: flex-start;
  margin-bottom: 25rpx;
  position: relative;
}

.avatar-section {
  position: relative;
  margin-right: 25rpx;
}

.teacher-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #00c6a7 0%, #00a886 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 15rpx rgba(0, 198, 167, 0.3);
}

.avatar-text {
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
}

.online-status {
  position: absolute;
  bottom: 5rpx;
  right: 5rpx;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  border: 3rpx solid #ffffff;
}

.online-status.online {
  background: #48bb78;
}

.online-status.offline {
  background: #a0aec0;
}

.teacher-info {
  flex: 1;
}

.teacher-name {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #2d3748;
  margin-bottom: 8rpx;
}

.teacher-id {
  display: block;
  font-size: 26rpx;
  color: #718096;
  margin-bottom: 5rpx;
}

.teacher-department {
  display: block;
  font-size: 24rpx;
  color: #a0aec0;
}

.appointment-status {
  position: absolute;
  top: 0;
  right: 0;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.appointment-status.available {
  background: #d4edda;
  color: #155724;
}

.appointment-status.appointed {
  background: #d1ecf1;
  color: #0c5460;
}

.appointment-status.busy {
  background: #fff3cd;
  color: #856404;
}

/* 专业领域 */
.expertise-section {
  margin-bottom: 20rpx;
  padding: 20rpx;
  background: #f8fdfb;
  border-radius: 12rpx;
  border: 1rpx solid #e0f2e9;
}

.section-label {
  font-size: 26rpx;
  color: #4a5568;
  font-weight: 500;
  margin-bottom: 12rpx;
  display: block;
}

.expertise-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.expertise-tag {
  padding: 8rpx 16rpx;
  background: rgba(0, 198, 167, 0.1);
  color: #00c6a7;
  border-radius: 16rpx;
  font-size: 22rpx;
  border: 1rpx solid rgba(0, 198, 167, 0.2);
}

/* 任命信息 */
.appointment-info {
  display: flex;
  align-items: center;
  gap: 15rpx;
  margin-bottom: 25rpx;
  padding: 18rpx;
  background: #fefce8;
  border-radius: 12rpx;
  border-left: 4rpx solid #f59e0b;
}

.info-label {
  font-size: 26rpx;
  color: #92400e;
  font-weight: 500;
}

.info-value {
  font-size: 26rpx;
  color: #92400e;
  flex: 1;
}

.info-role {
  padding: 6rpx 12rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.info-role.judge {
  background: #d1ecf1;
  color: #0c5460;
}

.info-role.chief {
  background: #fff3cd;
  color: #856404;
}

/* 操作按钮 */
.action-buttons {
  display: flex;
  gap: 15rpx;
  flex-wrap: wrap;
}

.action-btn {
  flex: 1;
  min-width: 160rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 18rpx 20rpx;
  border: none;
  border-radius: 10rpx;
  font-size: 24rpx;
  font-weight: 500;
  transition: all 0.3s ease;
}

.action-btn.appoint {
  background: linear-gradient(135deg, #00c6a7 0%, #00a886 100%);
  color: #ffffff;
}

.action-btn.change-role {
  background: linear-gradient(135deg, #ed8936 0%, #dd6b20 100%);
  color: #ffffff;
}

.action-btn.remove {
  background: linear-gradient(135deg, #e53e3e 0%, #c53030 100%);
  color: #ffffff;
}

.action-btn.view {
  background: linear-gradient(135deg, #4299e1 0%, #3182ce 100%);
  color: #ffffff;
}

.action-btn:active {
  transform: scale(0.95);
}

.btn-icon {
  font-size: 20rpx;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 120rpx 40rpx;
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(20rpx);
  margin: 40rpx 30rpx;
  border-radius: 25rpx;
  box-shadow: 0 10rpx 30rpx rgba(0, 198, 167, 0.15);
  border: 1rpx solid rgba(0, 198, 167, 0.1);
}

.empty-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 30rpx;
}

.empty-text {
  display: block;
  font-size: 32rpx;
  color: #4a5568;
  margin-bottom: 15rpx;
  font-weight: 600;
}

.empty-desc {
  display: block;
  font-size: 26rpx;
  color: #718096;
  margin-bottom: 40rpx;
}

.empty-btn {
  background: linear-gradient(135deg, #00c6a7 0%, #00a886 100%);
  color: #ffffff;
  border: none;
  border-radius: 50rpx;
  padding: 24rpx 60rpx;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 25rpx rgba(0, 198, 167, 0.4);
}

/* 模态框 */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2000;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
  padding: 40rpx;
}

.modal.show {
  opacity: 1;
  visibility: visible;
}

.modal-content {
  background: #ffffff;
  border-radius: 20rpx;
  width: 100%;
  max-width: 90vw;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.2);
  transform: translateY(50rpx);
  transition: all 0.3s ease;
}

.modal.show .modal-content {
  transform: translateY(0);
}

.modal-content.large {
  max-width: 95vw;
  max-height: 85vh;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 40rpx 40rpx 20rpx;
  border-bottom: 2rpx solid #e2e8f0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2d3748;
}

.modal-close {
  font-size: 40rpx;
  color: #a0aec0;
  padding: 10rpx;
}

.modal-body {
  padding: 40rpx;
}

.modal-teacher {
  display: block;
  font-size: 28rpx;
  color: #4a5568;
  margin-bottom: 40rpx;
  text-align: center;
  font-weight: 500;
}

/* 角色选择 */
.role-selection {
  margin-top: 30rpx;
}

.selection-label {
  display: block;
  font-size: 28rpx;
  color: #4a5568;
  margin-bottom: 25rpx;
  font-weight: 500;
}

.role-options {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.role-option {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border: 2rpx solid #e2e8f0;
  border-radius: 15rpx;
  transition: all 0.3s ease;
  cursor: pointer;
}

.role-option.selected {
  border-color: #00c6a7;
  background: rgba(0, 198, 167, 0.05);
}

.role-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.role-name {
  font-size: 28rpx;
  color: #2d3748;
  font-weight: 600;
  margin-right: 15rpx;
}

.role-desc {
  font-size: 24rpx;
  color: #718096;
  flex: 1;
}

/* 老师详情 */
.profile-section {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.profile-header {
  display: flex;
  align-items: center;
  gap: 25rpx;
  padding-bottom: 30rpx;
  border-bottom: 2rpx solid #e2e8f0;
}

.profile-avatar.large {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #00c6a7 0%, #00a886 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 20rpx rgba(0, 198, 167, 0.3);
}

.profile-avatar.large .avatar-text {
  font-size: 40rpx;
}

.profile-info {
  flex: 1;
}

.profile-name {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #2d3748;
  margin-bottom: 8rpx;
}

.profile-id {
  display: block;
  font-size: 26rpx;
  color: #718096;
  margin-bottom: 5rpx;
}

.profile-department {
  display: block;
  font-size: 24rpx;
  color: #a0aec0;
  margin-bottom: 10rpx;
}

.profile-status {
  padding: 6rpx 12rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  font-weight: 500;
  display: inline-block;
}

.profile-status.online {
  background: #d4edda;
  color: #155724;
}

.profile-status.offline {
  background: #e2e8f0;
  color: #4a5568;
}

.detail-section {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.detail-group {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #e2e8f0;
}

.detail-label {
  font-size: 28rpx;
  color: #718096;
  font-weight: 500;
  min-width: 140rpx;
}

.detail-value {
  font-size: 28rpx;
  color: #2d3748;
  font-weight: 600;
  flex: 1;
  text-align: right;
}

.detail-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  justify-content: flex-end;
}

.detail-tag {
  padding: 6rpx 12rpx;
  background: rgba(0, 198, 167, 0.1);
  color: #00c6a7;
  border-radius: 12rpx;
  font-size: 22rpx;
  border: 1rpx solid rgba(0, 198, 167, 0.2);
}

.appointment-history {
  margin-top: 20rpx;
}

.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #2d3748;
  margin-bottom: 20rpx;
  padding-bottom: 10rpx;
  border-bottom: 2rpx solid #00c6a7;
}

.history-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #e2e8f0;
}

.history-activity {
  font-size: 26rpx;
  color: #4a5568;
  flex: 1;
}

.history-role {
  padding: 6rpx 12rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  font-weight: 500;
  margin: 0 15rpx;
}

.history-role.judge {
  background: #d1ecf1;
  color: #0c5460;
}

.history-role.chief {
  background: #fff3cd;
  color: #856404;
}

.history-time {
  font-size: 22rpx;
  color: #a0aec0;
}

.modal-footer {
  display: flex;
  padding: 20rpx 40rpx 40rpx;
  gap: 20rpx;
}

.modal-btn {
  flex: 1;
  padding: 24rpx;
  border: none;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  transition: all 0.3s ease;
}

.modal-btn.cancel {
  background: #e2e8f0;
  color: #4a5568;
}

.modal-btn.confirm {
  background: linear-gradient(135deg, #00c6a7 0%, #00a886 100%);
  color: #ffffff;
}

.modal-btn.primary {
  background: linear-gradient(135deg, #00c6a7 0%, #00a886 100%);
  color: #ffffff;
}

.modal-btn:active {
  transform: scale(0.95);
}