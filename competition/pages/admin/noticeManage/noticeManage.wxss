/* competition/pages/admin/noticeManage/noticeManage.wxss */

.notice-manage-page {
  background: linear-gradient(180deg, #FFFFF5 0%, #FFFFFF 100%);
  min-height: 100vh;
  padding: 30rpx;
  position: relative;
}

/* 背景装饰 */
.notice-manage-page::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: 
    radial-gradient(ellipse at -20% 20%, rgba(80, 182, 255, 0.08) 0%, transparent 50%),
    radial-gradient(ellipse at 120% 80%, rgba(66, 255, 0, 0.08) 0%, transparent 50%);
  pointer-events: none;
  z-index: 1;
}

/* ========== 表单卡片 ========== */
.form-card {
  background: linear-gradient(148.26deg, rgba(130, 255, 158, 0.8) 0%, rgba(255, 255, 255, 0.8) 9%, rgba(255, 255, 255, 0.8) 100%);
  border-radius: 24rpx;
  backdrop-filter: blur(20rpx);
  box-shadow: 2rpx 2rpx 6rpx 0rpx #00000026;
  padding: 40rpx;
  margin-bottom: 30rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  position: relative;
  z-index: 2;
}

.form-header {
  text-align: center;
  margin-bottom: 40rpx;
  padding-bottom: 30rpx;
  border-bottom: 2rpx solid rgba(38, 166, 154, 0.2);
}

.form-title {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #3F3F3F;
  font-family: PingFang SC;
  margin-bottom: 10rpx;
}

.form-subtitle {
  display: block;
  font-size: 26rpx;
  color: #666;
  font-family: PingFang SC;
}

/* ========== 表单项 ========== */
.form-item {
  margin-bottom: 35rpx;
  position: relative;
}

.form-label {
  font-size: 28rpx;
  color: #3F3F3F;
  font-weight: 500;
  font-family: PingFang SC;
  margin-bottom: 15rpx;
  display: block;
}

.form-label.required::after {
  content: ' *';
  color: #d32f2f;
}

/* ========== 输入框样式 ========== */
.form-input {
  width: 100%;
  padding: 24rpx;
  background: rgba(255, 255, 255, 0.9);
  border: 2rpx solid rgba(38, 166, 154, 0.3);
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #3F3F3F;
  font-family: PingFang SC;
  box-sizing: border-box;
  transition: all 0.3s ease;
}

.form-input:focus {
  border-color: #26a69a;
  background: rgba(255, 255, 255, 1);
  box-shadow: 0 0 0 4rpx rgba(38, 166, 154, 0.1);
}

.form-textarea {
  width: 100%;
  min-height: 200rpx;
  padding: 24rpx;
  background: rgba(255, 255, 255, 0.9);
  border: 2rpx solid rgba(38, 166, 154, 0.3);
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #3F3F3F;
  font-family: PingFang SC;
  box-sizing: border-box;
  line-height: 1.6;
  transition: all 0.3s ease;
}

.form-textarea:focus {
  border-color: #26a69a;
  background: rgba(255, 255, 255, 1);
  box-shadow: 0 0 0 4rpx rgba(38, 166, 154, 0.1);
}

.input-counter,
.textarea-counter {
  text-align: right;
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
  font-family: PingFang SC;
}

/* ========== 错误提示 ========== */
.error-tip {
  color: #d32f2f;
  font-size: 24rpx;
  margin-top: 8rpx;
  font-family: PingFang SC;
}

/* ========== 发布对象选择 ========== */
.target-select {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.target-option {
  display: flex;
  align-items: center;
  padding: 25rpx;
  background: rgba(255, 255, 255, 0.7);
  border: 2rpx solid rgba(38, 166, 154, 0.2);
  border-radius: 16rpx;
  transition: all 0.3s ease;
  cursor: pointer;
}

.target-option:active {
  transform: scale(0.98);
}

.target-option.active {
  background: linear-gradient(135deg, rgba(38, 166, 154, 0.1) 0%, rgba(255, 255, 255, 0.9) 100%);
  border-color: #26a69a;
  box-shadow: 0 4rpx 12rpx rgba(38, 166, 154, 0.2);
}

.option-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.option-text {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.option-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #3F3F3F;
  font-family: PingFang SC;
  margin-bottom: 5rpx;
}

.option-desc {
  font-size: 24rpx;
  color: #666;
  font-family: PingFang SC;
}

.option-check {
  font-size: 32rpx;
  color: #26a69a;
  font-weight: bold;
  width: 40rpx;
  text-align: center;
}

/* ========== 状态信息 ========== */
.status-info {
  margin-top: 30rpx;
  padding: 25rpx;
  background: rgba(255, 255, 255, 0.6);
  border-radius: 16rpx;
  border: 1rpx solid rgba(38, 166, 154, 0.2);
}

.status-item {
  display: flex;
  align-items: center;
  margin-bottom: 15rpx;
  font-size: 26rpx;
  font-family: PingFang SC;
}

.status-item:last-child {
  margin-bottom: 0;
}

.status-label {
  color: #666;
  min-width: 140rpx;
}

.status-value {
  color: #3F3F3F;
  font-weight: 500;
}

/* ========== 操作按钮 ========== */
.action-buttons {
  display: flex;
  gap: 20rpx;
  margin-bottom: 30rpx;
  position: relative;
  z-index: 2;
}

.action-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 20rpx;
  font-size: 30rpx;
  font-weight: bold;
  font-family: PingFang SC;
  border: none;
  box-shadow: 2rpx 2rpx 6rpx 0rpx #00000026;
  transition: all 0.3s ease;
}

.action-btn:active:not([disabled]) {
  transform: translateY(2rpx);
  box-shadow: 1rpx 1rpx 3rpx 0rpx #0000001a;
}

.publish-btn {
  background: linear-gradient(135deg, #26a69a 0%, #4db6ac 100%);
  color: white;
}

.publish-btn[disabled] {
  background: #e0e0e0;
  color: #999;
  box-shadow: none;
}

.reset-btn {
  background: linear-gradient(135deg, rgba(224, 242, 241, 0.8) 0%, rgba(255, 255, 255, 0.8) 100%);
  color: #26a69a;
  border: 2rpx solid rgba(38, 166, 154, 0.3);
}

.reset-btn[disabled] {
  background: #e0e0e0;
  color: #999;
  border-color: #e0e0e0;
}

/* ========== 历史记录卡片 ========== */
.history-card {
  background: linear-gradient(148.26deg, rgba(130, 255, 158, 0.8) 0%, rgba(255, 255, 255, 0.8) 9%, rgba(255, 255, 255, 0.8) 100%);
  border-radius: 24rpx;
  backdrop-filter: blur(20rpx);
  box-shadow: 2rpx 2rpx 6rpx 0rpx #00000026;
  padding: 35rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  position: relative;
  z-index: 2;
}

.history-header {
  margin-bottom: 25rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid rgba(38, 166, 154, 0.2);
}

.history-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #3F3F3F;
  font-family: PingFang SC;
}

.notice-preview {
  padding: 20rpx;
  margin-bottom: 15rpx;
  background: rgba(255, 255, 255, 0.6);
  border-radius: 12rpx;
  border-left: 4rpx solid #26a69a;
  transition: all 0.3s ease;
}

.notice-preview:last-child {
  margin-bottom: 0;
}

.notice-preview:active {
  transform: translateX(5rpx);
  background: rgba(255, 255, 255, 0.8);
}

.preview-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #3F3F3F;
  font-family: PingFang SC;
  margin-bottom: 10rpx;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.preview-meta {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #666;
  font-family: PingFang SC;
}

.preview-time {
  margin-right: 10rpx;
}

.preview-target {
  color: #26a69a;
}

/* 响应式调整 */
@media (max-width: 750rpx) {
  .notice-manage-page {
    padding: 20rpx;
  }
  
  .form-card {
    padding: 30rpx;
  }
  
  .action-buttons {
    flex-direction: column;
  }
  
  .action-btn {
    width: 100%;
  }
}

