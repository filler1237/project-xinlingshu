/* =================================================
   评审打分页 - 统一科技绿设计系统
   ================================================= */

   page {
    background-color: #F4F8F6;
    --tech-green: #10B981;
    --tech-green-light: #ECFDF5;
    --text-main: #1F2937;
    --text-sub: #6B7280;
    --card-bg: #FFFFFF;
    --border-color: rgba(16, 185, 129, 0.15);
  }
  
  .scoring-page {
    min-height: 100vh;
    position: relative;
  }
  
  /* 统一背景光晕 */
  .scoring-page::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; height: 600rpx;
    background: radial-gradient(circle at 10% 10%, rgba(16, 185, 129, 0.06) 0%, transparent 60%);
    pointer-events: none;
    z-index: 0;
  }
  
  .content {
    padding: 30rpx;
    position: relative;
    z-index: 2;
  }
  
  /* ========== 通用卡片样式 ========== */
  .card {
    background: var(--card-bg);
    border-radius: 24rpx;
    padding: 36rpx;
    margin-bottom: 24rpx;
    border: 1rpx solid var(--border-color);
    box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.02);
  }
  
  .card-title {
    display: flex;
    align-items: center;
    margin-bottom: 30rpx;
    padding-bottom: 20rpx;
    border-bottom: 1rpx solid #F3F4F6;
  }
  
  .title-icon {
    width: 8rpx;
    height: 32rpx;
    background: var(--tech-green);
    border-radius: 4rpx;
    margin-right: 18rpx;
    flex-shrink: 0;
  }
  
  .title-text {
    font-size: 32rpx;
    font-weight: 600;
    color: var(--text-main);
  }
  
  /* ========== 信息展示项 ========== */
  .info-item {
    display: flex;
    margin-bottom: 20rpx;
  }
  
  .label {
    font-size: 28rpx;
    color: var(--text-sub);
    width: 140rpx;
    flex-shrink: 0;
  }
  
  .value {
    font-size: 28rpx;
    color: var(--text-main);
    font-weight: 500;
  }
  
  /* ========== 评分项核心样式 ========== */
  .score-item {
    margin-bottom: 30rpx;
    padding: 30rpx;
    background: #F9FAFB;
    border-radius: 20rpx;
    border: 1rpx solid #F3F4F6;
  }
  
  .score-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 24rpx;
  }
  
  .score-name {
    font-size: 30rpx;
    font-weight: 600;
    color: var(--text-main);
    margin-bottom: 8rpx;
    display: block;
  }
  
  .score-desc {
    font-size: 24rpx;
    color: var(--text-sub);
    line-height: 1.4;
  }
  
  .score-range {
    font-size: 24rpx;
    color: var(--tech-green);
    font-weight: 600;
    background: var(--tech-green-light);
    padding: 4rpx 12rpx;
    border-radius: 8rpx;
  }
  
  /* 评分输入框聚焦效果 */
  .score-input-section {
    display: flex;
    align-items: center;
  }
  
  .score-input {
    flex: 1;
    height: 90rpx;
    background: #FFFFFF;
    border: 2rpx solid #E5E7EB;
    border-radius: 16rpx;
    font-size: 36rpx;
    font-weight: 700;
    color: var(--tech-green);
    text-align: center;
    transition: all 0.3s ease;
  }
  
  .score-input:focus {
    border-color: var(--tech-green);
    background: var(--tech-green-light);
    box-shadow: 0 0 0 4rpx rgba(16, 185, 129, 0.1);
  }
  
  .score-unit {
    font-size: 28rpx;
    color: var(--text-sub);
    margin-left: 20rpx;
    font-weight: 500;
  }
  
  /* ========== 总分计算区域 ========== */
  .total-score-section {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 40rpx;
    background: linear-gradient(135deg, #10B981 0%, #059669 100%);
    border-radius: 24rpx;
    margin-top: 40rpx;
    box-shadow: 0 10rpx 20rpx rgba(16, 185, 129, 0.2);
  }
  
  .total-label {
    font-size: 32rpx;
    color: rgba(255, 255, 255, 0.9);
    margin-right: 20rpx;
  }
  
  .total-value {
    font-size: 64rpx;
    font-weight: 800;
    color: #FFFFFF;
    font-family: 'DIN Alternate', Arial, sans-serif;
  }
  
  /* ========== 评语输入区域 ========== */
  .comment-input {
    width: 100%;
    min-height: 240rpx;
    padding: 24rpx;
    background: #F9FAFB;
    border: 2rpx solid #E5E7EB;
    border-radius: 16rpx;
    font-size: 28rpx;
    color: var(--text-main);
    box-sizing: border-box;
  }
  
  .comment-input:focus {
    background: #FFFFFF;
    border-color: var(--tech-green);
  }
  
  .comment-count {
    display: block;
    text-align: right;
    margin-top: 16rpx;
    font-size: 24rpx;
    color: var(--text-sub);
  }
  
  /* ========== 状态提示 (已评审) ========== */
  .reviewed-tip {
    display: flex;
    align-items: center;
    padding: 24rpx 30rpx;
    background: #FFFBEB;
    border: 1rpx solid #FEF3C7;
    border-radius: 16rpx;
    margin-bottom: 30rpx;
  }
  
  .tip-icon {
    font-size: 32rpx;
    margin-right: 16rpx;
  }
  
  .tip-text {
    font-size: 26rpx;
    color: #B45309;
    font-weight: 500;
  }
  
  /* ========== 提交按钮 ========== */
  .submit-section {
    margin-top: 40rpx;
    padding-bottom: 80rpx;
  }
  
  .submit-btn {
    width: 100%;
    height: 100rpx;
    line-height: 100rpx;
    background: var(--tech-green);
    color: #FFFFFF;
    font-size: 32rpx;
    font-weight: 600;
    border-radius: 20rpx;
    box-shadow: 0 10rpx 20rpx rgba(16, 185, 129, 0.2);
    transition: all 0.3s;
  }
  
  .submit-btn[disabled] {
    background: #D1D5DB !important;
    color: #FFFFFF !important;
    box-shadow: none;
  }
  
  .submit-btn:active:not([disabled]) {
    transform: translateY(4rpx);
    box-shadow: 0 4rpx 8rpx rgba(16, 185, 129, 0.2);
  }
  
  /* 加载状态统一 */
  .loading-state {
    text-align: center;
    padding: 100rpx 0;
    color: var(--text-sub);
    font-size: 28rpx;
  }