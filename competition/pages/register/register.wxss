.register-container {
  padding: 40rpx;
  min-height: 100vh;
  background-color: #f5f5f5;
}

.register-header {
  text-align: center;
  margin-top: 60rpx;
  margin-bottom: 60rpx;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
}

.register-type {
  background-color: white;
  padding: 30rpx;
  border-radius: 16rpx;
  margin-bottom: 40rpx;
}

.radio-item {
  display: block;
  margin: 20rpx 0;
  font-size: 34rpx;
}

.register-form {
  background-color: white;
  padding: 30rpx;
  border-radius: 16rpx;
}

.input-group {
  margin-bottom: 40rpx;
}

.label {
  display: block;
  font-size: 32rpx;
  margin-bottom: 20rpx;
  color: #333;
}

.input {
  border: 2rpx solid #e5e5e5;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 32rpx;
}

.register-btn {
  background-color: #007AFF;
  color: white;
  border-radius: 12rpx;
  font-size: 34rpx;
  padding: 20rpx;
  margin-top: 20rpx;
}

.login-link {
  text-align: center;
  margin-top: 40rpx;
}

.link {
  color: #007AFF;
  font-size: 30rpx;
}