<view class="register-container">
  <view class="register-header">
    <text class="title">用户注册</text>
  </view>

  <view class="register-type">
    <radio-group bindchange="onRegisterTypeChange">
      <label class="radio-item">
        <radio value="student" checked="{{registerType === 'student'}}"/> 学生
      </label>
      <label class="radio-item">
        <radio value="admin" checked="{{registerType === 'admin'}}"/> 管理员
      </label>
      <label class="radio-item">
        <radio value="judge" checked="{{registerType === 'judge'}}"/> 评委
      </label>
    </radio-group>
  </view>

  <view class="register-form">
    <view class="input-group">
      <text class="label">用户名</text>
      <input 
        class="input" 
        placeholder="请输入用户名" 
        value="{{username}}"
        bindinput="onUsernameInput"
      />
    </view>

    <view class="input-group">
      <text class="label">密码</text>
      <input 
        class="input" 
        password 
        placeholder="请输入密码(至少6位)" 
        value="{{password}}"
        bindinput="onPasswordInput"
      />
    </view>

    <view class="input-group">
      <text class="label">确认密码</text>
      <input 
        class="input" 
        password 
        placeholder="请再次输入密码" 
        value="{{confirmPassword}}"
        bindinput="onConfirmPasswordInput"
      />
    </view>

    <view wx:if="{{registerType === 'student'}}" class="input-group">
      <text class="label">学号</text>
      <input 
        class="input" 
        placeholder="请输入学号" 
        value="{{studentId}}"
        bindinput="onStudentIdInput"
      />
    </view>

    <view class="input-group">
      <text class="label">院系/部门</text>
      <input 
        class="input" 
        placeholder="请输入院系或部门" 
        value="{{department}}"
        bindinput="onDepartmentInput"
      />
    </view>

    <button class="register-btn" bindtap="onRegister">注册</button>
    
    <view class="login-link">
      <text class="link" bindtap="onBackToLogin">返回登录</text>
    </view>
  </view>
</view>