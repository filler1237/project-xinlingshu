/* 个人中心页面样式 - 与评委工作台设计系统统一 */

.container {
  padding: 30rpx; /* 统一内边距 */
  min-height: 100vh; /* 最小高度为整个视口 */
  background: linear-gradient(180deg, #FFFFF5 0%, #FFFFFF 100%); /* 统一渐变背景 */
  position: relative; /* 相对定位，用于背景装饰元素 */
}

/* 背景装饰元素 - 保持统一风格 */
.sekuai1 {
  background: #50b6ff14; /* 浅蓝色背景，带透明度 */
  filter: blur(100rpx); /* 模糊效果，创建毛玻璃质感 */
  height: 384rpx; /* 固定高度 */
  position: absolute; /* 绝对定位，脱离文档流 */
  left: -120.63rpx; /* 向左偏移，部分超出容器 */
  top: 28rpx; /* 距离顶部位置 */
  z-index: 1; /* 层级在背景层 */
}

.sekuai2 {
  background: #42FF0019; /* 浅绿色背景，带透明度 */
  filter: blur(100rpx); /* 模糊效果 */
  height: 384rpx; /* 固定高度 */
  position: absolute; /* 绝对定位 */
  left: 312rpx; /* 水平位置 */
  top: 662.22rpx; /* 垂直位置 */
  z-index: 1; /* 背景层级 */
}

/* 头部区域 */
.header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 60rpx;
  position: relative; /* 相对定位 */
  z-index: 2; /* 确保在背景之上 */
}

/* 用户信息区域 */
.user-info {
  flex: 1;
}

/* 头部操作按钮区域 */
.header-actions {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
  margin-left: 20rpx;
}

/* 操作按钮基础样式 */
.action-btn {
  padding: 12rpx 20rpx; /* 统一内边距 */
  border-radius: 10rpx; /* 圆角 */
  font-size: 24rpx; /* 字号 */
  text-align: center; /* 文字居中 */
  min-width: 100rpx; /* 最小宽度 */
  font-weight: 500; /* 中等字重 */
  font-family: PingFang SC; /* 统一字体 */
  border: none;
  backdrop-filter: blur(20rpx); /* 毛玻璃效果 */
  box-shadow: 2rpx 2rpx 6rpx 0rpx #00000026; /* 统一阴影 */
}

/* 返回按钮 */
.back-btn {
  background: rgba(255, 255, 255, 0.25); /* 半透明白色背景 */
  color: #3F3F3F; /* 统一深灰色 */
  border: 1rpx solid rgba(255, 255, 255, 0.4); /* 半透明边框 */
}

/* 退出登录按钮 */
.logout-btn {
  background: rgba(239, 83, 80, 0.25); /* 浅红色半透明背景 */
  color: #3F3F3F; /* 统一深灰色 */
  border: 1rpx solid rgba(255, 255, 255, 0.4); /* 半透明边框 */
}

/* 按钮交互效果 */
.back-btn:active,
.logout-btn:active {
  transform: translateY(2rpx); /* 按下效果 */
  box-shadow: 1rpx 1rpx 3rpx 0rpx #0000001a;
}

/* 欢迎文本 */
.welcome {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #3F3F3F; /* 统一深灰色 */
  font-family: PingFang SC;
  line-height: 48rpx;
  letter-spacing: 1rpx;
  margin-bottom: 10rpx;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.05);
}

/* 用户名 */
.username {
  display: block;
  font-size: 30rpx; /* 统一字号 */
  color: #3F3F3F; /* 统一深灰色 */
  font-family: PingFang SC;
  font-weight: regular;
  line-height: 36rpx;
  letter-spacing: 0rpx;
  margin-bottom: 8rpx;
}

/* 部门信息 */
.department {
  display: block;
  font-size: 26rpx; /* 统一字号 */
  color: #3F3F3F; /* 统一深灰色 */
  font-family: PingFang SC;
  font-weight: regular;
  line-height: 32rpx;
  letter-spacing: 0rpx;
}

/* 统计卡片网格 */
.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr; /* 三列等宽 */
  gap: 20rpx; /* 网格间距 */
  margin-bottom: 40rpx; /* 底部外边距 */
  z-index: 2; /* 层级 */
  position: relative; /* 相对定位 */
}

/* 统计卡片 */
.stat-card {
  background: linear-gradient(148.26deg, rgba(130, 255, 158, 0.8) 0%, rgba(255, 255, 255, 0.8) 9%, rgba(255, 255, 255, 0.8) 100%); /* 统一渐变背景 */
  border-radius: 20rpx; /* 统一圆角 */
  backdrop-filter: blur(20rpx); /* 毛玻璃效果 */
  box-shadow: 2rpx 2rpx 6rpx 0rpx #00000026; /* 统一阴影 */
  padding: 25rpx 15rpx; /* 内边距 */
  text-align: center; /* 文字居中 */
  border: 1rpx solid rgba(255, 255, 255, 0.5); /* 半透明边框 */
  height: 140rpx; /* 固定高度 */
  display: flex; /* 弹性布局 */
  flex-direction: column; /* 垂直排列 */
  justify-content: center; /* 垂直居中 */
}

.stat-card:active {
  transform: translateY(2rpx); /* 统一交互反馈 */
  box-shadow: 1rpx 1rpx 3rpx 0rpx #0000001a;
}

/* 统计数字 */
.stat-number {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #3F3F3F; /* 统一深灰色 */
  margin-bottom: 8rpx;
  font-family: PingFang SC;
}

/* 统计标签 */
.stat-label {
  display: block;
  font-size: 22rpx;
  color: #3F3F3F; /* 统一深灰色 */
  font-family: PingFang SC;
  font-weight: regular;
}

/* 功能网格 */
.function-grid {
  display: grid;
  grid-template-columns: 1fr 1fr; /* 两列等宽 */
  gap: 25rpx; /* 网格间距 */
  margin-bottom: 40rpx; /* 底部外边距 */
  z-index: 2; /* 层级 */
  position: relative; /* 相对定位 */
}

/* 功能卡片 */
.function-card {
  background: linear-gradient(148.26deg, rgba(130, 255, 158, 0.8) 0%, rgba(255, 255, 255, 0.8) 9%, rgba(255, 255, 255, 0.8) 100%); /* 统一渐变背景 */
  border-radius: 20rpx; /* 统一圆角 */
  backdrop-filter: blur(20rpx); /* 毛玻璃效果 */
  box-shadow: 2rpx 2rpx 6rpx 0rpx #00000026; /* 统一阴影 */
  padding: 35rpx 25rpx; /* 内边距 */
  text-align: center; /* 文字居中 */
  border: 1rpx solid rgba(255, 255, 255, 0.5); /* 半透明边框 */
  height: 200rpx; /* 固定高度 */
  display: flex; /* 弹性布局 */
  flex-direction: column; /* 垂直排列 */
  justify-content: center; /* 垂直居中 */
}

.function-card:active {
  transform: translateY(2rpx); /* 统一交互反馈 */
  box-shadow: 1rpx 1rpx 3rpx 0rpx #0000001a;
}

/* 卡片图标 */
.card-icon {
  font-size: 54rpx; /* 较大字号用于图标 */
  margin-bottom: 15rpx; /* 底部外边距 */
  background: linear-gradient(135deg, #00897b 0%, #4db6ac 100%); /* 渐变背景 */
  -webkit-background-clip: text; /* 背景裁剪为文字形状 */
  -webkit-text-fill-color: transparent; /* 文字颜色透明，显示背景渐变 */
  background-clip: text; /* 标准属性 */
}

/* 卡片标题 */
.card-title {
  display: block;
  font-size: 30rpx; /* 统一字号 */
  font-weight: bold;
  margin-bottom: 8rpx;
  color: #3F3F3F; /* 统一深灰色 */
  font-family: PingFang SC;
}

/* 卡片描述 */
.card-desc {
  display: block;
  font-size: 22rpx; /* 较小字号 */
  color: #3F3F3F; /* 统一深灰色 */
  line-height: 1.4;
  font-family: PingFang SC;
  font-weight: regular;
}

/* 底部退出登录区域 */
.logout-section {
  text-align: center;
  margin-top: 40rpx;
  position: relative;
  z-index: 2;
}

/* 底部退出按钮 */
.logout-section .logout-btn {
  background: rgba(239, 83, 80, 0.25); /* 浅红色半透明背景 */
  color: #3F3F3F; /* 统一深灰色 */
  border: 1rpx solid rgba(255, 255, 255, 0.4); /* 半透明边框 */
  border-radius: 15rpx; /* 统一圆角 */
  padding: 20rpx 40rpx;
  font-size: 28rpx; /* 统一字号 */
  font-family: PingFang SC;
  font-weight: 500;
  backdrop-filter: blur(20rpx); /* 毛玻璃效果 */
  box-shadow: 2rpx 2rpx 6rpx 0rpx #00000026; /* 统一阴影 */
  min-width: auto; /* 重置最小宽度 */
}

.logout-section .logout-btn:active {
  transform: translateY(2rpx); /* 按下效果 */
  box-shadow: 1rpx 1rpx 3rpx 0rpx #0000001a;
  background: rgba(239, 83, 80, 0.35); /* 按下时加深背景 */
}

/* 底部信息区域 - 与工作台统一 */
.bottom-info {
  height: 56rpx; /* 固定高度 */
  background-color: rgba(255, 255, 255, 0.6); /* 半透明白色背景 */
  display: flex; /* 弹性布局 */
  flex-direction: row; /* 水平排列 */
  justify-content: space-between; /* 两端对齐 */
  align-items: center; /* 垂直居中 */
  padding: 0 30rpx; /* 水平内边距 */
  border-radius: 10rpx; /* 圆角 */
  z-index: 2; /* 层级 */
  position: relative; /* 相对定位 */
  margin-top: 40rpx;
}

.bottom-info .info-text {
  color: #000000; /* 黑色文字 */
  font-family: PingFang SC; /* 统一字体 */
  font-weight: regular; /* 常规字重 */
  font-size: 24rpx; /* 较小字号 */
  line-height: 56rpx; /* 行高等于容器高度，垂直居中 */
  letter-spacing: 0rpx; /* 无字间距 */
  text-align: center; /* 文字居中 */
}

/* 响应式调整 */
@media (max-width: 750rpx) {
  .header {
    flex-direction: column;
    align-items: stretch;
  }
  
  .header-actions {
    flex-direction: row;
    margin-left: 0;
    margin-top: 20rpx;
    justify-content: space-between;
  }
  
  .stats-grid {
    grid-template-columns: 1fr;
    gap: 15rpx;
  }
  
  .function-grid {
    grid-template-columns: 1fr;
    gap: 20rpx;
  }
  
  .action-btn {
    min-width: 120rpx;
  }
}