/* pages/teacher/home/teacherHome.wxss
 * 顶尖轻量UI | 柔和青绿 | 无荧光
-------------------------------------------------- */
page{
  background: linear-gradient(180deg, #F0F9F0 0%, #FFFFFF 100%);
  font-family: PingFang SC;
  min-height: 100vh;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

.container{
  padding: 120rpx 40rpx 40rpx;
  min-height: 100vh;
  background: transparent;
}

/* 顶部导航区 */
.header{
  display: flex; justify-content: space-between; align-items: flex-start;
  margin-bottom: 60rpx;
}
.user-info{ flex: 1; }
.header-actions{
  display: flex; flex-direction: column; gap: 16rpx;
  margin-left: 20rpx;
}
.action-btn{
  padding: 16rpx 28rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
  font-weight: 500;
  text-align: center;
  min-width: 120rpx;
  backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(255,255,255,.4);
  transition: all .2s;
}
/* 返回按钮 - 绿色实心方框 */
.back-btn{
  background: #7ED321;          /* 柔和草绿 */
  color: #FFFFFF;               /* 白色文字 */
  border: none;                 /* 去掉白线 */
  border-radius: 12rpx;         /* 小圆角，想要纯直角写 0 */
  padding: 16rpx 28rpx;
  font-size: 26rpx;
  font-weight: 500;
  text-align: center;
  min-width: 120rpx;
  box-shadow: 0 4rpx 12rpx rgba(126,211,33,.35); /* 淡绿阴影 */
  transition: all .2s;
}

/* 手指按下稍深一点 */
.back-btn:active{
  background: #6AC210;
  transform: scale(.96);
}

.welcome{
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: #3F3F3F;
  margin-bottom: 10rpx;
}
.role{
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 6rpx;
}
.department{
  display: block;
  font-size: 24rpx;
  color: #999;
}
.student-id{
  display: block;
  font-size: 24rpx;
  color: #999;
}

/* 功能卡片 */
.function-grid{
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 30rpx;
  margin-bottom: 60rpx;
}
.function-card{
  background: rgba(255,255,255,.8);
  border-radius: 24rpx;
  padding: 40rpx 30rpx;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,.05);
  backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(255,255,255,.5);
  transition: all .3s;
}
.function-card:active{
  transform: translateY(4rpx);
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,.05);
}

.card-icon{
  font-size: 60rpx;
  margin-bottom: 20rpx;
  color: #7ED321;
}
.card-title{
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #3F3F3F;
  margin-bottom: 10rpx;
}
.card-desc{
  display: block;
  font-size: 24rpx;
  color: #666;
  line-height: 1.4;
}

/* 列表区块 */
.section{
  margin-bottom: 40rpx;
  padding: 32rpx;
  background: rgba(255,255,255,.8);
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,.05);
  backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(255,255,255,.5);
}

.section-header{
  display: flex; justify-content: space-between; align-items: center;
  margin-bottom: 24rpx;
}
.section-title{
  font-size: 34rpx;
  font-weight: 600;
  color: #3F3F3F;
}
.section-more{
  font-size: 28rpx;
  color: #7ED321;
}

.activity-list,
.work-list{
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.activity-card,
.work-card{
  background: rgba(255,255,255,.6);
  border-radius: 16rpx;
  padding: 24rpx;
  transition: all .3s;
  border: 1rpx solid rgba(0,0,0,.04);
}
.activity-card:active,
.work-card:active{
  background: rgba(126,211,33,.08);
  transform: scale(.98);
}

.activity-header,
.work-header{
  display: flex; justify-content: space-between; align-items: flex-start;
  margin-bottom: 12rpx;
}

.activity-title,
.work-title{
  font-size: 32rpx;
  font-weight: 600;
  color: #3F3F3F;
  flex: 1;
  margin-right: 20rpx;
}

.activity-status,
.work-status{
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 500;
  white-space: nowrap;
}

.activity-desc,
.work-activity{
  font-size: 28rpx;
  color: #666;
  margin-bottom: 16rpx;
  line-height: 1.5;
}

.activity-info,
.work-info{
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.info-item{
  font-size: 24rpx;
  color: #999;
}