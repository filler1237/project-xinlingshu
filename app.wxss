/**app.wxss**/
@import '/miniprogram_npm/weui-miniprogram/weui-wxss/dist/style/weui.wxss';
.container {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  padding: 200rpx 0;
  box-sizing: border-box;
} 




/**result**/
.box{
  width: 100%;
  height: 1200rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 100rpx 50rpx;
  box-sizing: border-box; 
}

.title{
  font-size: 50rpx;
  font-weight: bolder;
  margin: 20rpx;
  text-align: center
}

.resultword{
  font-size: 35rpx;
  margin: 20rpx;
  text-align: center;
}

.back{
  color: #30432d;
  font-size: 30rpx;
  text-align: center;
  margin: 10rpx;
}

/* TEST.wxss */
.IconBox{
  width: 750rpx;
  height: 300rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 25rpx;
}
.QesIn{
  width: 230rpx;
  height: 250rpx;
  border-radius: 10rpx;
  backdrop-filter: blur(20rpx);
  box-shadow: 0rpx 0rpx 8rpx 0rpx #DCDCC14C;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}
.QesPic{
  margin-top: 10rpx;
  width: 100rpx;
}
.Font{
  font-family: PingFang SC;
  font-weight: 230;
  font-size: 28rpx;
  line-height: 1.25;
  letter-spacing: 0.25rpx;
  line-height: 1.5em;
  letter-spacing: 2px;
  word-spacing: 4px;
  /* text-align: center; */
  margin-top: 15rpx;
}


.quesbox{
  width: 100%;
  height: 900rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 45rpx;
  box-sizing: border-box;
}
.question{
  text-align: center;
  padding: 5rpx 3rpx;
  font-size: 38rpx;
  font-weight: normal;
}

.flex{
  display: flex;
  flex-direction: column;
  background-color: #FFFFF5;
}

.flex .item{
  flex: 100;
  display:flex;
  justify-content: center;
  align-items: center;
  padding: 7rpx;
  flex-direction: column;
}
 
.select {
  padding: 15px 10px;
  background-color: #FFFFF5;
}
 
.select label {
  border: 1px solid #96CE74;
  color: #96CE74;
  padding: 15px 7px;
  margin: 10rpx;
  font-size: 17px;
  font-weight: 300;
  border-radius: 4px;
  width: 550rpx;
  text-align: center;
}
.tips{
  font-size: 25rpx;
  color: rgb(203, 216, 216);
  text-align: center;
}

@font-face {
  font-weight: 400;
  font-family: vant-icon;
  font-style: normal;
  font-display: auto;
  src: url(/assets/fonts/vant-icon-d3825a.woff2) format("woff2"),
       url(/assets/fonts/vant-icon-d3825a.woff) format("woff"),
       url(/assets/fonts/vant-icon-d3825a.ttf) format("truetype");
}
