/* competition/pages/admin/manageActivity/manageActivity.wxss */

.manage-activity-page {
  background: linear-gradient(180deg, #f7fdf9 0%, #f0f9f4 100%);
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* ========== 筛选栏样式 ========== */
.filter-bar {
  display: flex;
  background: white;
  padding: 20rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(76, 217, 100, 0.08);
}

.filter-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #7f8c8d;
  border-radius: 12rpx;
  transition: all 0.3s;
  margin: 0 8rpx;
}

.filter-item.active {
  background: #4cd964;
  color: white;
  font-weight: 600;
}

/* ========== 活动列表样式 ========== */
.activity-list {
  padding: 0 32rpx;
}

.activity-item {
  background: white;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 30rpx rgba(76, 217, 100, 0.08);
  border: 1rpx solid rgba(76, 217, 100, 0.1);
}

.activity-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #f0f9f4;
}

.activity-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #2c3e50;
  flex: 1;
}

.activity-status {
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.status-notStarted {
  background: #fff3cd;
  color: #856404;
}

.status-running {
  background: #d4edda;
  color: #155724;
}

.status-ended {
  background: #f8d7da;
  color: #721c24;
}

/* ========== 活动信息样式 ========== */
.activity-info {
  margin-bottom: 24rpx;
}

.info-row {
  display: flex;
  margin-bottom: 16rpx;
  font-size: 26rpx;
}

.info-label {
  color: #7f8c8d;
  min-width: 140rpx;
  font-weight: 500;
}

.info-value {
  color: #2c3e50;
  flex: 1;
}

/* ========== 操作按钮样式 ========== */
.activity-actions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid #f0f9f4;
}

.action-btn {
  padding: 20rpx 0;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  transition: all 0.3s;
}

.edit-btn {
  background: #4cd964;
  color: white;
}

.edit-btn:active {
  background: #3ab850;
  transform: scale(0.98);
}

.delete-btn {
  background: #ff6b6b;
  color: white;
}

.delete-btn:active {
  background: #ee5a5a;
  transform: scale(0.98);
}

/* ========== 状态控制区域样式 ========== */
.status-control-group {
  background: #f8fcf9;
  border-radius: 16rpx;
  padding: 24rpx;
  border: 2rpx solid #e8f5e9;
}

.current-status-display {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #e8f5e9;
}

.status-label {
  font-size: 26rpx;
  color: #7f8c8d;
  font-weight: 500;
  margin-right: 16rpx;
}

.status-value {
  font-size: 28rpx;
  font-weight: 700;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
}

.status-buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.status-switch-btn {
  flex: 1;
  min-width: 140rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  font-weight: 600;
  border: 2rpx solid #4cd964;
  background: white;
  color: #4cd964;
  transition: all 0.3s;
}

.status-switch-btn:active {
  transform: scale(0.95);
}

.status-switch-btn.active {
  background: #4cd964;
  color: white;
}

/* ========== 空状态样式 ========== */
.empty-state {
  text-align: center;
  padding: 120rpx 0;
}

.empty-text {
  font-size: 28rpx;
  color: #95a5a6;
}

/* ========== 加载状态样式 ========== */
.loading-state {
  text-align: center;
  padding: 60rpx 0;
  font-size: 28rpx;
  color: #95a5a6;
}

/* ========== 编辑弹窗样式 ========== */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 90%;
  max-width: 600rpx;
  max-height: 80vh;
  background: white;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 2rpx solid #f0f9f4;
}

.modal-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #2c3e50;
}

.modal-close {
  font-size: 48rpx;
  color: #95a5a6;
  line-height: 1;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-body {
  flex: 1;
  padding: 32rpx;
  max-height: 60vh;
}

.modal-footer {
  display: flex;
  gap: 16rpx;
  padding: 24rpx 32rpx;
  border-top: 2rpx solid #f0f9f4;
}

.modal-btn {
  flex: 1;
  padding: 24rpx 0;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
}

.cancel-btn {
  background: #ecf0f1;
  color: #7f8c8d;
}

.cancel-btn:active {
  background: #d5dbdb;
}

.confirm-btn {
  background: #4cd964;
  color: white;
}

.confirm-btn:active {
  background: #3ab850;
}

/* ========== 表单样式 ========== */
.form-item {
  margin-bottom: 32rpx;
}

.form-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #34495e;
  margin-bottom: 16rpx;
}

.form-input {
  border: 2rpx solid #e8f5e9;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 28rpx;
  background: #f8fcf9;
}

.form-textarea {
  border: 2rpx solid #e8f5e9;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 28rpx;
  background: #f8fcf9;
  min-height: 200rpx;
  width: 100%;
  box-sizing: border-box;
}

.picker-display {
  border: 2rpx solid #e8f5e9;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 28rpx;
  background: #f8fcf9;
  color: #2c3e50;
}

