/* competition/pages/admin/exportResults/exportResults.wxss */

.export-results-page {
  background: linear-gradient(180deg, #f7fdf9 0%, #f0f9f4 100%);
  min-height: 100vh;
  padding-bottom: 40rpx;
  display: flex;
  justify-content: center;
  align-items: flex-start;
}

.export-results-page .content {
  width: 100%;
  max-width: 750rpx;
  margin: 0 auto;
}

.content {
  height: calc(100vh - 88rpx);
  padding: 24rpx 32rpx;
}

/* ========== 卡片样式 ========== */
.card {
  background: white;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 30rpx rgba(76, 217, 100, 0.08);
}

.card-title {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #f0f9f4;
}

.title-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.title-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #2c3e50;
}

/* ========== 选择器样式 ========== */
.picker-view {
  padding: 24rpx;
  background: #f8fcf9;
  border-radius: 12rpx;
  border: 2rpx solid #e8f5e9;
}

.picker-label {
  font-size: 26rpx;
  color: #7f8c8d;
  margin-bottom: 12rpx;
  display: block;
}

.picker-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.picker-text {
  font-size: 28rpx;
  color: #2c3e50;
  font-weight: 500;
}

.picker-arrow {
  font-size: 24rpx;
  color: #95a5a6;
}

/* ========== 活动信息样式 ========== */
.activity-info {
  margin-top: 24rpx;
  padding: 20rpx;
  background: #f8fcf9;
  border-radius: 12rpx;
}

.info-row {
  display: flex;
  margin-bottom: 12rpx;
  font-size: 26rpx;
}

.info-row:last-child {
  margin-bottom: 0;
}

.info-label {
  color: #7f8c8d;
  min-width: 140rpx;
}

.info-value {
  color: #2c3e50;
  font-weight: 500;
}

/* ========== 导出说明样式 ========== */
.export-info {
  margin-top: 20rpx;
}

.info-item {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  padding: 16rpx;
  background: #f8fcf9;
  border-radius: 12rpx;
}

.info-item:last-child {
  margin-bottom: 0;
}

.item-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.item-text {
  font-size: 26rpx;
  color: #34495e;
  flex: 1;
}

/* ========== 导出按钮样式 ========== */
.export-section {
  margin: 32rpx 0;
}

.export-btn {
  width: 100%;
  height: 88rpx;
  border-radius: 24rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  background: linear-gradient(135deg, #4cd964 0%, #3db954 100%);
  color: white;
  box-shadow: 0 8rpx 20rpx rgba(76, 217, 100, 0.3);
}

.export-btn[disabled] {
  background: #ecf0f1;
  color: #95a5a6;
  box-shadow: none;
}

.export-btn:active:not([disabled]) {
  opacity: 0.8;
}

/* ========== 导出历史样式 ========== */
.history-list {
  margin-top: 20rpx;
}

.history-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  margin-bottom: 16rpx;
  background: #f8fcf9;
  border-radius: 12rpx;
  border-left: 4rpx solid #4cd964;
}

.history-item:last-child {
  margin-bottom: 0;
}

.history-info {
  flex: 1;
}

.history-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #2c3e50;
  margin-bottom: 8rpx;
}

.history-time {
  display: block;
  font-size: 24rpx;
  color: #7f8c8d;
}

.download-btn {
  background: #4cd964;
  color: white;
  border-radius: 12rpx;
  font-size: 24rpx;
  padding: 12rpx 24rpx;
}

/* ========== 加载状态样式 ========== */
.loading-state {
  text-align: center;
  padding: 120rpx 0;
  font-size: 28rpx;
  color: #95a5a6;
}

