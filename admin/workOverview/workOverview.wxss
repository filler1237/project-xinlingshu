/* pages/admin/judgeManagement/judgeManagement.wxss
 * 顶尖轻量UI | 柔和草绿 | 无半圆切割
-------------------------------------------------- */

page {
    background: linear-gradient(180deg, #FFFFF5 0%, #FFFFFF 100%);
    font-family: PingFang SC;
    padding-bottom: constant(safe-area-inset-bottom);
    padding-bottom: env(safe-area-inset-bottom);
}


/* 顶部导航区 */

.page-header {
    position: relative;
    padding: 64rpx 40rpx 48rpx;
    background: transparent;
}

.back-btn {
    position: absolute;
    left: 40rpx;
    top: calc(44px + 20rpx);
    /* 刘海安全区 + 额外 20rpx */
    padding: 12rpx 24rpx;
    font-size: 28rpx;
    font-weight: 500;
    color: #3F3F3F;
    background: rgba(255, 255, 255, .85);
    border-radius: 16rpx;
    box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, .06);
    backdrop-filter: blur(20rpx);
}

.header-title {
    font-size: 56rpx;
    font-weight: 700;
    color: #3F3F3F;
    letter-spacing: .5rpx;
}

.header-desc {
    font-size: 28rpx;
    color: #666;
    margin-top: 8rpx;
}


/* 统计卡片 */

.stats-grid {
    display: flex;
    margin: 24rpx 40rpx;
    background: rgba(255, 255, 255, .8);
    border-radius: 24rpx;
    padding: 32rpx 0;
    box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, .05);
    backdrop-filter: blur(20rpx);
}

.stat-item {
    flex: 1;
    text-align: center;
}

.stat-number {
    font-size: 40rpx;
    font-weight: 700;
    color: #3F3F3F;
}

.stat-label {
    font-size: 24rpx;
    color: #999;
    margin-top: 8rpx;
}


/* 活动选择器 */

.activity-selector {
    display: flex;
    align-items: center;
    margin: 24rpx 40rpx;
    padding: 28rpx 32rpx;
    background: rgba(255, 255, 255, .8);
    border-radius: 24rpx;
    box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, .05);
    backdrop-filter: blur(20rpx);
}

.selector-label {
    font-size: 28rpx;
    font-weight: 500;
    color: #3F3F3F;
    margin-right: 24rpx;
    white-space: nowrap;
}

.picker-display {
    flex: 1;
    padding: 20rpx;
    font-size: 28rpx;
    font-weight: 500;
    color: #3F3F3F;
    text-align: center;
    background: rgba(255, 255, 255, .6);
    border-radius: 16rpx;
    border: 1rpx solid rgba(0, 0, 0, .06);
}


/* 搜索 & 筛选 */

.filter-section {
    margin: 0 40rpx 24rpx;
}

.search-box {
    position: relative;
}

.search-input {
    width: 100%;
    padding: 24rpx 64rpx 24rpx 32rpx;
    font-size: 28rpx;
    color: #3F3F3F;
    background: rgba(255, 255, 255, .8);
    border-radius: 24rpx;
    box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, .05);
    backdrop-filter: blur(20rpx);
}

.search-placeholder {
    color: #9B9B9B;
}

.search-icon {
    position: absolute;
    right: 32rpx;
    top: 50%;
    transform: translateY(-50%);
    color: #7ED321;
    font-size: 28rpx;
}

.filter-tabs {
    display: flex;
    margin-top: 24rpx;
    background: rgba(255, 255, 255, .8);
    border-radius: 24rpx;
    padding: 8rpx;
    box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, .05);
    backdrop-filter: blur(20rpx);
}

.filter-tab {
    flex: 1;
    text-align: center;
    padding: 20rpx;
    font-size: 26rpx;
    font-weight: 500;
    color: #666;
    border-radius: 16rpx;
    transition: all .2s;
}

.filter-tab.active {
    background: #7ED321;
    color: #FFFFFF;
}


/* 已任命评委 */

.appointed-panel {
    margin: 0 40rpx 24rpx;
    padding: 32rpx;
    background: rgba(255, 255, 255, .8);
    border-radius: 24rpx;
    box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, .05);
    backdrop-filter: blur(20rpx);
}

.panel-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24rpx;
}

.panel-title {
    font-size: 32rpx;
    font-weight: 600;
    color: #3F3F3F;
}

.panel-count {
    font-size: 24rpx;
    color: #7ED321;
    background: rgba(126, 211, 33, .1);
    padding: 8rpx 16rpx;
    border-radius: 12rpx;
    font-weight: 500;
}

.judges-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 12rpx;
}

.judge-tag {
    display: flex;
    align-items: center;
    gap: 10rpx;
    padding: 16rpx 20rpx;
    background: rgba(255, 255, 255, .6);
    border: 1rpx solid rgba(0, 0, 0, .06);
    border-radius: 20rpx;
}

.judge-tag.chief {
    background: #FFF8E1;
    border-color: #FFD54F;
}

.judge-name {
    font-size: 26rpx;
    color: #3F3F3F;
    font-weight: 500;
}

.judge-role {
    font-size: 22rpx;
    color: #666;
    background: rgba(255, 255, 255, .8);
    padding: 4rpx 10rpx;
    border-radius: 10rpx;
}

.judge-tag.chief .judge-role {
    color: #E65100;
}

.remove-btn {
    width: 28rpx;
    height: 28rpx;
    border-radius: 50%;
    background: #F44336;
    color: #fff;
    font-size: 18rpx;
    font-weight: bold;
    display: flex;
    align-items: center;
    justify-content: center;
}


/* 老师卡片 */

.teacher-list {
    padding: 0 40rpx;
}

.teacher-card {
    margin-bottom: 24rpx;
    padding: 32rpx;
    background: rgba(255, 255, 255, .8);
    border-radius: 24rpx;
    box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, .05);
    backdrop-filter: blur(20rpx);
}

.teacher-header {
    display: flex;
    align-items: flex-start;
    margin-bottom: 24rpx;
    position: relative;
}

.avatar-section {
    position: relative;
    margin-right: 24rpx;
}

.teacher-avatar {
    width: 88rpx;
    height: 88rpx;
    border-radius: 50%;
    background: #7ED321;
    display: flex;
    align-items: center;
    justify-content: center;
}

.avatar-text {
    color: #fff;
    font-size: 30rpx;
    font-weight: 600;
}

.online-status {
    position: absolute;
    bottom: 6rpx;
    right: 6rpx;
    width: 16rpx;
    height: 16rpx;
    border-radius: 50%;
    border: 2rpx solid #fff;
}

.online-status.online {
    background: #4CAF50;
}

.online-status.offline {
    background: #9E9E9E;
}

.teacher-info {
    flex: 1;
}

.teacher-name {
    font-size: 32rpx;
    font-weight: 600;
    color: #3F3F3F;
    margin-bottom: 6rpx;
}

.teacher-id {
    font-size: 26rpx;
    color: #666;
    margin-bottom: 4rpx;
}

.teacher-department {
    font-size: 24rpx;
    color: #999;
}

.appointment-status {
    position: absolute;
    top: 0;
    right: 0;
    padding: 8rpx 14rpx;
    border-radius: 12rpx;
    font-size: 22rpx;
    font-weight: 500;
}

.appointment-status.available {
    background: #E8F5E9;
    color: #2E7D32;
}

.appointment-status.appointed {
    background: #E3F2FD;
    color: #1565C0;
}

.appointment-status.busy {
    background: #FFF3E0;
    color: #EF6C00;
}


/* 专业领域 */

.expertise-section {
    margin-bottom: 20rpx;
    padding: 20rpx;
    background: rgba(255, 255, 255, .6);
    border-radius: 16rpx;
}

.section-label {
    font-size: 26rpx;
    color: #555;
    font-weight: 500;
    margin-bottom: 12rpx;
    display: block;
}

.expertise-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 10rpx;
}

.expertise-tag {
    padding: 6rpx 12rpx;
    background: rgba(126, 211, 33, .1);
    color: #7ED321;
    border-radius: 12rpx;
    font-size: 22rpx;
    border: 1rpx solid rgba(126, 211, 33, .2);
}


/* 任命信息 */

.appointment-info {
    display: flex;
    align-items: center;
    gap: 12rpx;
    margin-bottom: 20rpx;
    padding: 16rpx;
    background: #FFF8E1;
    border-radius: 16rpx;
}

.info-label {
    font-size: 26rpx;
    color: #E65100;
    font-weight: 500;
}

.info-value {
    flex: 1;
    font-size: 26rpx;
    color: #E65100;
}

.info-role {
    padding: 4rpx 10rpx;
    border-radius: 8rpx;
    font-size: 20rpx;
    font-weight: 500;
}

.info-role.judge {
    background: #E3F2FD;
    color: #1565C0;
}

.info-role.chief {
    background: #FFF3E0;
    color: #E65100;
}


/* 操作按钮 */

.action-buttons {
    display: flex;
    gap: 12rpx;
    flex-wrap: wrap;
}

.action-btn {
    flex: 1;
    min-width: 150rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6rpx;
    padding: 18rpx 20rpx;
    border: none;
    border-radius: 16rpx;
    font-size: 24rpx;
    font-weight: 500;
    box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, .08);
}

.action-btn.appoint {
    background: #7ED321;
    color: #fff;
}

.action-btn.change-role {
    background: #FF9800;
    color: #fff;
}

.action-btn.remove {
    background: #F44336;
    color: #fff;
}

.action-btn.view {
    background: #2196F3;
    color: #fff;
}

.btn-icon {
    font-size: 20rpx;
}


/* 空状态 */

.empty-state {
    margin: 64rpx 40rpx;
    padding: 80rpx 40rpx;
    background: rgba(255, 255, 255, .8);
    border-radius: 24rpx;
    text-align: center;
    box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, .05);
    backdrop-filter: blur(20rpx);
}

.empty-icon {
    font-size: 80rpx;
    color: #3F3F3F;
    margin-bottom: 24rpx;
}

.empty-text {
    font-size: 32rpx;
    color: #3F3F3F;
    font-weight: 600;
    margin-bottom: 12rpx;
}

.empty-desc {
    font-size: 26rpx;
    color: #9B9B9B;
    margin-bottom: 40rpx;
}

.empty-btn {
    background: #7ED321;
    color: #fff;
    border-radius: 24rpx;
    padding: 24rpx 56rpx;
    font-size: 28rpx;
    font-weight: 500;
    box-shadow: 0 4rpx 12rpx rgba(126, 211, 33, .3);
}


/* 模态框（轻毛玻璃） */

.modal {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, .45);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2000;
    opacity: 0;
    visibility: hidden;
    transition: all .3s;
    padding: 40rpx;
}

.modal.show {
    opacity: 1;
    visibility: visible;
}

.modal-content {
    width: 100%;
    max-width: 90vw;
    background: rgba(255, 255, 255, .85);
    border-radius: 24rpx;
    box-shadow: 0 12rpx 36rpx rgba(0, 0, 0, .1);
    backdrop-filter: blur(20rpx);
    transform: translateY(40rpx);
    transition: all .3s;
}

.modal.show .modal-content {
    transform: translateY(0);
}

.modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 32rpx 40rpx 24rpx;
    border-bottom: 1rpx solid rgba(0, 0, 0, .06);
}

.modal-title {
    font-size: 32rpx;
    font-weight: 600;
    color: #3F3F3F;
}

.modal-close {
    font-size: 36rpx;
    color: #999;
    padding: 8rpx;
}

.modal-body {
    padding: 32rpx 40rpx 40rpx;
}


/* 角色选择 */

.selection-label {
    font-size: 28rpx;
    color: #555;
    font-weight: 500;
    margin-bottom: 20rpx;
}

.role-options {
    display: flex;
    flex-direction: column;
    gap: 16rpx;
}

.role-option {
    display: flex;
    align-items: center;
    padding: 28rpx;
    background: rgba(255, 255, 255, .6);
    border: 1rpx solid rgba(0, 0, 0, .06);
    border-radius: 16rpx;
}

.role-option.selected {
    border-color: #7ED321;
    background: rgba(126, 211, 33, .08);
}

.role-icon {
    font-size: 32rpx;
    margin-right: 16rpx;
}

.role-name {
    font-size: 28rpx;
    color: #3F3F3F;
    font-weight: 500;
    margin-right: 12rpx;
}

.role-desc {
    font-size: 24rpx;
    color: #666;
    flex: 1;
}


/* 老师详情 */

.profile-section {
    display: flex;
    flex-direction: column;
    gap: 28rpx;
}

.profile-header {
    display: flex;
    align-items: center;
    gap: 24rpx;
    padding-bottom: 24rpx;
    border-bottom: 1rpx solid rgba(0, 0, 0, .06);
}

.profile-avatar.large {
    width: 96rpx;
    height: 96rpx;
    border-radius: 50%;
    background: #7ED321;
    display: flex;
    align-items: center;
    justify-content: center;
}

.profile-avatar.large .avatar-text {
    font-size: 36rpx;
    color: #fff;
}

.profile-info {
    flex: 1;
}

.profile-name {
    font-size: 34rpx;
    font-weight: 700;
    color: #3F3F3F;
    margin-bottom: 6rpx;
}

.profile-id {
    font-size: 26rpx;
    color: #666;
    margin-bottom: 4rpx;
}

.profile-department {
    font-size: 24rpx;
    color: #999;
    margin-bottom: 8rpx;
}

.profile-status {
    padding: 6rpx 12rpx;
    border-radius: 8rpx;
    font-size: 22rpx;
    font-weight: 500;
    display: inline-block;
}

.profile-status.online {
    background: #E8F5E9;
    color: #2E7D32;
}

.profile-status.offline {
    background: #F5F5F5;
    color: #666;
}

.detail-group {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding: 20rpx 0;
    border-bottom: 1rpx solid rgba(0, 0, 0, .06);
}

.detail-label {
    font-size: 28rpx;
    color: #666;
    font-weight: 500;
    min-width: 140rpx;
}

.detail-value {
    font-size: 28rpx;
    color: #3F3F3F;
    font-weight: 500;
    flex: 1;
    text-align: right;
}

.detail-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8rpx;
    justify-content: flex-end;
}

.detail-tag {
    padding: 6rpx 12rpx;
    background: rgba(126, 211, 33, .1);
    color: #7ED321;
    border-radius: 12rpx;
    font-size: 22rpx;
    border: 1rpx solid rgba(126, 211, 33, .2);
}

.appointment-history {
    margin-top: 20rpx;
}

.section-title {
    font-size: 30rpx;
    font-weight: 600;
    color: #3F3F3F;
    margin-bottom: 20rpx;
    padding-bottom: 8rpx;
    border-bottom: 1rpx solid #7ED321;
}

.history-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20rpx 0;
    border-bottom: 1rpx solid rgba(0, 0, 0, .06);
}

.history-activity {
    font-size: 26rpx;
    color: #555;
    flex: 1;
}

.history-role {
    padding: 6rpx 12rpx;
    border-radius: 8rpx;
    font-size: 22rpx;
    font-weight: 500;
    margin: 0 12rpx;
}

.history-role.judge {
    background: #E3F2FD;
    color: #1565C0;
}

.history-role.chief {
    background: #FFF3E0;
    color: #E65100;
}

.history-time {
    font-size: 22rpx;
    color: #999;
}

.modal-footer {
    display: flex;
    padding: 24rpx 40rpx 32rpx;
    gap: 16rpx;
}

.modal-btn {
    flex: 1;
    padding: 24rpx;
    border: none;
    border-radius: 16rpx;
    font-size: 28rpx;
    font-weight: 500;
    box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, .08);
}

.modal-btn.cancel {
    background: #F5F5F5;
    color: #666;
}

.modal-btn.confirm {
    background: #7ED321;
    color: #fff;
}

.modal-btn.primary {
    background: #7ED321;
    color: #fff;
}