/* pages/sushuo/DA/DA.wxss */
.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #f5f5f5;
}

.title {
  color: #000000;
  font-family: PingFang SC;
  font-weight: medium;
  font-size: 32rpx;
  line-height: 1.5;
  letter-spacing: 0rpx;
  text-align: center;
  position: absolute;
  top: 4.5%;
  left: 43%;
}

.partone {
  margin-bottom: 10rpx;
  height: 56rpx;
  position: absolute;
  top: 4.5%;
  left: 0;
}

.partone .back {
  position: absolute;
  z-index: 2;
  height: 34rpx;
  left: 50rpx;
  top: 20rpx;
}

.chat-container {
  flex: 1;
  padding: 20rpx;
  margin-top: 15%; /* 调整以适应标题栏 */
  background-color: #ffffff;
  overflow-y: auto; /* 允许滚动 */
}

/* --- 新增：消息行的基础样式 --- */
.message-row {
  display: flex;
  align-items: flex-start; /* 头像和气泡顶部对齐 */
  margin-bottom: 30rpx;
}

/* --- 新增：用户消息行的样式 --- */
.user-row {
  justify-content: flex-end; /* 用户消息靠右 */
}

/* --- 新增：AI 消息行的样式 --- */
.ai-row {
  justify-content: flex-start; /* AI 消息靠左 */
}

/* --- 新增：头像样式 --- */
.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  flex-shrink: 0; /* 防止头像被压缩 */
}

/* --- 修改：消息气泡的基础样式 --- */
.message-bubble {
  max-width: 65%; /* 调整最大宽度以适应头像 */
  padding: 20rpx;
  border-radius: 20rpx;
  word-wrap: break-word;
}

/* --- 新增：用户气泡样式 --- */
.user-bubble {
  background-color: #96CE74;
  color: #ffffff;
  margin-left: 20rpx;
  border-top-right-radius: 0; /* 小三角效果 */
}

/* --- 新增：AI 气泡样式 --- */
.ai-bubble {
  background-color: #f0f0f0;
  color: #333333;
  margin-right: 20rpx;
  border-top-left-radius: 0; /* 小三角效果 */
}

.message-text {
  font-size: 28rpx;
  line-height: 1.5;
}

.input-bar {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background-color: #ffffff;
  box-shadow: 0 -2rpx 4rpx rgba(0, 0, 0, 0.1);
}

.input-box {
  flex: 1;
  height: 80rpx;
  padding: 0 20rpx;
  border: 2rpx solid #ddd;
  border-radius: 10rpx;
  font-size: 28rpx;
  margin-right: 10rpx;
}

.send-button {
  width: 100rpx;
  height: 80rpx;
  background-color: #96CE74;
  color: #ffffff;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

/* --- 新增：思考中动画 --- */
.typing-indicator {
  display: flex;
  align-items: center;
  padding: 10rpx 0;
}

.typing-indicator .dot {
  width: 16rpx;
  height: 16rpx;
  background-color: #999;
  border-radius: 50%;
  margin: 0 6rpx;
  animation: typing-blink 1.4s infinite both;
}

.typing-indicator .dot:nth-child(2) {
  animation-delay: 0.2s;
}

.typing-indicator .dot:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes typing-blink {
  0% {
    opacity: 0.2;
  }
  20% {
    opacity: 1;
  }
  100% {
    opacity: 0.2;
  }
}
