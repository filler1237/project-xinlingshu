/* pages/sushuo/DA/DA.wxss */

/* --- 全局样式 --- */
.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #F7F8FA; /* 更柔和的背景色 */
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
}

/* --- 顶部导航栏 --- */
.header {
  display: flex;
  align-items: center;
  justify-content: center; /* 标题居中 */
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  background-color: #FFFFFF;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.05);
  z-index: 100;
}

.back-button {
  position: absolute;
  left: 20rpx;
  /* top and height are set via inline styles in WXML */
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 20rpx;
}

.back-icon {
  width: 36rpx;
  height: 36rpx;
}

.title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333333;
}

/* --- 聊天容器 --- */
.chat-container {
  flex: 1;
  padding: 20rpx;
  padding-bottom: 40rpx; /* 增加底部内边距 */
  background-color: #F7F8FA;
  overflow-y: auto;
  /* padding-top 将由 WXML 内联样式动态设置 */
}

/* --- 消息行 --- */
.message-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 40rpx;
  width: 100%;
}

.ai-row {
  justify-content: flex-start;
}

.user-row {
  justify-content: flex-end;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

/* --- 消息气泡 --- */
.message-bubble {
  max-width: calc(100% - 180rpx); /* 调整宽度以留出更多空间 */
  padding: 24rpx;
  border-radius: 24rpx;
  word-wrap: break-word;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.ai-bubble {
  background-color: #FFFFFF;
  color: #333333;
  margin-left: 20rpx;
  border-top-left-radius: 4rpx; /* 调整圆角以形成气泡尖角 */
}

.user-bubble {
  background-image: linear-gradient(to right, #88d75f, #96CE74); /* 渐变色 */
  color: #ffffff;
  margin-right: 20rpx;
  border-top-right-radius: 4rpx;
}

.message-text {
  font-size: 30rpx;
  line-height: 1.6;
}

/* --- 输入栏 --- */
.input-bar {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background-color: #FFFFFF;
  box-shadow: 0 -2rpx 4rpx rgba(0, 0, 0, 0.05);
}

.input-box {
  flex: 1;
  height: 80rpx;
  padding: 0 30rpx;
  background-color: #F7F8FA;
  border-radius: 40rpx; /* 圆角输入框 */
  font-size: 28rpx;
  margin-right: 20rpx;
  border: none; /* 移除边框 */
}

.send-button {
  width: 80rpx;
  height: 80rpx;
  background-color: #96CE74;
  border-radius: 50%; /* 圆形按钮 */
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  border: none;
  box-shadow: 0 4rpx 12rpx rgba(150, 206, 116, 0.4);
}

.send-icon {
  width: 40rpx;
  height: 40rpx;
  background-image: url('/image/QingSu-con.png');
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
}

/* --- 思考中动画 --- */
.typing-indicator {
  display: flex;
  align-items: center;
  padding: 10rpx 0;
}

.typing-indicator .dot {
  width: 16rpx;
  height: 16rpx;
  background-color: #999;
  border-radius: 50%;
  margin: 0 6rpx;
  animation: typing-blink 1.4s infinite both;
}

.typing-indicator .dot:nth-child(2) {
  animation-delay: 0.2s;
}

.typing-indicator .dot:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes typing-blink {
  0% {
    opacity: 0.2;
  }
  20% {
    opacity: 1;
  }
  100% {
    opacity: 0.2;
  }
}
