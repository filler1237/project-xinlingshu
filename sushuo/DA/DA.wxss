/* pages/sushuo/DA/DA.wxss */
.page {
  /* 移除 flex，回归最原始的块级布局，避免高度计算干扰 */
  min-height: 100vh;
  background-color: #f4f4f4;
  position: relative;
}

/* --- 自定义导航栏 --- */
.header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-between; /* 两端对齐，中间标题 */
  background-color: #f4f4f4; /* 改为与页面背景一致的浅灰 */
  /* border-bottom: 1rpx solid #e0e0e0; 移除边框以实现沉浸式效果 */
  z-index: 100;
  padding: 0 10rpx; /* 增加一点内边距 */
  box-sizing: border-box;
}

.back-button {
  width: 80rpx; /* 固定宽度方便点击 */
  display: flex;
  align-items: center;
  justify-content: center;
}

.title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
  position: absolute; /* 绝对定位居中 */
  left: 50%;
  transform: translateX(-50%);
}

.header-menu-btn {
  width: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon, .topics-menu-icon {
  width: 48rpx;
  height: 48rpx;
}

/* --- 话题侧边栏 --- */
.topics-panel {
  position: fixed;
  top: 0;
  left: -70vw; /* 初始状态下隐藏在左侧 */
  width: 70vw;
  height: 100%;
  background-color: #ffffff;
  box-shadow: 4rpx 0 12rpx rgba(0, 0, 0, 0.1);
  z-index: 201;
  transition: left 0.3s ease-in-out;
  display: flex;
  flex-direction: column;
}

.topics-panel.open {
  left: 0; /* open 状态下显示 */
}

.panel-header {
  padding: 30rpx;
  border-bottom: 1rpx solid #eee;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.panel-title {
  font-size: 32rpx;
  font-weight: bold;
}

.new-topic-btn {
  padding: 10rpx 20rpx;
  background-color: #07c160;
  color: white;
  border-radius: 30rpx;
  font-size: 24rpx;
}

.topics-list {
  flex: 1;
  overflow-y: auto;
}

.topic-item {
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.topic-item.active {
  background-color: #eefaf4;
  color: #07c160;
}

.topic-name {
  flex: 1;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  font-size: 28rpx;
}

.delete-topic-btn {
  margin-left: 20rpx;
  padding: 8rpx 16rpx;
  background-color: #f56c6c;
  color: white;
  border-radius: 20rpx;
  font-size: 22rpx;
}

/* 遮罩层 */
.overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 200;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease-in-out;
}

.overlay.show {
  opacity: 1;
  pointer-events: auto;
}

/* --- 聊天区域 --- */
.chat-container {
  /* 绝杀修正：改用 fixed 定位，直接相对于屏幕视口，无视父级高度，彻底消除截断问题 */
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 0; /* 确保在输入框之下 */
  box-sizing: border-box;
  /* 
     内边距策略：
     Top: 留给 fixed header 的空间 (代码动态设置)
     Bottom: 这里不再设置 padding-bottom，而是改为在 scroll-view 内部添加占位 view
             这样兼容性更好，确保内容一定能被顶上去
  */ 
}

.message-row {
  display: flex;
  padding: 20rpx;
  align-items: flex-start;
}

.user-row {
  justify-content: flex-end;
}

.ai-row {
  justify-content: flex-start;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.user-row .avatar {
  margin-left: 20rpx;
}

.ai-row .avatar {
  margin-right: 20rpx;
}

/* 气泡通用样式 */
.message-bubble {
  max-width: 75%;
  padding: 22rpx 30rpx;
  border-radius: 16rpx;
  word-break: break-all;
  box-shadow: 0 2rpx 4rpx rgba(0,0,0,0.05);
  position: relative;
  font-size: 30rpx;
  line-height: 1.6;
}

/* 用户气泡 - 微信绿 */
.user-bubble {
  background-color: #95ec69; 
  color: #1a1a1a;
  border-top-right-radius: 4rpx; /* 非对称圆角 */
  margin-right: 16rpx;
}

/* AI 气泡 - 纯白 */
.ai-bubble {
  background-color: #ffffff;
  color: #1a1a1a;
  border-top-left-radius: 4rpx; /* 非对称圆角 */
  margin-left: 16rpx;
}

/* AI 思考中 - 优化动画容器 */
.typing-indicator {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 15rpx;
  min-width: 80rpx;
}

.dot {
  width: 14rpx;
  height: 14rpx;
  background-color: #999;
  border-radius: 50%;
  margin: 0 5rpx;
  animation: typing 1.4s infinite ease-in-out both;
}

.dot:nth-child(1) { animation-delay: -0.32s; }
.dot:nth-child(2) { animation-delay: -0.16s; }
.dot:nth-child(3) { animation-delay: 0s; }

@keyframes typing {
  0%, 80%, 100% { 
    transform: scale(0.6);
    opacity: 0.6;
  }
  40% { 
    transform: scale(1);
    opacity: 1;
  }
}

/* --- 输入栏 --- */
.input-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  padding: 24rpx 30rpx;
  background-color: #f7f7f7; /* 稍浅一点 */
  border-top: 1rpx solid #ebebeb;
  box-shadow: 0 -2rpx 10rpx rgba(0,0,0,0.03); /* 上阴影 */
  z-index: 100;
  padding-bottom: calc(24rpx + constant(safe-area-inset-bottom)); /* 适配 iPhone X */
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.input-box {
  flex: 1;
  height: 80rpx;
  background-color: #fff;
  border-radius: 40rpx;
  padding: 0 30rpx;
  font-size: 30rpx;
}

.send-button {
  margin-left: 20rpx;
  width: 120rpx;
  height: 80rpx;
  background-color: #07c160;
  color: #fff;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.send-text {
  font-size: 30rpx;
  font-weight: bold;
}

.chat-image {
  max-width: 400rpx; /* 图片最大宽度 */
  border-radius: 18rpx; /* 图片圆角，和气泡保持一致 */
  display: block; /* 解决图片下方空隙问题 */
}