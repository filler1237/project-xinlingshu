/* pages/sushuo/DA/DA.wxss */
.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #f4f4f4;
  position: relative;
  overflow: hidden; /* 防止页面滚动 */
}

/* --- 自定义导航栏 --- */
.header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: center; /* 标题居中 */
  background-color: #ffffff;
  border-bottom: 1rpx solid #e0e0e0;
  z-index: 100;
}

.back-button {
  position: absolute;
  left: 20rpx;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 20rpx;
}

.back-icon {
  width: 40rpx;
  height: 40rpx;
}

.title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}

/* --- 话题菜单按钮 (修改为悬浮按钮) --- */
.topics-menu-button {
  position: fixed; /* 使用 fixed 定位 */
  right: 30rpx; /* 改为距离右边 30rpx */
  width: 90rpx;
  height: 90rpx;
  background-color: #ffffff;
  border-radius: 50%; /* 圆形 */
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15); /* 添加阴影 */
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 101; /* 确保在聊天内容之上 */
}

.topics-menu-icon {
  width: 48rpx;
  height: 48rpx;
}

/* --- 话题侧边栏 --- */
.topics-panel {
  position: fixed;
  top: 0;
  left: -70vw; /* 初始状态下隐藏在左侧 */
  width: 70vw;
  height: 100%;
  background-color: #ffffff;
  box-shadow: 4rpx 0 12rpx rgba(0, 0, 0, 0.1);
  z-index: 201;
  transition: left 0.3s ease-in-out;
  display: flex;
  flex-direction: column;
}

.topics-panel.open {
  left: 0; /* open 状态下显示 */
}

.panel-header {
  padding: 30rpx;
  border-bottom: 1rpx solid #eee;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.panel-title {
  font-size: 32rpx;
  font-weight: bold;
}

.new-topic-btn {
  padding: 10rpx 20rpx;
  background-color: #07c160;
  color: white;
  border-radius: 30rpx;
  font-size: 24rpx;
}

.topics-list {
  flex: 1;
  overflow-y: auto;
}

.topic-item {
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.topic-item.active {
  background-color: #eefaf4;
  color: #07c160;
}

.topic-name {
  flex: 1;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  font-size: 28rpx;
}

.delete-topic-btn {
  margin-left: 20rpx;
  padding: 8rpx 16rpx;
  background-color: #f56c6c;
  color: white;
  border-radius: 20rpx;
  font-size: 22rpx;
}

/* 遮罩层 */
.overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 200;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease-in-out;
}

.overlay.show {
  opacity: 1;
  pointer-events: auto;
}

/* --- 聊天区域 --- */
.chat-container {
  flex: 1;
  padding-bottom: 120rpx; /* 为输入框留出空间 */
  box-sizing: border-box;
  width: 100%;
}

.message-row {
  display: flex;
  padding: 20rpx;
  align-items: flex-start;
}

.user-row {
  justify-content: flex-end;
}

.ai-row {
  justify-content: flex-start;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.user-row .avatar {
  margin-left: 20rpx;
}

.ai-row .avatar {
  margin-right: 20rpx;
}

.message-bubble {
  max-width: 70%;
  padding: 20rpx;
  border-radius: 20rpx;
  word-break: break-all;
}

.user-bubble {
  background-color: #95ec69;
  color: #333;
}

.ai-bubble {
  background-color: #ffffff;
  color: #333;
}

.message-text {
  font-size: 30rpx;
  line-height: 1.5;
}

/* AI 思考中 */
.typing-indicator {
  display: flex;
  align-items: center;
  padding: 10rpx 0;
}

.dot {
  width: 16rpx;
  height: 16rpx;
  background-color: #aaa;
  border-radius: 50%;
  margin: 0 6rpx;
  animation: typing 1.2s infinite ease-in-out;
}

.dot:nth-child(2) {
  animation-delay: 0.2s;
}

.dot:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes typing {
  0%, 80%, 100% {
    transform: scale(0);
  }
  40% {
    transform: scale(1.0);
  }
}

/* --- 输入栏 --- */
.input-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  padding: 20rpx;
  background-color: #f8f8f8;
  border-top: 1rpx solid #e0e0e0;
}

.input-box {
  flex: 1;
  height: 80rpx;
  background-color: #fff;
  border-radius: 40rpx;
  padding: 0 30rpx;
  font-size: 30rpx;
}

.send-button {
  margin-left: 20rpx;
  width: 120rpx;
  height: 80rpx;
  background-color: #07c160;
  color: #fff;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.send-text {
  font-size: 30rpx;
  font-weight: bold;
}
