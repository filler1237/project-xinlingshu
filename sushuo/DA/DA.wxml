<view class="page">
  <!-- 自定义导航栏 -->
  <view class="header" style="padding-top: {{statusBarHeight}}px; height: {{headerHeight}}px;">
    <view class="back-button" bindtap="onBackTap" style="height: {{headerHeight}}px;">
      <image class="back-icon" src="cloud://cloud1-2gxal8as6b6bfe21.636c-cloud1-2gxal8as6b6bfe21-1378381651/image/back.svg"></image>
    </view>
    <view class="title">倾谈</view>
  </view>

  <!-- 移出并修改：话题菜单按钮，使其悬浮在左上角下方 -->
  <view class="topics-menu-button" bindtap="toggleTopicsPanel" style="top: calc({{statusBarHeight + headerHeight}}px + 30rpx);">
    <image class="topics-menu-icon" src="data:image/svg+xml;base64,"></image>
  </view>

  <!-- 新增：话题列表面板 (添加 statusBarHeight 内边距) -->
  <view class="topics-panel {{isTopicsPanelOpen ? 'open' : ''}}" style="padding-top: {{statusBarHeight}}px;">
    <view class="panel-header">
      <text class="panel-title">对话话题</text>
      <view class="new-topic-btn" bindtap="createNewTopic">+ 新建话题</view>
    </view>
    <scroll-view scroll-y="true" class="topics-list">
      <!-- 修复：将 topicId 相关的字段全部修正为 _id -->
      <view 
        wx:for="{{topics}}" 
        wx:key="_id" 
        class="topic-item {{item._id === currentTopicId ? 'active' : ''}}"
        bindtap="switchTopic"
        data-topic-id="{{item._id}}"
      >
        <text class="topic-name">{{item.name}}</text>
        <view class="delete-topic-btn" catchtap="deleteTopic" data-topic-id="{{item._id}}">删除</view>
      </view>
    </scroll-view>
  </view>
  <!-- 遮罩层 -->
  <view class="overlay {{isTopicsPanelOpen ? 'show' : ''}}" bindtap="toggleTopicsPanel"></view>

  <!-- 聊天内容区域 -->
  <scroll-view 
    class="chat-container" 
    scroll-y="true" 
    scroll-into-view="{{'msg-' + (content.length - 1)}}" 
    scroll-with-animation="true"
    style="padding-top: {{statusBarHeight + headerHeight}}px;"
  >
    <block wx:for="{{content}}" wx:key="index">
      <!-- 每条消息的容器 -->
      <view id="{{'msg-' + index}}" class="message-row {{item.isUser ? 'user-row' : 'ai-row'}}">
        <!-- AI 头像 -->
        <image wx:if="{{!item.isUser}}" class="avatar" src="{{aiAvatarUrl}}"></image>
        
        <!-- 消息气泡 -->
                <!-- 消息气泡 -->
        <view class="message-bubble {{item.isUser ? 'user-bubble' : 'ai-bubble'}}">
          <!-- 使用 wx:if 来根据消息类型渲染不同内容 -->
          
          <!-- 如果是文本类型 (或为了兼容老数据，没有type属性) -->
          <text wx:if="{{item.type === 'text' || !item.type}}" class="message-text">{{item.text}}</text>
          
          <!-- 如果是图片类型 -->
          <image wx:elif="{{item.type === 'image'}}" 
                 src="{{item.imageUrl}}" 
                 class="chat-image" 
                 mode="widthFix" 
                 bindtap="previewImage" 
                 data-src="{{item.imageUrl}}"></image>
        </view>


        <!-- 用户头像 -->
        <image wx:if="{{item.isUser}}" class="avatar" src="{{userAvatarUrl}}"></image>
      </view>
    </block>

    <!-- AI 思考中状态 -->
    <view wx:if="{{isSending}}" class="message-row ai-row">
      <image class="avatar" src="{{aiAvatarUrl}}"></image>
      <view class="message-bubble ai-bubble">
        <view class="typing-indicator">
          <view class="dot"></view>
          <view class="dot"></view>
          <view class="dot"></view>
        </view>
      </view>
    </view>
  </scroll-view>

  <!-- 输入栏 -->
  <view class="input-bar">
    <input class="input-box" placeholder="请输入内容..." value="{{inputText}}" bindinput="inputChange" confirm-type="send" bindconfirm="sendMessage"/>
    <view class="send-button" bindtap="sendMessage">
      <!-- 修复：直接使用 text 并调整样式，确保“发送”二字完整显示 -->
      <text class="send-text">发送</text>
    </view>
  </view>
</view>
