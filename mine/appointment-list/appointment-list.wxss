/* mine/appointment-list/appointment-list.wxss */
page {
  background-color: #f7f8fa;
  min-height: 100vh;
}

.page-container {
  padding: 24rpx;
  padding-top: 40rpx; /* 增加顶部间距防止遮挡 */
  padding-bottom: 40rpx;
}

/* 顶部统计条 - 新增 */
.header-count-bar {
  display: flex;
  justify-content: flex-end;
  margin-bottom: 20rpx;
}
.header-count-text {
  font-size: 26rpx;
  color: #666;
  background: rgba(0, 0, 0, 0.05);
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}


/* 顶部统计 - 旧样式保留备用或删除 */
.header-stats {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  padding: 0 8rpx;
}

.header-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.header-count {
  font-size: 26rpx;
  color: #666;
  background: rgba(255, 255, 255, 0.6);
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

/* 时间分组标题 */
.date-group-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #444;
  margin: 32rpx 0 16rpx 8rpx;
  display: flex;
  align-items: center;
}

.date-group-title::before {
  content: '';
  display: inline-block;
  width: 8rpx;
  height: 28rpx;
  background: #34D399; /* 主题绿 */
  margin-right: 12rpx;
  border-radius: 4rpx;
}

/* 预约卡片 */
.appointment-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.03);
  position: relative;
  overflow: hidden;
}

.card-time-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx dashed #f0f0f0;
}

.time-badge {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  font-family: 'DIN Alternate', sans-serif; /* 尝试使用数字字体 */
}

.status-badge {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: #e6f7ff;
  color: #1890ff;
}

.status-badge.expired {
  background: #f5f5f5;
  color: #999;
}

.card-content {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.info-row {
  display: flex;
  align-items: flex-start;
  font-size: 26rpx;
}

.info-label {
  color: #888;
  width: 120rpx;
  flex-shrink: 0;
}

.info-value {
  color: #333;
  flex: 1;
  line-height: 1.4;
}

.info-detail {
  color: #555;
  background: #f9f9f9;
  padding: 12rpx;
  border-radius: 8rpx;
  margin-top: 8rpx;
  font-size: 26rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 120rpx;
}

.empty-image {
  width: 240rpx;
  height: 240rpx;
  margin-bottom: 24rpx;
  opacity: 0.6;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}