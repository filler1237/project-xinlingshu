<!--pages/mine/record/record.wxml-->
<navigation-bar title='{{title}}'></navigation-bar>


<view class="max">
  <block wx:for="{{RECORD}}" wx:key="index">
    <view class="recordbox" style="background-color: {{item.backgroundColor}};">
      <view class="imgbox">
        <image class="img" src="{{item.imgSrc}}" mode="aspectFill"/>
      </view>
      <view class="textbox">
        <text style="font-size: 25rpx;">{{item.date}}</text>
        <text style="font-size: 40rpx;">{{item.title}}</text>
        <text style="font-size: 30rpx;">{{item.result}}</text>
      </view>
    </view>
  </block>
</view>
