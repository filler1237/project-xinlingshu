/* pages/mine/record/record.wxss */
page{
  background: linear-gradient(180deg, #FFFFF5 0%, #FFFFFF 100%);
}
.title{
  color: #000000;
  font-family: PingFang SC;
  font-weight: medium;
  font-size: 32rpx;
  line-height: 1.5;
  letter-spacing: 0rpx;
  text-align: center;
  position: absolute;
  top: 4.5%;
  left: 39%  ;
}
.partone{
  margin-bottom: 10rpx;
  height: 56rpx;
  position: absolute;
  top:4.5%;
  left: 0;
}
.partone .back {
  position: absolute;
  z-index:2;
  height: 34rpx;
  left: 50rpx;
  top:20rpx;
}
.up{
  position: fixed;
  left: 0;
  bottom: -5rpx;
  height: 292rpx;
}
.down{
  position:fixed;
  left: 0;
  bottom: -5rpx;
  height: 130rpx;
}
.girl{
  position: fixed;
  left: 426rpx;
  bottom: 35rpx;
  height: 212rpx;
}

.page{
  margin-top: 20%;
}

.max{
  display: flex;
  flex-direction: column;
  align-items: center;
}

.recordbox{
  height: 200rpx;
  width: 720rpx;
  display: flex;
  flex-direction: row;
  border-radius: 15rpx;
  margin: 10rpx;
}

.imgbox{
  height: 180rpx; 
  width: 180rpx;
  margin: 10rpx;
}
.img{
  height: 100%;
  width: 100%;
  border-radius: 15%;
}

.textbox{
  height: 180rpx;
  width: 500rpx;
  display: flex;
  flex-direction: column;
}