/* mine/record/record.wxss */
page {
  background-color: #f9f9f9; /* 柔和的背景色 */
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
}

.container {
  padding: 0; /* 移除容器的 padding */
  box-sizing: border-box;
}

/* 模块通用样式 */
.section {
  width: 100%; /* 占满横向空间 */
  padding: 30rpx; /* 使用 padding 控制内容间距 */
  margin-bottom: 20rpx; /* 调整模块间距 */
  box-sizing: border-box;
}

.section:last-child {
  margin-bottom: 0;
}

.section-title {
  font-size: 40rpx; /* 增大标题字号 */
  font-weight: bold; /* 加粗标题 */
  color: #333;
  margin-bottom: 30rpx;
  padding-left: 12rpx;
  border-left: 8rpx solid #8a96ff; /* 柔和的品牌色 */
  line-height: 1.2;
}

/* 记录卡片样式 */
.record-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx; /* 使用 gap 控制卡片间距 */
}

.record-card {
  background-color: #ffffff;
  border-radius: 20rpx; /* 更大的圆角 */
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.08); /* 更柔和的阴影 */
  padding: 30rpx;
  transition: all 0.3s ease; /* 更平滑的过渡 */
}

.record-card:active {
  transform: translateY(2rpx) scale(0.99);
  box-shadow: 0 5rpx 15rpx rgba(0, 0, 0, 0.1);
}

.card-title {
  font-size: 34rpx; /* 增大字号 */
  color: #333;
  font-weight: 600; /* 加粗 */
  margin-bottom: 15rpx;
  line-height: 1.4;
  /* 溢出处理 */
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.card-date {
  font-size: 26rpx;
  color: #aaa;
}

/* 展开/折叠按钮 */
.collapse-toggle {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 25rpx 0;
  font-size: 28rpx;
  color: #888;
  background-color: transparent; /* 透明背景 */
  border-radius: 16rpx;
  margin-top: 20rpx;
  transition: background-color 0.3s ease;
}

.collapse-toggle:hover {
  background-color: #f0f0f0;
}

.arrow-icon {
  width: 28rpx;
  height: 28rpx;
  margin-left: 15rpx;
  transition: transform 0.3s ease;
}

.arrow-icon.up {
  transform: rotate(180deg);
}

/* 空状态样式 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 80rpx 40rpx;
  text-align: center;
  color: #999;
  font-size: 30rpx;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.05);
}

.empty-tip {
  margin-top: 20rpx;
  color: #bbb;
  font-size: 26rpx;
}

/* 加载状态 */
.loading-state {
  text-align: center;
  padding: 100rpx 0;
  color: #aaa;
  font-size: 28rpx;
}
