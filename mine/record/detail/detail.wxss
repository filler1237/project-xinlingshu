/* mine/record/detail/detail.wxss */
page {
  background-color: #f5f5f5;
}

.container {
  padding: 30rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif;
}

/* 统一的区块样式 - 确保宽度完全一致 */
.question-section,
.cards-display-section,
.tarot-section,
.hexagram-section,
.hexagram-display {
  width: 100%;
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-sizing: border-box;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.section-title {
  font-size: 34rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  display: block;
  color: #333;
}

.question-text {
  font-size: 30rpx;
  color: #555;
  line-height: 1.6;
}

.analysis-text {
  font-size: 30rpx;
  color: #555;
  line-height: 1.8;
  white-space: pre-wrap;
}

.loading-state {
  text-align: center;
  padding-top: 100rpx;
  color: #999;
}

/* 卦象展示 */
.hexagram-display {
  display: flex;
  justify-content: center;
  align-items: center;
}

.hexagram-item {
  text-align: center;
}

.hexagram-label {
  font-size: 26rpx;
  color: #888;
}

.hexagram-name {
  font-size: 44rpx;
  font-weight: bold;
  color: #333;
  margin: 10rpx 0;
}

.hexagram-constitution {
  font-size: 26rpx;
  color: #666;
}

.arrow {
  font-size: 44rpx;
  margin: 0 40rpx;
  color: #888;
}

/* 塔罗牌展示 */
.cards-container {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 20rpx 0;
}

.card-image-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 30%;
}

.tarot-card-image {
  width: 100%;
  border-radius: 10rpx;
  margin-bottom: 15rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.card-name {
  font-size: 24rpx;
  text-align: center;
  color: #666;
  line-height: 1.4;
}
