.page-container {
  min-height: 100vh;
  background-color: #f7f8fa;
  padding: 0 32rpx 32rpx 32rpx; /* top padding 将由行内样式动态计算 */
  box-sizing: border-box;
}

/* 自定义导航栏 */
.nav-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  background-color: #f7f8fa; /* 和页面背景色一致 */
  z-index: 100;
  padding: 0 10rpx;
  box-sizing: border-box;
}

.back-button {
  width: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  width: 48rpx;
  height: 48rpx;
}

.header {
  text-align: center;
  margin-top: 8rpx;
  margin-bottom: 40rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.subtitle {
  display: block;
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #999;
}


/* 内容卡片 */
.content-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 40rpx 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.05);
}

.paragraph {
  display: block;
  font-size: 28rpx;
  line-height: 48rpx;
  color: #444;
  margin-bottom: 28rpx;
}

.paragraph.ending {
  margin-bottom: 40rpx;
}

/* 签名 */
.signature {
  text-align: right;
  font-size: 26rpx;
  color: #666;
}
