.page-container {
  min-height: 100vh;
  background-color: #f7f8fa;
  padding: 32rpx;
  box-sizing: border-box;
}

.header {
  text-align: center;
  margin-top: 8rpx;
  margin-bottom: 40rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.subtitle {
  display: block;
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #999;
}


/* 内容卡片 */
.content-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 40rpx 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.05);
}

.paragraph {
  display: block;
  font-size: 28rpx;
  line-height: 48rpx;
  color: #444;
  margin-bottom: 28rpx;
}

.paragraph.ending {
  margin-bottom: 40rpx;
}

/* 签名 */
.signature {
  text-align: right;
  font-size: 26rpx;
  color: #666;
}
