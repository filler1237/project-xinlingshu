<wxs src="../../utils/format.wxs" module="formatter" />

<view class='partone' style="width:82rpx" bindtap='onBackTap'>
    <image class='back' src='cloud://cloud1-2gxal8as6b6bfe21.636c-cloud1-2gxal8as6b6bfe21-1378381651/image/back.svg' style="width: 18rpx;"></image>
</view>
<view class="title">预约记录</view>
<view class="bottom">
  <image class="down"src="cloud://cloud1-2gxal8as6b6bfe21.636c-cloud1-2gxal8as6b6bfe21-1378381651/image/up.png" style="width: 100%;"/>
  <image class="up" src="cloud://cloud1-2gxal8as6b6bfe21.636c-cloud1-2gxal8as6b6bfe21-1378381651/image/down.png" style="width: 100%;"/>
  <image class="girl"src="cloud://cloud1-2gxal8as6b6bfe21.636c-cloud1-2gxal8as6b6bfe21-1378381651/image/girl.png" style="width: 200rpx;"/>
</view>

<view class="page">
<view hidden="{{booklist}}" class="notBook">
  还没有预约哦QAQ
</view>
<view class="max">
  <view wx:for="{{ Appointments }}" wx:key="_id" class="bookbox" style="{{ item.status === '已结束' ? 'background-color: #ccdcb4' : 'background-color: #98b86a' }}">
    <view class="timetable">
      <view class="datasize">{{ item.date }}  {{ formatter.formatHour(item.startTime) }}-{{ formatter.formatHour(item.endTime) }}</view>
      <view class="{{ item.status === '已结束' ? 'state2' : 'state1' }}">{{ item.status }}</view>
    </view>
    <view class="teacher">{{ item.teacher }}老师</view>

    <view class="button-container">
      <button
        wx:if="{{item.status === '进行中'}}"
        class="cancel-btn"
        data-id="{{item._id}}"
        data-availabilityid="{{item.availabilityId}}"
        data-timeslotindex="{{item.timeSlotIndex}}"
        bindtap="cancel">
        取消预约
      </button>
      <button
        wx:if="{{item.status === '进行中'}}"
        class="qrcode-btn"
        data-id="{{item._id}}"
        bindtap="showQrCode">
        显示二维码
      </button>
      <button
        wx:if="{{item.status === '已结束'}}"
        class="cancel-btn"
        data-id="{{item._id}}"
        bindtap="deleteAppointment">
        删除记录
      </button>
    </view>
    <view class="spacer"></view>
  </view>
</view>
</view>

<!-- QR Code Modal has been moved to a new page -->
