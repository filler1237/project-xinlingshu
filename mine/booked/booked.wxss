/* pages/mine/booked/booked.wxss */
page{
  background: linear-gradient(180deg, #FFFFF5 0%, #FFFFFF 100%);
}
.title{
  color: #000000;
  font-family: PingFang SC;
  font-weight: medium;
  font-size: 32rpx;
  line-height: 1.5;
  letter-spacing: 0rpx;
  text-align: center;
  position: absolute;
  top: 4.5%;
  left: 39%  ;
}
.partone{
  margin-bottom: 10rpx;
  height: 56rpx;
  position: absolute;
  top:4.5%;
  left: 0;
}
.partone .back {
  position: absolute;
  z-index:2;
  height: 34rpx;
  left: 50rpx;
  top:20rpx;
}
.up{
  position: fixed;
  left: 0;
  bottom: -5rpx;
  height: 292rpx;
}
.down{
  position:fixed;
  left: 0;
  bottom: -5rpx;
  height: 130rpx;
}
.girl{
  position: fixed;
  left: 426rpx;
  bottom: 35rpx;
  height: 212rpx;
}

.page{
  margin-top: 20%;
}

.max{
  display: flex;
  flex-direction: column;
  align-items: center;
}

.bookbox {
  height: auto;
  width: 720rpx;
  display: flex;
  flex-direction: column;
  border-radius: 15rpx;
  margin: 10rpx;
  align-items: center;
  overflow: hidden; /* 避免内容溢出 */
}

.bookbox.active {
  background-color: #98b86a; /* 进行中的背景颜色 */
}

.bookbox.inactive {
  background-color: #ccdcb4; /* 已结束的背景颜色 */
}
.spacer {
  height: 20rpx; /* 设置占位符的高度为10rpx */
}
.timetable{
  width :700rpx;
  display: flex;
  flex-direction: row;
  justify-content: space-between;
}

.datasize{
  font-size: 40rpx;
  margin: 20rpx;
}

.state1{
  font-size: 30rpx;
  margin: 20rpx;
  color: green;
}

.state2{
  font-size: 30rpx;
  margin: 20rpx;
  color: red;
}

.teacher{
  font-size: 35rpx;
}

.detail{
  margin: 10rpx;
}
.notBook{
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  margin-top: 70%;
  background-color: #98b86a;
  height: 20%;
  font-size:50rpx;
}