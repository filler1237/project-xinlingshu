/* pages/mine/list/list.wxss */
page{
  background: linear-gradient(180deg, #FFFFF5 0%, #FFFFFF 100%);
}
.title{
  color: #000000;
  font-family: PingFang SC;
  font-weight: medium;
  font-size: 32rpx;
  line-height: 1.5;
  letter-spacing: 0rpx;
  text-align: center;
  position: absolute;
  top: 4.5%;
  left: 39%  ;
}
.partone{
  margin-bottom: 10rpx;
  height: 56rpx;
  position: absolute;
  top:4.5%;
  left: 0;
}
.partone .back {
  position: absolute;
  z-index:2;
  height: 34rpx;
  left: 50rpx;
  top:20rpx;
}
.up{
  position: fixed;
  left: 0;
  bottom: -5rpx;
  height: 292rpx;
  z-index: -2;
}
.down{
  position:fixed;
  left: 0;
  bottom: -5rpx;
  height: 130rpx;
  z-index: -1;
}
.girl{
  position: fixed;
  left: 426rpx;
  bottom: 35rpx;
  height: 212rpx;
  z-index: -1;
}

.page{
  margin-top: 30%;
}


.order-wrap {
  display: flex;
  margin: 15rpx;
  height: 330rpx;
  width: 720rpx;
  border: 1rpx solid #804d4d;
  border-radius: 15rpx;
  box-shadow: 1rpx 1rpx 15rpx rgb(77, 75, 75);
  margin-bottom: 30rpx;
}

.picture {
  display: flex;
  justify-content: center;
  align-items: center;
  margin: 15rpx;
}

.picture image {
  width: 200rpx;
  height: 200rpx;
}

.info {
  display: flex;
  flex-direction: column;
  margin-left: 15rpx;
  margin-top: 15rpx;
}

.title2 {
  font-weight: bold;
  margin-bottom: 10rpx;
}

.text {
  margin-bottom: 5rpx;
}