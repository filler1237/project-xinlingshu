/* 页面容器：保持清爽的背景 */
.page-container {
  padding: 30rpx; /* 增加边距 */
  background-color: #f7f8fa; /* 极淡的灰背景，提升质感 */
  min-height: 100vh;
  box-sizing: border-box;
}

/* 时间范围选择器：胶囊风格 */
.time-range-selector {
  display: flex;
  justify-content: space-between;
  margin-bottom: 40rpx;
  background-color: #ffffff;
  border-radius: 100rpx; /* 大圆角 */
  padding: 8rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.03);
}

.time-range-button {
  flex: 1;
  padding: 16rpx 0;
  border-radius: 100rpx;
  font-size: 28rpx;
  color: #888;
  background-color: transparent;
  border: none;
  text-align: center;
  margin: 0;
  transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1); /* 平滑过渡 */
  font-weight: 500;
}

.time-range-button.active {
  background-color: #409eff; /* 主题色 */
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(64, 158, 255, 0.3); /* 柔和阴影 */
  transform: scale(1.02); /* 微微放大 */
}

/* 图表容器：卡片化 */
.chart-container {
  width: 100%;
  height: 640rpx; /* 稍微增加高度 */
  margin-bottom: 40rpx;
  background-color: #fff;
  border-radius: 24rpx;
  padding: 20rpx 0; /* 内边距 */
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.04); /* 更有层次感的阴影 */
  display: flex;
  justify-content: center;
  align-items: center;
  overflow: hidden; /* 防止溢出 */
}

.ec-canvas {
  width: 100%;
  height: 100%;
}

/* 数据摘要容器 */
.summary-container {
  background-color: #fff;
  padding: 32rpx;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.04);
}

/* 标题区 */
.summary-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.summary-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1f2937; /* 深灰黑 */
  letter-spacing: 1rpx;
}

/* 返回按钮：精致的胶囊 */
.drill-back {
  font-size: 24rpx;
  color: #409eff;
  background-color: #ecf5ff;
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  transition: all 0.2s;
  display: flex;
  align-items: center;
}

.drill-back:active {
  background-color: #d9ecff;
}

/* 关键指标网格 */
.indicators-grid {
  display: flex;
  gap: 24rpx; /* 卡片间距 */
  margin-bottom: 32rpx;
}

.indicator-card {
  flex: 1;
  background-color: #f9fafb; /* 极浅灰底色 */
  border-radius: 16rpx;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  border: 1rpx solid #f3f4f6;
}

.card-label {
  font-size: 26rpx;
  color: #6b7280;
  margin-bottom: 12rpx;
}

.card-value-group {
  display: flex;
  align-items: baseline;
}

.card-value {
  font-size: 44rpx;
  font-weight: 700;
  color: #111827;
  line-height: 1;
}

.card-unit {
  font-size: 24rpx;
  color: #9ca3af;
  margin-left: 8rpx;
}

/* 情绪文字颜色变体 */
.emotion-text {
    font-size: 40rpx; /* 稍微大一点 */
}
.text-positive { color: #34D399; }
.text-neutral { color: #60A5FA; }
.text-negative { color: #F87171; }

/* 专业建议盒子 */
.suggestion-box {
  background-color: #eff6ff; /* 浅蓝色背景强调 */
  border-radius: 16rpx;
  padding: 24rpx;
  border-left: 8rpx solid #409eff; /* 左侧装饰线 */
}

.suggestion-header {
  margin-bottom: 12rpx;
}

.suggestion-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #1e3a8a; /* 深蓝标题 */
}

.suggestion-content {
  font-size: 28rpx;
  color: #374151;
  line-height: 1.6;
  text-align: justify;
}
