.page-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 100vh;
  background-color: #f7f8fa;
  padding: 20rpx;
  box-sizing: border-box;
  position: relative;
}

.back-button {
  position: absolute;
  top: 30rpx;
  left: 30rpx;
  width: 50rpx;
  height: 50rpx;
  z-index: 10;
}

.back-icon {
  width: 100%;
  height: 100%;
}

.date-picker {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 20rpx 0;
  padding: 15rpx 30rpx;
  background-color: #fff;
  border-radius: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  font-size: 28rpx;
  color: #333;
}

.down-icon {
  width: 32rpx;
  height: 32rpx;
  margin-left: 15rpx;
}

.chart-container {
  width: 100%;
  height: 55vh; /* 调整高度以适应新元素 */
}

ec-canvas {
  width: 100%;
  height: 100%;
}

.summary-container {
  width: 100%;
  margin-top: 20rpx;
  padding: 30rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  box-sizing: border-box;
}

.summary-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  border-bottom: 1rpx solid #eee;
  padding-bottom: 20rpx;
}

.drill-back {
  font-size: 24rpx;
  color: #007aff;
  font-weight: normal;
  cursor: pointer;
}

.summary-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 28rpx;
  color: #666;
  padding: 15rpx 0;
}

.summary-item.suggestion {
  align-items: flex-start;
  flex-direction: column;
}

.summary-label {
  font-weight: bold;
  color: #333;
}

.summary-value {
  color: #007aff;
  font-weight: bold;
}

.summary-text {
  margin-top: 10rpx;
  line-height: 1.6;
  color: #666;
}
