.page-container {
  padding: 20rpx;
}

.time-range-selector {
  display: flex;
  justify-content: space-around;
  margin-bottom: 30rpx;
  background-color: #f0f0f0;
  border-radius: 10rpx;
  padding: 10rpx;
}

.time-range-button {
  padding: 15rpx 30rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #666;
  background-color: #fff;
  border: 1px solid #e0e0e0;
  flex: 1;
  text-align: center;
  margin: 0 5rpx;
  transition: all 0.2s ease;
}

.time-range-button.active {
  background-color: #409eff;
  color: #fff;
  border-color: #409eff;
  box-shadow: 0 2px 8px rgba(64, 158, 255, 0.3);
}

.time-range-button:active {
  transform: translateY(1px);
}

.chart-container {
  width: 100%;
  height: 600rpx; /* 将高度从 600rpx 增加到 800rpx */
  margin-bottom: 40rpx;
  background-color: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.05);
  display: flex;
  justify-content: center;
  align-items: center;
}

.ec-canvas {
  width: 100%;
  height: 100%;
}

.summary-container {
  background-color: #fff;
  padding: 30rpx;
  border-radius: 16rpx;
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.05);
}

.summary-title {
  font-size: 34rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  color: #333;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.summary-item {
  display: flex;
  justify-content: space-between;
  margin-bottom: 15rpx;
  font-size: 30rpx;
}

.summary-label {
  color: #666;
}

.summary-value {
  color: #333;
  font-weight: 500;
}

.suggestion {
  flex-direction: column;
  align-items: flex-start;
}

.summary-text {
  color: #409eff;
  font-style: italic;
  margin-top: 10rpx;
  line-height: 1.5;
}

.drill-back {
  font-size: 26rpx;
  color: #409eff;
  padding: 8rpx 15rpx;
  border: 1rpx solid #409eff;
  border-radius: 20rpx;
  margin-left: 20rpx;
  transition: all 0.2s ease;
}

.drill-back:active {
  background-color: #e6f7ff;
}
