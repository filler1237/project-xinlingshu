<view class="page-container">

  <!-- 时间范围选择器 -->
  <view class="time-range-selector">
    <view class="time-range-button {{activeRange === '7days' ? 'active' : ''}}" data-range="7days" bindtap="onRangeChange">最近7天</view>
    <view class="time-range-button {{activeRange === '30days' ? 'active' : ''}}" data-range="30days" bindtap="onRangeChange">最近30天</view>
    <view class="time-range-button {{activeRange === '90days' ? 'active' : ''}}" data-range="90days" bindtap="onRangeChange">最近90天</view>
  </view>

  <!-- 图表容器 -->
  <view class="chart-container">
    <ec-canvas
    class="ec-canvas"
    canvas-id="mychart-pie"
    ec="{{ ec }}"
  ></ec-canvas>
  </view>
  
  <!-- 数据摘要 -->
  <view class="summary-container">
    <view class="summary-header">
      <view class="summary-title">{{summary.title}}</view>
      <!-- 返回上一级按钮 -->
      <view wx:if="{{isDrilledDown}}" class="drill-back" bindtap="onDrillBack">
        <text>↩ 返回上一级</text>
      </view>
    </view>

    <!-- 关键指标卡片 -->
    <view class="indicators-grid">
      <view class="indicator-card">
        <text class="card-label">总人数</text>
        <view class="card-value-group">
          <text class="card-value">{{summary.total}}</text>
          <text class="card-unit">人</text>
        </view>
      </view>
      <view class="indicator-card">
        <text class="card-label">主要情绪</text>
        <text class="card-value emotion-text {{summary.majorEmotion === '消极' ? 'text-negative' : (summary.majorEmotion === '积极' ? 'text-positive' : 'text-neutral')}}">{{summary.majorEmotion}}</text>
      </view>
    </view>

    <!-- 专业建议 -->
    <view class="suggestion-box">
      <view class="suggestion-header">
        <image class="suggestion-icon" src="/images/icons/suggestion.png" wx:if="{{false}}"></image> <!-- 预留图标位 -->
        <text class="suggestion-label">专业建议</text>
      </view>
      <text class="suggestion-content">{{summary.suggestion}}</text>
    </view>
  </view>
</view>
