<view class="page-container">

  <!-- 时间范围选择器 -->
  <view class="time-range-selector">
    <view class="time-range-button {{activeRange === '7days' ? 'active' : ''}}" data-range="7days" bindtap="onRangeChange">最近7天</view>
    <view class="time-range-button {{activeRange === '30days' ? 'active' : ''}}" data-range="30days" bindtap="onRangeChange">最近30天</view>
    <view class="time-range-button {{activeRange === '90days' ? 'active' : ''}}" data-range="90days" bindtap="onRangeChange">最近90天</view>
  </view>

  <!-- 图表容器 -->
  <view class="chart-container">
    <ec-canvas
    class="ec-canvas"
    canvas-id="mychart-pie"
    ec="{{ ec }}"
  ></ec-canvas>
  </view>
  
  <!-- 数据摘要 -->
  <view class="summary-container">
    <view class="summary-title">
      <text>{{summary.title}}</text>
      <!-- 返回上一级按钮，仅在第二层级显示 -->
      <text wx:if="{{isDrilledDown}}" class="drill-back" bindtap="onDrillBack">返回上一级</text>
    </view>
    <view class="summary-item">
      <text class="summary-label">总人数：</text>
      <text class="summary-value">{{summary.total}} 人</text>
    </view>
    <view class="summary-item">
      <text class="summary-label">主要情绪：</text>
      <text class="summary-value">{{summary.majorEmotion}}</text>
    </view>
    <view class="summary-item suggestion">
      <text class="summary-label">专业建议：</text>
      <text class="summary-text">{{summary.suggestion}}</text>
    </view>
  </view>
</view>
