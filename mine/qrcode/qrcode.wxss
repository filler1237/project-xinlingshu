/* mine/qrcode/qrcode.wxss */
.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 100vh;
  background-color: #f0f4f7;
  padding: 180rpx 20px 20px;
  box-sizing: border-box;
}

.card {
  background-color: #ffffff;
  border-radius: 16px;
  padding: 30px 20px;
  box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);
  width: 100%;
  max-width: 350px;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.title {
  font-size: 18px;
  font-weight: bold;
  color: #333;
  margin-bottom: 25px;
}

.qrcode-wrapper {
  padding: 15px;
  border: 1px solid #eee;
  border-radius: 8px;
  margin-bottom: 25px;
}

.tips {
  display: flex;
  flex-direction: column;
  font-size: 14px;
  color: #999;
}

.tips text {
  line-height: 1.6;
}
