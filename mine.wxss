/* --- 编辑弹窗专属样式 (原生实现) --- */

/* 蒙层 */
.popup-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 999;
  display: flex;
  align-items: flex-end; /* 让弹窗从底部出现 */
}

/* 弹窗容器 */
.popup-container {
  width: 100%;
  height: 60%;
  background-color: #ffffff;
  border-radius: 20rpx 20rpx 0 0;
  display: flex;
  flex-direction: column;
  animation: slide-up 0.3s ease-out;
}

/* 弹窗上滑动画 */
@keyframes slide-up {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

.popup-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 100rpx;
  padding: 0 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
  flex-shrink: 0; /* 防止头部被压缩 */
}

.popup-header .cancel-btn {
  font-size: 32rpx;
  color: #666;
}

.popup-header .popup-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}

.popup-header .save-btn {
  font-size: 32rpx;
  color: #07c160;
  font-weight: 500;
}

.popup-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 60rpx;
}

.avatar-edit {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
}

.editing-avatar {
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  border: 4rpx solid #eee;
  margin-bottom: 20rpx;
}

.change-avatar-text {
  font-size: 28rpx;
  color: #07c160;
}

.nickname-edit {
  width: 100%;
  padding: 0 40rpx;
  box-sizing: border-box;
}

.input-wrapper {
  display: flex;
  align-items: center;
  width: 100%;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #ddd;
}

.input-label {
  font-size: 30rpx;
  color: #333;
  margin-right: 30rpx;
}

.input-field {
  flex: 1;
  font-size: 30rpx;
}

/* 身份选择弹窗样式 */
.popup-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 9999;
}

/* 身份选择弹窗样式 - 修复版本 */
.identity-popup {
  background: white;
  border-radius: 20rpx;
  width: 85%;
  max-width: 650rpx;
  overflow: hidden;
}

.identity-options {
  padding: 20rpx 0;
}

.identity-option {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 50rpx 40rpx;
  border-bottom: 1rpx solid #f0f0f0;
  min-height: 200rpx;
  box-sizing: border-box;
}

.identity-option:last-child {
  border-bottom: none;
}

.identity-option:active {
  background-color: #f8f8f8;
}

.identity-icon-placeholder {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 30rpx;
  font-size: 70rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  background: #f5f5f5;
  border-radius: 50%;
}

.identity-text {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  color: #333;
  text-align: center;
}

.identity-desc {
  font-size: 28rpx;
  color: #666;
  text-align: center;
  line-height: 1.5;
  width: 100%;
  padding: 0 20rpx;
  box-sizing: border-box;
}

.popup-footer {
  display: flex;
  justify-content: center;
  padding: 30rpx;
  border-top: 1rpx solid #f0f0f0;
}

.cancel-btn {
  background: none;
  border: none;
  color: #666;
  font-size: 28rpx;
  padding: 15rpx 40rpx;
}

.cancel-btn:active {
  background-color: #f0f0f0;
  border-radius: 10rpx;
}

/* 确保弹窗内容不被点击关闭 */
.popup-container {
  position: relative;
}

/* 响应式调整 */
@media (max-width: 750rpx) {
  .identity-popup {
    width: 90%;
    margin: 0 5%;
  }
}