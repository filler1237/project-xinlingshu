<!-- pages/growth/growth.wxml -->
<view class="nav-bar-wrapper">
  <navigation-bar title="我的成长树" background="transparent"></navigation-bar>
</view>
<view class="container">
  <!-- 1. 首屏区域：占满整个屏幕 -->
  <view class="hero-section">
    <image class="background-image" src="cloud://cloud1-2gxal8as6b6bfe21.636c-cloud1-2gxal8as6b6bfe21-1378381651/images/tree/背景图.png" mode="aspectFill"></image>
    <image class="cloud cloud1" src="cloud://cloud1-2gxal8as6b6bfe21.636c-cloud1-2gxal8as6b6bfe21-1378381651/images/tree/云朵1.png" mode="aspectFit"></image>
    <image class="cloud cloud2" src="cloud://cloud1-2gxal8as6b6bfe21.636c-cloud1-2gxal8as6b6bfe21-1378381651/images/tree/云朵2.png" mode="aspectFit"></image>
    <image class="cloud cloud3" src="cloud://cloud1-2gxal8as6b6bfe21.636c-cloud1-2gxal8as6b6bfe21-1378381651/images/tree/云朵3.png" mode="aspectFit"></image>
    <image class="cloud cloud4" src="cloud://cloud1-2gxal8as6b6bfe21.636c-cloud1-2gxal8as6b6bfe21-1378381651/images/tree/云朵3.png" mode="aspectFit"></image>
    <view class="tree-animation-wrapper {{animationState}} {{isAnimating ? 'is-growing' : ''}}">
      <image class="tree-image tree-level-{{treeLevel}}" src="cloud://cloud1-2gxal8as6b6bfe21.636c-cloud1-2gxal8as6b6bfe21-1378381651/images/tree/level_{{treeLevel}}.png" mode="aspectFit" />
    </view>
    <!-- 新增：浇水动画的水壶 -->
    <image wx:if="{{isWatering}}" class="watering-can" src="cloud://cloud1-2gxal8as6b6bfe21.636c-cloud1-2gxal8as6b6bfe21-1378381651/images/tree/水壶.png" mode="aspectFit"></image>
  </view>

  <!-- 2. 页面下方内容区域 -->
  <view class="content-section">
    <!-- 成长信息面板 -->
    <view class="growth-info">
      <view class="growth-level">心理树等级: {{treeLevel}}</view>
      <view class="growth-value">成长值: {{growthValue}}</view>
      <button class="water-button" type="primary" bindtap="onWatering">浇水 (水滴数：{{waterdrops}})</button>
    </view>

    <!-- 我的徽章 -->
    <view class="achievements-container">
      <view class="section-title">我的徽章</view>
      <view class="achievements-grid" wx:if="{{unlockedAchievements.length > 0}}">
        <view class="badge" wx:for="{{unlockedAchievements}}" wx:key="_id">
          <image class="badge-icon" src="{{item.iconUrl}}" />
          <view class="badge-name">{{item.name}}</view>
        </view>
      </view>
      <view class="no-achievements" wx:else>
        <text>暂未获得任何徽章，继续努力吧！</text>
      </view>
    </view>
  </view>
</view>
