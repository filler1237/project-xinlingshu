<view class="ucenter">
  <view class="profile-info" wx:if="isLogin==false">
    <image class="avatar" src="{{avatarUrl}}" bindtap="toLogin"></image>
    <view class="info">
      <text class="name" bindtap="toLogin">{{nickName}}</text>
      <!-- <text class="name" wx:if="isLogin!=true">{{username}}</text> -->
    </view>
  </view>
  <view class="order-wrap">
    <view class="order-header">
      <text class="txt">我的订单</text>
    </view>
    <view class="order-icon">
      <navigator class="icon-wrap" id="1" url="../../mine/pages/mine/booked/booked">
          <image class="icon" src="/assets/pay.png"></image>
        <text class="txt">已预约</text>
      </navigator>
      <navigator class="icon-wrap" id="2" url="../../mine/pages/mine/evaluate/evaluate">
          <image class="icon" src="/assets/comment.png"></image>
        <text class="txt">待评价</text>
      </navigator>
      <navigator class="icon-wrap" id="2" url="/mine/pages/mine/record/record">
          <image class="icon" src="/assets/note.png"></image>
        <text class="txt">测评记录</text>
      </navigator>
    </view>
  </view>

  <view class="order-wrap">
    <view class="order-header">
      <text class="txt">我的服务</text>
    </view>

    <view class="order-icon">
      <navigator class="icon-wrap" url="../../mine/pages/mine/list/list">
          <image class="icon" src="/assets/list.png"></image>
          <text class="txt">咨询师列表</text>
      </navigator>

      <navigator class="icon-wrap" url="../../mine/pages/mine/mycomment/mycomment">
          <image class="icon" src="/assets/communicate.png"></image>
          <text class="txt">我的消息</text>
      </navigator>

      <navigator class="icon-wrap" url="../../mine/pages/mine/setting/setting">
        <image class="icon" src="/assets/service.png"></image>
        <text class="txt">联系客服</text>
      </navigator>
    </view>
  </view>

</view>
<view class="level" wx:if="{{isLogin}}" style="height: 50rpx;">
  Lv{{fuyuanli.Level}}
</view>
<view class="fuyuanli" wx:if="{{isLogin}}">
  <view class="li">
    生理复原力：{{fuyuanli.shengli}}/{{fuyuanli.max}}
  </view>
  <view class="li">
    心理复原力：{{fuyuanli.xinli}}/{{fuyuanli.max}}
  </view>
  <view class="li">
    情绪复原力：{{fuyuanli.qingxu}}/{{fuyuanli.max}}
  </view>
  <view class="li">
    社交复原力：{{fuyuanli.shejiao}}/{{fuyuanli.max}}
  </view>
</view>
<view class="add" wx:if="{{isLogin}}">
  <button class="jia" bindtap="addSL">
  <view class="jiahao">
    +
  </view>
  </button>
  <button class="jia" bindtap="addXL">
  <view class="jiahao">
    +
  </view>
  </button>
  <button class="jia" bindtap="addQX">
  <view class="jiahao">
    +
  </view>
  </button>
  <button class="jia" bindtap="addSJ">
  <view class="jiahao">
    +
  </view>
  </button>
</view>
