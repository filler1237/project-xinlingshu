/* pages/auth/usercenter/usercenter.wxss */
.touxiangbox{
  height: 450rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  margin: 20rpx;
}

.touxiang {
  height: 250rpx;
  width: 250rpx;
  border-radius: 100%;
}

.Area{
  display: flex;
  flex-direction: column;
  margin: 35rpx;
}
.Each{
  display: flex;
  flex-direction: row;
  justify-content: space-around;
  justify-content: space-evenly;
  justify-content: space-between;
  align-items: center;
  margin: 15rpx;
  border-bottom: 2rpx solid #D8D8D8;
}