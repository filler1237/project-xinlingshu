/* pages/auth/usercenter/usercenter.wxss */
.container {
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  background-color: #f7f8fa;
  min-height: 100vh;
}

.header {
  width: 100%;
  margin-bottom: 60rpx;
  text-align: left;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
}

.subtitle {
  font-size: 28rpx;
  color: #999;
  margin-top: 16rpx;
}

.form-group {
  width: 100%;
}

/* 自定义 Vant Field 标签样式 */
.field-label {
  font-weight: 500 !important;
}

.submit-button-wrapper {
  width: 100%;
  margin-top: 80rpx;
}

.footer-tips {
  position: absolute;
  bottom: 40rpx;
  font-size: 24rpx;
  color: #c0c4cc;
}
