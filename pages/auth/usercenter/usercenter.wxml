<!--pages/auth/usercenter/usercenter.wxml-->
<view class="touxiangbox">
  <view bindtap="ChangeImage">
    <image class="touxiang" src="{{ImageSrc}}" mode="widthFix"/>
  </view>
  <view style="color: #91c789;">
    点击更换头像
  </view>
</view>

<van-cell-group >

  <van-field
    v-model="{{ Nickname }}"
    label="昵称"
    name = "昵称"
    placeholder="请输入昵称"
    bind:change="onChange"
  />

  <van-field
    value="{{ sign }}"
    placeholder="填写"
    label="个性签名"
    bind:change="onChange"
  />
  <van-field
    value=""
    label="性别"
    bind:change="onChange"
  />
  
  <van-field
    v-model="{{ PhoneNumber }}"
    label="电话号码"
    name = "电话号码"
    placeholder="请输入手机号"
    bind:change="onChange"
  />
  
</van-cell-group>

<view style="margin-top: 50rpx;">
  
</view>
<van-cell-group >
  <van-field 
  label="学校"
  value="深圳技术大学"
  readonly
  />
  <van-field
    value=""
    label="年级"
    bind:change="onChange"
  />

  <van-field
    value=""
    label="学院"
    bind:change="onChange"
  />
  
  <van-field
    value=""
    label="专业"
    bind:change="onChange"
  />

  <van-field
    value=""
    label="学号"
    bind:change="onChange"
  />
</van-cell-group>