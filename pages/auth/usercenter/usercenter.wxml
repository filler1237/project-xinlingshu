<!-- pages/auth/usercenter/usercenter.wxml -->
<view class="container">
  <view class="header">
    <view class="title">身份信息绑定</view>
    <view class="subtitle">为了提供更完整的服务，请绑定您的身份信息</view>
  </view>

  <view class="form-group">
    <van-cell-group inset>
      <!-- 身份选择 -->
      <van-field name="radio" label="选择身份">
        <!-- 修正这里：使用 slot="input" 替代 #input -->
        <template slot="input">
          <van-radio-group value="{{ role }}" bind:change="onRoleChange" direction="horizontal">
            <van-radio name="student">学生</van-radio>
            <van-radio name="judge">评委</van-radio>
            <van-radio name="admin">管理员</van-radio>
          </van-radio-group>
        </template>
      </van-field>

      <van-field
        value="{{ realName }}"
        label="真实姓名"
        placeholder="请输入您的真实姓名"
        bind:input="onInput"
        data-field="realName"
        required
        clearable
      />
      <van-field
        value="{{ studentId }}"
        label="学号/工号"
        placeholder="请输入您的学号或工号"
        bind:input="onInput"
        data-field="studentId"
        required
        clearable
      />
      <van-field
        value="{{ phoneNumber }}"
        label="手机号"
        type="number"
        placeholder="请输入您的手机号码"
        bind:input="onInput"
        data-field="phoneNumber"
        required
        clearable
      />
      <van-field
        value="{{ college }}"
        label="所在学院"
        placeholder="请输入您的学院"
        bind:input="onInput"
        data-field="college"
        required
        clearable
      />
      <van-field
        value="{{ major }}"
        label="专业"
        placeholder="请输入您的专业"
        bind:input="onInput"
        data-field="major"
        required
        clearable
      />
    </van-cell-group>
  </view>

  <view class="submit-button-wrapper">
    <van-button 
      type="primary" 
      block 
      round 
      bind:click="submitIdentity"
      disabled="{{ !role || !realName || !studentId || !phoneNumber || !college || !major }}"
    >
      确认绑定
    </van-button>
  </view>

  <view class="footer-tips">
    <text>信息仅用于身份核实，我们将严格保密。</text>
  </view>
</view>
