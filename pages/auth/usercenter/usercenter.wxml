<van-cell-group class="van-wrap">
  <van-field 
  label="头像"
  disabled
  size="large"
  right-icon="{{avatarUrl}}"
  right-icon-class="img"
  bind:click-icon="onChooseAvatar"
  />

  <van-field
    value="{{ value }}"
    label="昵称"
    placeholder="请输入用户名"
    bind:change="onChange"
  />
  <van-field
    value="{{ sign }}"
    placeholder="填写"
    label="个性签名"
    bind:change="onChangesign"
  />
  
  
  
</van-cell-group>

<van-cell-group class="van-wrap_1">
  <van-field 
  label="学校"
  value="深圳技术大学"
  disabled
  />
  <van-field
    value=""
    disabled
    label="年级"
    bind:change="onChange"
  />

  <van-field
    value=""
    disabled
    label="学院"
    border="{{ false }}"
    bind:change="onChange"
  />
  <van-field
    value=""
    disabled
    label="性别"
    border="{{ false }}"
    bind:change="onChange"
  />
</van-cell-group>