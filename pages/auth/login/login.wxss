/* pages/auth/login/login.wxss */
.page-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  background-color: #ffffff;
  padding-top: 120rpx; /* Space for custom navigation bar */
  box-sizing: border-box;
}

.info-container {
  text-align: center;
  margin-bottom: 80rpx;
  padding: 0 40rpx;
}

.info-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.info-description {
  font-size: 28rpx;
  color: #888;
}

/* Step 1: Role Selection */
.role-selection-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
}

.role-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80%;
  height: 120rpx;
  margin-bottom: 40rpx;
  border-radius: 16rpx;
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
  background-color: #f7f7f7;
  border: 1px solid #eee;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
}

.role-btn .icon {
  width: 60rpx;
  height: 60rpx;
  margin-right: 20rpx;
}

/* Step 2: Form Container */
.form-container {
  width: 85%;
  padding: 50rpx;
  background-color: #ffffff;
}

.form-title {
  font-size: 42rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 60rpx;
  color: #333;
}

.form-picker {
  width: 100%;
  padding: 25rpx 0;
  border-bottom: 1px solid #f0f0f0;
  margin-bottom: 30rpx;
}

.picker-view {
  display: flex;
  align-items: center;
  font-size: 30rpx;
}

.picker-label {
  color: #888;
}

.picker-value {
  flex: 1;
  text-align: right;
  color: #333;
  margin-right: 15rpx;
}

.picker-arrow {
  width: 30rpx;
  height: 30rpx;
}

.form-input-group {
  width: 100%;
  padding: 25rpx 0;
  border-bottom: 1px solid #f0f0f0;
  margin-bottom: 30rpx;
}

.form-input {
  width: 100%;
  font-size: 30rpx;
}

.submit-btn {
  width: 100%;
  height: 90rpx;
  line-height: 90rpx;
  margin-top: 50rpx;
  border-radius: 45rpx;
  background-color: #007bff;
  color: #fff;
  font-size: 32rpx;
}
