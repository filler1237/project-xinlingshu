<navigation-bar title="情绪词云" back="{{true}}"></navigation-bar>

<view class="container">
  <!-- Tab 切换 -->
  <van-tabs active="{{ activeTab }}" bind:change="onTabChange" class="tabs">
    <van-tab title="我的词云" name="personal"></van-tab>
    <van-tab title="大家的词云" name="global"></van-tab>
  </van-tabs>

  <!-- 时间范围选择 -->
  <view class="picker-container">
    <picker bindchange="onDaysChange" value="{{days}}" range="{{[7, 30, 90]}}">
      <view class="picker">
        最近 {{days}} 天 <van-icon name="arrow-down" />
      </view>
    </picker>
  </view>

  <!-- 词云容器 -->
  <view class="chart-container">
    <view wx:if="{{loading}}" class="loading">加载中...</view>
    <view wx:elif="{{error}}" class="error">{{error}}</view>
    <ec-canvas wx:else id="mychart-dom-wordcloud" canvas-id="mychart-wordcloud" ec="{{ ec }}"></ec-canvas>
  </view>

  <!-- 描述文字 -->
  <view class="description" wx:if="{{activeTab === 'global'}}">
    <text>看看和你一样的大学生，最近都在关心什么吧！</text>
  </view>
</view>
