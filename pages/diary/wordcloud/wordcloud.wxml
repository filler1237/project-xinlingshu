<view class="page-wrapper">
  <navigation-bar title="情绪词云" show-back-button="{{true}}"></navigation-bar>
  <view class="container">
    <van-tabs active="{{ activeTab }}" bind:change="onTabChange">
      <van-tab title="我的" name="personal"></van-tab>
      <van-tab title="大家" name="global"></van-tab>
    </van-tabs>

    <view class="slider-container">
      <text>时间范围: 最近 {{ days }} 天</text>
      <van-slider value="{{ days }}" min="7" max="365" bind:change="onDaysChange" />
    </view>

    <view class="debug-info" wx:if="{{debugInfo}}">
      <text>调试信息: {{debugInfo}}</text>
    </view>

    <view class="wordcloud-container">
      <van-loading wx:if="{{loading}}" size="24px">加载中...</van-loading>
      <view wx:if="{{!loading && error}}" class="error-message">{{ error }}</view>
      <liu-photo-wall wx:if="{{!loading && !error && keywordList.length > 0}}" dataList="{{keywordList}}" />
      <view wx:if="{{!loading && !error && keywordList.length === 0}}" class="empty-message">暂无数据</view>
    </view>
  </view>
</view>
