page {
  background-color: #f7f8fa;
}

.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx;
}

.tabs {
  width: 100%;
}

.picker-container {
  width: 100%;
  padding: 20rpx;
  text-align: center;
  background-color: #fff;
  margin-top: 20rpx;
  border-radius: 10rpx;
}

.picker {
  font-size: 28rpx;
  color: #333;
}

.chart-container {
  width: 100%;
  height: 800rpx;
  margin-top: 20rpx;
  background-color: #fff;
  border-radius: 10rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

ec-canvas {
  width: 100%;
  height: 100%;
}

.loading, .error {
  font-size: 28rpx;
  color: #999;
}

.description {
  margin-top: 30rpx;
  font-size: 26rpx;
  color: #666;
  text-align: center;
}
