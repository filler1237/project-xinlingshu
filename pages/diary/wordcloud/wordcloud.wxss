.page-wrapper {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.container {
  flex: 1;
  display: flex;
  flex-direction: column;
  background-color: #f7f8fa;
  /* Removed fixed height, it will now fill the remaining space */
}

.slider-container {
  padding: 16px;
  background-color: #fff;
}

.wordcloud-container {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: center;
  position: relative;
  width: 100%;
  /* Removed height: 100% as flex:1 will handle it */
  margin-top: 20px;
}

.error-message,
.empty-message {
  color: #999;
}
