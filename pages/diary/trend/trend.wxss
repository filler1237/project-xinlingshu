/* pages/diary/trend/trend.wxss */
page {
  background-color: #FFFFF5;
}

.container {
  padding: 20rpx;
  background: transparent;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 头部 */
.header {
  background: #E5FFF0;
  border-radius: 10rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  color: #96CE74;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 120rpx;
  box-shadow: 0rpx 0rpx 8rpx 0rpx #DCDCC14C;
  backdrop-filter: blur(20rpx);
}

.title {
  font-size: 36rpx;
  font-weight: 350;
  margin-bottom: 10rpx;
  text-align: center;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  font-family: PingFang SC;
  color: #96CE74;
}

.warm-prompt {
  font-size: 24rpx;
  color: #88B86A;
  background-color: rgba(255, 255, 255, 0.5);
  padding: 15rpx 20rpx;
  border-radius: 10rpx;
  margin-top: 15rpx;
  text-align: center;
  line-height: 1.6;
  border: 1rpx solid rgba(150, 206, 116, 0.2);
}

.date-range {
  font-size: 24rpx;
  opacity: 0.8;
  text-align: center;
  color: #96CE74;
  font-family: PingFang SC;
  font-weight: 300;
}

/* 时间范围选择 */
.time-range-selector {
  display: flex;
  gap: 8rpx;
  margin-bottom: 20rpx;
  padding: 0 20rpx;
  width: 100%;
  box-sizing: border-box;
}

.range-btn {
  flex: 1;
  padding: 12rpx 8rpx;
  border-radius: 10rpx;
  background: #ffffff;
  color: #96CE74;
  border: 2rpx solid #E5FFF0;
  font-size: 20rpx;
  text-align: center;
  min-width: 0;
  white-space: nowrap;
  font-family: PingFang SC;
  font-weight: 300;
  transition: all 0.3s ease;
  box-shadow: 0rpx 0rpx 8rpx 0rpx #DCDCC14C;
}

.range-btn.active {
  background: #96CE74;
  color: white;
  border-color: #96CE74;
  transform: scale(0.98);
}

.range-btn:active {
  transform: scale(0.95);
}

/* 情绪分布和趋势图表并排 */
.stats-chart-row {
  display: flex;
  gap: 15rpx;
  margin: 0 20rpx 20rpx 20rpx;
  width: calc(100% - 40rpx);
  box-sizing: border-box;
}

/* 情绪统计 */
.emotion-stats {
  background: #ffffff;
  border-radius: 10rpx;
  padding: 25rpx;
  box-shadow: 0rpx 0rpx 8rpx 0rpx #DCDCC14C;
  margin: 0 20rpx 20rpx 20rpx;
  width: calc(100% - 40rpx);
  box-sizing: border-box;
  display: block;
  backdrop-filter: blur(20rpx);
}

.stats-title {
  font-size: 32rpx;
  font-weight: 350;
  color: #96CE74;
  margin-bottom: 25rpx;
  font-family: PingFang SC;
  display: flex;
  align-items: center;
}

.stats-title::before {
  content: '';
  width: 6rpx;
  height: 32rpx;
  background: #96CE74;
  margin-right: 15rpx;
  border-radius: 3rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 15rpx;
}

.stat-item {
  display: flex;
  align-items: center;
  gap: 15rpx;
  padding: 20rpx;
  background: #E5FFF0;
  border-radius: 10rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
}

.stat-item:active {
  background: rgba(150, 206, 116, 0.2);
  border-color: #96CE74;
  transform: scale(0.98);
}

.stat-color {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  box-shadow: 0rpx 0rpx 8rpx 0rpx #DCDCC14C;
}

.stat-info {
  display: flex;
  flex-direction: column;
  gap: 5rpx;
}

.stat-emotion {
  font-size: 24rpx;
  color: #333;
  font-weight: 300;
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-family: PingFang SC;
}

.stat-count {
  font-size: 20rpx;
  color: #666;
  font-family: PingFang SC;
  font-weight: 300;
}


/* 趋势图表 */
.trend-chart {
  background: white;
  border-radius: 15rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
  flex: 1;
  min-width: 0;
}

.chart-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.chart-container {
  height: 250rpx;
  display: flex;
  align-items: end;
  gap: 8rpx;
  padding: 15rpx 0;
  overflow-x: auto;
}

.chart-bars {
  display: flex;
  align-items: end;
  gap: 8rpx;
  min-width: 100%;
  height: 100%;
}

.chart-bar {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100%;
  position: relative;
  min-width: 40rpx;
}

.bar-fill {
  width: 100%;
  min-height: 20rpx;
  border-radius: 4rpx 4rpx 0 0;
  transition: all 0.3s ease;
}

.bar-value {
  font-size: 20rpx;
  color: #666;
  margin-top: 10rpx;
}

.bar-date {
  font-size: 18rpx;
  color: #999;
  margin-top: 5rpx;
  transform: rotate(-45deg);
  white-space: nowrap;
}

/* 详细数据 */
.detail-data {
  background: #ffffff;
  border-radius: 10rpx;
  padding: 25rpx;
  margin: 0 20rpx 20rpx 20rpx;
  box-shadow: 0rpx 0rpx 8rpx 0rpx #DCDCC14C;
  width: calc(100% - 40rpx);
  box-sizing: border-box;
  backdrop-filter: blur(20rpx);
}

.detail-title {
  font-size: 32rpx;
  font-weight: 350;
  color: #96CE74;
  margin-bottom: 25rpx;
  font-family: PingFang SC;
  display: flex;
  align-items: center;
}

.detail-title::before {
  content: '';
  width: 6rpx;
  height: 32rpx;
  background: #96CE74;
  margin-right: 15rpx;
  border-radius: 3rpx;
}

.data-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.data-item {
  display: flex;
  align-items: center;
  gap: 15rpx;
  padding: 20rpx;
  background: #E5FFF0;
  border-radius: 10rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
}

.data-item:active {
  background: rgba(150, 206, 116, 0.2);
  border-color: #96CE74;
  transform: scale(0.98);
}

/* 左侧情绪信息 */
.data-emotion-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  min-width: 80rpx;
  padding: 8rpx;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 10rpx;
  border: 2rpx solid rgba(150, 206, 116, 0.3);
}

.emotion-emoji {
  font-size: 32rpx;
  line-height: 1;
}

.emotion-type {
  font-size: 18rpx;
  color: #666;
  font-weight: 300;
  text-align: center;
  font-family: PingFang SC;
}

/* 中间日期信息 */
.data-date {
  font-size: 24rpx;
  color: #333;
  font-weight: 350;
  min-width: 120rpx;
  font-family: PingFang SC;
}

/* 右侧数据信息 */
.data-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 5rpx;
}

.data-intensity {
  font-size: 22rpx;
  color: #666;
  font-family: PingFang SC;
  font-weight: 300;
}

.data-date-info {
  font-size: 20rpx;
  color: #999;
  font-family: PingFang SC;
  font-weight: 300;
}

/* 右侧情绪标签 */
.data-emotion {
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  color: white;
  font-size: 20rpx;
  font-weight: 300;
  font-family: PingFang SC;
  box-shadow: 0rpx 0rpx 8rpx 0rpx #DCDCC14C;
}

/* 展开/收起按钮 */
.expand-button {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 15rpx;
  margin-top: 10rpx;
  background: #E5FFF0;
  border-radius: 10rpx;
  border: 2rpx solid #96CE74;
  color: #96CE74;
  font-size: 24rpx;
  font-weight: 300;
  transition: all 0.3s ease;
  font-family: PingFang SC;
}

.expand-button:active {
  background: rgba(150, 206, 116, 0.2);
  transform: scale(0.98);
}

.expand-text {
  font-size: 24rpx;
  color: #96CE74;
  font-weight: 300;
  font-family: PingFang SC;
}

.expand-icon {
  font-size: 20rpx;
  color: #96CE74;
  font-weight: 300;
  font-family: PingFang SC;
}

/* 操作按钮 */
.action-buttons {
  display: flex;
  gap: 15rpx;
  margin: 0 20rpx 20rpx 20rpx;
  width: calc(100% - 40rpx);
  box-sizing: border-box;
}

.btn {
  flex: 1;
  padding: 20rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  border: none;
  text-align: center;
}

.btn-primary {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
}

.btn-secondary {
  background: #6c757d;
  color: white;
}

/* 加载状态 */
.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 400rpx;
  color: #666;
  font-size: 28rpx;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 400rpx;
  color: #666;
}

.empty-text {
  font-size: 32rpx;
  margin-bottom: 10rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: #999;
}

/* 情绪强度趋势折线图 - 独占一行 */
.intensity-trend-section {
  background: #ffffff;
  border-radius: 10rpx;
  margin: 20rpx;
  padding: 30rpx;
  box-shadow: 0rpx 0rpx 8rpx 0rpx #DCDCC14C;
  width: calc(100% - 40rpx);
  box-sizing: border-box;
  display: block;
  clear: both;
  backdrop-filter: blur(20rpx);
}

.trend-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.trend-title {
  font-size: 32rpx;
  font-weight: 350;
  color: #96CE74;
  font-family: PingFang SC;
  display: flex;
  align-items: center;
}

.trend-title::before {
  content: '';
  width: 6rpx;
  height: 32rpx;
  background: #96CE74;
  margin-right: 15rpx;
  border-radius: 3rpx;
}

.trend-actions {
  display: flex;
  gap: 15rpx;
}

.zoom-btn {
  font-size: 24rpx;
  color: #333;
  font-weight: 300;
  padding: 8rpx 16rpx;
  border-radius: 10rpx;
  background: rgba(150, 206, 116, 0.1);
  border: 2rpx solid rgba(150, 206, 116, 0.3);
  transition: all 0.3s ease;
  font-family: PingFang SC;
}

.zoom-btn:active {
  background: rgba(150, 206, 116, 0.2);
  transform: scale(0.95);
}

.line-chart-container {
  height: 500rpx;
  border: 2rpx solid #E5FFF0;
  border-radius: 10rpx;
  background: #ffffff;
  position: relative;
  overflow: visible;
  transition: all 0.3s ease;
}

.line-chart-container.zoomed {
  height: 600rpx;
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 90%;
  z-index: 1000;
  background: white;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.3);
}

.chart-wrapper {
  display: flex;
  height: 100%;
  position: relative;
}

.y-axis {
  width: 60rpx;
  display: flex;
  flex-direction: column-reverse;
  justify-content: space-between;
  padding: 20rpx 10rpx;
  background: #f8f9fa;
  border-right: 1rpx solid #e9ecef;
}

.y-label {
  font-size: 20rpx;
  color: #666;
  text-align: center;
  font-weight: 300;
  font-family: PingFang SC;
}

.chart-area {
  flex: 1;
  position: relative;
  padding: 20rpx 20rpx 80rpx 20rpx;
}

.grid-lines {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
}

.grid-line {
  position: absolute;
  left: 0;
  right: 0;
  height: 1rpx;
  background: #e9ecef;
}

.line-chart {
  position: relative;
  width: 100%;
  height: 100%;
}

.data-points {
  position: relative;
  width: 100%;
  height: 100%;
}

.data-point {
  position: absolute;
  transform: translate(-50%, -50%);
  cursor: pointer;
  z-index: 10;
}

.point-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  border: 3rpx solid white;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
  transition: all 0.3s ease;
}

.data-point:active .point-dot {
  transform: scale(1.5);
}

.point-tooltip {
  position: absolute;
  bottom: 30rpx;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(0, 0, 0, 0.8);
  color: white;
  padding: 8rpx 12rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  white-space: nowrap;
  opacity: 0;
  transition: opacity 0.3s ease;
  pointer-events: none;
}

.data-point:hover .point-tooltip,
.data-point:active .point-tooltip {
  opacity: 1;
}

.tooltip-date {
  display: block;
  font-weight: bold;
  margin-bottom: 4rpx;
}

.tooltip-intensity {
  display: block;
  font-size: 18rpx;
  opacity: 0.9;
}

.connection-lines {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
}

.line-segment {
  position: absolute;
  height: 3rpx;
  background: #667eea;
  transform-origin: left center;
  opacity: 0.8;
  border-radius: 2rpx;
  z-index: 5;
  box-shadow: 0 1rpx 3rpx rgba(102, 126, 234, 0.3);
}

/* 使用CSS绘制连接线 */
.connection-lines::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: 
    linear-gradient(
      to right,
      transparent 0%,
      #667eea 0%,
      #667eea 100%,
      transparent 100%
    );
  background-size: 100% 2rpx;
  background-repeat: no-repeat;
  background-position: 0 50%;
  opacity: 0.6;
  z-index: 1;
}

.x-axis {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 60rpx;
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  background: #f8f9fa;
  border-top: 1rpx solid #e9ecef;
  overflow: visible;
  z-index: 20;
}

.x-label {
  position: absolute;
  font-size: 20rpx;
  color: #333;
  text-align: center;
  white-space: nowrap;
  transform: translateX(-50%);
  min-width: 80rpx;
  font-weight: 300;
  font-family: PingFang SC;
}

.x-label.no-data {
  color: #999;
  font-style: italic;
  z-index: 21;
}

/* 数据点调试信息样式 */
.debug-point-info {
  position: absolute;
  top: -60rpx;
  left: 50%;
  transform: translateX(-50%);
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
  white-space: nowrap;
  z-index: 30;
  min-width: 80rpx;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.4);
  border: 2rpx solid rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(10rpx);
}

.debug-emotion {
  color: #ffffff;
  font-size: 18rpx;
  font-weight: 600;
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.3);
}

/* 横屏模式适配 */
.line-chart-container.zoomed {
  width: 100vh;
  height: 100vw;
  position: fixed;
  top: 50%;
  left: 50%;
  z-index: 9999;
  background: white;
  overflow: hidden;
  transform: rotate(90deg);
  transform-origin: center center;
  margin-top: -50vw;
  margin-left: -50vh;
}

.line-chart-container.zoomed .chart-wrapper {
  width: 100%;
  height: 100%;
  padding: 20rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.line-chart-container.zoomed .chart-area {
  flex: 1;
  position: relative;
  margin: 0 60rpx 40rpx 60rpx;
  min-height: 0;
}

.line-chart-container.zoomed .y-axis {
  width: 50rpx;
  height: 100%;
  position: absolute;
  left: -50rpx;
  top: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 0;
}

.line-chart-container.zoomed .x-axis {
  height: 40rpx;
  position: absolute;
  bottom: -40rpx;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 10rpx;
}

.line-chart-container.zoomed .line-chart {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
}

.line-chart-container.zoomed .y-label {
  font-size: 24rpx;
  color: #333;
  font-weight: 500;
}

.line-chart-container.zoomed .x-label {
  font-size: 20rpx;
  color: #333;
  font-weight: 500;
  white-space: nowrap;
}

.line-chart-container.zoomed .debug-point-info {
  font-size: 24rpx;
  padding: 10rpx 20rpx;
  min-width: 100rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 25rpx;
  box-shadow: 0 6rpx 16rpx rgba(102, 126, 234, 0.5);
  border: 3rpx solid rgba(255, 255, 255, 0.3);
}

.line-chart-container.zoomed .debug-emotion {
  font-size: 22rpx;
  font-weight: 600;
  color: #ffffff;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.4);
}

/* 横屏模式关闭按钮 */
.zoom-close-btn {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  width: 50rpx;
  height: 50rpx;
  background: rgba(0, 0, 0, 0.6);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10000;
  color: white;
  font-size: 28rpx;
  font-weight: bold;
}

.zoom-close-btn:active {
  background: rgba(0, 0, 0, 0.8);
}

/* 全屏模式下的容器样式 */
.container.fullscreen {
  padding: 0;
  height: 100vh;
  width: 100vw;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* AI趋势洞察 */
.ai-insight-section {
  background: #ffffff;
  border-radius: 10rpx;
  margin: 20rpx;
  padding: 30rpx;
  box-shadow: 0rpx 0rpx 8rpx 0rpx #DCDCC14C;
  width: calc(100% - 40rpx);
  box-sizing: border-box;
}

.insight-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 25rpx;
}

.insight-title {
  font-size: 32rpx;
  font-weight: 350;
  color: #96CE74;
  font-family: PingFang SC;
  display: flex;
  align-items: center;
}

.insight-title::before {
  content: '';
  width: 6rpx;
  height: 32rpx;
  background: #96CE74;
  margin-right: 15rpx;
  border-radius: 3rpx;
}

.analyze-btn {
  padding: 10rpx 25rpx;
  background: #96CE74;
  color: white;
  border-radius: 30rpx;
  font-size: 24rpx;
  font-weight: 300;
  border: none;
}

.insight-content {
  font-size: 26rpx;
  color: #333;
  line-height: 1.8;
  white-space: pre-wrap;
  background: #f8f9fa;
  padding: 20rpx;
  border-radius: 10rpx;
}

.insight-placeholder {
  font-size: 24rpx;
  color: #888;
  text-align: center;
  padding: 40rpx 20rpx;
  background: #f8f9fa;
  border-radius: 10rpx;
}
