<!--pages/diary/trend/trend.wxml-->
<navigation-bar title="情绪趋势分析" back="{{true}}" wx:if="{{!isZoomed}}"></navigation-bar>

<view class="container {{isZoomed ? 'fullscreen' : ''}}">
  <!-- 头部 -->
  <view class="header" wx:if="{{!isZoomed}}">
    <view class="title">
      <text>情绪趋势分析</text>
      <view class="warm-prompt">
        <text>💡在这里您可以看到近几天来您的心情变化趋势，这是了解自己的一个好方法！</text>
      </view>
      <view class="date-range">
        <text class="date-text">{{startDate}} 至 {{endDate}}</text>
      </view>
    </view>
  </view>

  <!-- 时间范围选择 -->
  <view class="time-range-selector" wx:if="{{!isZoomed}}">
    <button 
      class="range-btn {{timeRange === 'week' ? 'active' : ''}}"
      data-range="week"
      bindtap="selectTimeRange"
    >
      近7天
    </button>
    <button 
      class="range-btn {{timeRange === 'month' ? 'active' : ''}}"
      data-range="month"
      bindtap="selectTimeRange"
    >
      近30天
    </button>
    <button 
      class="range-btn {{timeRange === 'quarter' ? 'active' : ''}}"
      data-range="quarter"
      bindtap="selectTimeRange"
    >
      近90天
    </button>
  </view>


  <!-- 情绪统计 -->
  <view class="emotion-stats" wx:if="{{!loading && !isZoomed}}">
    <view class="stats-title">情绪分布</view>
    <view class="stats-grid">
      <view 
        class="stat-item" 
        wx:for="{{emotionStatsWithEmoji}}" 
        wx:key="*this"
        wx:for-item="emotionData"
        wx:for-index="emotion"
      >
        <view class="stat-color" style="background-color: {{getEmotionColor(emotion)}}"></view>
        <view class="stat-info">
          <text class="stat-emotion">{{emotionData.emoji}} {{emotion}}</text>
          <text class="stat-count">{{emotionData.count}}次</text>
        </view>
      </view>
    </view>
  </view>


  <!-- 情绪强度趋势折线图 - 独占一行 -->
  <view class="intensity-trend-section" wx:if="{{chartData && !loading}}">
    <view class="trend-header">
      <view class="trend-title">情绪强度趋势</view>
      <view class="trend-actions">
        <text class="zoom-btn" bindtap="toggleZoom">{{isZoomed ? '缩小' : '放大'}}</text>
      </view>
    </view>
    
    <view class="line-chart-container {{isZoomed ? 'zoomed' : ''}}" bindtap="toggleZoom">
      <!-- 横屏模式关闭按钮 -->
      <view class="zoom-close-btn" wx:if="{{isZoomed}}" bindtap="toggleZoom" catchtap="true">
        <text>✕</text>
      </view>
      
      <view class="chart-wrapper">
        <!-- Y轴标签 -->
        <view class="y-axis">
          <text class="y-label" wx:for="{{yAxisLabels}}" wx:key="*this">{{item}}</text>
        </view>
        
        <!-- 图表区域 -->
        <view class="chart-area">
          <!-- 网格线 -->
          <view class="grid-lines">
            <view class="grid-line" wx:for="{{yAxisLabels}}" wx:key="*this" style="top: {{(index * 100) / (yAxisLabels.length - 1)}}%"></view>
          </view>
          
          <!-- 折线图 -->
          <view class="line-chart">
            <view class="data-points">
                <view 
                  class="data-point" 
                  wx:for="{{chartData}}" 
                  wx:key="date"
                  style="left: {{(index * 100) / (chartData.length - 1)}}%; top: {{100 - (item.averageIntensity * 10)}}%"
                  data-index="{{index}}"
                  data-date="{{item.date}}"
                  data-intensity="{{item.averageIntensity}}"
                >
                <view class="point-dot" style="background-color: {{getEmotionColor(item.dominantEmotion)}}"></view>
                <view class="point-tooltip">
                  <text class="tooltip-date">{{formatDate(item.date)}}</text>
                  <text class="tooltip-intensity">强度: {{item.averageIntensity}}</text>
                </view>
                
                <!-- 调试信息 -->
                <view class="debug-point-info">
                  <text class="debug-emotion">{{item.dominantEmotionEmoji}} {{item.dominantEmotion || '未知'}}</text>
                </view>
              </view>
            </view>
            
            <!-- 连接线 -->
            <!-- <view class="connection-lines">
              <view 
                class="line-segment" 
                wx:for="{{chartData}}" 
                wx:key="date"
                wx:if="{{index < chartData.length - 1}}"
                style="left: {{(index * 100) / (chartData.length - 1)}}%; top: {{100 - (item.averageIntensity * 10)}}%; width: {{100 / (chartData.length - 1)}}%; transform: rotate({{calculateLineAngle(item.averageIntensity, chartData[index + 1].averageIntensity, 100 / (chartData.length - 1))}}deg);"
              ></view>
            </view> -->
          </view>
          
          <!-- X轴标签 -->
          <view class="x-axis">
            <text 
              class="x-label" 
              wx:for="{{chartData}}" 
              wx:key="date"
              wx:if="{{chartData.length > 0}}"
              style="left: {{chartData.length === 1 ? '50%' : chartData.length === 2 ? (index === 0 ? '25%' : '75%') : (index * 100) / (chartData.length - 1)}}%;"
            >{{item.date}}</text>
            <text 
              class="x-label no-data" 
              wx:if="{{chartData.length === 0}}"
              style="left: 50%; transform: translateX(-50%);"
            >暂无数据</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- AI趋势洞察 -->
  <view class="ai-insight-section" wx:if="{{!isZoomed}}">
    <view class="insight-header">
      <view class="insight-title">AI趋势洞察</view>
      <button class="analyze-btn" bindtap="runTrendAnalysis" loading="{{isAnalyzingTrend}}">
        {{isAnalyzingTrend ? '分析中...' : '获取AI分析'}}
      </button>
    </view>
    <view class="insight-content" wx:if="{{trendAnalysisResult}}">
      <text selectable="true">{{trendAnalysisResult}}</text>
    </view>
    <view class="insight-placeholder" wx:if="{{!trendAnalysisResult && !isAnalyzingTrend}}">
      <text>点击按钮，获取AI对您近期情绪趋势的专业分析和建议。</text>
    </view>
  </view>

  <!-- 详细数据 -->
  <view class="detail-data" wx:if="{{chartData && !loading && !isZoomed}}">
    <view class="detail-title">详细数据</view>
    <view class="data-list">
      <view 
        class="data-item" 
        wx:for="{{chartData}}" 
        wx:key="date"
        wx:if="{{item.emotionCount > 0 && (index < 3 || showAllDetails)}}"
      >
        <!-- 左侧情绪信息 -->
        <view class="data-emotion-info">
          <view class="emotion-emoji">{{item.dominantEmotionEmoji}}</view>
          <view class="emotion-type">{{item.dominantEmotion}}</view>
        </view>
        
        <!-- 中间日期信息 -->
        <view class="data-date">{{formatDate(item.date)}}</view>
        
        <!-- 右侧数据信息 -->
        <view class="data-info">
          <text class="data-intensity">情绪强度: {{item.averageIntensity}}</text>
          <text class="data-date-info">{{item.date}}</text>
        </view>
        
        <!-- 右侧情绪标签 -->
        <view 
          class="data-emotion" 
          style="background-color: {{getEmotionColor(item.dominantEmotion)}}"
        >
          {{item.dominantEmotion}}
        </view>
      </view>
      
      <!-- 展开/收起按钮 -->
      <view class="expand-button" wx:if="{{chartData.length > 3}}" bindtap="toggleDetailExpansion">
        <text class="expand-text">{{showAllDetails ? '收起' : '展开全部'}}</text>
        <text class="expand-icon">{{showAllDetails ? '▲' : '▼'}}</text>
      </view>
    </view>
  </view>


  <!-- 加载状态 -->
  <view class="loading" wx:if="{{loading && !isZoomed}}">
    <text>加载中...</text>
  </view>

  <!-- 空状态 -->
  <view class="empty" wx:if="{{!loading && trendData.length === 0 && !isZoomed}}">
    <text class="empty-text">暂无数据</text>
    <text class="empty-desc">开始记录你的心情吧</text>
  </view>
</view>
