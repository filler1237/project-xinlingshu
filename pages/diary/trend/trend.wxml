<!--pages/diary/trend/trend.wxml-->
<navigation-bar title="情绪趋势分析" back="{{true}}"></navigation-bar>

<view class="container">
  <!-- 头部 -->
  <view class="header">
    <view class="title">
      <text>情绪趋势分析</text>
      <view class="date-range">
        <text class="date-text">{{startDate}} 至 {{endDate}}</text>
      </view>
    </view>
  </view>

  <!-- 时间范围选择 -->
  <view class="time-range-selector">
    <button 
      class="range-btn {{timeRange === 'week' ? 'active' : ''}}"
      data-range="week"
      bindtap="selectTimeRange"
    >
      近7天
    </button>
    <button 
      class="range-btn {{timeRange === 'month' ? 'active' : ''}}"
      data-range="month"
      bindtap="selectTimeRange"
    >
      近30天
    </button>
    <button 
      class="range-btn {{timeRange === 'quarter' ? 'active' : ''}}"
      data-range="quarter"
      bindtap="selectTimeRange"
    >
      近90天
    </button>
  </view>

  <!-- 情绪筛选 -->
  <view class="emotion-filter">
    <view class="filter-title">筛选情绪</view>
    <view class="filter-buttons">
      <button 
        class="filter-btn {{selectedEmotion === 'all' ? 'active' : ''}}"
        data-emotion="all"
        bindtap="selectEmotion"
      >
        全部
      </button>
      <button 
        class="filter-btn {{selectedEmotion === item ? 'active' : ''}}"
        wx:for="{{emotionTypes}}" 
        wx:key="*this"
        data-emotion="{{item}}"
        bindtap="selectEmotion"
      >
        {{item}}
      </button>
    </view>
  </view>

  <!-- 情绪统计 -->
  <view class="emotion-stats" wx:if="{{!loading}}">
    <view class="stats-title">情绪分布</view>
    <view class="stats-grid">
      <view 
        class="stat-item" 
        wx:for="{{emotionStats}}" 
        wx:key="*this"
        wx:for-item="count"
        wx:for-index="emotion"
      >
        <view class="stat-color" style="background-color: {{getEmotionColor(emotion)}}"></view>
        <view class="stat-info">
          <text class="stat-emotion">{{emotion}}</text>
          <text class="stat-count">{{count}}次</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 情绪强度趋势折线图 - 独占一行 -->
  <view class="intensity-trend-section" wx:if="{{chartData && !loading}}">
    <view class="trend-header">
      <view class="trend-title">情绪强度趋势</view>
      <view class="trend-actions">
        <text class="zoom-btn" bindtap="toggleZoom">{{isZoomed ? '缩小' : '放大'}}</text>
      </view>
    </view>
    
    <view class="line-chart-container {{isZoomed ? 'zoomed' : ''}}" bindtap="toggleZoom">
      <view class="chart-wrapper">
        <!-- Y轴标签 -->
        <view class="y-axis">
          <text class="y-label" wx:for="{{yAxisLabels}}" wx:key="*this">{{item}}</text>
        </view>
        
        <!-- 图表区域 -->
        <view class="chart-area">
          <!-- 网格线 -->
          <view class="grid-lines">
            <view class="grid-line" wx:for="{{yAxisLabels}}" wx:key="*this" style="top: {{(index * 100) / (yAxisLabels.length - 1)}}%"></view>
          </view>
          
          <!-- 折线图 -->
          <view class="line-chart">
            <view class="data-points">
                <view 
                  class="data-point" 
                  wx:for="{{chartData}}" 
                  wx:key="date"
                  style="left: {{(index * 100) / (chartData.length - 1)}}%; top: {{(item.averageIntensity * 10)}}%"
                  data-index="{{index}}"
                  data-date="{{item.date}}"
                  data-intensity="{{item.averageIntensity}}"
                >
                <view class="point-dot" style="background-color: {{getEmotionColor(item.dominantEmotion)}}"></view>
                <view class="point-tooltip">
                  <text class="tooltip-date">{{formatDate(item.date)}}</text>
                  <text class="tooltip-intensity">强度: {{item.averageIntensity}}</text>
                </view>
              </view>
            </view>
            
              <!-- 连接线 -->
              <view class="connection-lines">
                <view 
                  class="line-segment" 
                  wx:for="{{chartData}}" 
                  wx:key="date"
                  wx:if="{{index < chartData.length - 1}}"
                  style="left: {{(index * 100) / (chartData.length - 1)}}%; top: {{(item.averageIntensity * 10)}}%; width: {{100 / (chartData.length - 1)}}%;"
                ></view>
              </view>
          </view>
          
          <!-- X轴标签 -->
          <view class="x-axis">
            <text class="x-label" wx:for="{{chartData}}" wx:key="date">{{formatDate(item.date)}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 详细数据 -->
  <view class="detail-data" wx:if="{{chartData && !loading}}">
    <view class="detail-title">详细数据</view>
    <view class="data-list">
      <view 
        class="data-item" 
        wx:for="{{chartData}}" 
        wx:key="date"
        wx:if="{{item.emotionCount > 0}}"
      >
        <view class="data-date">{{formatDate(item.date)}}</view>
        <view class="data-info">
          <text class="data-intensity">平均强度: {{item.averageIntensity}}</text>
          <text class="data-count">记录: {{item.emotionCount}}次</text>
        </view>
        <view 
          class="data-emotion" 
          style="background-color: {{getEmotionColor(item.dominantEmotion)}}"
        >
          {{item.dominantEmotion}}
        </view>
      </view>
    </view>
  </view>

  <!-- 操作按钮 -->
  <view class="action-buttons">
    <button class="btn btn-secondary" bindtap="exportData">导出数据</button>
    <button class="btn btn-primary" bindtap="loadTrendData">刷新数据</button>
  </view>

  <!-- 加载状态 -->
  <view class="loading" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>

  <!-- 空状态 -->
  <view class="empty" wx:if="{{!loading && trendData.length === 0}}">
    <text class="empty-text">暂无数据</text>
    <text class="empty-desc">开始记录你的心情吧</text>
  </view>
</view>
