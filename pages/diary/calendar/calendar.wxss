/* pages/diary/calendar/calendar.wxss */
page {
  background-color: #FFFFF5;
}

.container {
  padding: 20rpx;
  background: transparent;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 导航栏 */
.nav-bar {
  display: flex;
  justify-content: center;
  gap: 60rpx;
  background: #E5FFF0;
  padding: 40rpx 30rpx;
  margin-bottom: 20rpx;
  border-radius: 10rpx;
  box-shadow: 0rpx 0rpx 8rpx 0rpx #DCDCC14C;
  width: 100%;
  box-sizing: border-box;
  backdrop-filter: blur(20rpx);
}

.nav-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  padding: 15rpx;
  border-radius: 10rpx;
  transition: all 0.3s ease;
}

.nav-item:active {
  background: rgba(150, 206, 116, 0.2);
  transform: scale(0.95);
}

.nav-icon {
  font-size: 32rpx;
  color: #96CE74;
}

.nav-text {
  font-size: 22rpx;
  color: #333;
  font-weight: 300;
  font-family: PingFang SC;
}

/* 用户引导信息 */
.guidance-info {
  background: #E5FFF0;
  padding: 20rpx;
  margin-bottom: 20rpx;
  border-radius: 10rpx;
  text-align: center;
  box-shadow: 0rpx 0rpx 8rpx 0rpx #DCDCC14C;
}

.guidance-text {
  font-size: 24rpx;
  color: #333;
}

/* 头部 */
.header {
  background: #ffffff;
  padding: 25rpx;
  margin-bottom: 20rpx;
  border-radius: 10rpx;
  box-shadow: 0rpx 0rpx 8rpx 0rpx #DCDCC14C;
  position: relative;
  width: 100%;
  box-sizing: border-box;
  backdrop-filter: blur(20rpx);
}

.month-selector {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.nav-btn {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: #96CE74;
  border: none;
  font-size: 28rpx;
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0rpx 0rpx 8rpx 0rpx #DCDCC14C;
  transition: all 0.3s ease;
}

.nav-btn:active {
  transform: scale(0.95);
  background: #7FB85A;
}

.month-display {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-wrap: nowrap;
  white-space: nowrap;
}

.month-text {
  font-size: 32rpx;
  font-weight: 350;
  color: #333;
  font-family: PingFang SC;
}

.arrow {
  font-size: 24rpx;
  color: #96CE74;
  font-weight: 300;
}

/* 星期标题 */
.weekdays {
  display: flex;
  background: #ffffff;
  border-bottom: 1rpx solid #E5FFF0;
  border-radius: 10rpx 10rpx 0 0;
  margin-bottom: 0;
  width: 100%;
  box-sizing: border-box;
  box-shadow: 0rpx 0rpx 8rpx 0rpx #DCDCC14C;
}

.weekday {
  width: calc(100% / 7);
  text-align: center;
  padding: 25rpx 0;
  font-size: 28rpx;
  color: #96CE74;
  font-weight: 300;
  font-family: PingFang SC;
  border-right: 1rpx solid #E5FFF0;
  box-sizing: border-box;
  position: relative;
}

.weekday:last-child {
  border-right: none;
}
/* 日历网格 */
.calendar-grid {
  display: flex;
  flex-wrap: wrap;
  background: #ffffff;
  margin-bottom: 20rpx;
  border-radius: 0 0 10rpx 10rpx;
  width: 100%;
  box-sizing: border-box;
  box-shadow: 0rpx 0rpx 8rpx 0rpx #DCDCC14C;
}

.calendar-day {
  width: calc(100% / 7);
  height: 120rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  border-right: 1rpx solid #E5FFF0;
  border-bottom: 1rpx solid #E5FFF0;
  transition: all 0.3s ease;
  box-sizing: border-box;
  cursor: pointer;
}

.calendar-day:active {
  background: #E5FFF0;
  transform: scale(0.95);
}

.calendar-day.has-diary {
  cursor: pointer;
  position: relative;
}

.calendar-day.has-diary:active {
  background: rgba(150, 206, 116, 0.1);
  transform: scale(0.95);
}

.calendar-day.has-diary::after {
  content: '';
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 12rpx;
  height: 12rpx;
  background: #96CE74;
  border-radius: 50%;
  opacity: 0.8;
  box-shadow: 0rpx 0rpx 8rpx 0rpx #DCDCC14C;
}

.calendar-day:nth-child(7n) {
  border-right: none;
}

.calendar-day.current-month {
  color: #333;
}

.calendar-day.other-month {
  color: #ccc;
}

.calendar-day.today {
  background: #96CE74;
  color: white;
  font-weight: 350;
  box-shadow: 0rpx 0rpx 8rpx 0rpx #DCDCC14C;
  border-radius: 8rpx;
  margin: 4rpx;
  width: calc(100% / 7 - 8rpx);
  height: calc(120rpx - 8rpx);
}

.calendar-day.today .day-number {
  font-weight: bold;
  font-size: 26rpx;
}

.calendar-day.today .emotion-indicator {
  border-color: rgba(255, 255, 255, 0.9);
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.3);
}

.day-number {
  font-size: 26rpx;
  font-weight: 300;
  margin-bottom: 5rpx;
  font-family: PingFang SC;
}

.emotion-indicator {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  position: absolute;
  bottom: 8rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.9);
  box-shadow: 0 3rpx 8rpx rgba(0, 0, 0, 0.3);
}

/* 情绪图例 */
.emotion-legend {
  background: #ffffff;
  padding: 25rpx;
  border-radius: 10rpx;
  margin-bottom: 20rpx;
  box-shadow: 0rpx 0rpx 8rpx 0rpx #DCDCC14C;
  width: 100%;
  box-sizing: border-box;
  backdrop-filter: blur(20rpx);
}

.legend-title {
  font-size: 32rpx;
  font-weight: 350;
  color: #96CE74;
  margin-bottom: 25rpx;
  font-family: PingFang SC;
  display: flex;
  align-items: center;
}

.legend-title::before {
  content: '';
  width: 6rpx;
  height: 32rpx;
  background: #96CE74;
  margin-right: 15rpx;
  border-radius: 3rpx;
}

.legend-items {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx 16rpx;
  background: #E5FFF0;
  border-radius: 10rpx;
  transition: all 0.3s ease;
  border: 2rpx solid transparent;
}

.legend-item:active {
  background: rgba(150, 206, 116, 0.2);
  border-color: #96CE74;
  transform: scale(0.95);
}

.legend-color {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  flex-shrink: 0;
  box-shadow: 0rpx 0rpx 8rpx 0rpx #DCDCC14C;
}

.legend-emoji {
  font-size: 24rpx;
  flex-shrink: 0;
}

.legend-text {
  font-size: 24rpx;
  color: #333;
  font-weight: 300;
  font-family: PingFang SC;
}

/* 日期选择器 */
.date-picker-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.date-picker-content {
  background: #ffffff;
  border-radius: 10rpx;
  padding: 40rpx;
  margin: 40rpx;
  max-height: 80vh;
  overflow-y: auto;
  min-width: 600rpx;
  box-shadow: 0rpx 0rpx 8rpx 0rpx #DCDCC14C;
  backdrop-filter: blur(20rpx);
}

.picker-title {
  font-size: 36rpx;
  font-weight: 350;
  text-align: center;
  margin-bottom: 40rpx;
  color: #96CE74;
  font-family: PingFang SC;
}

.picker-container {
  display: flex;
  gap: 30rpx;
  margin-bottom: 40rpx;
  justify-content: center;
}

.picker-column {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.picker-label {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 15rpx;
  font-weight: bold;
}

.picker-display {
  padding: 25rpx 35rpx;
  background: #E5FFF0;
  border-radius: 10rpx;
  font-size: 30rpx;
  color: #96CE74;
  text-align: center;
  min-width: 120rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
  font-family: PingFang SC;
  font-weight: 300;
}

.picker-display:active {
  background: rgba(150, 206, 116, 0.2);
  border-color: #96CE74;
  transform: scale(0.98);
}

.picker-actions {
  display: flex;
  gap: 20rpx;
  justify-content: center;
}

.picker-btn {
  padding: 25rpx 45rpx;
  border-radius: 10rpx;
  font-size: 30rpx;
  font-weight: 300;
  border: none;
  min-width: 140rpx;
  transition: all 0.3s ease;
  font-family: PingFang SC;
}

.picker-btn.cancel {
  background: #E5FFF0;
  color: #96CE74;
  border: 2rpx solid #96CE74;
}

.picker-btn.cancel:active {
  background: rgba(150, 206, 116, 0.2);
  transform: scale(0.95);
}

.picker-btn.confirm {
  background: #96CE74;
  color: white;
  box-shadow: 0rpx 0rpx 8rpx 0rpx #DCDCC14C;
}

.picker-btn.confirm:active {
  transform: scale(0.95);
  background: #7FB85A;
}

/* 加载状态 */
.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 200rpx;
  color: #666;
  font-size: 28rpx;
}

/* 日记列表弹窗 */
.diary-list-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.diary-list-content {
  background: #ffffff;
  border-radius: 10rpx;
  margin: 20rpx;
  max-height: 70vh;
  width: calc(100% - 40rpx);
  display: flex;
  flex-direction: column;
  position: relative;
  box-shadow: 0rpx 0rpx 8rpx 0rpx #DCDCC14C;
  backdrop-filter: blur(20rpx);
}

.diary-list-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 40rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.diary-list-title {
  font-size: 36rpx;
  font-weight: 350;
  color: #96CE74;
  font-family: PingFang SC;
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.delete-all-btn {
  font-size: 24rpx;
  color: #ff4757;
  font-weight: bold;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  background: rgba(255, 71, 87, 0.1);
  border: 1rpx solid rgba(255, 71, 87, 0.3);
  transition: all 0.3s ease;
}

.delete-all-btn:active {
  background: rgba(255, 71, 87, 0.2);
  transform: scale(0.95);
}

.close-btn {
  font-size: 40rpx;
  color: #999;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f8f9fa;
}

.diary-list-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  min-height: 0;
}

.diary-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 200rpx;
  color: #666;
  font-size: 28rpx;
}

.diary-deleting {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 200rpx;
  color: #ff4757;
  font-size: 28rpx;
  font-weight: bold;
}

.diary-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 200rpx;
  color: #999;
  font-size: 28rpx;
}

.diary-scroll {
  flex: 1;
  padding: 20rpx;
  height: 0; /* 确保滚动容器有固定高度 */
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}

.diary-item {
  display: flex;
  align-items: center;
  padding: 25rpx;
  margin-bottom: 20rpx;
  background: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  border: 1rpx solid #E5FFF0;
  transition: all 0.2s ease-in-out;
}

.diary-item:active {
  transform: scale(0.98);
  background: #F8F9FA;
}

.diary-item-date {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-right: 25rpx;
  padding-right: 25rpx;
  border-right: 1rpx solid #E5FFF0;
}

.diary-item-date .day {
  font-size: 48rpx;
  font-weight: 500;
  color: #96CE74;
  line-height: 1;
}

.diary-item-date .month {
  font-size: 24rpx;
  color: #999;
}

.diary-item-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  overflow: hidden;
  min-width: 0;
}

.main-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.diary-emotion-tag {
  padding: 6rpx 15rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  color: white;
  font-weight: 400;
}

.diary-weekday {
  font-size: 24rpx;
  color: #999;
}

.main-content {
  width: 100%;
}

.diary-content-preview {
  font-size: 28rpx;
  color: #333;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  display: block;
}

.main-footer {
  width: 100%;
}

.diary-time {
  font-size: 22rpx;
  color: #ccc;
}
