/* pages/diary/calendar/calendar.wxss */
.container {
  background-color: #f8f9fa;
  min-height: 100vh;
}

/* 导航栏 */
.nav-bar {
  display: flex;
  justify-content: center;
  gap: 60rpx;
  background: white;
  padding: 40rpx 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 15rpx rgba(0, 0, 0, 0.08);
  width: 100%;
}

.nav-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  padding: 15rpx;
  border-radius: 20rpx;
  transition: all 0.3s ease;
}

.nav-item:active {
  background: #f8f9fa;
}

.nav-icon {
  font-size: 32rpx;
}

.nav-text {
  font-size: 22rpx;
  color: #666;
}

/* 头部 */
.header {
  background: white;
  padding: 15rpx;
  margin: 0 10rpx;
  border-radius: 15rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
  position: relative;
}

.month-selector {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.nav-btn {
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  background: #f8f9fa;
  border: none;
  font-size: 28rpx;
  color: #667eea;
  display: flex;
  align-items: center;
  justify-content: center;
}

.month-display {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-wrap: nowrap;
  white-space: nowrap;
}

.month-text {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.arrow {
  font-size: 24rpx;
  color: #999;
}

/* 星期标题 */
.weekdays {
  display: flex;
  margin: 0 10rpx;
  background: white;
  border-bottom: 1rpx solid #f0f0f0;
  border-radius: 15rpx 15rpx 0 0;
}

.weekday {
  width: calc(100% / 7);
  text-align: center;
  padding: 20rpx 0;
  font-size: 26rpx;
  color: #666;
  font-weight: bold;
  border-right: 1rpx solid #f0f0f0;
  box-sizing: border-box;
  position: relative;
}

.weekday:last-child {
  border-right: none;
}
/* 日历网格 */
.calendar-grid {
  display: flex;
  flex-wrap: wrap;
  background: white;
  margin: 0 10rpx 20rpx 10rpx;
  border-radius: 0 0 15rpx 15rpx;
}

.calendar-day {
  width: calc(100% / 7);
  height: 100rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  border-right: 1rpx solid #f0f0f0;
  border-bottom: 1rpx solid #f0f0f0;
  transition: all 0.3s ease;
  box-sizing: border-box;
}

.calendar-day:nth-child(7n) {
  border-right: none;
}

.calendar-day.current-month {
  color: #333;
}

.calendar-day.other-month {
  color: #ccc;
}

.calendar-day.today {
  background: #667eea;
  color: white;
  font-weight: bold;
}

.calendar-day.today .day-number {
  font-weight: bold;
}

.day-number {
  font-size: 24rpx;
  font-weight: bold;
  margin-bottom: 3rpx;
}

.emotion-indicator {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  position: absolute;
  bottom: 8rpx;
}

/* 情绪图例 */
.emotion-legend {
  background: white;
  padding: 20rpx;
  border-radius: 15rpx;
  margin: 0 10rpx 20rpx 10rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.legend-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.legend-items {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.legend-color {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
}

.legend-text {
  font-size: 24rpx;
  color: #666;
}

/* 月份选择器 */
.month-picker-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.month-picker-content {
  background: white;
  border-radius: 20rpx;
  padding: 40rpx;
  margin: 40rpx;
  max-height: 80vh;
  overflow-y: auto;
}

.picker-title {
  font-size: 32rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 30rpx;
  color: #333;
}

.year-selector {
  display: flex;
  gap: 20rpx;
  margin-bottom: 30rpx;
  justify-content: center;
}

.year-btn {
  padding: 15rpx 30rpx;
  border-radius: 10rpx;
  background: #f8f9fa;
  color: #666;
  border: none;
  font-size: 24rpx;
}

.year-btn.current {
  background: #667eea;
  color: white;
}

.month-selector {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 15rpx;
}

.month-btn {
  padding: 20rpx;
  border-radius: 10rpx;
  background: #f8f9fa;
  color: #666;
  border: none;
  font-size: 24rpx;
  text-align: center;
}

.month-btn.current {
  background: #667eea;
  color: white;
}

/* 加载状态 */
.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 200rpx;
  color: #666;
  font-size: 28rpx;
}

/* 日记列表弹窗 */
.diary-list-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.diary-list-content {
  background: white;
  border-radius: 20rpx;
  margin: 20rpx;
  max-height: 60vh;
  width: calc(100% - 40rpx);
  display: flex;
  flex-direction: column;
  position: relative;
}

.diary-list-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 40rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.diary-list-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.delete-all-btn {
  font-size: 24rpx;
  color: #ff4757;
  font-weight: bold;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  background: rgba(255, 71, 87, 0.1);
  border: 1rpx solid rgba(255, 71, 87, 0.3);
  transition: all 0.3s ease;
}

.delete-all-btn:active {
  background: rgba(255, 71, 87, 0.2);
  transform: scale(0.95);
}

.close-btn {
  font-size: 40rpx;
  color: #999;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f8f9fa;
}

.diary-list-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  min-height: 0;
}

.diary-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 200rpx;
  color: #666;
  font-size: 28rpx;
}

.diary-deleting {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 200rpx;
  color: #ff4757;
  font-size: 28rpx;
  font-weight: bold;
}

.diary-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 200rpx;
  color: #999;
  font-size: 28rpx;
}

.diary-scroll {
  flex: 1;
  padding: 20rpx;
  height: 0; /* 确保滚动容器有固定高度 */
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}

.diary-item {
  background: #f8f9fa;
  border-radius: 15rpx;
  padding: 15rpx;
  margin-bottom: 15rpx;
  border-left: 6rpx solid #667eea;
  transition: all 0.3s ease;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  width: 100%;
}

.diary-item:active {
  background: #e9ecef;
  transform: scale(0.98);
}

.diary-item-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 10rpx;
  flex-shrink: 0;
}

.diary-date-section {
  display: flex;
  flex-direction: column;
  gap: 5rpx;
}

.diary-date {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.diary-weekday {
  font-size: 22rpx;
  color: #666;
}

.diary-emotion-section {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

.diary-emotion-tag {
  padding: 6rpx 12rpx;
  border-radius: 15rpx;
  font-size: 20rpx;
  color: white;
  font-weight: bold;
  min-width: 60rpx;
  text-align: center;
}

.diary-intensity {
  font-size: 18rpx;
  color: rgb(153, 153, 153);
  background: #f0f0f0;
  padding: 4rpx 8rpx;
  border-radius: 10rpx;
}

.diary-content-wrapper {
  margin-bottom: 10rpx;
  flex-shrink: 0;
}

.diary-content {
  font-size: 28rpx;
  color: rgb(68, 63, 63);
  line-height: 1.5;
  word-wrap: break-word;
  word-break: break-all;
  white-space: pre-wrap;
  display: block;
}

.diary-info-section {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
  flex-shrink: 0;
  padding: 5rpx 0;
  width: 100%;
  box-sizing: border-box;
  overflow: hidden;
}

.diary-date-emotion {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex: 1;
  margin-right: 10rpx;
  min-width: 0;
  overflow: hidden;
}

.diary-record-date {
  font-size: 20rpx;
  color: rgb(63, 59, 59);
  font-weight: bold;
  max-width: 100rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.diary-record-emotion {
  padding: 2rpx 8rpx;
  border-radius: 10rpx;
  font-size: 32rpx;
  color: rgb(201, 87, 87);
  font-weight: bold;
  min-width: 50rpx;
  text-align: center;
}

.diary-preview {
  font-size: 18rpx;
  color: #667eea;
  font-weight: bold;
  white-space: nowrap; /* 防止换行 */
  flex-shrink: 0; /* 防止被压缩 */
  max-width: 120rpx; /* 限制最大宽度 */
  overflow: hidden;
  text-overflow: ellipsis;
}

.diary-footer {
  display: flex;
  justify-content: flex-start;
  align-items: center;
  flex-shrink: 0;
  padding: 5rpx 0;
}

.diary-time {
  font-size: 18rpx;
  color: #999;
}

/* 调试按钮 */
.debug-btn {
  background: #667eea;
  color: white;
  border-radius: 20rpx;
  font-size: 20rpx;
  padding: 10rpx 20rpx;
  border: none;
  box-shadow: 0 4rpx 10rpx rgba(102, 126, 234, 0.3);
}
