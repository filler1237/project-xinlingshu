<!--pages/diary/calendar/calendar.wxml-->
<navigation-bar title="日记日历" back="{{true}}"></navigation-bar>

<view class="container">
  <!-- 导航栏 - 移到最上方 -->
  <view class="nav-bar">
    <view class="nav-item" bindtap="goToCreate">
      <text class="nav-icon">✏️</text>
      <text class="nav-text">写日记</text>
    </view>
    <view class="nav-item" bindtap="showDiaryList">
      <text class="nav-icon">📝</text>
      <text class="nav-text">我的日记</text>
    </view>
    <view class="nav-item" bindtap="goToTrend">
      <text class="nav-icon">📊</text>
      <text class="nav-text">趋势分析</text>
    </view>
  </view>
  
  <!-- 头部 -->
  <view class="header">
    <view class="month-selector">
      <button class="nav-btn" bindtap="prevMonth">‹</button>
      <view class="month-display" bindtap="showDatePicker">
        <text class="month-text">{{currentYear}}年{{currentMonth}}月</text>
        <text class="arrow">▼</text>
      </view>
      <button class="nav-btn" bindtap="nextMonth">›</button>
    </view>
  </view>

  <!-- 星期标题 -->
  <view class="weekdays">
    <text class="weekday" wx:for="{{['日', '一', '二', '三', '四', '五', '六']}}" wx:key="*this">
      {{item}}
    </text>
  </view>

  <!-- 日历网格 -->
  <view class="calendar-grid">
    <view 
      class="calendar-day {{item.isCurrentMonth ? 'current-month' : 'other-month'}} {{item.isToday ? 'today' : ''}} {{item.emotionType ? 'has-diary' : ''}}"
      wx:for="{{daysInMonth}}" 
      wx:key="date"
      bindtap="onDayClick"
      data-date="{{item.date}}"
      data-emotion-type="{{item.emotionType}}"
      data-diary-id="{{item.diaryId}}"
    >
      <view class="day-number">{{item.day}}</view>
      <view 
        class="emotion-indicator"
        wx:if="{{item.emotionType}}"
        style="background-color: {{item.emotionColor}}; {{item.intensityStyle}}"
      ></view>
    </view>
  </view>

  <!-- 情绪图例 -->
  <view class="emotion-legend">
    <view class="legend-title">情绪图例</view>
    <view class="legend-items">
      <view 
        class="legend-item" 
        wx:for="{{emotionColors}}" 
        wx:key="*this"
        wx:for-item="color"
        wx:for-index="emotion"
      >
        <view class="legend-color" style="background-color: {{color}}"></view>
        <text class="legend-emoji">{{getEmotionEmoji(emotion)}}</text>
        <text class="legend-text">{{emotion}}</text>
      </view>
    </view>
  </view>

  <!-- 日期选择器 -->
  <view class="date-picker-modal" wx:if="{{showDatePicker}}" bindtap="hideDatePicker">
    <view class="date-picker-content" catchtap="">
      <view class="picker-title">选择日期</view>
      
      <!-- 年月日选择器 -->
      <view class="picker-container">
        <view class="picker-column">
          <text class="picker-label">年</text>
          <picker 
            mode="selector" 
            range="{{yearList}}" 
            value="{{yearList.indexOf(selectedYear)}}"
            bindchange="selectYear"
          >
            <view class="picker-display">{{selectedYear}}年</view>
          </picker>
        </view>
        
        <view class="picker-column">
          <text class="picker-label">月</text>
          <picker 
            mode="selector" 
            range="{{monthList}}" 
            value="{{selectedMonth - 1}}"
            bindchange="selectMonth"
          >
            <view class="picker-display">{{selectedMonth}}月</view>
          </picker>
        </view>
        
        <view class="picker-column">
          <text class="picker-label">日</text>
          <picker 
            mode="selector" 
            range="{{dayList}}" 
            value="{{selectedDay - 1}}"
            bindchange="selectDay"
          >
            <view class="picker-display">{{selectedDay}}日</view>
          </picker>
        </view>
      </view>
      
      <!-- 操作按钮 -->
      <view class="picker-actions">
        <button class="picker-btn cancel" bindtap="hideDatePicker">取消</button>
        <button class="picker-btn confirm" bindtap="confirmDateSelection">确定</button>
      </view>
    </view>
  </view>

  <!-- 日记列表弹窗 -->
  <view class="diary-list-modal" wx:if="{{showDiaryListModal}}" bindtap="hideDiaryList">
    <view class="diary-list-content" catchtap="">
      <view class="diary-list-header">
        <text class="diary-list-title">我的日记</text>
        <view class="header-actions">
          <text class="delete-all-btn" bindtap="showDeleteAllConfirm" wx:if="{{diaryList.length > 0}}">清空</text>
          <text class="close-btn" bindtap="hideDiaryList">×</text>
        </view>
      </view>
      
      <view class="diary-list-body">
        <view class="diary-loading" wx:if="{{diaryListLoading}}">
          <text>加载中...</text>
        </view>
        
        <view class="diary-deleting" wx:elif="{{isDeletingAll}}">
          <text>正在删除所有日记...</text>
        </view>
        
        <view class="diary-empty" wx:elif="{{diaryList.length === 0}}">
          <text>还没有写过日记</text>
        </view>
        
        <scroll-view class="diary-scroll" scroll-y="true" wx:else>
          <view 
            class="diary-item" 
            wx:for="{{diaryList}}" 
            wx:key="_id"
            bindtap="viewDiaryDetail"
            data-id="{{item._id}}"
          >
            <view class="diary-item-header">
              <view class="diary-date-section">
                <text class="diary-date">{{formatDate(item.date)}}</text>
                <text class="diary-weekday">{{formatWeekday(item.date)}}</text>
              </view>
              <view class="diary-emotion-section">
                <view 
                  class="diary-emotion-tag" 
                  wx:if="{{item.emotionType}}"
                  style="background-color: {{getEmotionColor(item.emotionType)}}"
                >
                  {{item.emotionType}}
                </view>
                <view 
                  class="diary-intensity" 
                  wx:if="{{item.emotionIntensity !== null && item.emotionIntensity !== undefined}}"
                >
                  强度: {{item.emotionIntensity}}/10
                </view>
              </view>
            </view>
            <view class="diary-content-wrapper">
              <text class="diary-content">{{item.content}}</text>
            </view>
            <view class="diary-info-section">
              <view class="diary-date-emotion">
                <text class="diary-record-date">{{formatDate(item.date)}}</text>
                <view 
                  class="diary-record-emotion" 
                  wx:if="{{item.emotionType}}"
                  style="background-color: {{getEmotionColor(item.emotionType)}}"
                >
                  {{item.emotionType}}
                </view>
              </view>
              <text class="diary-preview">点击查看详情</text>
            </view>
            <view class="diary-footer">
              <text class="diary-time">{{formatTime(item.createdAt)}}</text>
            </view>
          </view>
        </scroll-view>
      </view>
    </view>
  </view>


  <!-- 加载状态 -->
  <view class="loading" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>
</view>
