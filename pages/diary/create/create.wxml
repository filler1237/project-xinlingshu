<!--pages/diary/create/create.wxml-->
<navigation-bar title="记录心情" back="{{true}}"></navigation-bar>

<view class="container">
  <!-- 头部 -->
  <view class="header">
    <view class="title">记录心情</view>
    <view class="warm-prompt">
      <text>💡十分感谢您选择在这里记录心情，无论今天是晴天还是雨天，这里永远是您的专属日记，随时等待您的倾诉</text>
    </view>
    <view class="date-picker">
      <picker mode="date" value="{{date}}" bindchange="onDateChange">
        <view class="date-display">
          <text class="date-text">{{date}}</text>
          <text class="date-icon">📅</text>
        </view>
      </picker>
    </view>
  </view>

  <!-- 情绪类型选择器 -->
  <view class="emotion-section">
    <view class="section-title">情绪类型</view>
    <view class="emotion-emoji-selector">
      <view 
        wx:for="{{emotionOptions}}" 
        wx:key="item.name" 
        class="emotion-emoji-item {{selectedEmotionType === item.name ? 'selected' : ''}}"
        bindtap="selectEmotionType"
        data-emotion="{{item.name}}"
      >
        <text class="emoji">{{item.emoji}}</text>
        <text class="emoji-name">{{item.name}}</text>
      </view>
    </view>
  </view>

  <!-- 情绪强度选择器 -->
  <view class="intensity-section">
    <view class="section-title">情绪强度</view>
    <view class="intensity-display">
      <text class="intensity-label">强度: {{emotionIntensity}}/10</text>
      <slider 
        value="{{emotionIntensity}}" 
        min="1" 
        max="10" 
        step="1"
        bindchange="onEmotionIntensityChange"
        activeColor="#96CE74"
        backgroundColor="#E5FFF0"
        block-size="20"
      />
    </view>
  </view>

  <!-- 日记内容输入 -->
  <view class="content-section">
    <view class="section-title">
      <view class="title-text">日记内容</view>
      <view class="clear-btn" bindtap="clearContent">清空</view>
    </view>
    <textarea 
      class="content-input"
      placeholder="记录今天的心情和感受..."
      value="{{content}}"
      bindinput="onContentInput"
      maxlength="2000"
      show-confirm-bar="{{false}}"
      auto-height
    />
    <view class="char-count">{{content.length}}/2000</view>
  </view>

  <!-- 提交按钮 -->
  <view class="submit-section">
    <button 
      class="btn btn-primary submit-btn" 
      bindtap="submitDiary"
      disabled="{{isSubmitting || isAnalyzing}}"
      loading="{{isSubmitting}}"
    >
      <text wx:if="{{isAnalyzing}}">AI分析中...</text>
      <text wx:elif="{{isSubmitting}}">保存中...</text>
      <text wx:else>保存日记</text>
    </button>
  </view>
</view>
