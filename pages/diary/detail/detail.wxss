/* pages/diary/detail/detail.wxss */
.container {
  padding: 20rpx;
  background-color: #f8f9fa;
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: 120rpx; /* 为底部按钮留出空间 */
}

/* 加载和错误状态 */
.loading,
.error {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 400rpx;
  color: #666;
  font-size: 28rpx;
}

.retry-btn {
  margin-top: 20rpx;
  padding: 15rpx 30rpx;
  background: #667eea;
  color: white;
  border-radius: 10rpx;
  font-size: 24rpx;
}

/* 日记内容 */
.diary-content {
  background: white;
  border-radius: 15rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
  width: 100%;
  box-sizing: border-box;
}

/* 头部 */
.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 25rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  min-height: 120rpx;
  width: 100%;
  box-sizing: border-box;
  position: relative;
  box-shadow: 0 4rpx 15rpx rgba(102, 126, 234, 0.3);
}

.date-info {
  display: flex !important;
  flex-direction: column;
  gap: 8rpx;
  flex: 1;
  padding-right: 20rpx;
  min-width: 200rpx;
  visibility: visible !important;
  opacity: 1 !important;
}

.date {
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.3);
  color: white !important;
  letter-spacing: 1rpx;
  display: block !important;
  line-height: 1.2;
  white-space: nowrap;
  visibility: visible !important;
  opacity: 1 !important;
}

.weekday {
  font-size: 26rpx;
  opacity: 0.95;
  font-weight: 600;
  color: white !important;
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.2);
  margin-bottom: 5rpx;
  display: block !important;
  visibility: visible !important;
}

.time {
  font-size: 24rpx;
  opacity: 0.9;
  font-weight: 500;
  color: white !important;
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.2);
  background: rgba(255, 255, 255, 0.2);
  padding: 4rpx 8rpx;
  border-radius: 6rpx;
  backdrop-filter: blur(10rpx);
  display: block !important;
  visibility: visible !important;
}

.debug-text {
  font-size: 32rpx;
  color: white !important;
  padding: 4rpx 8rpx;
  border-radius: 6rpx;
  display: block !important;
  visibility: visible !important;
  margin-bottom: 4rpx;
}

.emotion-badge {
  padding: 20rpx 30rpx;
  border-radius: 30rpx;
  backdrop-filter: blur(15rpx);
  min-width: 140rpx;
  text-align: center;
  background: rgba(255, 255, 255, 0.15);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.1);
}

.emotion-text {
  font-size: 28rpx;
  font-weight: bold;
  color: white;
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.2);
}

/* 情绪分析 */
.emotion-analysis {
  padding: 25rpx;
  border-bottom: 1rpx solid #f0f0f0;
  width: 100%;
  box-sizing: border-box;
}

.analysis-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
}

.analysis-title::before {
  content: '';
  width: 6rpx;
  height: 30rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  margin-right: 15rpx;
  border-radius: 3rpx;
}

.intensity-info {
  display: flex;
  align-items: center;
  margin-bottom: 25rpx;
  gap: 15rpx;
}

.intensity-label {
  font-size: 26rpx;
  color: #666;
  font-weight: 500;
}

.intensity-value {
  font-size: 32rpx;
  color: #333;
  font-weight: bold;
  background: #f8f9fa;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  border: 2rpx solid #e9ecef;
}

/* AI回复 */
.ai-reply {
  margin-bottom: 30rpx;
}

.reply-title {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 15rpx;
  font-weight: bold;
}

.reply-content {
  background: #f8f9fa;
  padding: 25rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  line-height: 1.8;
  color: #333;
  border-left: 6rpx solid #667eea;
  word-wrap: break-word;
  word-break: break-all;
  width: 100%;
  box-sizing: border-box;
  min-height: 120rpx;
  display: flex;
  align-items: flex-start;
}


/* 内容区域 */
.content-section {
  padding: 25rpx;
  width: 100%;
  box-sizing: border-box;
}

.content-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 15rpx;
  padding-bottom: 10rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.content-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.content-date {
  font-size: 24rpx;
  color: #666;
  font-weight: 500;
  background: #f8f9fa;
  padding: 6rpx 12rpx;
  border-radius: 8rpx;
  border: 1rpx solid #e9ecef;
}

.content-text {
  font-size: 28rpx;
  line-height: 1.8;
  color: #333;
  white-space: pre-wrap;
  word-wrap: break-word;
  word-break: break-all;
  width: 100%;
  box-sizing: border-box;
}

/* 操作按钮 */
.action-buttons {
  display: flex;
  gap: 15rpx;
  padding: 25rpx;
  background: #f8f9fa;
  width: 100%;
  box-sizing: border-box;
  flex-wrap: wrap;
}

.btn {
  flex: 1;
  padding: 18rpx 12rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  border: none;
  text-align: center;
  min-width: 0;
  max-width: calc(25% - 12rpx);
  box-sizing: border-box;
}

.btn-primary {
  background: #667eea;
  color: white;
}

.btn-secondary {
  background: #6c757d;
  color: white;
}

.btn-danger {
  background: #dc3545;
  color: white;
}

.btn:disabled {
  opacity: 0.6;
}
