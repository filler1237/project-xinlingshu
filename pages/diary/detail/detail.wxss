/* pages/diary/detail/detail.wxss */
.container {
  padding: 20rpx;
  background-color: #f8f9fa;
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: 120rpx; /* 为底部按钮留出空间 */
}

/* 加载和错误状态 */
.loading,
.error {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 400rpx;
  color: #666;
  font-size: 28rpx;
}

.retry-btn {
  margin-top: 20rpx;
  padding: 15rpx 30rpx;
  background: #667eea;
  color: white;
  border-radius: 10rpx;
  font-size: 24rpx;
}

/* 日记内容 */
.diary-content {
  background: white;
  border-radius: 15rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
  width: 100%;
  box-sizing: border-box;
}

/* 头部 */
.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 25rpx 20rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  min-height: 100rpx;
  width: 100%;
  box-sizing: border-box;
}

.date-info {
  display: flex;
  flex-direction: column;
}

.date {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.time {
  font-size: 26rpx;
  opacity: 0.8;
}

.emotion-badge {
  padding: 18rpx 28rpx;
  border-radius: 25rpx;
  backdrop-filter: blur(10rpx);
  min-width: 120rpx;
  text-align: center;
}

.emotion-text {
  font-size: 26rpx;
  font-weight: bold;
  color: white;
}

/* 情绪分析 */
.emotion-analysis {
  padding: 25rpx;
  border-bottom: 1rpx solid #f0f0f0;
  width: 100%;
  box-sizing: border-box;
}

.analysis-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
}

.analysis-title::before {
  content: '';
  width: 6rpx;
  height: 30rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  margin-right: 15rpx;
  border-radius: 3rpx;
}

.intensity-info {
  display: flex;
  align-items: center;
  margin-bottom: 25rpx;
  gap: 20rpx;
  flex-wrap: wrap;
}

.intensity-label {
  font-size: 26rpx;
  color: #666;
  min-width: 80rpx;
  font-weight: 500;
}

.intensity-bar {
  flex: 1;
  height: 16rpx;
  background: #e9ecef;
  border-radius: 8rpx;
  overflow: hidden;
  min-width: 120rpx;
}

.intensity-fill {
  height: 100%;
  border-radius: 8rpx;
  transition: width 0.3s ease;
}

.intensity-value {
  font-size: 26rpx;
  color: #666;
  min-width: 100rpx;
  font-weight: 500;
}

.intensity-desc {
  font-size: 26rpx;
  color: #999;
  font-weight: 500;
}

/* AI回复 */
.ai-reply {
  margin-bottom: 20rpx;
}

.reply-title {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.reply-content {
  background: #f8f9fa;
  padding: 20rpx;
  border-radius: 10rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #333;
  border-left: 4rpx solid #667eea;
  word-wrap: break-word;
  word-break: break-all;
  width: 100%;
  box-sizing: border-box;
}

/* 关键词 */
.keywords {
  margin-bottom: 20rpx;
}

.keywords-title {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 15rpx;
}

.keywords-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.keyword-tag {
  background: #e9ecef;
  color: #495057;
  padding: 6rpx 12rpx;
  border-radius: 15rpx;
  font-size: 22rpx;
  margin: 2rpx;
  display: inline-block;
  white-space: nowrap;
}

/* 内容区域 */
.content-section {
  padding: 25rpx;
  width: 100%;
  box-sizing: border-box;
}

.content-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 15rpx;
}

.content-text {
  font-size: 28rpx;
  line-height: 1.8;
  color: #333;
  white-space: pre-wrap;
  word-wrap: break-word;
  word-break: break-all;
  width: 100%;
  box-sizing: border-box;
}

/* 操作按钮 */
.action-buttons {
  display: flex;
  gap: 15rpx;
  padding: 25rpx;
  background: #f8f9fa;
  width: 100%;
  box-sizing: border-box;
  flex-wrap: wrap;
}

.btn {
  flex: 1;
  padding: 18rpx 12rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  border: none;
  text-align: center;
  min-width: 0;
  max-width: calc(25% - 12rpx);
  box-sizing: border-box;
}

.btn-primary {
  background: #667eea;
  color: white;
}

.btn-secondary {
  background: #6c757d;
  color: white;
}

.btn-danger {
  background: #dc3545;
  color: white;
}

.btn:disabled {
  opacity: 0.6;
}
