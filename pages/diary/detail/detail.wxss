/* pages/diary/detail/detail.wxss */
page {
  background-color: #FFFFF5;
}

.container {
  padding: 20rpx;
  background: transparent;
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: 120rpx; /* 为底部按钮留出空间 */
}

/* 加载和错误状态 */
.loading,
.error {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 400rpx;
  color: #666;
  font-size: 28rpx;
}

.retry-btn {
  margin-top: 20rpx;
  padding: 15rpx 30rpx;
  background: #96CE74;
  color: white;
  border-radius: 10rpx;
  font-size: 24rpx;
  font-family: PingFang SC;
  font-weight: 300;
  box-shadow: 0rpx 0rpx 8rpx 0rpx #DCDCC14C;
}

.retry-btn:active {
  background: #7FB85A;
  transform: scale(0.98);
}

/* 日记内容 */
.diary-content {
  background: #ffffff;
  border-radius: 10rpx;
  overflow: hidden;
  box-shadow: 0rpx 0rpx 8rpx 0rpx #DCDCC14C;
  width: 100%;
  box-sizing: border-box;
  backdrop-filter: blur(20rpx);
}

/* 头部 */
.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 25rpx;
  background: #E5FFF0;
  color: #96CE74;
  min-height: 120rpx;
  width: 100%;
  box-sizing: border-box;
  position: relative;
  box-shadow: 0rpx 0rpx 8rpx 0rpx #DCDCC14C;
  backdrop-filter: blur(20rpx);
}

.date-info {
  display: flex !important;
  flex-direction: column;
  gap: 8rpx;
  flex: 1;
  padding-right: 20rpx;
  min-width: 200rpx;
  visibility: visible !important;
  opacity: 1 !important;
}

.date {
  font-size: 40rpx;
  font-weight: 350;
  margin-bottom: 8rpx;
  color: #96CE74 !important;
  letter-spacing: 1rpx;
  display: block !important;
  line-height: 1.2;
  white-space: nowrap;
  visibility: visible !important;
  opacity: 1 !important;
  font-family: PingFang SC;
}

.weekday {
  font-size: 26rpx;
  opacity: 0.95;
  font-weight: 300;
  color: #96CE74 !important;
  margin-bottom: 5rpx;
  display: block !important;
  visibility: visible !important;
  font-family: PingFang SC;
}

.time {
  font-size: 24rpx;
  opacity: 0.9;
  font-weight: 300;
  color: #96CE74 !important;
  background: rgba(150, 206, 116, 0.2);
  padding: 4rpx 8rpx;
  border-radius: 6rpx;
  backdrop-filter: blur(10rpx);
  display: block !important;
  visibility: visible !important;
  font-family: PingFang SC;
}

.debug-text {
  font-size: 32rpx;
  color: #333 !important;
  padding: 4rpx 8rpx;
  border-radius: 6rpx;
  display: block !important;
  visibility: visible !important;
  margin-bottom: 4rpx;
  font-family: PingFang SC;
  font-weight: 300;
}

.emotion-badge {
  padding: 20rpx 30rpx;
  border-radius: 30rpx;
  backdrop-filter: blur(15rpx);
  min-width: 140rpx;
  text-align: center;
  background: rgba(255, 255, 255, 0.8);
  border: 2rpx solid rgba(150, 206, 116, 0.3);
  box-shadow: 0rpx 0rpx 8rpx 0rpx #DCDCC14C;
}

.emotion-text {
  font-size: 28rpx;
  font-weight: 300;
  color: #333;
  font-family: PingFang SC;
}

/* 情绪分析 */
.emotion-analysis {
  padding: 25rpx;
  border-bottom: 1rpx solid #E5FFF0;
  width: 100%;
  box-sizing: border-box;
}

.analysis-title {
  font-size: 32rpx;
  font-weight: 350;
  color: #96CE74;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  font-family: PingFang SC;
}

.analysis-title::before {
  content: '';
  width: 6rpx;
  height: 32rpx;
  background: #96CE74;
  margin-right: 15rpx;
  border-radius: 3rpx;
}

.intensity-info {
  display: flex;
  align-items: center;
  margin-bottom: 25rpx;
  gap: 15rpx;
}

.intensity-label {
  font-size: 26rpx;
  color: #666;
  font-weight: 300;
  font-family: PingFang SC;
}

.intensity-value {
  font-size: 32rpx;
  color: #333;
  font-weight: 300;
  background: #f8f9fa;
  padding: 8rpx 16rpx;
  border-radius: 10rpx;
  border: 2rpx solid #e9ecef;
  font-family: PingFang SC;
}

/* AI回复 */
.ai-reply {
  margin-bottom: 30rpx;
}

.reply-title {
  font-size: 28rpx;
  color: #96CE74;
  margin-bottom: 15rpx;
  font-weight: 350;
  font-family: PingFang SC;
}

.reply-content {
  background: #E5FFF0;
  padding: 25rpx;
  border-radius: 10rpx;
  font-size: 28rpx;
  line-height: 1.8;
  color: #333;
  border-left: 6rpx solid #96CE74;
  word-wrap: break-word;
  word-break: break-all;
  width: 100%;
  box-sizing: border-box;
  min-height: 120rpx;
  display: flex;
  align-items: flex-start;
  font-family: PingFang SC;
  font-weight: 300;
}

/* 情绪电台 */
.emotion-radio {
  padding: 25rpx;
  border-bottom: 1rpx solid #E5FFF0;
}

.radio-title {
  font-size: 32rpx;
  font-weight: 350;
  color: #96CE74;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  font-family: PingFang SC;
}

.radio-title::before {
  content: '';
  width: 6rpx;
  height: 32rpx;
  background: #96CE74;
  margin-right: 15rpx;
  border-radius: 3rpx;
}

.recommendation-card {
  background: #f8f9fa;
  border-radius: 10rpx;
  padding: 25rpx;
  border: 2rpx solid #e9ecef;
}

.rec-type {
  font-size: 24rpx;
  font-weight: 300;
  color: #fff;
  background-color: #96CE74;
  padding: 5rpx 15rpx;
  border-radius: 20rpx;
  display: inline-block;
  margin-bottom: 15rpx;
}

.rec-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.rec-author {
  font-size: 26rpx;
  color: #888;
  margin-bottom: 20rpx;
  text-align: right;
}

.rec-reason {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}


/* 内容区域 */
.content-section {
  padding: 25rpx;
  width: 100%;
  box-sizing: border-box;
}

.content-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 15rpx;
  padding-bottom: 10rpx;
  border-bottom: 1rpx solid #E5FFF0;
}

.content-title {
  font-size: 32rpx;
  font-weight: 350;
  color: #96CE74;
  font-family: PingFang SC;
  display: flex;
  align-items: center;
}

.content-title::before {
  content: '';
  width: 6rpx;
  height: 32rpx;
  background: #96CE74;
  margin-right: 15rpx;
  border-radius: 3rpx;
}

.content-date {
  font-size: 24rpx;
  color: #96CE74;
  font-weight: 300;
  background: #E5FFF0;
  padding: 6rpx 12rpx;
  border-radius: 10rpx;
  border: 2rpx solid #96CE74;
  font-family: PingFang SC;
}

.content-text {
  font-size: 28rpx;
  line-height: 1.8;
  color: #333;
  white-space: pre-wrap;
  word-wrap: break-word;
  word-break: break-all;
  width: 100%;
  box-sizing: border-box;
  font-family: PingFang SC;
  font-weight: 300;
}

/* 操作按钮 */
.action-buttons {
  display: flex;
  gap: 15rpx;
  padding: 25rpx;
  background: #E5FFF0;
  width: 100%;
  box-sizing: border-box;
  flex-wrap: wrap;
}

.btn {
  flex: 1;
  padding: 18rpx 12rpx;
  border-radius: 10rpx;
  font-size: 24rpx;
  border: none;
  text-align: center;
  min-width: 0;
  box-sizing: border-box;
  font-family: PingFang SC;
  font-weight: 300;
  transition: all 0.3s ease;
}

.btn-primary {
  background: #96CE74;
  color: white;
  box-shadow: 0rpx 0rpx 8rpx 0rpx #DCDCC14C;
}

.btn-primary:active {
  background: #7FB85A;
  transform: scale(0.98);
}

.btn-secondary {
  background: #E5FFF0;
  color: #96CE74;
  border: 2rpx solid #96CE74;
}

.btn-secondary:active {
  background: rgba(150, 206, 116, 0.2);
  transform: scale(0.98);
}

.btn-danger {
  background: #FFE5E5;
  color: #FF6B6B;
  border: 2rpx solid #FF6B6B;
}

.btn-danger:active {
  background: rgba(255, 107, 107, 0.2);
  transform: scale(0.98);
}

.btn:disabled {
  opacity: 0.6;
}
