<!--pages/diary/detail/detail.wxml-->
<navigation-bar title="日记详情" back="{{true}}"></navigation-bar>

<view class="container">
  <!-- 加载状态 -->
  <view class="loading" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>

  <!-- 错误状态 -->
  <view class="error" wx:elif="{{error}}">
    <text>{{error}}</text>
    <button class="retry-btn" bindtap="loadDiaryEntry">重试</button>
  </view>

  <!-- 日记内容 -->
  <view class="diary-content" wx:elif="{{diaryEntry}}">
    <!-- 头部信息 -->
    <view class="header">
      <view class="date-info">
        <text class="date">{{formatDate(diaryEntry.date)}}</text>
        <text class="weekday">{{formatWeekday(diaryEntry.date)}}</text>
        <text class="time">{{formatTime(diaryEntry.createdAt)}}</text>
        <text class="debug-text">创建日期: {{diaryEntry.date}}</text>
        
      </view>
      <view class="emotion-badge" style="background-color: {{getEmotionColor(diaryEntry.emotionType)}}">
        <text class="emotion-text">{{diaryEntry.emotionType || '未分析'}}</text>
      </view>
    </view>

    <!-- 情绪分析 -->
    <view class="emotion-analysis" wx:if="{{diaryEntry.emotionType}}">
      <view class="analysis-title">情绪分析</view>
      <view class="intensity-info">
        <text class="intensity-label">强度：</text>
        <text class="intensity-value">{{diaryEntry.emotionIntensity || 0}}</text>
      </view>
      
      <!-- AI回复 -->
      <view class="ai-reply" wx:if="{{diaryEntry.empathyReply}}">
        <view class="reply-title">AI回复</view>
        <view class="reply-content">{{diaryEntry.empathyReply}}</view>
      </view>

    </view>

    <!-- 情绪电台 -->
    <view class="emotion-radio" wx:if="{{diaryEntry.recommendation}}">
      <view class="radio-title">情绪电台</view>
      <view class="recommendation-card">
        <view class="rec-type">{{diaryEntry.recommendation.type}}</view>
        <view class="rec-title">{{diaryEntry.recommendation.title}}</view>
        <view class="rec-author" wx:if="{{diaryEntry.recommendation.author}}">—— {{diaryEntry.recommendation.author}}</view>
        <view class="rec-reason">{{diaryEntry.recommendation.reason}}</view>
      </view>
    </view>

    <!-- 日记内容 -->
    <view class="content-section">
      <view class="content-header">
        <view class="content-title">日记内容</view>
        <view class="content-date">{{formatDate(diaryEntry.date)}} {{formatWeekday(diaryEntry.date)}}</view>
      </view>
      <view class="content-text">{{diaryEntry.content}}</view>
    </view>

    <!-- 操作按钮 -->
    <view class="action-buttons">
      <button class="btn btn-primary" bindtap="reanalyzeDiary" loading="{{isAnalyzing}}">
        <text wx:if="{{isAnalyzing}}">重新分析中...</text>
        <text wx:else>重新分析</text>
      </button>
      <button class="btn btn-secondary" bindtap="copyContent">复制AI回复</button>
      <button class="btn btn-danger" bindtap="deleteDiary">删除</button>
    </view>
  </view>
</view>
<!-- 水滴动画组件 -->
<water-drop-effect id="waterDropEffect" />
