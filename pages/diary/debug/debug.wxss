/* pages/diary/debug/debug.wxss */
.container {
  padding: 20rpx;
  background-color: #f8f9fa;
  min-height: 100vh;
}

.debug-section {
  background: white;
  border-radius: 15rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  border-left: 6rpx solid #667eea;
  padding-left: 15rpx;
}

.debug-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 15rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.debug-item:last-child {
  border-bottom: none;
}

.label {
  font-size: 24rpx;
  color: #666;
  font-weight: bold;
}

.value {
  font-size: 24rpx;
  color: #333;
  background: #f8f9fa;
  padding: 8rpx 15rpx;
  border-radius: 8rpx;
  max-width: 400rpx;
  word-break: break-all;
}

.test-btn {
  width: 100%;
  padding: 20rpx;
  margin-bottom: 15rpx;
  background: #667eea;
  color: white;
  border-radius: 12rpx;
  font-size: 24rpx;
  border: none;
}

.test-btn:last-child {
  margin-bottom: 0;
}
