/* pages/speak/speak.wxss */
.TreeBack{
  width: 750rpx;
  height: 986rpx;
  /* background: linear-gradient(180deg, #57DA72 0%, #E9F280 82%, #CAE8DE00 100%); */
  display: flex;
  align-items: flex-end;
  justify-content: center;
  position: relative;
}
.Back{
  position: absolute;
  width: 750rpx; 
}
.Tree{
  position: absolute;
  width: 676rpx;
  height: 742rpx;
  bottom: 80rpx;
  z-index: 1;
}

.Font{
  color: #FFFFFF;
  font-family: PingFang SC;
  font-weight: 400;
  font-size: 48rpx;
  line-height: normal;
  letter-spacing: 0rpx;
  text-align: center;

}
.Font_s{
  color: #FFFFFF;
  font-family: Inter;
  font-weight: 400;
  font-size: 16rpx;
  line-height: normal;
  letter-spacing: 60rpx;
  text-align: center;
}
.FontBox{
  width: 296rpx;
  height: 310rpx;
  display: flex;
  padding: 20rpx;
  justify-content: flex-end;
  align-items: flex-end;
  flex-direction: column;
  position: absolute;
  z-index: 4;
}
.ChoiceBox{
  width: 750rpx;
  height: 376rpx;
  margin-top: 100rpx;
  display: flex;
  flex-direction: row;
  justify-content: space-around;
}
.Choice{
  width: 296rpx;
  height: 310rpx;
  border-radius: 30rpx;
  display: flex;
  flex-direction: column;
  position: relative;
}
.Pic{
  width: 200rpx;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  position: relative;
  z-index: 2;
  top: -35rpx;
  left: -5rpx;
}
.BoxCon{
  width: 296rpx;
  height: 100%;
  display: flex;
  align-items: flex-end;
  position: absolute; 
  z-index: 3;
}
.QingSu{
  width: 296rpx;
  height: 310rpx;
  border-radius: 30rpx;
  background: #93DF5D;
  box-shadow: 0rpx 8rpx 20rpx 0rpx #0000003F;
  position: relative;
}
.QingTan{
  width: 296rpx;
  height: 310rpx;
  border-radius: 30rpx;
  background: #FCAFE8;
  box-shadow: 0rpx 8rpx 20rpx 0rpx #0000003F;
  position: relative;
}