.container1 {
    height: 400px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    padding: 30rpx 0;
    box-sizing: border-box;
} 
.container2 {
    height: 50px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    padding: 25rpx 0;
    box-sizing: border-box;
    
}
.flex-wrp {
    display: flex;
    flex-direction: row;
    justify-content: center;
    height: 100%;
}
.button1 {
    height: 220rpx;
    width: 330rpx;
    margin: 20rpx;
    border-radius: 15rpx;
    text-align: center;
    flex-direction: row;
    display: flex; 
    align-items: center;
    border:5rpx solid #36474f;
    background-color: #91c789;
}

