<!--pages/Main/Main.wxml-->
<view style="height: 100%; flex-direction: column;">
<view class= "SwiperBox">
  <swiper class="SwiperBox" indicator-dots="true" indicator-active-color="#FEDB03" indicator-color="#FEDB033F">
    <swiper-item class= "SwiperIma">
      <view class= "SwiperIma">
        <image src="cloud://cloud1-2gxal8as6b6bfe21.636c-cloud1-2gxal8as6b6bfe21-1378381651/image/swiper_image.jpg" mode="widthFix"></image>
      </view>
    </swiper-item>
  </swiper>
</view>

<view class="pageall">
  <view class="Mid">
    <view class="Mid_r">
      <view class="ZiXun" bind:tap="gotoZiXun">
        <view class="ZiXun">
          <text class="Font">心理咨询</text>
          <text class="Font_s">psychological counseling</text>
          <image style="height: 275rpx;" src="cloud://cloud1-2gxal8as6b6bfe21.636c-cloud1-2gxal8as6b6bfe21-1378381651/image/ZiXun.png" mode="heightFix"/>
        </view>
      </view>
    </view>

  <view class="Mid_r">
    <view class="CePing" bind:tap="gotoCePing">
      <view class="CePing">
        <view class="Mid_f">
          <text class="Font">心理测评</text>
          <text class="Font_s">Psychological Assessment</text>
        </view>
        <view class="Mid_i">
          <image src="cloud://cloud1-2gxal8as6b6bfe21.636c-cloud1-2gxal8as6b6bfe21-1378381651/image/CePing.png" mode="widthFix"/>
        </view>
      </view>
    </view>

    <view class="SheQu" bind:tap="gotoSheQu">
      <view class="SheQu">
        <view class="Mid_f">
          <text class="Font">心理社区</text>
          <text class="Font_s">Mental Health Community</text>
        </view>
        <view class="Mid_i">
          <image src="cloud://cloud1-2gxal8as6b6bfe21.636c-cloud1-2gxal8as6b6bfe21-1378381651/image/SheQu.png" mode="widthFix"/>
        </view>
      </view>
    </view>
  </view>
</view>

<view class="BuJi" bind:tap="gotoEchoWall">
  <view class="BuJi" style="margin: 0;">
    <view class="BuJi_i" style="width:250rpx; flex-direction: column;">
      <text class="Font">心理树洞</text>
      <text class="Font_s">Echo Wall</text>
    </view>
    <view class="BuJi_i" style="justify-content: flex-end; align-items: flex-end; margin-right: 25rpx;">
      <image src="cloud://cloud1-2gxal8as6b6bfe21.636c-cloud1-2gxal8as6b6bfe21-1378381651/image/BuJi.png" mode="widthFix"/>
    </view>
  </view>
</view>

<view class="Diary" bind:tap="gotoDiary">
  <view class="Diary" style="margin: 0;">
    <view class="Diary_i" style="width:250rpx; flex-direction: column;">
      <text class="Font">情绪日记</text>
      <text class="Font_s">Emotion Diary</text>
    </view>
    <view class="Diary_i" style="justify-content: flex-end; align-items: flex-end; margin-right: 25rpx;">
      <image src="cloud://cloud1-2gxal8as6b6bfe21.636c-cloud1-2gxal8as6b6bfe21-1378381651/image/屏幕截图 2025-10-21 170644.png" mode="widthFix"/>
    </view>
  </view>
</view>

<text class="Font" style="margin-left: 50rpx;">心灵工具</text>
<view class="GameBox">
<view class="Game" bind:tap="gotoTools">
    <view class="GameIma">
      <image src="cloud://cloud1-2gxal8as6b6bfe21.636c-cloud1-2gxal8as6b6bfe21-1378381651/image/Gemini_Generated_Image_q11g7qq11g7qq11g.png" mode="aspectFill"/>
    </view>
    <text class="Font_G">减压工具箱</text>
  </view>
  <view class="Game" bind:tap="gotoTaLuo">
    <view class="GameIma">
      <image src="cloud://cloud1-2gxal8as6b6bfe21.636c-cloud1-2gxal8as6b6bfe21-1378381651/image/background4.jpg" mode="aspectFill"/>
    </view>
    <text class="Font_G">塔罗牌</text>
  </view>
  <view class="Game" bind:tap="gotoDivination">
    <view class="GameIma">
      <image src="cloud://cloud1-2gxal8as6b6bfe21.636c-cloud1-2gxal8as6b6bfe21-1378381651/image/屏幕截图 2025-10-21 172801.png" mode="aspectFill"/>
    </view>
    <text class="Font_G">周易智慧</text>
  </view>
</view>

</view>
</view>
