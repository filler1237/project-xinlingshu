<!--pages/Main/Main.wxml-->
<view style="height: 100%; flex-direction: column;">
<view class= "SwiperBox">
  <swiper class="SwiperBox" indicator-dots="true" indicator-active-color="#FEDB03" indicator-color="#FEDB033F">
    <swiper-item class= "SwiperIma">
      <view class= "SwiperIma">
        <image src="/image/swiper_image.png" mode="widthFix"></image>
      </view>
    </swiper-item>
  </swiper>
</view>

<view class="pageall">
  <view class="Mid">
    <view class="Mid_r">
      <view class="ZiXun" bind:tap="gotoZiXun">
        <view class="ZiXun">
          <text class="Font">心理咨询</text>
          <text class="Font_s">psychological counseling</text>
          <image style="height: 275rpx;" src="/image/ZiXun.png" mode="heightFix"/>
        </view>
      </view>
    </view>

  <view class="Mid_r">
    <view class="CePing" bind:tap="gotoCePing">
      <view class="CePing">
        <view class="Mid_f">
          <text class="Font">心理测评</text>
          <text class="Font_s">治愈您的心灵</text>
        </view>
        <view class="Mid_i">
          <image src="/image/CePing.png" mode="widthFix"/>
        </view>
      </view>
    </view>

    <view class="SheQu" bind:tap="gotoSheQu">
      <view class="SheQu">
        <view class="Mid_f">
          <text class="Font">心理社区</text>
          <text class="Font_s">治愈您的心灵</text>
        </view>
        <view class="Mid_i">
          <image src="/image/SheQu.png" mode="widthFix"/>
        </view>
      </view>
    </view>
  </view>
</view>

<view class="BuJi" bind:tap="gotoBuJi">
  <view class="BuJi" style="margin: 0;">
    <view class="BuJi_i" style="width:250rpx; flex-direction: column;">
      <text class="Font">心理补给</text>
      <text class="Font_s">Spiritual nourishment</text>
    </view>
    <view class="BuJi_i" style="justify-content: flex-end; align-items: flex-end; margin-right: 25rpx;">
      <image src="/image/BuJi.png" mode="widthFix"/>
    </view>
  </view>
</view>

<text class="Font" style="margin-left: 50rpx;">心灵娱乐</text>
<view class="GameBox">
  <view class="Game" bind:tap="gotoTaLuo">
    <view class="GameIma">
      <image src="/image/TaLuo.png" mode="widthFix" class="GameIma"/>
    </view>
    <text class="Font_G">塔罗牌</text>
  </view>
  <view class="Game">
  <view class="GameIma">
    <image src="/image/TaLuo.png" mode="widthFix" class="GameIma"/>
  </view>
    <text class="Font_G">塔罗牌</text>
  </view>
  <view class="Game">
  <view class="GameIma">
    <image src="/image/TaLuo.png" mode="widthFix" class="GameIma"/>
  </view>
    <text class="Font_G">塔罗牌</text>
  </view>
</view>

</view>
</view>