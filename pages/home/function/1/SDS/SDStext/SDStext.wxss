.question{
  text-align: center;
  padding: 10rpx 3rpx;
  font-size: 35rpx;
}

.flex{
  display: flex;
  flex-direction: column;
  
}
.flex .item{
  flex: 100;
  display:flex;
  justify-content: center;
}
 
.select {
  padding: 15px 10px;
  background: rgb(255, 255, 255);

}
 
.select label {
  border: 1px solid #dbc98c;
  color: #db858f;
  padding: 6px 7px;
  font-size: 12px;
  border-radius: 4px;
  width: 300rpx;
  text-align: center;
}
 
.select .pick {
  background: #30432d;
}