/* pages/Main/Main.wxss */
swiper{
	width: 100%;
  height: calc(100vw*410/750);
  overflow: hidden;
}
swiper image{
  width: 100%;
  height: 100%;
}

.SwiperBox{
  width: 750rpx;
  height: 450rpx;
  border-radius: 0rpx 0rpx 60rpx 60rpx;
  box-shadow: 0rpx 0rpx 10rpx 0rpx #00000026;
  background: #FFFFFF;
  margin-bottom: 20rpx;
}
.SwiperIma{
  width: 100%;
  height: 100%;
  border-radius:  0rpx 0rpx 60rpx 60rpx;
}
