page{
  background-color:white ;
}
.tips{
  text-align: center;
  line-height: 100%;
  justify-content: center;
  width: 99%;
  height:230rpx;
  border: 5rpx solid #ff8474;
  display: flex;  
  flex-direction: row;
  align-items: center;
  background-color: #FEFEF5;
  border-radius: 30rpx;
}
.tital{
  margin-top: 10rpx;
  text-align: center;
  font-family: "Microsoft Yahei";
  color: #36474F;
}
.ttxt{
  margin-top: 10rpx;
  padding-left: 20rpx;
  padding-right: 10rpx;
  text-align: left;
  text-align-last: left;
  font-family: "Microsoft Yahei";
  color: #36474F;
}
.button1{
  height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: space-around;
  margin-top: 50rpx;
}
.mbutton{
  height:90%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  border-radius: 30rpx; 
  border: 5rpx solid #ff8474;
}
.mbutton image{
  padding-top: 10rpx;
}
.button2{
  height:360rpx;
