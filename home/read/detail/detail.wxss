/* home/read/detail/detail.wxss */

page {
  background-color: #f7f7f7;
  padding-bottom: 220rpx; /* 大幅增加底部留白，防止内容被输入框遮挡 */
  margin: 0;
}

.container {
  padding: 0;
  width: 100%;
  box-sizing: border-box;
}

/* 文章区域 - 重构后 */
.article-wrapper {
  background-color: #fff;
  padding: 30rpx 40rpx; /* 增加左右内边距，确保内容不贴边 */
  width: 100%;
  box-sizing: border-box;
}

/* 顶部用户信息 */
.article-header {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

.header-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.header-info {
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.header-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 4rpx;
}

.header-time {
  font-size: 24rpx;
  color: #999;
}

/* 文章主体 */
.article-content-body {
  width: 100%;
  margin-bottom: 30rpx;
}

.detail-image-full {
  width: 100%;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
  display: block;
}

.detail-text-content {
  font-size: 32rpx;
  color: #333;
  line-height: 1.7;
  text-align: justify;
}

/* 底部操作栏（点赞） */
.article-actions-bar {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  margin-top: 10rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f9f9f9;
}

/* 文章底部操作栏（点赞等） */
.article-actions {
  display: flex;
  justify-content: flex-end;
  padding: 20rpx 40rpx;
  border-top: 1rpx solid #f5f5f5;
  margin-top: 30rpx;
}

.action-item {
  display: flex;
  align-items: center;
}

.action-icon {
  width: 48rpx;
  height: 48rpx;
  margin-right: 10rpx;
}

.action-count {
  font-size: 28rpx;
  color: #666;
}

/* 分隔线 */
.divider {
  height: 1rpx;
  background-color: #e0e0e0;
  margin: 20rpx 0;
  width: 100%; /* 确保占据全宽 */
  box-sizing: border-box;
}

/* 评论区域 */
.comments-section {
  background-color: #fff;
  padding-bottom: 30rpx;
  border-radius: 16rpx;
  /* 移除固定宽度，让其自然撑开 */
  width: 100%;
  box-sizing: border-box;
  padding-left: 0; /* 移除左右内边距 */
  padding-right: 0; /* 移除左右内边距 */
}

.comments-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 30rpx;
  padding: 30rpx 0 10rpx 0; /* 只保留上下内边距，移除左右内边距 */
  border-bottom: 1rpx solid #f0f0f0;
  width: 100%;
  box-sizing: border-box;
}

/* 评论条目 - 核心样式 */
.comment-item {
  display: flex;
  padding: 20rpx 0; /* 只保留上下内边距，移除左右内边距 */
  border-bottom: 1rpx solid #f0f0f0;
  width: 100%;
  box-sizing: border-box;
}
.comment-item:last-child {
  border-bottom: none;
}

.comment-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  flex-shrink: 0; /* 防止头像被压缩 */
}

.comment-main {
  flex-grow: 1;
}

.comment-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.comment-author-time {
  display: flex;
  flex-direction: column;
}

.comment-author {
  font-size: 28rpx;
  color: #555;
  font-weight: bold;
}

.comment-time {
  font-size: 24rpx;
  color: #999;
}

.comment-like-icon {
  width: 40rpx;
  height: 40rpx;
}

.comment-content {
  font-size: 30rpx;
  color: #333;
  line-height: 1.6;
  word-break: break-all;
}

.drawing-image-detail {
  width: 100%;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
  display: block; 
}

.empty-tip {
  text-align: center;
  color: #c0c4cc;
  padding: 60rpx 0;
  width: 100%;
  box-sizing: border-box;
  font-size: 28rpx;
}

/* 底部评论输入框 - 优化版 */
.comment-input-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  /* 增加 padding */
  padding: 20rpx 30rpx;
  /* 适配全面屏底部安全区 */
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background-color: #ffffff;
  border-top: 1rpx solid #ebedf0;
  width: 100%;
  box-sizing: border-box;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.03);
  z-index: 100;
}

.comment-input {
  flex-grow: 1;
  height: 80rpx; /* 更高一点，手感更好 */
  background-color: #f2f3f5;
  border-radius: 40rpx; /* 胶囊圆角 */
  padding: 0 30rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  color: #333;
}

/* 占位符颜色 */
.comment-input-placeholder {
  color: #969799;
}

.send-button {
  margin-left: 20rpx;
  background: linear-gradient(135deg, #07c160, #36d385);
  color: white;
  border-radius: 40rpx; /* 与输入框一致 */
  font-size: 28rpx;
  font-weight: 600;
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 40rpx; /* 增加宽一些 */
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.3);
}

.send-button[disabled] {
  background: #ebedf0;
  color: #c8c9cc;
  box-shadow: none;
}

.send-button::after {
  border: none;
}

/* 评论操作区 - 稍微调整 */
.comment-actions {
  display: flex;
  align-items: center;
}

.reply-text {
  font-size: 26rpx;
  color: #576b95; /* 微信蓝链接色 */
  margin-right: 24rpx;
  font-weight: 500;
}

/* ...后续保持不变... */
/* 子回复区域 */
.reply-box {
  background-color: #f7f8fa; /* 调整背景色 */
  border-radius: 12rpx;
  padding: 24rpx;
  margin-top: 20rpx;
}

.reply-item {
  margin-bottom: 24rpx;
}

.reply-item:last-child {
  margin-bottom: 0;
}

.reply-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start; /* 顶部对齐 */
  margin-bottom: 8rpx;
}

.reply-avatar {
  width: 48rpx; /* 稍微大一点 */
  height: 48rpx;
  border-radius: 8rpx; /* 方形圆角头像 */
  margin-right: 16rpx;
}

.reply-author-time {
  flex-grow: 1;
  display: flex;
  flex-direction: column; 
}

.reply-author {
  font-size: 26rpx;
  color: #576b95; /* 名字用蓝色 */
  margin-bottom: 4rpx;
  font-weight: 600;
}

.reply-arrow {
  color: #999;
  margin: 0 8rpx;
  font-size: 24rpx;
}

.author-badge {
    background-color: #f0ad4e;
    color: white;
    font-size: 20rpx;
    padding: 2rpx 8rpx;
    border-radius: 6rpx;
    margin-left: 10rpx;
    vertical-align: middle;
}

.reply-time {
  font-size: 22rpx;
  color: #c0c4cc;
}

.reply-like-icon {
    width: 32rpx;
    height: 32rpx;
    opacity: 0.5; /* 半透明图标，不抢视觉 */
}

.reply-content {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  padding-left: 64rpx; /* 与文字左边缘对齐 */
  margin-top: -10rpx; /* 稍微紧凑一点 */
}

.expand-replies {
  font-size: 26rpx;
  color: #576b95;
  margin-top: 20rpx;
  padding-left: 64rpx;
}

/* 取消回复按钮 */
.cancel-reply {
    font-size: 40rpx;
    color: #c8c9cc;
    padding: 0 20rpx;
    line-height: 80rpx; /* 居中 */
}
/* 多图轮播样式 */
.swiper-container {
  position: relative;
  width: 100%;
  height: 60vh; /* 固定高度，或者根据需求调整 */
  background-color: #f9f9f9;
  border-radius: 12rpx;
  overflow: hidden;
  margin-bottom: 30rpx;
}

.detail-swiper {
  width: 100%;
  height: 100%;
}

.slide-image {
  width: 100%;
  height: 100%;
}

.image-counter {
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  background-color: rgba(0, 0, 0, 0.5);
  color: #fff;
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}
