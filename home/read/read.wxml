<navigation-bar title="心灵社区">
</navigation-bar>

<view class="articles-list">
  <!-- 文章卡片循环开始 -->
  <view wx:for="{{articles}}" wx:key="_id" class="article-card" bind:tap="goToDetail" data-id="{{item._id}}" data-collectionname="{{item.collectionName}}">

    <view class="card-header" catch:tap="goToUserProfile" data-userid="{{item._openid}}">
      <image class="author-avatar" src="{{item.authorAvatarUrl}}" mode="aspectFill"></image>
      <view class="author-info">
        <view class="author-nickname">{{item.authorNickName}}</view>
        <view class="publish-time">{{item.createTime}}</view>
      </view>
      <!-- More actions menu (visible to everyone) -->
      <view class="actions-menu" catch:tap="onMoreActions" data-id="{{item._id}}" data-index="{{index}}" data-isowner="{{item._openid === userOpenid}}">
        <text class="dot">●</text><text class="dot">●</text><text class="dot">●</text>
      </view>
    </view>

    <view class="card-body">
      <view class="article-title" wx:if="{{item.title}}">{{item.title}}</view>
      <view class="article-summary">{{item.content || item.summary}}</view>

      <!-- 多图九宫格 -->
      <view class="image-grid" wx:if="{{item.images && item.images.length > 1}}">
        <block wx:for="{{item.images}}" wx:for-item="img" wx:key="*this">
          <image class="grid-image" src="{{img}}" mode="aspectFill" lazy-load="{{true}}" catch:tap="onPreviewImage" data-urls="{{item.images}}" data-current="{{img}}"></image>
        </block>
      </view>

      <!-- 单图模式 (新发的单图 或 旧数据/AI画作) -->
      <block wx:elif="{{(item.images && item.images.length === 1) || item.imageUrl}}">
         <image class="single-image" src="{{(item.images && item.images.length === 1) ? item.images[0] : item.imageUrl}}" mode="aspectFill" lazy-load="{{true}}" catch:tap="onPreviewImage" data-urls="{{item.images || [item.imageUrl]}}" data-current="{{(item.images && item.images.length === 1) ? item.images[0] : item.imageUrl}}"></image>
      </block>
    </view>

    <!-- 底部操作区 -->
    <view class="card-footer">
      <view class="footer-item" catch:tap="onToggleLike" data-id="{{item._id}}" data-index="{{index}}" data-collectionname="{{item.collectionName}}">
        <image class="footer-icon" src="{{item.liked ? 'cloud://cloud1-2gxal8as6b6bfe21.636c-cloud1-2gxal8as6b6bfe21-1378381651/image/likeup.png' : 'cloud://cloud1-2gxal8as6b6bfe21.636c-cloud1-2gxal8as6b6bfe21-1378381651/image/like.png'}}"></image>
        <text>{{item.likes}}</text>
      </view>
      <view class="footer-item">
        <image class="footer-icon" src="cloud://cloud1-2gxal8as6b6bfe21.636c-cloud1-2gxal8as6b6bfe21-1378381651/image/comment.png"></image>
        <text>{{item.commentsCount}}</text>
      </view>
    </view>

    <!-- 评论预览区 (神评) -->
    <view class="comments-preview" wx:if="{{item.comments && item.comments.length > 0}}">
      <block wx:for="{{item.comments}}" wx:for-item="comment" wx:key="_id" wx:if="{{index < 2}}">
        <view class="comment-preview-item">
          <text class="comment-user">{{comment.authorNickName}}</text>：{{comment.content}}
        </view>
      </block>
    </view>

  </view>

  <view wx:if="{{articles.length === 0}}" class="empty-tip">
    <text>还没有人分享，快来抢占沙发吧！</text>
  </view>
  <water-drop-effect id="waterDrop" />
  
  <!-- 彩蛋 -->
  <view class="easter-egg" wx:if="{{articles.length > 0}}">
    <text>已经没有了哦</text>
  </view>
</view>

<view class="add-button" bind:tap="goToCreatePage"> + </view>
