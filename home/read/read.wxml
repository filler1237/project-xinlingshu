<navigation-bar title="心灵社区">
</navigation-bar>

<view class="articles-list">
  <!-- 文章卡片循环开始 -->
  <view wx:for="{{articles}}" wx:key="_id" class="article-card" bind:tap="goToDetail" data-id="{{item._id}}">

    <view class="card-header" catch:tap="goToUserProfile" data-userid="{{item._openid}}">
      <image class="author-avatar" src="{{item.authorAvatarUrl}}" mode="aspectFill"></image>
      <view class="author-info">
        <view class="author-nickname">{{item.authorNickName}}</view>
        <view class="publish-time">{{item.createTime}}</view>
      </view>
      <!-- More actions menu -->
      <view class="actions-menu" wx:if="{{item._openid === userOpenid}}" catch:tap="deleteArticle" data-id="{{item._id}}">
        <text class="dot">●</text><text class="dot">●</text><text class="dot">●</text>
      </view>
    </view>

    <view class="card-body">
      <view class="article-title">{{item.title}}</view>
      <view class="article-summary">{{item.summary}}</view>
    </view>

    <view class="card-footer">
      <view class="footer-item" catch:tap="onToggleLike" data-id="{{item._id}}" data-index="{{index}}">
        <image class="footer-icon" src="{{item.liked ? 'cloud://cloud1-2gxal8as6b6bfe21.636c-cloud1-2gxal8as6b6bfe21-1378381651/image/likeup.png' : 'cloud://cloud1-2gxal8as6b6bfe21.636c-cloud1-2gxal8as6b6bfe21-1378381651/image/like.png'}}"></image>
        <text>{{item.likes}}</text>
      </view>
      <view class="footer-item">
        <image class="footer-icon" src="cloud://cloud1-2gxal8as6b6bfe21.636c-cloud1-2gxal8as6b6bfe21-1378381651/image/comment.png"></image>
        <text>{{item.commentsCount}}</text>
      </view>
    </view>

  </view>

  <view wx:if="{{articles.length === 0}}" class="empty-tip">
    <text>还没有人分享，快来抢占沙发吧！</text>
  </view>
  <water-drop-effect id="waterDrop" />
</view>

<view class="add-button" bind:tap="goToCreatePage"> + </view>
