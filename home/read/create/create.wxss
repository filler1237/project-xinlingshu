/* home/read/create/create.wxss */

/* 防止全局样式干扰，显式重置 */
page {
  background-color: #ffffff;
  min-height: 100vh;
}

.publish-container {
  padding: 10rpx 20rpx; /* 极窄左右边距 */
  background-color: #ffffff;
  min-height: 100vh;
  box-sizing: border-box;
  display: block; /* 防止继承 flex */
}

.input-group {
  margin-bottom: 40rpx;
}

.title-section {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eeeeee;
  margin-bottom: 20rpx;
}

.title-input {
  font-size: 44rpx; /* 进一步加大 */
  font-weight: bold;
  color: #000;
  height: 80rpx;
  min-height: 80rpx;
  text-align: left;
}

.title-placeholder {
  color: #bfbfbf; 
}

.divider {
  display: none; 
}

.content-section {
  width: 100%;
  padding-top: 10rpx;
}

.content-textarea {
  width: 100%;
  height: 400rpx; /* 加高 */
  font-size: 32rpx;
  color: #333;
  line-height: 1.6;
  text-align: left;
  padding: 0;
}

.content-placeholder {
  color: #bfbfbf;
}

.button-wrapper {
  margin-top: 60rpx;
  padding: 0;
}

.publish-button {
  background: #07c160;
  color: white;
  border-radius: 12rpx;
  font-size: 34rpx;
  font-weight: 500;
  height: 90rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.publish-button:active {
  background: #06ad56;
}

/* 图片选择器 - 核心优化 */
.image-picker {
  padding: 0;
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
}

/* 九宫格计算：一行3个，间距10rpx */
.image-item, .add-image-btn {
  position: relative;
  border-radius: 8rpx;
  overflow: hidden;
  width: 32%; 
  height: 0;
  padding-bottom: 32%; /* 保持正方形 */
  margin-right: 2%; 
  margin-bottom: 2%;
  box-sizing: border-box;
}

/* 每行第3个清除右边距 */
.image-picker > view:nth-child(3n) {
  margin-right: 0;
}

.image-item image {
  position: absolute;
  width: 100%;
  height: 100%;
  top: 0;
  left: 0;
  object-fit: cover;
}

.delete-btn {
  position: absolute;
  top: 0;
  right: 0;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0,0,0,0.5);
  color: #fff;
  border-radius: 0 0 0 12rpx; /* 角标样式 */
  text-align: center;
  line-height: 36rpx;
  font-size: 30rpx;
  z-index: 10;
}

.add-image-btn {
  background-color: #f0f0f0; /* 更明显的灰色 */
  display: flex; /* 注意：这里的flex对height:0的padding hack元素内部定位不起作用，需要内部绝对定位 */
  border: none;
}

.add-icon-wrapper {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.add-symbol {
  font-size: 100rpx; /* 巨大号 */
  color: #b0b0b0;
  font-weight: 200; /* 细体但大 */
  line-height: 0.8;
  margin-bottom: 10rpx;
  padding-top: 10rpx; /* 视觉修正 */
}

.add-text {
  font-size: 26rpx;
  color: #b0b0b0;
}
