<!-- home/read/create/create.wxml -->
<view class="container">
  <view class="card">
    <view class="form-item">
      <text class="form-label">文章标题</text>
      <input class="title-input" placeholder="请输入文章标题" model:value="{{title}}" />
    </view>
    <view class="form-item">
      <text class="form-label">文章内容</text>
      <textarea class="content-textarea" placeholder="请输入文章内容..." model:value="{{content}}"></textarea>
    </view>
  </view>
  <button class="publish-button" type="primary" bind:tap="publishArticle">发表文章</button>
</view>
