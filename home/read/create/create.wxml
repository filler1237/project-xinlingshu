<!-- home/read/create/create.wxml -->
<view class="container">
  <view class="header">
    <view class="header-title">分享你的想法</view>
    <view class="header-subtitle">在这里，每个声音都被听见</view>
  </view>

  <view class="card">
    <view class="form-item title-wrapper">
      <input class="title-input" placeholder="给你的文章起个标题吧" model:value="{{title}}" />
    </view>
    <view class="divider"></view>
    <view class="form-item content-wrapper">
      <textarea class="content-textarea" placeholder="尽情书写你的想法和故事..." model:value="{{content}}" placeholder-class="textarea-placeholder"></textarea>
    </view>
  </view>

  <view class="button-wrapper">
    <button class="publish-button" type="primary" bind:tap="publishArticle">
      立即发布
    </button>
  </view>
  <water-drop-effect id="waterDrop" />
</view>
