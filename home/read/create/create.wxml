<!-- home/read/create/create.wxml -->
<view class="publish-container">

  
  <view class="input-group">
    <!-- 标题输入 -->
    <view class="title-section">
      <input class="title-input" placeholder="添加标题 (非必填)" placeholder-class="title-placeholder" model:value="{{title}}" />
    </view>
    
    <view class="divider"></view>

    <!-- 正文输入 -->
    <view class="content-section">
      <textarea class="content-textarea" placeholder="添加正文" maxlength="1000" placeholder-class="content-placeholder" model:value="{{content}}"></textarea>
    </view>
  </view>

  <!-- 图片选择区域 -->
  <view class="image-picker">
    <view class="image-item" wx:for="{{tempImages}}" wx:key="*this">
      <image src="{{item}}" mode="aspectFill" bindtap="previewImage" data-src="{{item}}"></image>
      <view class="delete-btn" catchtap="deleteImage" data-index="{{index}}">×</view>
    </view>
    <!-- 添加按钮 - 样式调整为灰色块 -->
    <view class="add-image-btn" bindtap="chooseImage" wx:if="{{tempImages.length < 9}}">
      <view class="add-icon-wrapper">
         <!-- 使用自定义图标或简单的 + 号 -->
         <text class="add-symbol">+</text>
      </view>
      <text class="add-text">添加图片</text>
    </view>
  </view>

  <view class="button-wrapper">
    <button class="publish-button" type="primary" bind:tap="publishArticle">
      立即发布
    </button>
  </view>
  <water-drop-effect id="waterDrop" />
</view>
