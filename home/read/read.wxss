/* home/read/read.wxss */

.article-list {
  padding: 20rpx;
  background-color: #f7f7f7; /* 给列表一个浅灰色背景 */
}

.article-card {
  background-color: #ffffff; /* 卡片背景为白色 */
  border-radius: 16rpx; /* 圆角 */
  margin-bottom: 20rpx; /* 卡片间距 */
  padding: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05); /* 添加轻微的阴影增加立体感 */
  overflow: hidden; /* 防止内容溢出 */
}

/* 卡片头部 */
.card-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.author-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%; /* 头像圆形 */
  margin-right: 20rpx;
}

.author-info {
  display: flex;
  flex-direction: column;
}

.author-nickname {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
}

.publish-time {
  font-size: 24rpx;
  color: #999999;
}

/* 卡片主体 */
.card-body {
  margin-bottom: 20rpx;
}

.article-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 10rpx;
  /* 最多显示两行，超出部分显示省略号 */
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  text-overflow: ellipsis;
}

.article-summary {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.6;
  /* 最多显示三行 */
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 卡片底部 */
.card-footer {
  display: flex;
  justify-content: flex-end; /* 让点赞评论靠右对齐 */
  align-items: center;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0; /* 添加一条分割线 */
}

.footer-item {
  display: flex;
  align-items: center;
  margin-left: 40rpx; /* 调整点赞和评论之间的间距 */
  font-size: 26rpx;
  color: #888888;
}

.footer-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 10rpx;
}

/* 空状态提示 */
.empty-tip {
  text-align: center;
  padding: 100rpx 0;
  color: #999999;
  font-size: 28rpx;
}
