/* home/read/read.wxss */

.add-button {
  position: fixed;
  right: 40rpx;
  bottom: 80rpx; /* 稍微抬高，避免碰到全面屏底部条 */
  font-size: 56rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #07c160, #36d385); /* 渐变色背景 */
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: 0 8rpx 20rpx rgba(7, 193, 96, 0.4); /* 更柔和的彩色投影 */
  z-index: 1000;
  transition: transform 0.2s;
}

.add-button:active {
  transform: scale(0.95);
}

.article-list {
  padding: 24rpx; /* 增加页面边距 */
  background-color: #f6f7f9; /* 极淡的灰蓝色背景 */
  min-height: 100vh;
}

.article-card {
  background-color: #ffffff;
  border-radius: 24rpx; /* 更大的圆角 */
  margin-bottom: 24rpx;
  padding: 32rpx; /* 增加内边距 */
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.03); /* 极淡的阴影 */
  overflow: hidden;
}

/* 卡片头部 */
.card-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  position: relative;
}

.actions-menu {
  position: absolute;
  top: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 60rpx;
  height: 40rpx;
}

.dot {
  color: #c0c4cc; /* 更浅的灰色 */
  font-size: 20rpx;
  margin: 0 2rpx;
}

.author-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  background-color: #f0f0f0;
}

.author-info {
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.author-nickname {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 6rpx;
}

.publish-time {
  font-size: 24rpx;
  color: #909399; /* 浅灰色 */
}

/* 卡片主体 */
.card-body {
  margin-bottom: 20rpx;
}

.article-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #2c3e50;
  margin-bottom: 12rpx;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  text-overflow: ellipsis;
}

.article-summary {
  font-size: 28rpx;
  color: #555555;
  line-height: 1.6;
  margin-bottom: 16rpx;
  /* 最多显示4行 */
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 4;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 多图九宫格布局 */
.image-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.grid-image {
  /* 32% * 3 + 2% * 2 = 100% */
  width: 32%; 
  height: 220rpx;
  margin-right: 2%;
  margin-bottom: 2%; /* 上下间距 */
  border-radius: 8rpx;
  background-color: #f0f2f5;
}

/* 每行第3个元素移除右边距 */
.grid-image:nth-child(3n) {
  margin-right: 0;
}

/* 单图模式：稍微大一点，突出显示 */
.single-image {
  width: 60%; /* 单图占60%宽度 */
  height: 360rpx; /* 高度自适应或固定 */
  border-radius: 12rpx;
  margin-top: 16rpx;
  background-color: #f0f2f5;
  display: block;
}

/* 卡片底部 */
.card-footer {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  margin-top: 10rpx;
}

.footer-item {
  display: flex;
  align-items: center;
  margin-left: 48rpx;
  font-size: 26rpx;
  color: #909399;
}

.footer-icon {
  width: 32rpx; /* 更小的图标 */
  height: 32rpx;
  margin-right: 8rpx;
}

/* 评论预览区（仿朋友圈/小红书） */
.comments-preview {
  margin-top: 24rpx;
  padding: 16rpx 20rpx;
  background-color: #f7f8fa; /* 浅灰色背景 */
  border-radius: 12rpx;
}

.comment-preview-item {
  font-size: 26rpx;
  color: #555;
  line-height: 1.5;
  margin-bottom: 8rpx;
}

.comment-preview-item:last-child {
  margin-bottom: 0;
}

.comment-user {
  font-weight: 600;
  color: #576b95; /* 微信蓝 */
}

/* 空状态提示 */
.empty-tip {
  text-align: center;
  padding: 100rpx 0;
  color: #c0c4cc;
  font-size: 28rpx;
}

/* 彩蛋 */
.easter-egg {
  text-align: center;
  padding: 40rpx 0 160rpx;
  color: #eaeaea; /* 几乎看不见 */
  font-size: 20rpx;
}
