page{
  background: linear-gradient(180deg, #FFFFF5 0%, #FFFFFF 100%);
}
.title{
  color: #000000;
  font-family: PingFang SC;
  font-weight: medium;
  font-size: 32rpx;
  line-height: 1.5;
  letter-spacing: 0rpx;
  text-align: center;
  position: absolute;
  top: 4.5%;
  left: 39%  ;
}
.partone{
  margin-bottom: 10rpx;
  height: 56rpx;
  position: absolute;
  top:4.5%;
  left: 0;
}
.partone .back {
  position: absolute;
  z-index:2;
  height: 34rpx;
  left: 50rpx;
  top:20rpx;
}
.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  height: 100%;
}
.card-actions {
  display: flex;
  justify-content: space-between;
  width: 100%;
}

.edit-button,
.delete-button {
  line-height: 40rpx;
  text-align: center;
  background-color: #1AAD19;
  color: #ffffff;
  border-radius: 5rpx;
}

.delete-button {
  background-color: #f00;
}
.card-list {
  margin-top: 20px;
  width: 100%;
}

.card {
  padding: 10px;
  background-color: #f5f5f5;
  border-radius: 5px;
  margin-bottom: 10px;
}
.add-card-button {
  position: fixed;
  bottom: 20rpx;
  right: 20rpx;
  width: 80rpx;
  height: 80rpx;
  background-color: #1AAD19;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon {
  font-size: 50rpx;
  color: #ffffff;
}

.add-card-popup {
  position: fixed;
  bottom: 0;
  left: 0;
  background-color: #ffffff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-around;
  padding: 20rpx;
  box-sizing: border-box;
}

.input {
  width: 100%;
  height: 100rpx;
  border: 1px solid #cccccc;
  border-radius: 5rpx;
  padding: 0 10rpx;
  box-sizing: border-box;
}

.add-button {
  background-color: #1AAD19;
  color: #ffffff;
  border-radius: 5rpx;
}
