<!--home/divination/divination.wxml-->
<navigation-bar title="周易智慧" back="{{true}}" color="black" background="white"></navigation-bar>
<view class="container">
  <!-- Loading Overlay -->
  <view class="loading-overlay" wx:if="{{isDivining}}">
    <view class="loading-spinner"></view>
    <view class="loading-text">正在为您解读卦象...</view>
    <view class="tarot-fact">{{currentFact}}</view>
  </view>

  <view class="description">静心思考，投掷六次，探索《周易》的智慧。</view>

  <view class="instructions-panel">
    <view class="instructions-title">💡玩法简介</view>
    <view class="instructions-text">《周易》是中国古老的智慧经典，它通过六十四卦象，揭示事物变化的规律。本工具旨在通过模拟古代的占卜过程，为你提供一种独特的内省和思考工具。</view>
    <view class="instructions-step">1. 提出问题：在心中默念你所困惑的问题。</view>
    <view class="instructions-step">2. 投掷硬币：点击“投掷”按钮六次，每一次投掷都代表了卦象的一爻。</view>
    <view class="instructions-step">3. 解读卦象：六次投掷后，系统将为你生成对应的卦象，并结合现代心理学知识，为你提供多角度的思考和建议。</view>
    <view class="instructions-tip">提示：请将此过程视为一种激发思考和获得启发的方式，而非预知未来的手段。</view>
  </view>

  <view class="hexagram-area">
    <block wx:if="{{hexagram.length > 0}}">
      <view wx:for="{{hexagram}}" wx:key="index" class="line-container">
        <view class="line-symbol">{{item.symbol}}</view>
        <view class="line-type">
          <block wx:if="{{item.isChanging}}">
            (动爻)
          </block>
          <block wx:else>
            ({{item.value === 7 ? '少阳' : '少阴'}})
          </block>
        </view>
      </view>
    </block>
    <block wx:else>
      <view class="placeholder">请开始投掷...</view>
    </block>
  </view>

  <!-- 硬币动画区域 -->
  <view class="coins-animation-area">
    <view class="coin-container" wx:for="{{coins}}" wx:key="index">
      <view class="coin {{item.animationClass}}">
        <view class="coin-face coin-front"></view>
        <view class="coin-face coin-back"></view>
      </view>
    </view>
  </view>

  <view class="controls">
    <button 
      class="throw-button" 
      bindtap="throwCoins" 
      disabled="{{!canThrow || isDivining}}"
      loading="{{isDivining}}">
      {{throwCount < 6 ? '第 ' + (throwCount + 1) + ' 次投掷' : '查看结果'}}
    </button>
    <button class="reset-button" bindtap="reset" wx:if="{{throwCount > 0}}">重新探索</button>
  </view>

  <view class="result-area" wx:if="{{result}}">
    <!-- 结构化展示 -->
    <block wx:if="{{isResultObject}}">
      <view class="result-title">探索结果</view>
      
      <view class="hexagram-display">
        <view class="hexagram-item">
          <view class="hexagram-label">本卦</view>
          <view class="hexagram-name">{{result.originalHexagram.name}}</view>
          <view class="hexagram-constitution">{{result.originalHexagram.constitution}}</view>
        </view>
        
        <view class="arrow" wx:if="{{result.changedHexagram.name !== '无'}}">→</view>
        
        <view class="hexagram-item" wx:if="{{result.changedHexagram.name !== '无'}}">
          <view class="hexagram-label">变卦</view>
          <view class="hexagram-name">{{result.changedHexagram.name}}</view>
          <view class="hexagram-constitution">{{result.changedHexagram.constitution}}</view>
        </view>
      </view>

      <view class="moving-lines" wx:if="{{result.movingLineInfos.length > 0}}">
        {{result.movingLineInfos.join('、')}}
      </view>

      <view class="interpretation-divider"></view>

      <view class="interpretation-title">智者解读</view>
      <text class="result-text">{{result.aiInterpretation}}</text>
    </block>
    <!-- 错误信息展示 -->
    <block wx:else>
      <view class="result-title">出错了</view>
      <text class="result-text error-text">{{result}}</text>
    </block>
  </view>

  <view class="footer-note">
    <text>-- 结果仅供娱乐 --</text>
  </view>
</view>
