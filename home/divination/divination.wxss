/* home/divination/divination.wxss */
.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx;
  padding-top: 120rpx; /* 为自定义导航栏留出空间 */
  background-color: #f7f7f7;
  min-height: 100vh;
  box-sizing: border-box;
}

.description {
  font-size: 28rpx;
  color: #888;
  margin-bottom: 40rpx;
}

.instructions-panel {
  width: 100%;
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  border: 1rpx solid #eee;
}

.instructions-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  text-align: center;
  margin-bottom: 20rpx;
}

.instructions-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.7;
  margin-bottom: 20rpx;
}

.instructions-step {
  font-size: 26rpx;
  color: #555;
  margin-bottom: 10rpx;
  line-height: 1.6;
}

.instructions-tip {
  font-size: 24rpx;
  color: #07c160;
  margin-top: 20rpx;
  text-align: center;
  font-weight: bold;
}

.hexagram-area {
  width: 100%;
  min-height: 300rpx;
  background-color: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  margin-bottom: 40rpx;
  display: flex;
  flex-direction: column-reverse; /* 爻从下往上显示 */
  justify-content: center;
  align-items: center;
  padding: 20rpx;
  box-sizing: border-box;
}

.placeholder {
  color: #aaa;
}

.line-container {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 80%;
  margin: 8rpx 0;
}

.line-symbol {
  font-size: 40rpx;
  font-weight: bold;
  letter-spacing: 4rpx;
  color: #333;
}

.line-type {
  font-size: 24rpx;
  color: #666;
}

.changing-indicator {
  font-weight: bold;
  color: #e54d42;
  margin-right: 8rpx;
}

.controls {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
}

.throw-button, .reset-button {
  width: 80%;
  height: 90rpx;
  border-radius: 45rpx;
  font-size: 32rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  box-sizing: border-box;
}

.throw-button {
  background-color: #07c160;
  color: white;
  margin-bottom: 30rpx;
}

.reset-button {
  background-color: #fff;
  color: #555;
  border: 1rpx solid #ddd;
}

.result-area {
  width: 100%;
  margin-top: 40rpx;
  padding: 30rpx;
  background-color: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  box-sizing: border-box;
}

.result-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  text-align: center;
  margin-bottom: 20rpx;
}

.result-text {
  font-size: 28rpx;
  color: #555;
  line-height: 1.8;
  white-space: pre-wrap; /* 保留换行符 */
}

.footer-note {
  margin-top: 60rpx;
  font-size: 24rpx;
  color: #aaa;
}

/* 硬币动画区域 */
.coins-animation-area {
  display: flex;
  justify-content: space-around;
  width: 80%;
  margin-bottom: 40rpx;
  height: 100rpx; /* 给动画留出空间 */
}

.coin-container {
  perspective: 1000rpx;
}

.coin {
  width: 100rpx;
  height: 100rpx;
  position: relative;
  transform-style: preserve-3d;
  transition: transform 1s;
}

.coin-face {
  position: absolute;
  width: 100%;
  height: 100%;
  backface-visibility: hidden;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 40rpx;
  font-weight: bold;
}

.coin-front {
  background-color: #f0c27b;
  color: #a67c52;
  border: 4rpx solid #a67c52;
  box-sizing: border-box;
}
.coin-front::after {
  content: '正';
}

.coin-back {
  background-color: #dcdcdc;
  color: #888;
  border: 4rpx solid #888;
  box-sizing: border-box;
  transform: rotateY(180deg);
}
.coin-back::after {
  content: '反';
}

/* 动画类 */
.flip-heads {
  transform: rotateY(1800deg); /* 翻转5圈，最终停在正面 */
}

.flip-tails {
  transform: rotateY(1980deg); /* 翻转5.5圈，最终停在反面 */
}

/* 新增的结果区域样式 */
.hexagram-display {
  display: flex;
  justify-content: center;
  align-items: center;
  margin: 20rpx 0;
}

.hexagram-item {
  text-align: center;
  padding: 0 30rpx;
}

.hexagram-label {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.hexagram-name {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
}

.hexagram-constitution {
  font-size: 24rpx;
  color: #666;
}

.arrow {
  font-size: 40rpx;
  color: #aaa;
}

.moving-lines {
  text-align: center;
  font-size: 26rpx;
  color: #e54d42;
  margin-top: 10rpx;
  font-weight: bold;
}

.interpretation-divider {
  height: 1rpx;
  background-color: #eee;
  width: 90%;
  margin: 40rpx auto;
}

.interpretation-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  text-align: center;
  margin-bottom: 20rpx;
}

.error-text {
  color: #e54d42;
  text-align: center;
}
