.detail-container {
    display: flex;
    flex-direction: column;
  }
  .head-image {
    width: 100%;
    height: 460rpx;
  }
  
 
  
  .title {
    margin-left: 40rpx;
    font-size: 36rpx;
    font-weight: 700;
    margin-top: 30rpx;
    letter-spacing: 2px;
    color: #4b556c;
  }
  
  .tool {
    margin-top: 20rpx;
  }
  

  .horizon {
    width: 660rpx;
    height: 1px;
    background-color: #e5e5e5;
    vertical-align: middle;
    position: relative;
    top: 5rpx;
    margin: 0 auto;
    z-index: -99;
  }
  
  .detail {
    color: #666;
    margin-left: 30rpx;
    margin-top: 20rpx;
    margin-right: 30rpx;
    line-height: 44rpx;
    letter-spacing: 2px;
    font-size: 36rpx;
    font-family: MicroSoft Yahei;
  }
