
<view class="tips" style="color: #30432d;" wx:if="{{id<=7}}">
    {{id+1}}/8
</view>

<view class="quesbox" wx:if="{{id<=7}}">

<swiper style="height: 85%;" current="{{id}}" bindchange="QueChange" >
  <block wx:for="{{AISquestion}}" >
    <swiper-item style="height:fit-content;">
        
      <view class="question">
        {{item.question}}
      </view>

      <view class="select flex" >
        <view  class="item" >
          <label bindtap="OpA">{{OptionA}}</label>
          <label bindtap="OpB">{{OptionB}}</label>
          <label bindtap="OpC">{{OptionC}}</label>
          <label bindtap="OpD">{{OptionD}}</label>
        </view>
      </view>

      <view wx:if="{{id != 0}}">
            <view class="tips" bindtap="LastQ">
                上一题
            </view>
      </view>
      
      
    </swiper-item>  
  </block> 
</swiper>
</view>

<view wx:if="{{id==8}}" class="quesbox"  >
   <view  class="result" bindtap="Goresult">
    查看结果</view> 
</view>


