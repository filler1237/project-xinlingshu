<!--pages/home/function/1/SDS/SDS.wxml-->
<!--pages/mine/List/List.wxml-->
<view class="contentsPages" style="height:{{navBarHeight}}px; padding: {{titleBottom+45}}rpx 0rpx 0rpx 20rpx;">
  <view class="title" bind:tap="BACK">
    {{title}}
  </view></view>


<view class="IconBox">
  <view class="QesIn" style="background: #E5FFF0;" bind:tap="GoToSDS">
    <image src="/image/TestIcon.png" mode="widthFix" class="QesPic"/>
    <view class="Font" style="text-align: center;">
      <text >抑郁自评量表</text>
      <text >SDS</text>
    </view>
  </view>
</view>

<view class="IntroBox">
<text class="Font" style="color: #96CE74; top: 20rpx;">量表简介</text>
<text class="Font" style="color: #000000;">{{intro}}</text>
<text class="Font" style="color: #96CE74; text-align: center;">请根据最近一周的实际感觉，选择较符合的选项</text>
<button style="color: #ffffff;" bind:tap="Gotext">开始测试</button>
</view>



<view style="padding-top: 82rpx;">
  <image src="/image/Test.png" mode="widthFix" style="width: 750rpx;"/>
</view>