<!--pages/home/function/1/SDS/SDStext/SDStext.wxml-->
<view class="quesbox">

  <swiper style="height: 80%;" bindchange="QueChange" current="{{id}}">
    <block wx:for="{{QUESTION}}">
      <swiper-item style="height: fit-content;">
        
      
        <view class="question">
          {{item.question}}
        </view>
    
        <radio-group bindchange="serviceValChange">
        <view class="select flex">
          <block wx:for="{{options}}">
            <view class=" item " bindtap="NextQ">
              <label class="checkbox {{item.checked?'pick':''}}">
                <radio value="{{item.value}}" checked="{{item.checked}}" hidden="false" />{{item.level}}
              </label>
            </view>
          </block>
        </view>
        </radio-group>
</swiper-item>  
</block> 
  </swiper>
</view>




<button form-type="submit" bindtap="Goresult">我填好了</button>