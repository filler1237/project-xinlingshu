<!--pages/home/function/1/SDS/SDStext/SDStext.wxml-->
<view class="contentsPages" style="height:{{navBarHeight}}px; padding: {{titleBottom+45}}rpx 0rpx 0rpx 20rpx;">
  <view class="title" bind:tap="BACK">
    {{title}}
  </view>
</view>

<view class="IconBox">
  <view class="QesIn" style="background: #E5FFF0;">
    <image src="/image/TestIcon.png" mode="widthFix" class="QesPic"/>
    <view class="Font" style="text-align: center;">
      <text >抑郁自评量表</text>
      <text >SDS</text>
    </view>
  </view>
</view>

<view class="quesbox" wx:if="{{id<=19}}">

<swiper style="height: 95%;" current="{{id}}" bindchange="QueChange" >
  <block wx:for="{{QUESTION}}" >
    <swiper-item style="height:fit-content;">
        
      <view class="question">
        {{item.question}}
      </view>

      <view class="select flex" >
        <view  class="item" >
          <label bindtap="OpA">{{OptionA}}</label>
          <label bindtap="OpB">{{OptionB}}</label>
          <label bindtap="OpC">{{OptionC}}</label>
          <label bindtap="OpD">{{OptionD}}</label>
        </view>
      </view>

      
      
      
    </swiper-item>  
  </block> 
</swiper>
<view wx:if="{{id != 0}}">
  <view class="tips" bindtap="LastQ">
    上一题
  </view>
</view>
<view class="tips" style="color: #FEDB03;" wx:if="{{id<=19}}">
    {{id+1}}/20
</view>
</view>



<view wx:if="{{id==20}}" class="quesbox"  >
   <view class="select flex" bindtap="Goresult">
    <label >查看结果</label>
    </view> 
</view>

<view>
  <image src="/image/Test.png" mode="widthFix" style="width: 750rpx;"/>
</view>
