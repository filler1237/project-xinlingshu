<!--home/pages/home/function/test/GHQ/result/result.wxml-->

<view >
  <view class="box">
    <view class="title">
      您的测评结果是：
    </view>
    <view class="resultword">
        <text style="text-indent: 10rpx;">自我肯定：{{A}}分\n</text>
        <text style="text-indent: 10rpx;">抑郁：{{B}}分\n</text>
        <text style="text-indent: 10rpx;">焦虑：{{C}}分\n</text>
    </view>
    <view class="resultword">
        抑郁量表和焦虑量表得分越高说明抑郁程度和焦虑程度越高
    </view>
  </view>
</view>


<view style="display: flex; justify-content: center; flex-direction: column;">
    <view class="back" bindtap="BackTo">
        返回
    </view>
    <view class="tips" bindtap="OneMore">
        再测一次
    </view>
</view>



