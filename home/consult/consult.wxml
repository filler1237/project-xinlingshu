<view class="page" data-weui-theme="{{theme}}">
  <mp-toptips msg="{{error}}" type="error" show="{{error}}"></mp-toptips>

  <mp-form-page class="message_1" title="个人预约信息">
    <mp-form id="form" models="{{formData}}">
      <mp-cells class="message" title="预约信息">
        <mp-cell prop="teacher" title="咨询师" ext-class="">
          <picker mode="selector" range="{{teacherList}}" value="{{teacherIndex}}" bindchange="bindTeacherChange">
        <view class="value">{{teacherList[teacherIndex] || '请选择咨询师'}}</view>
      </picker>
        </mp-cell>
        <mp-cell prop="date" title="预约日期" ext-class="">
          <picker mode="selector" range="{{dateList}}" value="{{selectedDateIndex}}" bindchange="onDateChange">
        <view class="value">{{dateList[selectedDateIndex] || '请选择日期'}}</view>
      </picker>
        </mp-cell>

        <mp-cell prop="hour" title="预约时间" ext-class="">
          <picker mode="selector" range="{{hourList}}" value="{{hourIndex}}" bindchange="onHourChange">
        <view class="value">{{hourList[hourIndex] || '请选择时间'}}</view>
      </picker>
        </mp-cell>
        <mp-cell prop="phonenumber" title="联系方式" ext-class="">
        <input type="number" placeholder="填写手机号码"
        maxlength="11" bindinput="onPhoneInput" value="{{phone}}"/>
        </mp-cell>
      </mp-cells>
    </mp-form>
  </mp-form-page>
  <view slot="button">
    <button class="weui-btn {{!isFormValid ? 'weui-btn_disabled' : ''}}" bindtap="goToNextStep" disabled="{{!isFormValid}}">
        <view class="character">下一步
      </view>
    </button>
    </view>
</view>
