<!--pages/sushuo/XIE/XIE.wxml-->
<view class='partone' style="width:82rpx" bindtap='onBackTap'>
    <image class='back' src='/image/back.svg' style="width: 18rpx;"></image>
</view>
<view class="title">心理咨询</view>
<view class="bottom">
  <image class="down" src="/image/down.png" style="width: 100%;"/>
  <image class="up"src="/image/up.png" style="width: 100%;"/>
  <image class="girl"src="/image/girl.png" style="width: 200rpx;"/>
</view>
<view class="logo">
<image class="logo_1" src="/image/logo1.png" >
</image>
<view class="value_1"  >预约信息</view>
<image class="rail_1" src="/image/railgreen.png"></image>

<image class="logo_2" src="/image/logo1.png" >
</image>
<view class="value_2"  >预约信息</view>
<image class="rail_2" src="/image/tailwhite.png"></image>

<image class="logo_3" src="/image/logo1.png" >
</image>
<view class="value_3"  >预约信息</view>
<image class="rail_3" src="/image/tailwhite.png"></image>
</view>

<view class="page" data-weui-theme="{{theme}}">
  <mp-toptips msg="{{error}}" type="error" show="{{error}}"></mp-toptips>

  <mp-form-page class="message_1" title="个人预约信息">
    <mp-form id="form" models="{{formData}}">
      <mp-cells class="message" title="预约信息">
        <mp-cell prop="teacher" title="咨询师" ext-class="">
          <picker mode="selector" range="{{teacherList}}" value="{{teacherIndex}}" bindchange="bindTeacherChange">
        <view class="value">{{teacherList[teacherIndex] || '请选择咨询师'}}</view>
      </picker>
        </mp-cell>
        <mp-cell prop="date" title="预约日期" ext-class="">
          <picker mode="selector" range="{{dateList}}" value="{{selectedDateIndex}}" bindchange="onDateChange">
        <view class="value">{{dateList[selectedDateIndex] || '请选择日期'}}</view>
      </picker>
        </mp-cell>

        <mp-cell prop="hour" title="预约时间" ext-class="">
          <picker mode="selector" range="{{hourList}}" value="{{hourIndex}}" bindchange="onHourChange">
        <view class="value">{{hourList[hourIndex] || '请选择时间'}}</view>
      </picker>
        </mp-cell>
        <mp-cell prop="phonenumber" title="联系方式" ext-class="">
        <input type="number" placeholder="填写手机号码"
        maxlength="11"/>
        </mp-cell>
      </mp-cells>
    </mp-form>
  </mp-form-page>
  <view slot="button">
    <navigator url="./next/1/1" >
      <button class="weui-btn" >
          <view class="character">下一步
        </view>
      </button>
    </navigator>
    </view>
</view>