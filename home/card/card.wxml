<!-- home/card/card.wxml -->
<view class="container">
  <!-- Loading Overlay -->
  <view class="loading-overlay" wx:if="{{isLoading}}">
    <view class="loading-spinner"></view>
    <view class="loading-text">正在为您解读塔罗牌...</view>
    <view class="tarot-fact">{{currentFact}}</view>
  </view>

  <view class="title">请点击牌堆抽取塔罗牌</view>
  <view class="navigation-hint">从牌堆中抽取三张牌以获取解读</view>

  <!-- 主牌堆，用于发牌 -->
  <view class="dealing-area">
    <view class="main-deck {{selectedCards.length >= 3 ? 'disabled' : ''}}" bindtap="handleDealTap">
      <image mode="widthFix" src="cloud://cloud1-2gxal8as6b6bfe21.636c-cloud1-2gxal8as6b6bfe21-1378381651/Cards-jpg/CardBacks.jpg" />
    </view>
  </view>

  <!-- 已选牌区 -->
  <view class="selected-area">
    <!-- 三个卡牌展示区 -->
    <view class="card-display-wrapper" wx:for="{{[0, 1, 2]}}" wx:key="*this">
      <view class="card-slot">
        <view class="card-container {{selectedCards[index] ? 'dealt' : ''}}">
          <!-- 卡牌翻转容器 -->
          <view class="card-inner {{selectedCards[index].isFlipped ? 'is-flipped' : ''}}">
            <!-- 卡背 -->
            <view class="card-face card-back">
              <image mode="widthFix" src="cloud://cloud1-2gxal8as6b6bfe21.636c-cloud1-2gxal8as6b6bfe21-1378381651/Cards-jpg/CardBacks.jpg" />
            </view>
            <!-- 卡面 -->
            <view class="card-face card-front">
              <image wx:if="{{selectedCards[index]}}" class="card-image" src="{{selectedCards[index].frontImage}}"></image>
            </view>
          </view>
        </view>
      </view>
      <text wx:if="{{selectedCards[index]}}" class="card-name">{{selectedCards[index].name}} {{selectedCards[index].isReversed ? '(逆)' : '(正)'}}</text>
      <!-- Add a placeholder for the text so the layout doesn't jump -->
      <text wx:else class="card-name placeholder">&nbsp;</text>
    </view>
  </view>

  <!-- 操作按钮 -->
  <view class="actions">
    <button bindtap="handleRetry" class="retry-btn">重新选择</button>
    <button bindtap="viewResult" class="result-btn" disabled="{{selectedCards.length < 3 || isLoading}}" loading="{{isLoading}}">
      {{isLoading ? '分析中...' : '查看结果'}}
    </button>
  </view>

  <!-- AI分析结果区 -->
  <view class="analysis-area" wx:if="{{analysisResult}}">
    <view class="analysis-title">AI解读</view>
    <view class="analysis-content">{{analysisResult}}</view>
  </view>

  <!-- 免责声明 -->
  <view class="disclaimer">
    -- 结果仅供娱乐 --
  </view>
</view>
