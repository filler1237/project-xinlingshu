.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  background-color: #f5f5dc; /* 淡米白色 */
  padding: 40rpx;
  padding-top: 120rpx; /* Add padding to avoid overlap with navigation bar */
  box-sizing: border-box;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  color: #5d4037; /* 深棕色 */
  margin-bottom: 20rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #795548; /* 棕色 */
  margin-bottom: 60rpx;
}

.question-input {
  width: 100%;
  height: 300rpx;
  background-color: #ffffff;
  border: 1rpx solid #ddd;
  border-radius: 20rpx;
  padding: 30rpx;
  box-sizing: border-box;
  margin-bottom: 60rpx;
  font-size: 32rpx;
  color: #333;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.submit-btn {
  width: 100%;
  background-color: #4CAF50; /* 绿色 */
  color: white;
  border: none;
  border-radius: 50rpx;
  padding: 25rpx;
  font-size: 36rpx;
  font-weight: bold;
  box-shadow: 0 8rpx 16rpx rgba(0, 0, 0, 0.1);
  transition: all 0.2s ease;
}

.submit-btn:active {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.1);
}
