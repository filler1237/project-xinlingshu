/* page 元素作为顶层容器 */
page {
  background-color: #f5f5dc; /* 淡米白色 */
  height: 100%;
  overflow: hidden;
}

.page-container {
  display: flex;
  flex-direction: column;
  height: 100vh; /* 确保页面容器占满整个视口 */
}

/* 新增：内容容器，用于垂直居中 */
.content-container {
  flex: 1; /* 占据导航栏之外的剩余所有空间 */
  display: flex;
  align-items: center;
  justify-content: center; /* 垂直居中 */
  padding: 0 50rpx; /* 左右留出一些边距 */
  box-sizing: border-box;
}

.content-wrapper {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.title {
  font-size: 44rpx;
  font-weight: bold;
  color: #5d4037;
  margin-bottom: 15rpx;
}

.subtitle {
  font-size: 26rpx;
  color: #795548;
  margin-bottom: 40rpx;
}

.question-input {
  width: 100%;
  height: 200rpx;
  background-color: #ffffff;
  border: 1rpx solid #ddd;
  border-radius: 20rpx;
  padding: 25rpx;
  box-sizing: border-box;
  margin-bottom: 40rpx;
  font-size: 30rpx;
  color: #333;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.submit-btn {
  width: 90%;
  background-color: #4CAF50;
  color: white;
  border: none;
  border-radius: 50rpx;
  padding: 20rpx;
  font-size: 32rpx;
  font-weight: bold;
  box-shadow: 0 8rpx 16rpx rgba(0, 0, 0, 0.1);
  transition: all 0.2s ease;
  margin: 0 auto;
}

.submit-btn:active {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.1);
}
