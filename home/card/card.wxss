.rows{
  margin-bottom:5rpx ;
  padding:0rpx;
  text-align:center;
  flex-direction:row;
  display:flex;
}
.cols{
  margin: 5rpx;
}

@keyframes flip {
  0% {
    transform: rotateY(0);
  }
  50% {
    transform: rotateY(90deg);
  }
}

.card {
  animation: flip 0.5s linear;
  animation-fill-mode: forwards;
  transform-style: preserve-3d;
}
.card{
   width:  225rpx;
   height: 310rpx;
   padding:1rpx;
   margin: 0.5rpx;
}
@keyframes neonGlow {
  0% {
    text-shadow: 0 0 4px #fff, 0 0 6px #fff, 0 0 8px #fff, 0 0 10px #00e3e3, 0 0 12px #00e3e3, 0 0 14px #00e3e3, 0 0 16px #00e3e3;
  }
  50% {
    text-shadow: none;
  }
  100% {
    text-shadow: 0 0 4px #fff, 0 0 6px #fff, 0 0 8px #fff, 0 0 10px #00e3e3, 0 0 12px #00e3e3, 0 0 14px #00e3e3, 0 0 16px #00e3e3;
  }
}

.text {
  font-size: 25px;
  color: rgb(239, 247, 242);
  text-align: center;
  padding: 6px;
}

.cool-title {
  background-color: rgba(0, 0, 0, 0); /* 设置背景颜色为透明 */
  animation: neonGlow 2s infinite alternate;
}