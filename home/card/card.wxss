/* home/card/card.wxss */
.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  background-color: #f0f0f0;
  min-height: 100vh;
  box-sizing: border-box;
  padding-top: 120rpx; /* 为导航栏预留空间 */
}

.partone {
  position: absolute;
  top: 40rpx;
  left: 20rpx;
  z-index: 10;
}

.back {
  width: 18rpx;
  height: 36rpx;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 20rpx; /* Reduced margin */
}

.navigation-hint {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 40rpx;
}

/* 发牌区 */
.dealing-area {
  width: 100%;
  height: 300rpx; /* Reduced height */
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 40rpx;
}

.main-deck {
  width: 180rpx;
  cursor: pointer;
  transition: transform 0.3s, opacity 0.3s;
}

.main-deck:active {
  transform: scale(0.95);
}

.main-deck.disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.main-deck image {
  width: 100%;
  border-radius: 10rpx;
  box-shadow: 0 4rpx 8rpx rgba(0,0,0,0.2);
}

/* 已选牌区 */
.selected-area {
  display: flex;
  justify-content: space-around;
  align-items: flex-start; /* Align to top to accommodate text below */
  width: 100%;
  margin-bottom: 40rpx;
  height: 400rpx; /* Increased height for text */
  padding: 0 20rpx;
  box-sizing: border-box;
}

.card-display-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.card-slot {
  width: 200rpx;
  height: 300rpx;
  perspective: 1000px; /* For 3D effect */
  border: 2rpx dashed #aaa;
  border-radius: 10rpx;
  background-color: #e0e0e0;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 10rpx; /* Space between card and name */
}

.card-container {
  width: 100%;
  height: 100%;
  position: relative;
  opacity: 0;
  transform: translateY(-300rpx);
  transition: opacity 0.5s ease-out, transform 0.5s ease-out;
}

.card-container.dealt {
  opacity: 1;
  transform: translateY(0);
}

.card-inner {
  width: 100%;
  height: 100%;
  position: relative;
  transform-style: preserve-3d;
  transition: transform 0.6s;
}

.card-inner.is-flipped {
  transform: rotateY(180deg);
}

.card-face {
  position: absolute;
  width: 100%;
  height: 100%;
  backface-visibility: hidden;
  border-radius: 10rpx;
  overflow: hidden;
}

.card-back {
  background-color: #fff;
}

.card-back image {
  width: 100%;
  height: 100%;
}

.card-front {
  background-color: #fff;
  transform: rotateY(180deg);
  display: flex;
  align-items: center;
  justify-content: center;
}

.card-image {
  width: 100%;
  height: 100%;
  object-fit: cover; /* Fill the container */
}

.card-name {
  font-size: 24rpx;
  color: #333;
  text-align: center;
  width: 200rpx; /* Match card width */
  height: 60rpx; /* Fixed height for name */
  display: flex;
  justify-content: center;
  align-items: center;
}

.card-name.placeholder {
  visibility: hidden;
}

/* 操作按钮 */
.actions {
  display: flex;
  justify-content: space-around;
  width: 100%;
  margin-top: 40rpx;
}

.retry-btn, .result-btn {
  width: 40%;
  font-size: 32rpx;
}

.result-btn[disabled] {
  background-color: #ccc;
  color: #666;
}

/* AI分析结果区 */
.analysis-area {
  width: 100%;
  margin-top: 60rpx;
  padding: 30rpx;
  background-color: #fff;
  border-radius: 10rpx;
  box-shadow: 0 4rpx 8rpx rgba(0,0,0,0.1);
  box-sizing: border-box;
}

.analysis-title {
  font-size: 36rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 20rpx;
  color: #333;
}

.analysis-content {
  font-size: 28rpx;
  color: #555;
  line-height: 1.6;
  text-align: justify;
}

/* Loading Overlay Styles */
.loading-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.7);
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  z-index: 999;
  color: white;
}

.loading-spinner {
  border: 8rpx solid #f3f3f3;
  border-top: 8rpx solid #888;
  border-radius: 50%;
  width: 60rpx;
  height: 60rpx;
  animation: spin 1s linear infinite;
  margin-bottom: 40rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  font-size: 32rpx;
  margin-bottom: 30rpx;
}

.tarot-fact {
  font-size: 28rpx;
  padding: 0 40rpx;
  text-align: center;
  line-height: 1.5;
}
