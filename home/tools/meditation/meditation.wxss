/* home/tools/meditation/meditation.wxss */
page {
  background-color: #f7f8fa;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, 'Noto Sans', sans-serif, 'Apple Color Emoji', 'Segoe UI Emoji', 'Segoe UI Symbol', 'Noto Color Emoji';
}

.container {
  box-sizing: border-box;
  padding: 40rpx;
  min-height: 100vh;
  background-color: #f7f8fa;
}

/* Card Base Style */
.card {
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.05);
}

/* Card Titles */
.card-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 24rpx;
}

/* Setup Card */
.setup-card .selector-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.setup-card .selector-row:last-child {
  margin-bottom: 0;
}

.setup-card .selector-title {
  font-size: 30rpx;
  color: #333333;
  font-weight: 600;
}

.setup-card .options-group {
  display: flex;
  gap: 16rpx;
}

.option-btn {
  padding: 12rpx 24rpx;
  font-size: 28rpx;
  border-radius: 12rpx;
  background-color: #f3f4f6;
  color: #666666;
  transition: all 0.2s ease-in-out;
  height: auto;
  line-height: 1.5;
  text-align: center;
}

.option-btn.selected {
  background-color: #A899E2; /* Soft Purple */
  color: #ffffff;
  font-weight: 600;
}

/* Meditation Main Area */
.meditation-main {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx 0;
}

.meditation-circle-container {
  width: 400rpx;
  height: 400rpx;
  margin-bottom: 60rpx;
  position: relative;
}

.meditation-circle {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: white;
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.1);
  border: 2rpx solid rgba(255, 255, 255, 0.3);
  overflow: hidden;
  text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.2);
}

@keyframes pulse {
  0% { transform: scale(1); }
  50% { transform: scale(1.05); }
  100% { transform: scale(1); }
}

.meditation-emoji {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.circle-text {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.timer-text {
  font-size: 72rpx;
  font-weight: bold;
}

.breathing-guide {
  position: absolute;
  bottom: 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.breathing-emoji {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.breathing-text {
  font-size: 32rpx;
  font-weight: 500;
}

/* Progress Bar */
.progress-bar-container {
  width: 100%;
  height: 16rpx;
  background-color: #e9ecef;
  border-radius: 8rpx;
  margin-bottom: 40rpx;
  overflow: hidden;
}

.progress-bar {
  height: 100%;
  border-radius: 8rpx;
  transition: width 0.5s ease;
}

/* Controls */
.controls {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}

.control-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 100rpx;
  text-align: center;
  transition: all 0.2s ease-in-out;
  border: none;
  padding: 0;
}

.control-btn.primary {
  background-color: #A899E2;
  color: white;
}

.control-btn.secondary {
  background-color: #ffffff;
  color: #A899E2;
  border: 2rpx solid #A899E2;
}

.control-btn:active {
  transform: scale(0.98);
  opacity: 0.9;
}


/* Completion Card */
.completion-card {
  text-align: center;
}
.completion-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 20rpx;
}

.completion-text {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.6;
  display: block;
}
.completion-text:last-child {
  margin-top: 10rpx;
}


/* Tips Card */
.tips-card .tip-item {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.8;
  margin-bottom: 12rpx;
}
.tips-card .tip-item:last-child {
  margin-bottom: 0;
}

/* Background Image Text Color Adapt */
.container[style*="url("] .card {
  background-color: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(10px);
}

.container[style*="url("] .card-title,
.container[style*="url("] .selector-title,
.container[style*="url("] .tip-item {
  color: #333;
}

.container[style*="url("] .option-btn {
  background-color: rgba(255, 255, 255, 0.7);
  color: #333;
}

.container[style*="url("] .option-btn.selected {
  background-color: #A899E2;
  color: #ffffff;
}
