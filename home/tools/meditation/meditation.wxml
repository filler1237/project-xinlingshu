<!-- home/tools/meditation/meditation.wxml -->
<navigation-bar title="正念冥想" back="{{true}}" background="#f7f8fa" color="black"></navigation-bar>
<view class="container" style="background-image: {{selectedBackground ? 'url(' + selectedBackground + ')' : ''}}; background-color: #f7f8fa; background-size: cover; background-position: center; padding-top: {{navigationBarHeight}}px;">

  <!-- 设置区 -->
  <view class="card setup-card" wx:if="{{status === 'ready' || status === 'completed'}}">
    <!-- 冥想时间选择 -->
    <view class="selector-row">
      <text class="selector-title">冥想时长</text>
      <view class="options-group">
        <view class="option-btn {{selectedDuration === 3 ? 'selected' : ''}}" bind:tap="selectDuration" data-duration="3">3分钟</view>
        <view class="option-btn {{selectedDuration === 5 ? 'selected' : ''}}" bind:tap="selectDuration" data-duration="5">5分钟</view>
        <view class="option-btn {{selectedDuration === 10 ? 'selected' : ''}}" bind:tap="selectDuration" data-duration="10">10分钟</view>
        <view class="option-btn {{selectedDuration === 15 ? 'selected' : ''}}" bind:tap="selectDuration" data-duration="15">15分钟</view>
      </view>
    </view>

    <!-- 背景选择 -->
    <view class="selector-row">
      <text class="selector-title">选择背景</text>
      <view class="options-group">
        <view class="option-btn {{selectedBackgroundType === 'forest' ? 'selected' : ''}}" bind:tap="selectBackground" data-type="forest">森林</view>
        <view class="option-btn {{selectedBackgroundType === 'ocean' ? 'selected' : ''}}" bind:tap="selectBackground" data-type="ocean">海洋</view>
        <view class="option-btn {{selectedBackgroundType === 'mountain' ? 'selected' : ''}}" bind:tap="selectBackground" data-type="mountain">山脉</view>
        <view class="option-btn {{selectedBackgroundType === 'none' ? 'selected' : ''}}" bind:tap="selectBackground" data-type="none">默认</view>
      </view>
    </view>

    <!-- 背景音乐选择 -->
    <view class="selector-row">
      <text class="selector-title">背景音乐</text>
      <view class="options-group">
        <view class="option-btn {{selectedMusic === 'rain' ? 'selected' : ''}}" bind:tap="selectMusic" data-music="rain">雨声</view>
        <view class="option-btn {{selectedMusic === 'forest' ? 'selected' : ''}}" bind:tap="selectMusic" data-music="forest">森林</view>
        <view class="option-btn {{selectedMusic === 'waves' ? 'selected' : ''}}" bind:tap="selectMusic" data-music="waves">海浪</view>
        <view class="option-btn {{selectedMusic === 'none' ? 'selected' : ''}}" bind:tap="selectMusic" data-music="none">无音乐</view>
      </view>
    </view>
  </view>
  
  <!-- 冥想界面 -->
  <view class="meditation-main">
    <view class="meditation-circle-container">
    <view class="meditation-circle" style="background: {{selectedBackgroundType !== 'none' ? 'rgba(255, 255, 255, 0.3)' : 'linear-gradient(135deg, ' + currentColor1 + ', ' + currentColor2 + ')'}}; backdrop-filter: blur(10px); animation: pulse {{pulseSpeed}}s ease-in-out infinite;">
        <text class="meditation-emoji" wx:if="{{status === 'ready' || status === 'completed'}}"></text>
        <text class="circle-text">{{instruction}}</text>
        <text class="timer-text">{{formattedTime}}</text>
        
        <!-- 呼吸提示 -->
        <view class="breathing-guide" wx:if="{{showBreathingGuide}}">
          
          <text class="breathing-text">{{breathingInstruction}}</text>
        </view>
      </view>
    </view>

    <view class="progress-bar-container">
        <view class="progress-bar" style="width: {{progress}}%; background: linear-gradient(90deg, {{currentColor1}}, {{currentColor2}});"></view>
    </view>
    
    <view class="controls">
      <button wx:if="{{status === 'ready' || status === 'completed'}}" class="control-btn primary" bind:tap="startMeditation">开始冥想</button>
      <button wx:elif="{{status === 'paused'}}" class="control-btn primary" bind:tap="resumeMeditation">继续冥想</button>
      <button wx:elif="{{status !== 'ready' && status !== 'paused' && status !== 'completed'}}" class="control-btn secondary" bind:tap="pauseMeditation">暂停冥想</button>
      <button wx:if="{{status !== 'ready'}}" class="control-btn secondary" bind:tap="resetMeditation">重新开始</button>
    </view>
  </view>
  
  <!-- 冥想完成页面 -->
  <view class="card completion-card" wx:if="{{status === 'completed'}}">
    <text class="completion-title">冥想完成</text>
    <text class="completion-text">恭喜你完成了 {{selectedDuration}} 分钟的正念冥想。</text>
    <text class="completion-text">你今天已经冥想了 {{totalMinutes}} 分钟，请继续保持。</text>
  </view>
  
  <!-- 冥想提示 -->
  <view class="card tips-card" wx:if="{{status === 'ready' || status === 'completed'}}">
    <text class="card-title">冥想小贴士</text>
    <view class="tip-item">• 找一个安静舒适的地方</view>
    <view class="tip-item">• 保持坐姿端正或躺卧放松</view>
    <view class="tip-item">• 闭上眼睛，专注于呼吸</view>
    <view class="tip-item">• 当思绪飘走时，温柔地将注意力带回</view>
    <view class="tip-item">• 享受这段属于自己的宁静时光</view>
  </view>
</view>
