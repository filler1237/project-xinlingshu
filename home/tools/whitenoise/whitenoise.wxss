/* home/tools/whitenoise/whitenoise.wxss */
.header {
  margin-bottom: 40rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.back-button {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  width: 40rpx;
  height: 40rpx;
}

.header-right {
  width: 60rpx;
}

.header-title {
  color: #253858;
  font-family: PingFang SC;
  font-weight: 600;
  font-size: 40rpx;
}

.player {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 50rpx;
}

.play-button {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #4CAF50, #8BC34A);
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  box-shadow: 0rpx 0rpx 20rpx 0rpx rgba(76, 175, 80, 0.3);
  margin-bottom: 20rpx;
}

.play-icon {
  width: 60rpx;
  height: 60rpx;
  margin-bottom: 10rpx;
}

.play-text {
  color: white;
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 24rpx;
}

.current-sound {
  margin-top: 20rpx;
}

.current-sound-text {
  color: #253858;
  font-family: PingFang SC;
  font-weight: 400;
  font-size: 28rpx;
}

.volume-control {
  margin-bottom: 50rpx;
}

.volume-label {
  color: #253858;
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 32rpx;
  display: block;
  margin-bottom: 20rpx;
}

.sound-list {
  margin-bottom: 40rpx;
}

.list-title {
  color: #253858;
  font-family: PingFang SC;
  font-weight: 500;
  font-size: 32rpx;
  display: block;
  margin-bottom: 20rpx;
}

.sound-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.sound-item {
  width: 160rpx;
  height: 180rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  box-shadow: 0rpx 0rpx 8rpx 0rpx #00000019;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  margin-bottom: 30rpx;
  transition: all 0.3s ease;
}

.sound-item.selected {
  background: #E8F7FE;
  box-shadow: 0rpx 0rpx 15rpx 0rpx #00000029;
  transform: translateY(-5rpx);
}

.sound-icon {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 15rpx;
}

.sound-icon-img {
  width: 100%;
  height: 100%;
}

.sound-name {
  color: #253858;
  font-family: PingFang SC;
  font-weight: 400;
  font-size: 24rpx;
}

.benefits {
  width: 100%;
  background: #F5F5F5;
  border-radius: 20rpx;
  padding: 30rpx;
}

.benefits-title {
  color: #253858;
  font-family: PingFang SC;
  font-weight: 600;
  font-size: 28rpx;
  display: block;
  margin-bottom: 15rpx;
}

.benefits-text {
  color: #2538587F;
  font-family: PingFang SC;
  font-weight: 400;
  font-size: 24rpx;
  display: block;
  margin-bottom: 8rpx;
}