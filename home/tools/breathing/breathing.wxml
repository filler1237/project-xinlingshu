<!-- home/tools/breathing/breathing.wxml -->
<view class="container">
  <!-- Dynamic Background -->
  <view class="dynamic-bg {{status}}"></view>

  <view class="header" style="padding-top: {{statusBarHeight}}px; height: {{navBarHeight}}px;">
    <view class="back-button" bind:tap="navigateBack" style="top: {{statusBarHeight + (navBarHeight - 32)/2}}px;">
      <image src="cloud://cloud1-2gxal8as6b6bfe21.636c-cloud1-2gxal8as6b6bfe21-1378381651/image/back.svg" mode="aspectFit" class="back-icon"/>
    </view>
    <text class="header-title" style="line-height: {{navBarHeight}}px;">快乐呼吸练习</text>
  </view>
  
  <view class="content-wrapper" style="margin-top: {{totalNavHeight}}px;">
    <view class="breathing-display">
      <view class="halo-ring ring-1 {{status}}"></view>
      <view class="halo-ring ring-2 {{status}}"></view>
      <view class="breathing-circle {{status}}">
        <view class="inner-content">
          <text class="circle-emoji">{{status === 'inhaling' ? '🌬️' : status === 'holding' ? '😶' : status === 'exhaling' ? '😮‍💨' : status === 'paused' ? '⏸️' : '😌'}}</text>
          <text class="circle-status">{{instruction}}</text>
          <text class="circle-timer" wx:if="{{status !== 'ready'}}">{{countdown}}</text>
        </view>
      </view>
    </view>
    
    <view class="progress-container">
      <view class="progress-bar">
        <view class="progress-fill {{status}}" style="width: {{progress}}%;"></view>
      </view>
    </view>
    
    <view class="controls-area">
      <button wx:if="{{status === 'ready'}}" class="action-btn start-btn" bind:tap="startBreathing">开始练习</button>
      <button wx:elif="{{status === 'paused'}}" class="action-btn resume-btn" bind:tap="resumeBreathing">继续</button>
      <button wx:elif="{{status !== 'ready'}}" class="action-btn pause-btn" bind:tap="stopBreathing">暂停</button>
      <button class="action-btn reset-btn" bind:tap="resetBreathing">重置</button>
    </view>
    
    <view class="glass-card instructions">
      <view class="instruction-row">
        <text class="step-icon">🌬️</text>
        <text class="step-text">吸气 4 秒</text>
      </view>
      <view class="instruction-row">
        <text class="step-icon">😶</text>
        <text class="step-text">屏息 7 秒</text>
      </view>
      <view class="instruction-row">
        <text class="step-icon">😮‍💨</text>
        <text class="step-text">呼气 8 秒</text>
      </view>
      <view class="instruction-tip">重复 3 次 · 感受身心放松</view>
    </view>
  </view>
</view>
