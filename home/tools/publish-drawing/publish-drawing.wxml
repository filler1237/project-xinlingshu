<!-- home/tools/publish-drawing/publish-drawing.wxml -->
<view class="page">
  <navigation-bar title="发布作品" back="{{true}}"></navigation-bar>
  
  <view class="publish-container">
    <view class="preview-section">
      <image class="preview-image" src="{{tempFilePath}}" mode="aspectFit"></image>
    </view>
    
    <view class="form-section">
      <textarea 
        class="description-input" 
        placeholder="为你的作品添加一句话描述吧..." 
        maxlength="140"
        bindinput="onDescriptionInput"
        value="{{description}}">
      </textarea>
    </view>
    
    <view class="activity-section" wx:if="{{activity}}">
      <view class="activity-title">发现正在进行的活动</view>
      <view class="activity-info">
        <image class="activity-banner" src="{{activity.banner}}" mode="aspectFill"></image>
        <view class="activity-details">
          <view class="activity-name">{{activity.title}}</view>
          <view class="activity-desc">{{activity.description}}</view>
        </view>
      </view>
      <switch class="activity-switch" checked="{{joinActivity}}" bindchange="onActivitySwitchChange">
        <text>参加活动</text>
      </switch>
    </view>
    
    <button 
      class="publish-btn" 
      bindtap="publishDrawing" 
      loading="{{isPublishing}}">
      {{isPublishing ? '发布中...' : '确认发布'}}
    </button>
  </view>
</view>
