/* home/tools/publish-drawing/publish-drawing.wxss */
.page {
  background-color: #f7f7f7;
  min-height: 100vh;
}

.publish-container {
  padding: 30rpx;
}

.preview-section {
  width: 100%;
  height: 400rpx;
  background-color: #fff;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.preview-image {
  width: 100%;
  height: 100%;
}

.form-section {
  margin-top: 30rpx;
}

.description-input {
  width: 100%;
  height: 180rpx;
  background-color: #fff;
  border-radius: 20rpx;
  padding: 20rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  color: #333;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.activity-section {
  margin-top: 40rpx;
  background-color: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.activity-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.activity-info {
  display: flex;
  align-items: center;
}

.activity-banner {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
  background-color: #eee;
}

.activity-details {
  flex: 1;
}

.activity-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.activity-desc {
  font-size: 24rpx;
  color: #888;
  margin-top: 8rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.activity-switch {
  margin-top: 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 28rpx;
}

.publish-btn {
  margin-top: 60rpx;
  width: 100%;
  height: 90rpx;
  line-height: 90rpx;
  background: linear-gradient(135deg, #d4af37, #b48a00);
  color: #fff;
  border-radius: 45rpx;
  font-size: 32rpx;
  box-shadow: 0 8rpx 16rpx rgba(212, 175, 55, 0.3);
}
