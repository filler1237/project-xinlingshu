/* pages/home/function/test/test.wxss */
page {
  background-color: #F8F8F8; /* 柔和的米白背景 */
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  color: #333;
}

.page-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-bottom: 120rpx; /* 为底部插画留出空间 */
}

.top-tree {
  width: 100%;
  height: 400rpx;
  margin-top: -20rpx;
}

.section {
  width: 90%;
  margin-top: 30rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 25rpx;
  padding-left: 10rpx;
  border-left: 8rpx solid #A8D8B8; /* 柔和的绿色装饰线 */
}

.ipip-title {
  color: #555555;
  border-left-color: #F0C9A8; /* 温暖的橙色装饰线 */
}

.card-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.card {
  width: 48%;
  height: 280rpx;
  border-radius: 20rpx;
  margin-bottom: 25rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  transition: all 0.3s ease;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.card:hover {
  transform: translateY(-10rpx);
  box-shadow: 0 10rpx 20rpx rgba(0, 0, 0, 0.1);
}

.professional-card {
  /* 渐变背景已在js中定义 */
}

.ipip-card {
  /* 渐变背景已在js中定义 */
}

.card-icon {
  width: 100rpx;
  height: 100rpx;
}

.card-font {
  margin-top: 20rpx;
  text-align: center;
}

.card-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #444444;
}

.card-abbr {
  font-size: 22rpx;
  color: #888888;
  margin-top: 5rpx;
  display: block;
}

.bottom-illustration {
  width: 100%;
  position: fixed;
  bottom: 0;
  left: 0;
  z-index: -1;
}
