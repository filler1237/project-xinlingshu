<navigation-bar title="一般健康问卷 GHQ-12"></navigation-bar>

<view class="IconBox">
  <view class="QesIn" style="background: {{color}};">
    <image src="/image/TestIcon.png" mode="widthFix" class="QesPic"/>
    <view class="Font" style="text-align: center;">
      <text >一般健康问卷</text>
      <text >GHQ-12</text>
    </view>
  </view>
</view>

<view class="quesbox" wx:if="{{id<12}}">

<swiper style="height: 100%;" current="{{id}}" bindchange="QueChange" >
  <block wx:for="{{GHQQuestion}}" >
    <swiper-item style="height:fit-content;">
        
      <view class="question">
        {{item.question}}
      </view>

      <view class="select flex" >
        <view  class="item" >
          <label bindtap="OpA">{{OptionA}}</label>
          <label bindtap="OpB">{{OptionB}}</label>
          <label bindtap="OpC">{{OptionC}}</label>
          <label bindtap="OpD">{{OptionD}}</label>
        </view>
      </view>
      
      
    </swiper-item>  
  </block> 
</swiper>
<view wx:if="{{id != 0}}">
  <view class="tips" bindtap="LastQ">
    上一题
  </view>
</view>
<view class="tips" style="color: #FEDB03;" wx:if="{{id<12}}">
    {{id+1}}/12
</view>
</view>



<view wx:if="{{id==12}}" class="quesbox"  >
   <view class="select flex" bindtap="Goresult">
    <label >查看结果</label>
    </view> 
</view>

<view>
  <image src="/image/Test.png" mode="widthFix" style="width: 750rpx;"/>
</view>
