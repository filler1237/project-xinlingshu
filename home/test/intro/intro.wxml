<navigation-bar title="{{title}}"></navigation-bar>

<view class="page-container">
  <!-- 图标区域 -->
  <view class="icon-section">
    <view class="icon-card" style="background: {{color}};">
      <image src="{{icon}}" mode="widthFix" class="icon-image"/>
      <view class="icon-title">{{icontitle}}</view>
    </view>
  </view>

  <!-- 介绍内容区域 -->
  <view class="intro-section">
    <view class="intro-card">
      <view class="section-title">量表简介</view>
      <view class="intro-content">{{intro}}</view>
      <view class="instruction">请根据最近一周的实际感觉，选择较符合的选项</view>
      <view class="disclaimer">
        <text class="disclaimer-icon">⚠️</text>
        <text class="disclaimer-text">免责声明：本测评结果仅供参考，不能替代专业医疗诊断。如有心理健康问题，请及时咨询专业医生或心理咨询师。本平台不对测评结果承担任何法律责任。</text>
      </view>
    </view>
  </view>

  <!-- 开始测试按钮 -->
  <view class="action-section">
    <view class="start-button" bind:tap="GoTest">开始测试</view>
  </view>
</view>

