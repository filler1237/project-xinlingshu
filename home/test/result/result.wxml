<!--home/test/result/result.wxml-->
<!--pages/home/function/1/SDS/result/result.wxml-->
<navigation-bar title='{{title}}'></navigation-bar>


<view class="IconBox">
  <view class="QesIn" style="background: {{color}};" bind:tap="GoToSDS">
    <image src="/image/TestIcon.png" mode="widthFix" class="QesPic"/>
    <view class="Font" style="text-align: center;">
      <text >{{icontitle}}</text>
    </view>
  </view>
</view>


<view class="IntroBox">
<text class="Font" style="color: #96CE74; top: 20rpx;">您的测评结果</text>

<view >
<text class="Font" style="color: #000000;">{{advise}}</text>
</view>

<view style="display: flex; justify-content: center;">
  <text class="Font" style="color: #96CE74; align-items: center;" bind:tap="OneMore">
  再测一次
  </text>
</view>

<button style="color: #ffffff;" bind:tap="BackTo">返回</button>
</view>


<view style="padding-top: 82rpx;">
  <image src="/image/Test.png" mode="widthFix" style="width: 750rpx;"/>
</view>
