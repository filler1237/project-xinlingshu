<!--pages/home/function/test/test.wxml-->
<view class="contentsPages" style="height:{{navBarHeight}}px; padding: {{titleBottom+45}}rpx 0rpx 0rpx 20rpx;">
  <view class="title" bind:tap="BACK">
    {{title}}
  </view></view>

<view class="Pic">
<image src="/image/QingSu.png" mode="heightFix" class="Pic"/>
</view>

<view class="QesBox">
  <view class="QesIn" style="background: #E5FFF0;" bind:tap="GoToSDS">
    <image src="/image/TestIcon.png" mode="widthFix" class="QesPic"/>
    <view class="Font">
      <text>抑郁自评量表</text>
      <text>SDS</text>
    </view>
  </view>
  <view class="QesIn" style="background: #EDF9FC;" bind:tap="GoToSAS">
    <image src="/image/TestIcon.png" mode="widthFix" class="QesPic"/>
    <view class="Font">
      <text>焦虑自评量表</text>
      <text>SAS</text>
    </view>
  </view>
  <view class="QesIn" style="background: #FFFBE3;" bind:tap="GoToAIS">
    <image src="/image/TestIcon.png" mode="widthFix" class="QesPic"/>
    <view class="Font">
      <text>阿森斯失眠量表</text>
      <text>AIS</text>
    </view>
  </view>
</view>


<view class="QesBox">
