<!--pages/home/function/test/test.wxml-->
<navigation-bar title="心理测评"></navigation-bar>

<view class="page-container">
  <!-- 保留顶部的树 -->
  <image src="cloud://cloud1-2gxal8as6b6bfe21.636c-cloud1-2gxal8as6b6bfe21-1378381651/image/QingSu.png" mode="widthFix" class="top-tree"/>

  <!-- 专业量表区 -->
  <view class="section">
    <view class="section-title">专业心理测评</view>
    <view class="card-grid">
      <view wx:for="{{professionalScales}}" wx:key="id" class="card professional-card" style="background: {{item.bgColor}};" data-url="{{item.url}}" bind:tap="GoToIntro">
        <image src="{{item.icon}}" mode="widthFix" class="card-icon"/>
        <view class="card-font">
          <text class="card-title">{{item.title}}</text>
          <text class="card-abbr">{{item.abbr}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- IPIP 轻量问卷区 -->
  <view class="section">
    <view class="section-title ipip-title">自我探索问卷 (IPIP)</view>
    <view class="card-grid">
      <view wx:for="{{ipipScales}}" wx:key="id" class="card ipip-card" style="background: {{item.bgColor}};" data-url="{{item.url}}" bind:tap="GoToIntro">
        <image src="{{item.icon}}" mode="widthFix" class="card-icon"/>
        <view class="card-font">
          <text class="card-title">{{item.title}}</text>
          <text class="card-abbr">{{item.abbr}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部插画 -->
  <image src="cloud://cloud1-2gxal8as6b6bfe21.636c-cloud1-2gxal8as6b6bfe21-1378381651/image/Test.png" mode="widthFix" class="bottom-illustration"/>
</view>
