      <text>焦虑自评量表</text>
      <text>SAS</text>
    </view>
  </view>
  <view class="QesIn" style="background: #F9FFE3;">
    <image src="/image/TestIcon.png" mode="widthFix" class="QesPic"/>
    <view class="Font">
      <text>阿森斯失眠量表</text>
      <text>AIS</text>
    </view>
  </view>
</view>

<view style="padding-top: 45rpx;">
  <image src="/image/Test.png" mode="widthFix" style="width: 750rpx;"/>
