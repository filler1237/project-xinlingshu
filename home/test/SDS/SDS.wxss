/* pages/home/function/1/SDS/SDStext/SDStext.wxss */
page{
  background-color: #FFFFF5;
}

.IconBox{
  width: 750rpx;
  height: 300rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 25rpx;
}
.QesIn{
  width: 220rpx;
  height: 244rpx;
  border-radius: 10rpx;
  backdrop-filter: blur(20rpx);
  box-shadow: 0rpx 0rpx 8rpx 0rpx #DCDCC14C;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}
.QesPic{
  margin-top: 10rpx;
  width: 100rpx;
}
.Font{
  font-family: PingFang SC;
  font-weight: 230;
  font-size: 28rpx;
  line-height: 1.25;
  letter-spacing: 0.25rpx;
  line-height: 1.5em;
  letter-spacing: 2px;
  word-spacing: 4px;
  /* text-align: center; */
  margin-top: 15rpx;
}


.quesbox{
  width: 100%;
  height: 900rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 45rpx;
  box-sizing: border-box;
}
.question{
  text-align: center;
  padding: 5rpx 3rpx;
  font-size: 38rpx;
  font-weight: normal;
}

.flex{
  display: flex;
  flex-direction: column;
  background-color: #FFFFF5;
}

.flex .item{
  flex: 100;
  display:flex;
  justify-content: center;
  align-items: center;
  padding: 7rpx;
  flex-direction: column;
}
 
.select {
  padding: 15px 10px;
  background-color: #FFFFF5;
}
 
.select label {
  border: 1px solid #96CE74;
  color: #96CE74;
  padding: 15px 7px;
  margin: 10rpx;
  font-size: 17px;
  font-weight: 300;
  border-radius: 4px;
  width: 550rpx;
  text-align: center;
}
 