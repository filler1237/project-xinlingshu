@keyframes option-click {
  0% { transform: scale(1); }
  50% { transform: scale(0.95); }
  100% { transform: scale(1); }
}

@keyframes button-click {
  0% { transform: scale(1); }
  50% { transform: scale(0.95); }
  100% { transform: scale(1); }
}

page {
  height: 100%;
  overflow: hidden;
}

.page-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #F8F9FA;
  overflow: hidden;
}

.main-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  width: 100%;
  padding: 0 50rpx;
  box-sizing: border-box;
  transform: translateY(-5%);
}

.progress-section {
  width: 100%;
  margin-bottom: 50rpx;
}

.progress-bar-container {
  width: 100%;
  height: 8rpx;
  background-color: #E9ECEF;
  border-radius: 4rpx;
  margin-bottom: 15rpx;
}

.progress-bar {
  height: 100%;
  background-color: #A8D8B8;
  border-radius: 4rpx;
  transition: width 0.5s ease;
}

.progress-text {
  font-size: 26rpx;
  color: #868E96;
  text-align: center;
}

.question-section {
  width: 100%;
  text-align: center;
}

.question-stem {
  font-size: 36rpx;
  color: #343A40;
  margin-bottom: 60rpx;
  font-weight: bold;
  line-height: 1.4;
}

.options-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
}

.option-card {
  width: 100%;
  padding: 45rpx;
  margin-bottom: 35rpx;
  background-color: #FFFFFF;
  border-radius: 30rpx;
  box-shadow: 0 6rpx 20rpx rgba(168, 216, 184, 0.2);
  font-size: 32rpx;
  color: #495057;
  text-align: center;
  transition: all 0.2s ease;
}

.option-card.selected {
  background-color: #A8D8B8;
  color: #FFFFFF;
  animation: option-click 0.2s ease-in-out;
}

.footer-actions {
  display: flex;
  justify-content: space-between;
  width: 100%;
  padding: 0 50rpx 80rpx;
  box-sizing: border-box;
  position: absolute;
  bottom: 0;
  left: 0;
}

.nav-button {
  width: 35%;
  padding: 25rpx 0;
  text-align: center;
  border-radius: 40rpx;
  font-size: 30rpx;
  transition: background-color 0.3s ease;
}

.nav-button:active {
  animation: button-click 0.2s ease-in-out;
}

.prev-button {
  background-color: #DEE2E6;
  color: #868E96;
}

.prev-button:not(.disabled) {
  background-color: #495057;
  color: #FFFFFF;
}

.submit-button {
  background-color: #CED4DA;
  color: #868E96;
}

.submit-button.enabled {
  background-color: #A8D8B8;
  color: #FFFFFF;
}
.question{
  text-align: center;
  padding: 5rpx 3rpx;
  font-size: 38rpx;
  font-weight: normal;
}

.flex{
  display: flex;
  flex-direction: column;
  background-color: #FFFFF5;
}

.flex .item{
  flex: 100;
  display:flex;
  justify-content: center;
  align-items: center;
  padding: 7rpx;
  flex-direction: column;
}
 
.select {
  padding: 15px 10px;
  background-color: #FFFFF5;
}
 
.select label {
  border: 1px solid #96CE74;
  color: #96CE74;
  padding: 15px 7px;
  margin: 10rpx;
  font-size: 17px;
  font-weight: 300;
  border-radius: 4px;
  width: 550rpx;
  text-align: center;
}
 