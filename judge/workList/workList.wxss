/* 活动列表页面样式 - 与评委工作台设计系统统一 */

.container {
    padding: 30rpx;
    /* 统一内边距 */
    min-height: 100vh;
    /* 最小高度为整个视口 */
    background: linear-gradient(180deg, #FFFFF5 0%, #FFFFFF 100%);
    /* 统一渐变背景 */
    position: relative;
    /* 相对定位，用于背景装饰元素 */
}


/* 背景装饰元素 - 保持统一风格 */

.container::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: radial-gradient(ellipse at -20% 20%, rgba(80, 182, 255, 0.08) 0%, transparent 50%), radial-gradient(ellipse at 120% 80%, rgba(66, 255, 0, 0.08) 0%, transparent 50%);
    pointer-events: none;
    /* 确保不影响交互 */
    z-index: 1;
}


/* 头部区域 */

.header {
    display: flex;
    align-items: center;
    margin-bottom: 30rpx;
    padding: 20rpx 0;
    position: relative;
    /* 相对定位 */
    z-index: 2;
    /* 确保在背景之上 */
}


/* 返回按钮 - 统一风格 */

.back-btn {
    padding: 15rpx 25rpx;
    background: linear-gradient(135deg, #26a69a 0%, #4db6ac 100%);
    /* 渐变背景 */
    color: white;
    border-radius: 15rpx;
    /* 统一圆角 */
    font-size: 28rpx;
    font-family: PingFang SC;
    font-weight: 500;
    border: none;
    box-shadow: 2rpx 2rpx 6rpx 0rpx #00000026;
    /* 统一阴影 */
    backdrop-filter: blur(10rpx);
    /* 毛玻璃效果 */
}

.back-btn:active {
    transform: translateY(2rpx);
    /* 按下效果 */
    box-shadow: 1rpx 1rpx 3rpx 0rpx #0000001a;
}


/* 页面标题 */

.title {
    flex: 1;
    text-align: center;
    font-size: 36rpx;
    font-weight: bold;
    color: #3F3F3F;
    /* 统一深灰色 */
    font-family: PingFang SC;
    letter-spacing: 1rpx;
}


/* 筛选标签 - 统一风格 */

.filter-tabs {
    width: 100%;
    display: flex;
    background: linear-gradient(148.26deg, rgba(130, 255, 158, 0.8) 0%, rgba(255, 255, 255, 0.8) 9%, rgba(255, 255, 255, 0.8) 100%);
    /* 统一渐变背景 */
    border-radius: 20rpx;
    /* 统一圆角 */
    backdrop-filter: blur(20rpx);
    /* 毛玻璃效果 */
    box-shadow: 2rpx 2rpx 6rpx 0rpx #00000026;
    /* 统一阴影 */
    padding: 10rpx;
    margin-bottom: 30rpx;
    border: 1rpx solid rgba(255, 255, 255, 0.5);
    /* 半透明边框 */
    position: relative;
    z-index: 2;
}

.tab-item {
    flex: 1;
    text-align: center;
    padding: 20rpx;
    font-size: 28rpx;
    color: #3F3F3F;
    /* 统一深灰色 */
    border-radius: 15rpx;
    /* 统一圆角 */
    font-family: PingFang SC;
    font-weight: regular;
    transition: all 0.3s ease;
}

.tab-item.active {
    background: linear-gradient(135deg, #26a69a 0%, #4db6ac 100%);
    /* 渐变背景 */
    color: white;
    font-weight: bold;
    box-shadow: 2rpx 2rpx 6rpx 0rpx #00000026;
    /* 激活状态阴影 */
}


/* 统计信息 - 统一风格 */

.stats-bar {
    background: linear-gradient(148.26deg, rgba(130, 255, 158, 0.8) 0%, rgba(255, 255, 255, 0.8) 9%, rgba(255, 255, 255, 0.8) 100%);
    /* 统一渐变背景 */
    border-radius: 20rpx;
    /* 统一圆角 */
    backdrop-filter: blur(20rpx);
    /* 毛玻璃效果 */
    box-shadow: 2rpx 2rpx 6rpx 0rpx #00000026;
    /* 统一阴影 */
    padding: 25rpx;
    margin-bottom: 30rpx;
    border: 1rpx solid rgba(255, 255, 255, 0.5);
    /* 半透明边框 */
    position: relative;
    z-index: 2;
}

.stat-text {
    font-size: 26rpx;
    color: #3F3F3F;
    /* 统一深灰色 */
    font-family: PingFang SC;
    font-weight: regular;
    text-align: center;
    letter-spacing: 0.5rpx;
}


/* 活动列表 */

.work-list {
    height: calc(100vh - 400rpx);
    position: relative;
    z-index: 2;
}


/* 活动项卡片 - 统一风格 */

.work-item {
    background: linear-gradient(148.26deg, rgba(130, 255, 158, 0.8) 0%, rgba(255, 255, 255, 0.8) 9%, rgba(255, 255, 255, 0.8) 100%);
    /* 统一渐变背景 */
    border-radius: 20rpx;
    /* 统一圆角 */
    backdrop-filter: blur(20rpx);
    /* 毛玻璃效果 */
    box-shadow: 2rpx 2rpx 6rpx 0rpx #00000026;
    /* 统一阴影 */
    padding: 30rpx;
    margin-bottom: 25rpx;
    border: 1rpx solid rgba(255, 255, 255, 0.5);
    /* 半透明边框 */
    transition: all 0.3s ease;
}

.work-item:active {
    transform: translateY(2rpx);
    /* 统一交互反馈 */
    box-shadow: 1rpx 1rpx 3rpx 0rpx #0000001a;
}

.work-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 20rpx;
}

.work-title {
    font-size: 30rpx;
    font-weight: bold;
    color: #3F3F3F;
    /* 统一深灰色 */
    flex: 1;
    margin-right: 20rpx;
    font-family: PingFang SC;
    line-height: 1.4;
}


/* 作品状态徽章 */

.work-status {
    padding: 8rpx 16rpx;
    border-radius: 20rpx;
    /* 统一圆角 */
    font-size: 22rpx;
    font-weight: bold;
    font-family: PingFang SC;
    min-width: 80rpx;
    text-align: center;
    backdrop-filter: blur(10rpx);
    /* 毛玻璃效果 */
}

.work-status.pending {
    background: rgba(211, 47, 47, 0.2);
    /* 红色半透明背景 */
    color: #d32f2f;
    /* 红色文字 */
    border: 1rpx solid rgba(211, 47, 47, 0.3);
}

.work-status.reviewed {
    background: rgba(56, 142, 60, 0.2);
    /* 绿色半透明背景 */
    color: #388e3c;
    /* 绿色文字 */
    border: 1rpx solid rgba(56, 142, 60, 0.3);
}


/* 作品信息 */

.work-info {
    display: flex;
    gap: 30rpx;
    margin-bottom: 15rpx;
    flex-wrap: wrap;
}

.info-item {
    font-size: 26rpx;
    color: #3F3F3F;
    /* 统一深灰色 */
    font-family: PingFang SC;
    font-weight: regular;
    display: flex;
    align-items: center;
}

.info-item::before {
    content: '•';
    margin-right: 8rpx;
    color: #26a69a;
    /* 主题绿色 */
}

.work-meta {
    display: flex;
    justify-content: space-between;
    margin-bottom: 15rpx;
    flex-wrap: wrap;
    gap: 15rpx;
}

.meta-item {
    font-size: 24rpx;
    color: #666;
    /* 稍浅的灰色 */
    font-family: PingFang SC;
    font-weight: regular;
}

.meta-item.score {
    color: #d32f2f;
    /* 保持醒目的红色 */
    font-weight: bold;
    background: rgba(211, 47, 47, 0.1);
    padding: 4rpx 12rpx;
    border-radius: 10rpx;
}

.work-desc {
    font-size: 26rpx;
    color: #3F3F3F;
    /* 统一深灰色 */
    line-height: 1.4;
    margin-bottom: 20rpx;
    font-family: PingFang SC;
    font-weight: regular;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
}


/* 作品操作按钮 */

.work-actions {
    display: flex;
    gap: 15rpx;
}

.action-btn {
    padding: 15rpx 25rpx;
    border-radius: 15rpx;
    /* 统一圆角 */
    font-size: 26rpx;
    font-weight: bold;
    text-align: center;
    font-family: PingFang SC;
    border: none;
    box-shadow: 2rpx 2rpx 6rpx 0rpx #00000026;
    /* 统一阴影 */
    backdrop-filter: blur(10rpx);
    /* 毛玻璃效果 */
    flex: 1;
    transition: all 0.3s ease;
}

.action-btn:active {
    transform: translateY(2rpx);
    /* 按下效果 */
    box-shadow: 1rpx 1rpx 3rpx 0rpx #0000001a;
}

.action-btn.detail {
    background: linear-gradient(135deg, rgba(224, 242, 241, 0.8) 0%, rgba(255, 255, 255, 0.8) 100%);
    /* 浅绿色渐变 */
    color: #26a69a;
    /* 主题绿色 */
    border: 1rpx solid rgba(38, 166, 154, 0.3);
}

.action-btn.review {
    background: linear-gradient(135deg, #26a69a 0%, #4db6ac 100%);
    /* 主题绿色渐变 */
    color: white;
}


/* 空状态 */

.empty-state {
    text-align: center;
    padding: 100rpx 20rpx;
    position: relative;
    z-index: 2;
}

.empty-text {
    font-size: 28rpx;
    color: #666;
    /* 稍浅的灰色 */
    font-family: PingFang SC;
    font-weight: regular;
    line-height: 1.6;
}


/* 响应式调整 */

@media (max-width: 750rpx) {
    .work-header {
        flex-direction: column;
        align-items: flex-start;
    }
    .work-status {
        margin-top: 10rpx;
        align-self: flex-start;
    }
    .work-info {
        flex-direction: column;
        gap: 10rpx;
    }
    .work-meta {
        flex-direction: column;
        gap: 10rpx;
    }
    .work-actions {
        flex-direction: column;
    }
}


/* 加载状态动画 */

@keyframes shimmer {
    0% {
        background-position: -468px 0;
    }
    100% {
        background-position: 468px 0;
    }
}

.loading-item {
    animation-duration: 1.25s;
    animation-fill-mode: forwards;
    animation-iteration-count: infinite;
    animation-name: shimmer;
    animation-timing-function: linear;
    background: linear-gradient(to right, rgba(255, 255, 255, 0.1) 8%, rgba(255, 255, 255, 0.3) 18%, rgba(255, 255, 255, 0.1) 33%);
    background-size: 800px 104px;
}