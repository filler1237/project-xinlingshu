/* competition/pages/judge/scoring/scoring.wxss */

.scoring-page {
  background: linear-gradient(180deg, #f7fdf9 0%, #f0f9f4 100%);
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.content {
  height: calc(100vh - 88rpx);
  padding: 24rpx 32rpx;
}

.loading-state {
  text-align: center;
  padding: 120rpx 0;
  font-size: 28rpx;
  color: #95a5a6;
}

/* ========== 卡片样式 ========== */
.card {
  background: white;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 30rpx rgba(76, 217, 100, 0.08);
}

.card-title {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #f0f9f4;
}

.title-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.title-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #2c3e50;
}

/* ========== 信息项样式 ========== */
.info-item {
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f9f4;
}

.info-item:last-child {
  margin-bottom: 0;
  padding-bottom: 0;
  border-bottom: none;
}

.label {
  font-size: 28rpx;
  color: #7f8c8d;
  margin-right: 12rpx;
}

.value {
  font-size: 28rpx;
  color: #2c3e50;
}

.description-text {
  display: block;
  margin-top: 8rpx;
  line-height: 1.6;
  color: #34495e;
}

/* ========== 文件区域样式 ========== */
.file-section {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 20rpx;
  padding: 20rpx;
  background: #f8fcf9;
  border-radius: 12rpx;
}

.file-info {
  display: flex;
  align-items: center;
  flex: 1;
}

.file-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.file-name {
  font-size: 26rpx;
  color: #2c3e50;
}

.download-btn {
  background: #4cd964;
  color: white;
  border-radius: 12rpx;
  font-size: 24rpx;
  padding: 12rpx 24rpx;
}

/* ========== 评分项样式 ========== */
.score-items {
  margin-bottom: 24rpx;
}

.score-item {
  margin-bottom: 32rpx;
  padding: 24rpx;
  background: #f8fcf9;
  border-radius: 16rpx;
}

.score-item:last-child {
  margin-bottom: 0;
}

.score-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16rpx;
}

.score-name-section {
  flex: 1;
}

.score-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #2c3e50;
  display: block;
  margin-bottom: 8rpx;
}

.score-desc {
  font-size: 24rpx;
  color: #7f8c8d;
  display: block;
}

.score-range {
  font-size: 24rpx;
  color: #95a5a6;
}

.score-input-section {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}

.score-input {
  flex: 1;
  padding: 16rpx 20rpx;
  border: 2rpx solid #e8f5e9;
  border-radius: 12rpx;
  background: white;
  font-size: 32rpx;
  font-weight: 600;
  color: #2c3e50;
  text-align: center;
}

.score-input[disabled] {
  background: #f5f5f5;
  color: #95a5a6;
}

.score-unit {
  font-size: 28rpx;
  color: #7f8c8d;
  margin-left: 12rpx;
}

/* ========== 总分样式 ========== */
.total-score-section {
  text-align: center;
  padding: 24rpx;
  background: #e8f5e9;
  border-radius: 12rpx;
  margin-top: 24rpx;
}

.total-label {
  font-size: 28rpx;
  color: #2c3e50;
  margin-right: 12rpx;
}

.total-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #4cd964;
}

/* ========== 评语区域样式 ========== */
.comment-input {
  width: 100%;
  min-height: 200rpx;
  padding: 20rpx;
  border: 2rpx solid #e8f5e9;
  border-radius: 12rpx;
  background: #f8fcf9;
  font-size: 28rpx;
  color: #2c3e50;
  line-height: 1.6;
}

.comment-input[disabled] {
  background: #f5f5f5;
  color: #95a5a6;
}

.comment-count {
  display: block;
  text-align: right;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #95a5a6;
}

/* ========== 已评审提示 ========== */
.reviewed-tip {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx;
  background: #fff3cd;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
}

.tip-icon {
  font-size: 32rpx;
  color: #856404;
  margin-right: 12rpx;
}

.tip-text {
  font-size: 26rpx;
  color: #856404;
}

/* ========== 提交按钮样式 ========== */
.submit-section {
  margin-top: 32rpx;
  padding-bottom: 40rpx;
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  border-radius: 24rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  background: linear-gradient(135deg, #4cd964 0%, #3db954 100%);
  color: white;
  box-shadow: 0 8rpx 20rpx rgba(76, 217, 100, 0.3);
}

.submit-btn[disabled] {
  background: #ecf0f1;
  color: #95a5a6;
  box-shadow: none;
}

.submit-btn:active:not([disabled]) {
  opacity: 0.8;
}

